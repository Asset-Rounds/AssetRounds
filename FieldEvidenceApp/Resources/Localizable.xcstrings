    "v30.parts-stock.open-catalog-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the open catalog hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the contained catalog view when the caller supplies the route. It does not register a new root."
          }
        },
        "es": {
          "stringUnit": {
