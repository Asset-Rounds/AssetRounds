          }
        }
      }
    },
    "v30.voice-capture.target-description": {
      "comment": "Screen: Voice capture. Meaning: Explains target description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture target is fixed by the supplied context. If that revision changes, the caller must mark this session stale and return to manual entry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El destino de captura está fijado por el contexto proporcionado. Si esa revisión cambia, el componente solicitante debe marcar esta sesión como desactualizada y volver a la entrada manual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "采集目标由提供的上下文固定。如果该修订版更改，调用方必须将此会话标记为过期，并返回手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "擷取目標由提供的脈絡固定。若修訂版改變，呼叫端必須將此工作階段標為過期，並返回手動輸入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đích thu thập được cố định theo ngữ cảnh được cung cấp. Nếu bản sửa đổi thay đổi, bên gọi phải đánh dấu phiên này là lỗi thời và quay lại nhập thủ công."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수집 대상은 제공된 맥락에 의해 고정됩니다. 해당 개정본이 변경되면 호출 측은 이 세션을 오래된 상태로 표시하고 수동 입력으로 돌아가야 합니다."
          }
        }
      }
    },
    "v30.voice-capture.target-revision": {
      "comment": "Screen: Voice capture. Meaning: Names the target revision value. Role: value-row label. Arguments: none. Plural/select: none. Accessibility: The combined row exposes this label with its value to VoiceOver. Screenshot: Voice capture value-row label state; no screenshot is claimed.",
      "localizations": {
