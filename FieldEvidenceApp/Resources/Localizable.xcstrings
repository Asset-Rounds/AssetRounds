          }
        }
      }
    },
    "v30.recipient-review.trust-description": {
      "comment": "Screen: Recipient review. Meaning: Explains trust description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A matching response proof shows possession of the request capability and detects a changed response for that request. It does not establish identity, authority, personal review, delivery, read status, legal effect, or approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una prueba de respuesta coincidente muestra la posesión de la capacidad solicitada y detecta una respuesta modificada para esa solicitud. No establece identidad, autoridad, revisión personal, entrega, estado de lectura, efecto legal ni aprobación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "匹配的响应证明显示拥有该请求能力，并检测到该请求的响应已更改。它不确立身份、权限、个人审核、交付、阅读状态、法律效力或批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相符的回應證明顯示擁有請求能力，並偵測該請求的回應是否變更。它不確立身分、權限、個人檢閱、交付、已讀狀態、法律效力或核准。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bằng chứng phản hồi khớp cho thấy đang sở hữu khả năng yêu cầu và phát hiện phản hồi đã thay đổi cho yêu cầu đó. Không xác lập danh tính, thẩm quyền, xem xét cá nhân, giao nhận, trạng thái đã đọc, hiệu lực pháp lý hoặc phê duyệt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일치하는 응답 증명은 요청 기능의 보유를 보여 주고 해당 요청의 변경된 응답을 감지합니다. 신원, 권한, 개인 검토, 납품, 읽음 상태, 법적 효력 또는 승인을 확립하지 않습니다."
          }
        }
      }
    },
