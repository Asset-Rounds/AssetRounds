    "v30.service-request.accessibility-description": {
      "comment": "Screen: Service request. Meaning: Explains accessibility description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All controls have stable labels for VoiceOver, Voice Control, Switch Control, keyboard use, and RTL layout. At Accessibility text sizes, content reflows without relying on truncation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los controles tienen etiquetas estables para VoiceOver, Control por voz, Control por botón, uso del teclado y diseño de derecha a izquierda. Con los tamaños de texto de accesibilidad, el contenido se redistribuye sin depender de recortes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有控件均有稳定标签，支持旁白、语音控制、切换控制、键盘和从右到左的布局。在辅助功能字体大小下，内容会重新排布，无需依赖截断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有控制項都有固定標籤，支援 VoiceOver、語音控制、切換控制、鍵盤與由右至左的版面配置。使用輔助使用字體大小時，內容會重新排列，不需依賴截斷。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mọi điều khiển đều có nhãn ổn định cho VoiceOver, Điều khiển bằng giọng nói, Điều khiển công tắc, bàn phím và bố cục từ phải sang trái. Với cỡ chữ trợ năng, nội dung tự bố trí lại thay vì dựa vào việc cắt ngắn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 컨트롤에는 VoiceOver, 음성 명령, 스위치 제어, 키보드 사용 및 RTL 레이아웃을 위한 일관된 라벨이 있습니다. 손쉬운 사용 텍스트 크기에서는 잘라내기에 의존하지 않고 콘텐츠가 재배치됩니다."
          }
        }
      }
    },
    "v30.service-request.boundaries-description": {
      "comment": "Screen: Service request. Meaning: Explains boundaries description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Errors move focus to needs-triage. Reduce Motion adds no state-change animation. This contained surface makes no network, portal, delivery, dispatch, SLA, monitoring, or contact-verification claim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los errores mueven el foco a necesita clasificación. Reducir movimiento no agrega animación de cambio de estado. Esta superficie contenida no declara red, portal, entrega, envío, SLA, supervisión ni verificación de contacto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "错误会将焦点移至“需要分类”。减少动态效果不会添加状态变更动画。此受限界面不作出网络、门户、交付、派遣、SLA、监控或联系人验证声明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "錯誤會將焦點移至需要分流。減少動態效果不會新增狀態變更動畫。此受限介面不宣稱網路、入口網站、交付、派送、SLA、監控或聯絡驗證。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lỗi chuyển tiêu điểm đến phần cần phân loại. Giảm Chuyển động không thêm hoạt ảnh thay đổi trạng thái. Bề mặt giới hạn này không tuyên bố mạng, cổng thông tin, gửi, điều phối, SLA, theo dõi hoặc xác minh liên hệ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오류는 포커스를 분류 필요 항목으로 이동합니다. 동작 줄이기는 상태 변경 애니메이션을 추가하지 않습니다. 이 제한된 화면은 네트워크, 포털, 전송, 배정, SLA, 모니터링 또는 연락처 검증을 주장하지 않습니다."
          }
        }
      }
    },
