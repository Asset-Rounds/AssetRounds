    "v30.parts-stock.state-storage-unavailable-description": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state storage unavailable description to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage is unavailable or below its preflight requirement. Existing state remains untouched; retry after storage recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El almacenamiento local no está disponible o está por debajo de su requisito de comprobación previa. El estado existente permanece intacto; vuelva a intentarlo después de recuperar el almacenamiento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本地存储不可用或低于其预检要求。现有状态保持不变；存储恢复后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本機儲存空間無法使用或低於預檢要求。現有狀態未受影響；請在儲存空間復原後重試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bộ nhớ cục bộ không khả dụng hoặc thấp hơn yêu cầu tiền kiểm. Trạng thái hiện có không bị thay đổi; hãy thử lại sau khi khôi phục bộ nhớ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로컬 저장 공간을 사용할 수 없거나 사전 점검 요건보다 부족합니다. 기존 상태는 그대로 유지됩니다. 저장 공간 복구 후 다시 시도하십시오."
          }
        }
      }
    },
