    "c12.queue.disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acknowledgement records review only. It does not resolve the source or make prior evidence new."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El reconocimiento solo registra la revisión. No resuelve el origen ni convierte la evidencia anterior en nueva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "确认仅记录审核。它不会解决来源问题，也不会使先前证据成为新证据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "確認僅記錄審核。它不會解決來源，也不會讓先前證據變成新的。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc xác nhận chỉ ghi nhận sự xem xét. Nó không giải quyết nguồn hoặc làm bằng chứng trước đó trở thành mới."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "확인은 검토만 기록합니다. 원본을 해결하거나 이전 증거를 새것으로 만들지 않습니다."
          }
        }
      }
    },
