    "v30.subscription.status.billing.retry.detail": {
      "comment": "Screen: Subscription status screen. Meaning: Uses the English default “Apple reported billing retry without signed grace. Existing data remains available.”. Role: presentation title. Arguments: none. Plural/select: none. Accessibility: Supplied to the screen’s presentation model and read when that title is rendered. Screenshot: Subscription status screen. state where this presentation title is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple reported billing retry without signed grace. Existing data remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple informó un reintento de facturación sin período de gracia firmado. Los datos existentes permanecen disponibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple 报告了无签署宽限期的计费重试。现有数据仍可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple 已回報未含簽署寬限期的重新扣款。現有資料仍可使用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple đã báo cáo thử lại thanh toán mà không có thời gian gia hạn có chữ ký. Dữ liệu hiện có vẫn khả dụng."
          }
