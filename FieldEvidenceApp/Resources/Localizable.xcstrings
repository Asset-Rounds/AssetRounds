    "v30.parts-stock.search-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the search hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches local catalog names and stock product identities. It does not change stock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Busca nombres del catálogo local e identidades de productos en existencias. No cambia las existencias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "搜索本地目录名称和库存产品标识，不更改库存。"
          }
        },
        "zh-Hant": {
