    "v30.advanced-recurrence.mutation-receipt": {
      "comment": "Screen: Advanced recurrence. Meaning: Reports mutation receipt to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Advanced recurrence operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
