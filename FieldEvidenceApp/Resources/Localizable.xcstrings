    "v30.voice-capture.draft-description": {
      "comment": "Screen: Voice capture. Meaning: Explains draft description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The complete typed path stays available. Voice proposals are review-only until an explicit per-field request crosses the existing ordinary draft authority."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vía completa de entrada escrita sigue disponible. Las propuestas de voz son solo para revisión hasta que una solicitud explícita por campo pasa por la autoridad habitual de borrador existente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完整的键入途径始终可用。在通过现有常规草稿授权逐字段明确请求之前，语音建议仅供审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完整的鍵入途徑仍可使用。在逐欄明確請求通過既有的一般草稿授權前，語音提案僅供審閱。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luồng nhập bằng bàn phím vẫn có đầy đủ chức năng. Đề xuất giọng nói chỉ để xem xét cho đến khi yêu cầu rõ ràng cho từng trường đi qua thẩm quyền bản nháp thông thường hiện có."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "직접 입력하는 전체 경로는 계속 사용할 수 있습니다. 음성 제안은 필드별 명시적 요청이 기존 일반 초안 담당 주체에 전달될 때까지 검토용으로만 유지됩니다."
          }
        }
      }
    },
