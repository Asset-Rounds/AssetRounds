    "v30.recipient-review.recovery-complete": {
      "comment": "Screen: Recipient review. Meaning: Reports recovery complete to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Recipient review operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery completed. Refresh from the canonical record before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La recuperación finalizó. Actualice desde el registro canónico antes de continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "恢复已完成。请刷新规范记录后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "復原已完成。請從標準記錄更新資料後再繼續。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã khôi phục xong. Hãy làm mới từ bản ghi chuẩn trước khi tiếp tục."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "복구가 완료되었습니다. 계속하기 전에 기준 기록에서 새로 고치세요."
          }
        }
      }
    },
    "v30.recipient-review.recovery-description": {
      "comment": "Screen: Recipient review. Meaning: Explains recovery description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry reuses the supplied mutation identity and returns its existing effect or receipt, or no effect. Reload the canonical record after interruption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El reintento reutiliza la identidad de modificación proporcionada y devuelve su efecto o comprobante existente, o ningún efecto. Vuelva a cargar el registro canónico después de una interrupción."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重试会复用提供的变更标识，并返回其现有效果或回执，或不产生效果。中断后请重新加载规范记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重試會沿用提供的變更識別碼，傳回其既有效果或回執，或不產生效果。中斷後請重新載入標準記錄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thử lại dùng cùng mã định danh thay đổi được cung cấp và trả về tác động hoặc biên nhận hiện có, hoặc không có tác động. Hãy tải lại bản ghi chuẩn sau khi bị gián đoạn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재시도는 제공된 변경 식별자를 재사용하여 기존 반영 결과나 처리 확인서를 반환하거나 아무 변경도 반영하지 않습니다. 중단 후에는 기준 기록을 다시 불러오세요."
          }
        }
      }
    },
