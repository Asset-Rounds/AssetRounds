          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu hành động công việc chuẩn được cung cấp riêng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
