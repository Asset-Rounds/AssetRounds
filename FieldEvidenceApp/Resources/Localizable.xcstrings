    "v30.backup-export.export.photo.label": {
      "comment": "Screen: Backup export. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Backup export rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup contains sign details, notes, photos, and reports. It does not contain your subscription. Store and share it securely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta copia de seguridad contiene detalles de letreros, notas, fotos e informes. No contiene su suscripción. Almacénela y compártala de forma segura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此备份包含标牌详情、备注、照片和报告，不包含您的订阅。请安全存储和共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此備份包含標牌詳情、備註、照片與報告，不包含您的訂閱。請安全儲存及分享。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản sao lưu này chứa thông tin biển hiệu, ghi chú, ảnh và báo cáo. Bản sao lưu không chứa gói đăng ký của bạn. Hãy lưu trữ và chia sẻ an toàn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 백업에는 간판 정보, 메모, 사진 및 보고서가 포함됩니다. 구독은 포함되지 않습니다. 안전하게 보관하고 공유하세요."
          }
        }
      }
    },
