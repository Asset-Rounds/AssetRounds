    "v30.rating-support.status-description": {
      "comment": "Screen: Rating and support. Meaning: Explains status description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Rating and support body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This status never confirms a prompt, star value, review text, submission, store response, reward, or effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este estado nunca confirma una solicitud, cantidad de estrellas, texto de reseña, envío, respuesta de la tienda, recompensa ni efecto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此状态绝不确认提示、星级、评价文本、提交、商店回复、奖励或效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此狀態絕不確認提示、星等、評論文字、提交、商店回應、獎勵或效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trạng thái này không bao giờ xác nhận lời nhắc, số sao, nội dung đánh giá, việc gửi, phản hồi từ cửa hàng, phần thưởng hay tác động."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 상태는 요청 화면, 별점, 리뷰 내용, 제출, 스토어 응답, 보상 또는 반영 결과를 확인하지 않습니다."
          }
        }
      }
    },
    "v30.rating-support.status-duplicate-attempt": {
      "comment": "Screen: Rating and support. Meaning: Reports status duplicate attempt to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Rating and support operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A prior local attempt is already recorded, so no additional native rating request was made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya se registró un intento local anterior, por lo que no se realizó ninguna solicitud adicional de calificación nativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先前的本地尝试已记录，因此未发出额外的原生评分请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先前的本機嘗試已記錄，因此未提出額外的原生評分請求。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lần thử cục bộ trước đã được ghi nhận, nên không gửi thêm yêu cầu đánh giá gốc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이전 로컬 시도가 이미 기록되어 있어 추가 기본 평가 요청을 하지 않았습니다."
          }
        }
      }
    },
    "v30.rating-support.status-heading": {
      "comment": "Screen: Rating and support. Meaning: Names the status heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Rating and support section heading state; no screenshot is claimed.",
