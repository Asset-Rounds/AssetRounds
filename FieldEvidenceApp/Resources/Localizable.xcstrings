    "v30.manual-work-resource.unavailable-command": {
      "comment": "Screen: Manual work resources. Meaning: Unavailable manual-resource command. Role: visible availability explanation. Arguments: title String formattedPresentation x1. Plural/select: none. Accessibility: Read beside unavailable command.. Screenshot: Manual work resources visible state.",
