    "v30.feedback.feedback.label7": {
      "comment": "Screen: Feedback. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Feedback rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Attach to include exactly this reviewed JSON, or Don't Attach to open the same editable composer without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elija Adjuntar para incluir exactamente este JSON revisado, o No adjuntar para abrir el mismo editor modificable sin él."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择“附加”以包含此完全相同的已审核 JSON，或选择“不附加”以在不含它的情况下打开相同的可编辑编辑器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇「附加」即可包含確切的已審核 JSON，或選擇「不附加」以開啟不含它的相同可編輯撰寫器。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn Đính kèm để bao gồm chính xác JSON đã xem xét này, hoặc Không đính kèm để mở cùng trình soạn thảo có thể chỉnh sửa mà không có nó."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "검토한 이 정확한 JSON을 포함하려면 첨부를 선택하고, 포함 안 함을 선택하면 동일한 편집 가능한 작성기를 엽니다."
          }
        }
      }
    },
