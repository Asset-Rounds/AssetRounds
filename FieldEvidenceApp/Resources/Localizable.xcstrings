    "v30.diagnostics.diagnostic.label2": {
      "comment": "Screen: Diagnostics export. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Diagnostics export rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These counters are best-effort lower-bound signals. They may be incomplete and are not payment, access, or cohort authority."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estos contadores son señales de límite inferior obtenidas según la disponibilidad. Pueden estar incompletos y no determinan pagos, acceso ni pertenencia a grupos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这些计数器是尽力提供的下限信号，可能不完整，不构成付款、访问或群组授权依据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這些計數器是盡力提供的下限訊號，可能不完整，並非付款、存取或群組授權依據。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các bộ đếm này là tín hiệu giới hạn dưới được thu thập trong khả năng cho phép. Chúng có thể chưa đầy đủ và không phải căn cứ có thẩm quyền về thanh toán, quyền truy cập hay nhóm người dùng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 카운터는 가능한 범위에서 수집된 하한 신호입니다. 불완전할 수 있으며 결제, 접근 권한 또는 집단 판정의 근거가 아닙니다."
          }
        }
      }
    },
    "v30.diagnostics.diagnostic.label3": {
      "comment": "Screen: Diagnostics export. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Diagnostics export rendered state; no screenshot is asserted.",
