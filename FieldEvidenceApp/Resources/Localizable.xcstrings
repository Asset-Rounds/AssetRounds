            "value": "%@ 편집"
          }
        }
      }
    },
    "v30.voice-capture.edit-field-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the edit field hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a manual value. The caller validates its type and sends it through the ordinary draft authority; typing does not write the draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingrese un valor manual. El llamador valida su tipo y lo envía mediante la autoridad ordinaria de borrador; escribir no guarda el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入手动值。调用方验证其类型并通过常规草稿权限发送；输入不会写入草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入手動值。呼叫端會驗證其類型並透過一般草稿權限傳送；輸入不會寫入草稿。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập giá trị thủ công. Bên gọi xác thực kiểu của nó và gửi qua quyền hạn bản nháp thông thường; việc nhập không ghi vào bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수동 값을 입력하세요. 호출자가 해당 유형을 검증하고 일반 초안 권한을 통해 전송하며, 입력만으로 초안이 기록되지는 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.edit-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the edit hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a full keyboard-editable value field. The caller validates the typed value before ordinary draft review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre un campo de valor editable con teclado completo. El llamador valida el valor escrito antes de la revisión ordinaria del borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开可由完整键盘编辑的值字段。调用方在常规草稿审查前验证输入值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開啟可用鍵盤完整編輯的值欄位。呼叫端會在一般草稿審查前驗證輸入的值。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở trường giá trị có thể chỉnh sửa hoàn toàn bằng bàn phím. Bên gọi xác thực giá trị đã nhập trước khi xem xét bản nháp thông thường."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "전체 키보드 편집 가능한 값 필드를 엽니다. 호출자는 일반 초안 검토 전에 입력한 값을 검증합니다."
          }
        }
      }
    },
    "v30.voice-capture.edit-requested": {
      "comment": "Screen: Voice capture. Meaning: Edit request sent for a field. Role: operation status. Arguments: label String authoredSource x1. Plural/select: none. Accessibility: Read in operation status.. Screenshot: Voice capture visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit request sent for %@. The caller must convert and validate the typed value through C56; no Saved or Complete claim is made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se envió una solicitud de edición para %@. El llamador debe convertir y validar el valor escrito mediante C56; no se declara Guardado ni Completado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已向 %@ 发送编辑请求。调用方必须通过 C56 转换并验证输入值；未作出“已保存”或“完成”声明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已傳送 %@ 的編輯請求。呼叫端必須透過 C56 轉換並驗證輸入值；不宣稱已儲存或已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã gửi yêu cầu chỉnh sửa cho %@. Bên gọi phải chuyển đổi và xác thực giá trị đã nhập qua C56; không tuyên bố Đã lưu hoặc Hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에 대한 편집 요청을 보냈습니다. 호출자는 C56을 통해 입력 값을 변환하고 검증해야 하며 저장됨 또는 완료됨을 주장하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.edit-value": {
      "comment": "Screen: Voice capture. Meaning: Field-specific edit prompt. Role: text field label. Arguments: label String authoredSource x1. Plural/select: none. Accessibility: VoiceOver prompt for manual field edit.. Screenshot: Voice capture visible state.",
