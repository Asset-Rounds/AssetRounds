    "v30.parts-stock.lookup-stale": {
      "comment": "Screen: Parts & Stock. Meaning: Reports lookup stale to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lookup became stale. Reload the local catalog before selecting an item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La búsqueda quedó desactualizada. Vuelva a cargar el catálogo local antes de seleccionar un artículo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "查找结果已过期。请选择项目前重新加载本地目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "查找結果已過期。選取項目前請重新載入本機目錄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết quả tra cứu đã lỗi thời. Hãy tải lại danh mục cục bộ trước khi chọn mục."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "조회 결과가 오래되었습니다. 항목을 선택하기 전에 로컬 카탈로그를 다시 불러오세요."
          }
        }
      }
    },
    "v30.parts-stock.low-stock-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains low stock description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferred minimum produces an in-app attention only. It is not purchase, reorder, valuation, or availability truth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El mínimo preferido solo genera una atención dentro de la app. No es verdad de compra, reordenación, valoración ni disponibilidad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "首选最小值只会产生应用内提示。它不是采购、补货、估值或可用性事实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "偏好最低值只會在 App 內產生注意提示。它不是採購、重新訂購、估值或可用性的事實。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mức tối thiểu ưu tiên chỉ tạo thông báo cần chú ý trong ứng dụng. Đây không phải là thông tin xác thực về mua hàng, đặt hàng lại, định giá hay tình trạng sẵn có."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선호 최소값은 앱 내 주의만 생성합니다. 구매, 재주문, 평가 또는 가용성 사실이 아닙니다."
          }
        }
      }
    },
