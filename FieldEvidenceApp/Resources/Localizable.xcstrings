    "v30.installation.workflow.as.built.notice": {
      "comment": "Screen: Installation workflow screen. Meaning: Uses the English default “Capture as-built facts and a recorded variation only through supplied canonical commands. This screen does not invent placement, measurement, evidence, or variation facts.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Installation workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture as-built facts and a recorded variation only through supplied canonical commands. This screen does not invent placement, measurement, evidence, or variation facts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Capture hechos conforme a lo construido y una variación registrada solo mediante comandos canónicos proporcionados. Esta pantalla no inventa hechos de ubicación, medición, evidencia ni variación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅通过提供的规范命令采集竣工事实和已记录变更。此屏幕不会编造放置、测量、证据或变更事实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅透過提供的標準命令擷取竣工事實與已記錄的變更。此畫面不會捏造位置、測量、證據或變更事實。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ thu thập thông tin hoàn công và một biến thể đã ghi nhận thông qua các lệnh chuẩn được cung cấp. Màn hình này không tạo ra thông tin về vị trí, phép đo, bằng chứng hoặc biến thể."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 기준 명령을 통해서만 완료 도면 사실과 기록된 변경 사항을 캡처합니다. 이 화면은 배치, 측정, 증거 또는 변경 사실을 만들어 내지 않습니다."
          }
        }
      }
    },
