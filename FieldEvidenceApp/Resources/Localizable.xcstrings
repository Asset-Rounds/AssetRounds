    "v30.parts-stock.adjust-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the adjust action. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests a reasoned adjustment only when the supplied source balance is known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicita un ajuste fundamentado solo cuando se conoce el saldo de origen proporcionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在所提供的来源余额已知时请求有理由的调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅在提供的來源餘額已知時，要求有理由的調整。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ yêu cầu điều chỉnh có lý do khi số dư nguồn được cung cấp đã biết."
          }
        },
        "ko": {
