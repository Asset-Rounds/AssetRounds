    "v30.my-day.save-preview-available": {
      "comment": "Screen: My Day. Meaning: Explains save preview available in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
