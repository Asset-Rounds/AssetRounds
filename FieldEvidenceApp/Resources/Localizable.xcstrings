    "illuminated.playbook.disclaimer": {
      "comment": "C03 exact visible-condition, non-certification disclaimer.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report records visible conditions from the listed photos and time. It is not an electrical, code, safety, or professional certification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este informe registra las condiciones visibles de las fotos y la hora indicadas. No es una certificación eléctrica, normativa, de seguridad ni profesional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此报告记录所列照片和时间对应的可见状况，不构成电气、法规、安全或专业认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此報告記錄所列照片與時間的可見狀況，不是電氣、法規、安全或專業認證。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Báo cáo này ghi nhận tình trạng nhìn thấy được từ các ảnh và thời điểm được liệt kê. Đây không phải là chứng nhận về điện, quy chuẩn, an toàn hay chuyên môn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 보고서는 나열된 사진과 시각에서 눈으로 확인되는 상태를 기록합니다. 전기, 법규, 안전 또는 전문 인증이 아닙니다."
          }
        }
      }
    },
