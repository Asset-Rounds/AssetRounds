    "v30.signoff.enrollment.accessibility.notice": {
      "comment": "Screen: Signoff response enrollment screen. Meaning: Uses the English default “Typed entry is complete for VoiceOver, Voice Control, Switch Control, keyboard, and motor access. The drawn mark is optional and has accessible Clear and Skip controls.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Signoff response enrollment screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed entry is complete for VoiceOver, Voice Control, Switch Control, keyboard, and motor access. The drawn mark is optional and has accessible Clear and Skip controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La entrada escrita está completa para VoiceOver, Control por voz, Control por botón, teclado y acceso motor. La marca dibujada es opcional y tiene controles accesibles para Borrar y Omitir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "键入方式完整支持旁白、语音控制、切换控制、键盘及肢体操作辅助。手绘标记为可选项，并提供无障碍的“清除”和“跳过”控件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "鍵入方式完整支援 VoiceOver、語音控制、切換控制、鍵盤及肢體操作輔助。手繪記號為選用項目，並提供無障礙的「清除」與「略過」控制項。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập bằng bàn phím hỗ trợ đầy đủ VoiceOver, Điều khiển bằng giọng nói, Điều khiển công tắc, bàn phím và hỗ trợ vận động. Dấu vẽ là tùy chọn và có nút Xóa và Bỏ qua hỗ trợ trợ năng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "직접 입력은 VoiceOver, 음성 명령, 스위치 제어, 키보드 및 운동 기능 접근에서 모든 입력 기능을 제공합니다. 직접 그리는 표시는 선택 사항이며 접근 가능한 지우기 및 건너뛰기 컨트롤이 있습니다."
          }
        }
      }
    },
    "v30.signoff.enrollment.boundaries.notice": {
      "comment": "Screen: Signoff response enrollment screen. Meaning: Uses the English default “This local response does not claim verified identity or authority, final approval, acceptance for another person, a workflow transition, a legal signature or effect, or nonrepudiation.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Signoff response enrollment screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local response does not claim verified identity or authority, final approval, acceptance for another person, a workflow transition, a legal signature or effect, or nonrepudiation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta respuesta local no confirma identidad o autoridad verificadas, aprobación final, aceptación por otra persona, una transición del flujo de trabajo, una firma o efecto legal ni no repudio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此本地回复不声称身份或权限已验证、最终批准、代他人接受、工作流转换、法律签名或效力，亦不构成不可否认性证明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此本機回覆不聲稱身分或授權已驗證、最終核准、代他人接受、工作流程轉換、法律簽章或效力，也不具不可否認性的聲明。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phản hồi cục bộ này không khẳng định danh tính hay thẩm quyền đã được xác minh, phê duyệt cuối cùng, chấp nhận thay người khác, chuyển trạng thái quy trình, chữ ký hay hiệu lực pháp lý, hoặc khả năng chống chối bỏ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 로컬 응답은 검증된 신원 또는 권한, 최종 승인, 타인을 대신한 수락, 워크플로 전환, 법적 서명이나 효력 또는 부인 방지를 의미하지 않습니다."
          }
        }
      }
    },
