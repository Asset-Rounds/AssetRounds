    "v30.recipient-review.unavailable-command": {
      "comment": "Screen: Recipient review. Meaning: The unavailable recipient-review command. Role: visible availability explanation. Arguments: title String formattedPresentation x1. Plural/select: none. Accessibility: Read beside unavailable command. Screenshot: Recipient review visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unavailable until its canonical command is supplied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no está disponible hasta que se proporcione su comando canónico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在提供其规范命令前，%@不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "必須提供 %@ 的標準命令後才能使用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ không khả dụng cho đến khi lệnh chuẩn của nó được cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) 기준 명령이 제공될 때까지 사용할 수 없습니다."
          }
        }
      }
    },
