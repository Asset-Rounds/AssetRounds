    "v30.party.contact.workflow.introduction": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Uses the English default “Review supplied, zero-write changes before any separate canonical action. Equal names, phone numbers, and email addresses remain distinct assertions, not identity proof.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Party/contact/Site-role workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review supplied, zero-write changes before any separate canonical action. Equal names, phone numbers, and email addresses remain distinct assertions, not identity proof."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revise los cambios proporcionados sin escrituras antes de cualquier acción canónica independiente. Los nombres, números de teléfono y direcciones de correo iguales siguen siendo declaraciones distintas, no pruebas de identidad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先审核提供的零写入变更，再执行任何单独的规范数据操作。相同姓名、电话号码和电子邮件地址仍为独立声明，不构成身份证明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "執行任何獨立的標準資料動作前，請先審閱提供的零寫入變更。相同姓名、電話號碼與電子郵件地址仍是不同聲明，不構成身分證明。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xem xét các thay đổi không ghi dữ liệu được cung cấp trước bất kỳ hành động riêng nào với dữ liệu chuẩn. Tên, số điện thoại và địa chỉ email giống nhau vẫn là các lời khai riêng biệt, không phải bằng chứng danh tính."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "별도의 기준 데이터 작업 전에 제공된 변경 사항을 기록 없이 검토합니다. 이름, 전화번호, 이메일 주소가 같더라도 별개의 주장으로 유지되며 신원 증거가 되지 않습니다."
          }
        }
      }
    },
