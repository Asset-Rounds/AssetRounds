    "evidence.curation.item.remove_history_disclosure": {
      "comment": "C02 truthful disclosure for removal from current work/report use.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Immutable evidence history remains. If this evidence is required, completion returns to incomplete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El historial de evidencia inmutable permanece. Si esta evidencia es obligatoria, la finalización vuelve a incompleta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不可变的证据历史记录仍然存在。如果需要此证据，完成状态将恢复为未完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不可變證據歷程會保留。如果需要此證據，完成會回到未完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lịch sử bằng chứng bất biến vẫn còn. Nếu bằng chứng này là bắt buộc, việc hoàn tất trở lại chưa hoàn chỉnh."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "변경 불가 증거 이력은 유지됩니다. 이 증거가 필요하면 완료 상태는 미완료로 돌아갑니다."
          }
        }
      }
    },
