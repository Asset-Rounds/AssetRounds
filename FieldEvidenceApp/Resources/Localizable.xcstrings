            "value": "A customer-safe PDF handoff is not supplied. This view cannot create, render, send, deliver, or confirm a PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporcionó un PDF apto para compartir con el cliente. Esta vista no puede crear, generar, enviar, entregar ni confirmar un PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
