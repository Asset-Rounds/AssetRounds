    "v30.asset.import.diagnostics.boundary": {
      "comment": "Screen: Party/contact/Site-role import screen. Meaning: Uses the English default “Contact-safe diagnostics show source metadata, row numbers, dispositions, and reason codes. Contact values are never rendered here.”. Role: visible explanatory Text. Arguments: none. Plural/select: none. Accessibility: This visible explanatory Text is available in normal VoiceOver traversal. Screenshot: Party/contact/Site-role import screen. state where this visible explanatory Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact-safe diagnostics show source metadata, row numbers, dispositions, and reason codes. Contact values are never rendered here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los diagnósticos seguros para contactos muestran metadatos de origen, números de fila, disposiciones y códigos de motivo. Los valores de contacto nunca se muestran aquí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "安全联系人诊断显示源元数据、行号、处置和原因代码。此处绝不呈现联系值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "聯絡人安全診斷會顯示來源中繼資料、列號、處置和原因代碼。此處絕不顯示聯絡人值。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chẩn đoán an toàn cho liên hệ hiển thị siêu dữ liệu nguồn, số hàng, cách xử lý và mã lý do. Giá trị liên hệ không bao giờ được hiển thị ở đây."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연락처 안전 진단에는 소스 메타데이터, 행 번호, 처리 상태 및 사유 코드가 표시됩니다. 연락처 값은 여기에서 절대 렌더링되지 않습니다."
          }
        }
      }
    },
