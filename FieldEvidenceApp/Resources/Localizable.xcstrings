    "v30.voice-capture.continue-manual-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the continue manual hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the current typed text to the existing ordinary draft authority. It does not claim Saved or Complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envía el texto escrito actual a la autoridad habitual de borrador existente. No confirma Guardado ni Completo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将当前键入文本发送到现有常规草稿授权方，不声称已保存或已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將目前鍵入的文字傳送至既有的一般草稿授權方，不聲稱已儲存或已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gửi văn bản đang nhập đến thẩm quyền bản nháp thông thường hiện có. Không khẳng định Đã lưu hoặc Hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "현재 입력한 텍스트를 기존 일반 초안 담당 주체에 보냅니다. 저장됨 또는 완료됨을 의미하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.decimal-value": {
      "comment": "Screen: Voice capture. Meaning: Decimal quantity and canonical unit. Role: visible proposed value. Arguments: value String formattedPresentation x1; unit String formattedPresentation x1. Plural/select: none. Accessibility: Read in Review each field.. Screenshot: Voice capture visible state.",
