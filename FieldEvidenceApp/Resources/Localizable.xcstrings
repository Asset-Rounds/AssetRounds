    "v30.incumbent-file-adapter.heading-description": {
      "comment": "Screen: Data & Portability. Meaning: Explains heading description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Data & Portability body copy state; no screenshot is claimed.",
