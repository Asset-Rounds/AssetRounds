    "v30.service-request.no-pdf-handoff": {
      "comment": "Screen: Service request. Meaning: Explains no pdf handoff in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
