          }
        }
      }
    },
    "v30.installation.workflow.report.ready": {
      "comment": "Screen: Installation workflow screen. Meaning: Uses the English default “The accepted recorded closeout is report-ready for the existing renderer.”. Role: visible Label title. Arguments: none. Plural/select: none. Accessibility: SwiftUI combines the Label title with its symbol for accessibility. Screenshot: Installation workflow screen. state where this visible Label title is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accepted recorded closeout is report-ready for the existing renderer."
          }
        },
        "es": {
          "stringUnit": {
