    "v30.incumbent-file-adapter.mapping-description": {
      "comment": "Screen: Data & Portability. Meaning: Explains mapping description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Data & Portability body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection, parsing, and mapping are deterministic preview work. Preview makes zero canonical writes and does not mean imported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La detección, el análisis y la asignación son trabajo determinista de vista previa. La vista previa no realiza escrituras canónicas y no significa que se haya importado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "检测、解析和映射都是确定性预览工作。预览不进行规范写入，也不表示已导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "偵測、剖析與對映是確定性的預覽工作。預覽不進行任何標準寫入，也不表示已匯入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phát hiện, phân tích cú pháp và ánh xạ là công việc xem trước có tính xác định. Xem trước không ghi bất kỳ dữ liệu bản ghi chuẩn nào và không có nghĩa là đã nhập."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "감지, 구문 분석 및 매핑은 결정론적 미리보기 작업입니다. 미리보기는 기준 기록을 전혀 쓰지 않으며 가져오기를 의미하지 않습니다."
          }
        }
      }
