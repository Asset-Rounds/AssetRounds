    "v30.parts-stock.checkpoint-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the checkpoint hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests the existing draft authority to checkpoint this text. The view does not claim Saved until the caller supplies a confirmed state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicita a la autoridad de borrador existente que establezca un punto de control para este texto. La vista no afirma Guardado hasta que quien llama proporcione un estado confirmado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求现有草稿权限为此文本创建检查点。直到调用方提供确认状态前，此视图不声称已保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要求既有草稿授權方為此文字建立檢查點。在呼叫端提供確認狀態前，此畫面不聲稱已儲存。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu bên quản lý bản nháp hiện có lưu mốc văn bản này. Màn hình không khẳng định Đã lưu cho đến khi bên gọi cung cấp trạng thái đã xác nhận."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기존 초안 담당 주체에 이 텍스트의 저장 지점 생성을 요청합니다. 호출 측이 확인된 상태를 제공할 때까지 이 화면은 저장됨으로 표시하지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.checkpoint-requested": {
      "comment": "Screen: Parts & Stock. Meaning: Explains checkpoint requested in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
