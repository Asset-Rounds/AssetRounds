            "value": "Đủ điều kiện tại một điểm dừng tự nhiên yên tĩnh"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "조용한 자연스러운 중단 지점에서 적격"
          }
        }
      }
    },
    "v30.rating-support.eligible-description": {
      "comment": "Screen: Rating and support. Meaning: Explains eligible description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Rating and support body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the natural-stop integration may ask the system to consider a rating request. This Settings screen does not make that request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo la integración de detención natural puede pedir al sistema que considere una solicitud de calificación. Esta pantalla de Configuración no realiza esa solicitud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有自然停顿点集成可请求系统考虑评分请求。此“设置”屏幕不会提出该请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有自然停止整合可要求系統考慮評分請求。此「設定」畫面不會提出該請求。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ tích hợp dừng tự nhiên mới có thể yêu cầu hệ thống xem xét yêu cầu đánh giá. Màn hình Cài đặt này không thực hiện yêu cầu đó."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자연스러운 중단 통합만 시스템에 평점 요청을 고려하도록 요청할 수 있습니다. 이 설정 화면에서는 해당 요청을 하지 않습니다."
          }
        }
      }
    },
    "v30.rating-support.heading": {
