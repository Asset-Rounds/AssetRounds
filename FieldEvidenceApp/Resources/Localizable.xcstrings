    "v30.recipient-review.response-available": {
      "comment": "Screen: Recipient review. Meaning: Explains response available in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A canonical response can be created from the supplied request manifest and capability."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se puede crear una respuesta canónica a partir del manifiesto de solicitud y la capacidad proporcionados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可根据提供的请求清单和能力创建规范响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可根據提供的請求資訊清單與能力建立標準回應。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Có thể tạo phản hồi chuẩn từ tệp kê khai yêu cầu và khả năng đã cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 요청 매니페스트와 기능으로 기준 응답을 만들 수 있습니다."
          }
        }
      }
    },
    "v30.recipient-review.response-boundary": {
      "comment": "Screen: Recipient review. Meaning: Explains response boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No response is rendered as secure, verified, approved, accepted, signed, or legally effective by this surface."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta superficie no muestra ninguna respuesta como segura, verificada, aprobada, aceptada, firmada ni legalmente efectiva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此界面不会将任何响应呈现为安全、已验证、已批准、已接受、已签名或具有法律效力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此介面不會將任何回應呈現為安全、已驗證、已核准、已接受、已簽署或具有法律效力。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bề mặt này không hiển thị phản hồi là an toàn, đã xác minh, được phê duyệt, được chấp nhận, đã ký hoặc có hiệu lực pháp lý."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 화면은 응답을 보안됨, 확인됨, 승인됨, 수락됨, 서명됨 또는 법적 효력이 있는 것으로 표시하지 않습니다."
          }
        }
      }
    },
    "v30.recipient-review.response-created": {
      "comment": "Screen: Recipient review. Meaning: Reports response created to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Recipient review operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The supplied recipient response was created from the canonical request inputs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La respuesta del destinatario proporcionada se creó a partir de los datos canónicos de la solicitud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的接收方回复根据规范请求输入创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的接收者回覆是由標準請求輸入建立。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phản hồi của người nhận được cung cấp đã được tạo từ dữ liệu đầu vào chuẩn của yêu cầu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 수신자 응답은 기준 요청 입력으로부터 생성되었습니다."
          }
        }
      }
    },
    "v30.recipient-review.response-description": {
      "comment": "Screen: Recipient review. Meaning: Explains response description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response author text is self-entered assertion, not verified identity. Review disposition remains a recorded response, not an approval claim by this screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El texto del autor de la respuesta es una declaración ingresada por la propia persona, no una identidad verificada. La disposición de revisión sigue siendo una respuesta registrada, no una afirmación de aprobación por esta pantalla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回复作者文本为自行输入的声明，并非已验证的身份。审核处置仍属于已记录的回复，不代表本屏幕声明已批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回覆作者文字屬自行輸入的聲明，不是已驗證的身分。審閱處置仍是已記錄的回覆，不代表此畫面聲稱已核准。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Văn bản tác giả phản hồi là lời tự khai, không phải danh tính đã xác minh. Cách xử lý khi xem xét vẫn là phản hồi đã ghi nhận, không phải tuyên bố phê duyệt từ màn hình này."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "응답 작성자 텍스트는 직접 입력한 주장이며 검증된 신원이 아닙니다. 검토 처리 결과는 기록된 응답일 뿐 이 화면에서 승인되었음을 의미하지 않습니다."
          }
        }
      }
    },
    "v30.recipient-review.response-elsewhere-description": {
      "comment": "Screen: Recipient review. Meaning: Explains response elsewhere description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a response received elsewhere only through the supplied canonical command. It remains unverified by AssetRounds and is not applied to the canonical workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registre una respuesta recibida en otro lugar solo mediante el comando canónico proporcionado. Permanece sin verificar por AssetRounds y no se aplica al espacio de trabajo canónico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅通过所提供的规范命令记录在其他地方收到的响应。该响应未经 AssetRounds 验证，且不会应用于规范工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只能透過提供的標準命令記錄其他途徑收到的回覆。AssetRounds 並未驗證該回覆，也不會將其套用至標準工作區。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ ghi phản hồi nhận được ở nơi khác thông qua lệnh chuẩn được cung cấp. Phản hồi vẫn chưa được AssetRounds xác minh và không được áp dụng cho không gian làm việc chuẩn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "외부에서 받은 응답은 제공된 기준 명령을 통해서만 기록하세요. AssetRounds에서 검증되지 않으며 기준 작업 공간에 적용되지 않습니다."
          }
        }
      }
    },
    "v30.recipient-review.response-elsewhere-heading": {
      "comment": "Screen: Recipient review. Meaning: Names the response elsewhere heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Recipient review section heading state; no screenshot is claimed.",
