    "temporal_evidence.permission.camera.purpose": {
      "comment": "C25 purpose copy for the independent video permission matrix.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera and microphone access record the video you choose for this evidence. Manual evidence remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El acceso a la cámara y al micrófono permite grabar el video que elija para esta evidencia. La evidencia manual sigue disponible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相机和麦克风权限用于录制您为此证据选择的视频。仍可手动提供证据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相機與麥克風權限用於錄製您為此證據選擇的影片。仍可手動提供證據。"
          }
