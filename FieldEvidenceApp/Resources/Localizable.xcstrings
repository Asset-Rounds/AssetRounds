    "v30.feedback.photo.label": {
      "comment": "Screen: Feedback. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Feedback rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reviewed JSON never includes customer or sign details, addresses, notes, photos, reports, backups, paths, hashes, StoreKit details, credentials, or logs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este JSON revisado nunca incluye datos de clientes o letreros, direcciones, notas, fotos, informes, copias de seguridad, rutas, hashes, detalles de StoreKit, credenciales ni registros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此已审核的 JSON 绝不包含客户或标牌详情、地址、备注、照片、报告、备份、路径、哈希、StoreKit 详情、凭据或日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此經審閱的 JSON 絕不包含客戶或標牌詳情、地址、備註、照片、報告、備份、路徑、雜湊、StoreKit 詳情、憑證或記錄檔。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "JSON đã xem xét này không bao giờ chứa thông tin khách hàng hay biển hiệu, địa chỉ, ghi chú, ảnh, báo cáo, bản sao lưu, đường dẫn, giá trị băm, thông tin StoreKit, thông tin xác thực hay nhật ký."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "검토된 이 JSON에는 고객 또는 간판 정보, 주소, 메모, 사진, 보고서, 백업, 경로, 해시, StoreKit 정보, 자격 증명 또는 로그가 포함되지 않습니다."
          }
        }
      }
    },
    "v30.form-semantics.invalid-condition": {
      "comment": "App-owned source default; preserve the existing meaning and typed arguments.",
      "localizations": {
