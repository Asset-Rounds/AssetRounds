        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El componente solicitante proporcionó un resultado de operación. Esta vista no infiere Guardado, Completo ni ningún efecto canónico adicional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "调用方提供了操作结果。此视图不推断已保存、已完成或任何额外规范数据效果。"
