    "v30.service-request.create-work": {
      "comment": "Screen: Service request. Meaning: Names the create work action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Service request button title state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create work from supplied request"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crear trabajo a partir de la solicitud proporcionada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "根据提供的请求创建工作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從提供的請求建立工作"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tạo công việc từ yêu cầu được cung cấp"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 요청에서 작업 생성"
          }
        }
      }
    },
    "v30.service-request.create-work-description": {
      "comment": "Screen: Service request. Meaning: Explains create work description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create work is separate from request intake and disposition. It requires a supplied canonical work action; this button does not claim assignment, dispatch, scheduling, monitoring, an SLA, or completion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crear trabajo es independiente de la recepción y disposición de solicitudes. Requiere una acción de trabajo canónica proporcionada; este botón no declara asignación, envío, programación, supervisión, un SLA ni finalización."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "创建工作与请求接收和处置分开。它需要提供的规范工作操作；此按钮不声称分配、派发、计划、监控、SLA 或完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "建立工作與請求受理及處置分開。它需要提供的標準工作操作；此按鈕不宣稱指派、派送、排程、監控、SLA 或完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tạo công việc tách biệt với tiếp nhận và xử lý yêu cầu. Việc này cần một hành động công việc bản ghi chuẩn được cung cấp; nút này không tuyên bố phân công, điều phối, lập lịch, theo dõi, SLA hoặc hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 생성은 요청 접수 및 처리와 별개입니다. 제공된 기준 작업이 필요하며 이 버튼은 할당, 배정, 일정, 모니터링, SLA 또는 완료를 주장하지 않습니다."
          }
        }
      }
    },
