    "v30.advanced-recurrence.projected-run-description": {
      "comment": "Screen: Advanced recurrence. Meaning: Explains projected run description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Advanced recurrence body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A projected run is not a scheduled task, completion, reminder set, or owner receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una ejecución proyectada no es una tarea programada, una finalización, un recordatorio establecido ni un recibo del propietario."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "推算运行不是已计划任务、完成、已设置的提醒或所有者回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "投影執行不是已排程工作、完成、已設定提醒或擁有者回執。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lần chạy bản chiếu không phải tác vụ đã lên lịch, hoàn thành, lời nhắc đã đặt hoặc biên nhận của chủ sở hữu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "조회된 실행은 예약된 작업, 완료, 설정된 알림 또는 소유자 처리 확인서가 아닙니다."
          }
        }
      }
    },
    "v30.advanced-recurrence.receipt-description": {
      "comment": "Screen: Advanced recurrence. Meaning: Explains receipt description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Advanced recurrence body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a supplied canonical command for any record or generation attempt. Read its owner receipt before treating a completion, schedule, or reminder as recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use un comando canónico proporcionado para cualquier intento de registro o generación. Lea el comprobante del componente responsable antes de considerar registrada una finalización, programación o recordatorio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何记录或生成尝试均须使用提供的规范命令。请读取其负责方回执后，再将完成、计划或提醒视为已记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何記錄或產生嘗試都應使用提供的標準命令。請先讀取負責方回執，才將完成、排程或提醒視為已記錄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sử dụng một lệnh chuẩn được cung cấp cho mọi lần thử ghi nhận hoặc tạo dữ liệu. Đọc biên nhận từ bên quản lý lệnh trước khi coi việc hoàn thành, lịch hay lời nhắc là đã được ghi nhận."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기록 또는 생성을 시도할 때는 제공된 기준 명령을 사용하세요. 완료, 일정 또는 알림이 기록되었다고 보기 전에 담당 주체의 처리 확인서를 읽으세요."
          }
        }
      }
    },
