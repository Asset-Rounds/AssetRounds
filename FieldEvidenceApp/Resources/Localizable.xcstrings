    "v30.parts-stock.draft-preservation-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains draft preservation description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If protected data, storage, cancellation, interruption, or relaunch occurs, the caller-supplied draft remains the source of truth. Uncheckpointed text is not presented as saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si se producen datos protegidos, almacenamiento, cancelación, interrupción o relanzamiento, el borrador proporcionado por el llamador permanece como fuente de verdad. El texto sin punto de control no se presenta como guardado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果发生受保护数据、存储、取消、中断或重新启动，调用方提供的草稿仍是事实来源。未建立检查点的文本不会显示为已保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果發生受保護資料、儲存空間、取消、中斷或重新啟動，呼叫端提供的草稿仍是事實來源。未檢查點文字不會呈現為已儲存。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi gặp tình huống liên quan đến dữ liệu được bảo vệ, lưu trữ, hủy, gián đoạn hoặc khởi chạy lại, bản nháp do bên gọi cung cấp vẫn là nguồn thông tin chuẩn. Văn bản chưa được lưu mốc không được hiển thị là đã lưu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보호된 데이터, 저장 공간, 취소, 중단 또는 재실행이 발생하면 호출자가 제공한 초안이 기준이 됩니다. 저장 지점에 저장되지 않은 텍스트는 저장된 것으로 표시되지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.draft-protected-data": {
      "comment": "Screen: Parts & Stock. Meaning: Reports draft protected data to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
