        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "采集"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "擷取"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thu thập"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "캡처"
          }
        }
      }
    },
    "v30.voice-capture.confidence": {
      "comment": "Screen: Voice capture. Meaning: Informational recognition confidence percentage. Role: visible field detail. Arguments: percent Int formattedPresentation x1. Plural/select: none. Accessibility: Read in Review each field.. Screenshot: Voice capture visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidence: %lld%% (informational only; not a correctness, verification, or approval decision)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confianza: %lld%% (solo informativa; no es una decisión de corrección, verificación ni aprobación)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "置信度：%lld%%（仅供参考；不是正确性、验证或批准决定）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "信心：%lld%%（僅供參考；不是正確性、驗證或核准決定）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Độ tin cậy: %lld%% (chỉ để thông tin; không phải quyết định về tính đúng đắn, xác minh hoặc phê duyệt)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "신뢰도: %lld%%(정보 제공용이며 정확성, 검증 또는 승인 결정이 아닙니다)."
          }
        }
      }
    },
    "v30.voice-capture.confidence-unavailable": {
      "comment": "Screen: Voice capture. Meaning: Reports confidence unavailable to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidence: not supplied; informational only, not a correctness decision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confianza: no proporcionada; solo informativa, no es una decisión de corrección."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "置信度：未提供；仅供参考，不是正确性决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供信心；僅供參考，非正確性決定。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Độ tin cậy: chưa được cung cấp; chỉ để thông tin, không phải quyết định về tính đúng đắn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "신뢰도: 제공되지 않음; 정보 제공용이며 정확성 결정이 아닙니다."
          }
        }
      }
    },
    "v30.voice-capture.containment-boundary": {
      "comment": "Screen: Voice capture. Meaning: Explains containment boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an iPhone contained surface only. Native/root/hosted/physical acceptance and release adoption remain false pending S10.6 reconciliation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta es solo una interfaz aislada para iPhone. La aceptación nativa, de la raíz, alojada y física, así como la incorporación a una versión publicada, siguen siendo falsas hasta la conciliación de S10.6."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这仅为 iPhone 独立界面。在 S10.6 协调完成前，原生、根界面、托管、实机验收及发布接入状态均为未通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這僅為 iPhone 獨立介面。在 S10.6 協調前，原生／根畫面／託管／實機驗收與發行接入皆未通過。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây chỉ là giao diện biệt lập trên iPhone. Việc nghiệm thu trên thiết bị/gốc/được lưu trữ/thực tế và tích hợp vào bản phát hành vẫn chưa được xác nhận, đang chờ đối soát S10.6."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이것은 iPhone의 격리된 화면일 뿐입니다. S10.6 조정 전까지 네이티브, 루트, 호스팅, 실제 환경의 검수와 출시 채택은 승인되지 않은 상태로 유지됩니다."
          }
        }
      }
    },
    "v30.voice-capture.context-unavailable": {
      "comment": "Screen: Voice capture. Meaning: Explains context unavailable in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak details is unavailable until the caller supplies a current StructuredVoiceCaptureContextV1. Manual entry remains complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dictar detalles no está disponible hasta que el componente solicitante proporcione un StructuredVoiceCaptureContextV1 actual. La entrada manual sigue completa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "调用方提供当前 StructuredVoiceCaptureContextV1 后才能使用“说出详情”。手动输入功能仍完整可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "呼叫端提供目前的 StructuredVoiceCaptureContextV1 後，才能使用口述詳情。手動輸入仍完整可用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nói chi tiết chưa khả dụng cho đến khi bên gọi cung cấp StructuredVoiceCaptureContextV1 hiện tại. Nhập thủ công vẫn có đầy đủ chức năng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호출 측이 현재 StructuredVoiceCaptureContextV1을 제공할 때까지 세부 내용 말하기를 사용할 수 없습니다. 수동 입력은 모든 입력 기능을 계속 제공합니다."
          }
        }
      }
    },
    "v30.voice-capture.continue-manual": {
      "comment": "Screen: Voice capture. Meaning: Names the continue manual action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Voice capture button title state; no screenshot is claimed.",
      "localizations": {
