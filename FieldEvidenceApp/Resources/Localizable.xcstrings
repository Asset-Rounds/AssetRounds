    "v30.report-failure.failure.check.retry": {
      "comment": "Screen: Report PDF retry. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Report PDF retry rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your completed check and saved report remain on this device. Retry report makes one new PDF attempt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su verificación completada y el informe guardado permanecen en este dispositivo. Reintentar informe hace un nuevo intento de generar el PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已完成的检查和已保存的报告仍保留在此设备上。“重试报告”会重新尝试生成一次 PDF。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已完成的檢查與已儲存的報告會保留在此裝置上。「重試報告」會重新嘗試產生一次 PDF。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lần kiểm tra đã hoàn tất và báo cáo đã lưu vẫn ở trên thiết bị này. Thử lại báo cáo sẽ thực hiện một lần tạo PDF mới."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "완료된 점검과 저장된 보고서는 이 기기에 유지됩니다. 보고서 다시 시도는 PDF 생성을 한 번 새로 시도합니다."
          }
        }
      }
    },
