      "comment": "Screen: Voice capture. Meaning: Reports state unsupported to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device speech unsupported"
          }
        }
      }
    },
    "v30.voice-capture.stop-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the stop hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops this explicit push-to-talk capture. It does not accept a transcript or write the draft."
          }
        }
      }
    },
    "v30.voice-capture.stop-requested": {
      "comment": "Screen: Voice capture. Meaning: Reports stop requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop requested. Waiting for the caller's final on-device transcript; no proposal or draft effect is claimed."
          }
        }
      }
    },
    "v30.voice-capture.stop-speaking": {
      "comment": "Screen: Voice capture. Meaning: Names the stop speaking action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Voice capture button title state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop speaking"
          }
        }
      }
    },
    "v30.voice-capture.target-description": {
      "comment": "Screen: Voice capture. Meaning: Explains target description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture target is fixed by the supplied context. If that revision changes, the caller must mark this session stale and return to manual entry."
          }
        }
      }
    },
    "v30.voice-capture.target-revision": {
      "comment": "Screen: Voice capture. Meaning: Names the target revision value. Role: value-row label. Arguments: none. Plural/select: none. Accessibility: The combined row exposes this label with its value to VoiceOver. Screenshot: Voice capture value-row label state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice target revision"
          }
        }
      }
    },
    "v30.voice-capture.time": {
      "comment": "Screen: Voice capture. Meaning: Elapsed, maximum, and remaining capture time. Role: visible countdown. Arguments: elapsed Int aggregateCount x1; maximum Int aggregateCount x1; remaining Int aggregateCount x1. Plural/select: independent English one/other catalog substitutions for maximum, remaining; other arguments are not plural selectors. Accessibility: Read by the active-capture countdown.. Screenshot: Voice capture visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture time: %1$lld of %#@maximum@; %#@remaining@"
          },
          "substitutions": {
            "maximum": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg second"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg seconds"
                    }
                  }
                }
              }
            },
            "remaining": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg second remaining"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg seconds remaining"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "v30.voice-capture.time-limit": {
      "comment": "Screen: Voice capture. Meaning: Names the time limit control. Role: accessibility label. Arguments: none. Plural/select: none. Accessibility: VoiceOver uses this exact text as the control label. Screenshot: Voice capture accessibility label state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture time limit"
