            "value": "이 필드는 정확한 제안이 아닙니다. 직접 편집하거나 거부하세요. 전송된 값은 없습니다."
          }
        }
      }
    },
    "v30.voice-capture.operation-cancelled": {
      "comment": "Screen: Voice capture. Meaning: Reports operation cancelled to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation makes no completion, transcript, proposal, or draft-effect claim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cancelación no declara finalización, transcripción, propuesta ni efecto en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "取消不声称完成、转录、提案或草稿效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "取消不宣稱完成、逐字稿、提案或草稿效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc hủy không tuyên bố hoàn tất, bản chép lời, đề xuất hoặc ảnh hưởng đến bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "취소는 완료, 대화록, 제안 또는 초안 효과를 주장하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.operation-failure": {
      "comment": "Screen: Voice capture. Meaning: Reports operation failure to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation did not produce a confirmed canonical result. Review the supplied error and reload before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La operación no produjo un resultado canónico confirmado. Revise el error proporcionado y vuelva a cargar antes de reintentar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "操作未产生已确认的规范结果。请检查提供的错误并重新加载后再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "操作未產生已確認的標準結果。請查看提供的錯誤並重新載入後再重試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thao tác không tạo ra kết quả chuẩn đã xác nhận. Hãy xem lỗi được cung cấp và tải lại trước khi thử lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업에서 확인된 기준 결과가 생성되지 않았습니다. 다시 시도하기 전에 제공된 오류를 검토하고 다시 불러오세요."
          }
        }
      }
    },
    "v30.voice-capture.operation-no-result": {
      "comment": "Screen: Voice capture. Meaning: Reports operation no result to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
