    "v30.parts-stock.archived-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains archived description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
