    "v30.parts-stock.csv-schema": {
      "comment": "Screen: Parts & Stock. Meaning: The exact CSV schema ID and exchange boundary. Role: visible CSV instruction. Arguments: schema String opaqueIdentifier x1. Plural/select: none. Accessibility: Read in Catalog CSV section.. Screenshot: Parts & Stock visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact schema: %@. Import is preview-first and validates the complete source before any canonical command. Export is deterministic catalog data only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esquema exacto: %@. La importación comienza con una vista previa y valida el origen completo antes de cualquier comando canónico. La exportación solo contiene datos deterministas de catálogo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "精确架构：%@。导入先预览，并在任何规范命令之前验证完整来源。导出仅为确定性的目录数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "確切結構描述：%@。匯入先預覽，並會在任何標準命令前驗證完整來源。匯出僅為確定性的目錄資料。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lược đồ chính xác: %@. Việc nhập ưu tiên xem trước và xác thực toàn bộ nguồn trước bất kỳ lệnh chuẩn nào. Việc xuất chỉ là dữ liệu danh mục có thể xác định."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "정확한 스키마: %@. 가져오기는 미리보기를 먼저 수행하고 기준 명령 전에 전체 소스를 검증합니다. 내보내기는 결정론적 카탈로그 데이터만 제공합니다."
          }
        }
      }
    },
