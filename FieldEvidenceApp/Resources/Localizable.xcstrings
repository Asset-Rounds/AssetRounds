    "v30.parts-stock.action-requested": {
      "comment": "Screen: Parts & Stock. Meaning: Requested explicit stock action. Role: operation status. Arguments: action String formattedPresentation x1. Plural/select: none. Accessibility: Read after Count, Adjust, Transfer, or Archive request.. Screenshot: Parts & Stock visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested explicit %@ for the selected catalog item. Waiting for the canonical owner; no completion is inferred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó %@ explícito para el elemento de catálogo seleccionado. Esperando al propietario canónico; no se infiere finalización."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求对所选目录项目执行明确 %@。等待规范所有者；不推断已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求對所選目錄項目明確執行 %@。正在等待標準資料負責方；不推斷已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu %@ rõ ràng cho mục danh mục đã chọn. Đang chờ chủ sở hữu chuẩn; không suy ra hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 카탈로그 항목에 대해 명시적 %@을 요청했습니다. 기준 소유자를 기다리는 중이며 완료는 추론되지 않습니다."
          }
        }
      }
    },
