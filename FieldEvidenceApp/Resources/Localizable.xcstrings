          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "C08 기준 데이터 가져오기 미리보기가 기준 데이터를 기록하지 않고 완료되었습니다. 이후 별도의 명시적 명령이 여전히 필요합니다."
          }
        }
      }
    },
    "v30.incumbent-file-adapter.canonical-preview-ready": {
      "comment": "Screen: Data & Portability. Meaning: Explains canonical preview ready in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Data & Portability body copy state; no screenshot is claimed.",
