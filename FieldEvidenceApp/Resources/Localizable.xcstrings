    "v30.asset.import.commit.disclosure": {
      "comment": "Screen: Party/contact/Site-role import screen. Meaning: Uses the English default “Commit is explicit and delegates one all-or-nothing canonical workspace command to the incumbent writer.”. Role: VoiceOver hint. Arguments: none. Plural/select: none. Accessibility: Passed to an accessibilityHint modifier; VoiceOver reads it after the associated control label. Screenshot: Party/contact/Site-role import screen. state where this VoiceOver hint is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit is explicit and delegates one all-or-nothing canonical workspace command to the incumbent writer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La confirmación es explícita y delega un comando canónico de espacio de trabajo de todo o nada al escritor existente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提交是明确的，并将一项全有或全无的规范工作区命令委托给现有写入方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提交為明確操作，並將一個全有或全無的標準工作區命令委派給現任寫入者。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xác nhận là rõ ràng và ủy quyền một lệnh không thể tách rời của không gian làm việc bản ghi chuẩn cho người ghi đương nhiệm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "확정 저장은 명시적이며, 현 작성자에게 전부 아니면 전무 방식의 기준 작업 공간 명령 하나를 위임합니다."
          }
        }
      }
    },
