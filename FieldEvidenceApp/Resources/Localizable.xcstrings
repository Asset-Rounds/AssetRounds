    "v30.voice-capture.operation-pending": {
      "comment": "Screen: Voice capture. Meaning: Reports operation pending to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
