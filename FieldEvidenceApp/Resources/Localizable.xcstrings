    },
    "v30.recipient-review.session": {
      "comment": "Screen: Recipient review. Meaning: Names the session value. Role: value-row label. Arguments: none. Plural/select: none. Accessibility: The combined row exposes this label with its value to VoiceOver. Screenshot: Recipient review value-row label state; no screenshot is claimed.",
