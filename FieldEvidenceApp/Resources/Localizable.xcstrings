    },
    "v30.parts-stock.state-protected-data-description": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state protected data description to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected local data is unavailable. The last readable state is not reconstructed, and no write is attempted. Retry after the caller reports protected data available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los datos locales protegidos no están disponibles. El último estado legible no se reconstruye y no se intenta ninguna escritura. Vuelva a intentarlo después de que el llamador informe que los datos protegidos están disponibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "受保护的本地数据不可用。不会重建最后可读状态，也不会尝试写入。请在调用方报告受保护数据可用后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "受保護的本機資料不可用。不會重建最後可讀狀態，也不會嘗試寫入。請在呼叫端回報受保護資料可用後重試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dữ liệu cục bộ được bảo vệ không khả dụng. Không tái dựng trạng thái đọc được gần nhất và không thử ghi. Hãy thử lại sau khi bên gọi báo dữ liệu được bảo vệ đã khả dụng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보호된 로컬 데이터를 사용할 수 없습니다. 마지막으로 읽을 수 있었던 상태를 재구성하지 않으며 쓰기를 시도하지 않습니다. 호출자가 보호된 데이터를 사용할 수 있다고 보고한 뒤 재시도하세요."
          }
        }
      }
    },
    "v30.parts-stock.state-ready": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state ready to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready for supplied local catalog work"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Listo para trabajo de catálogo local proporcionado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可进行所提供的本地目录工作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "準備好處理提供的本機目錄工作"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sẵn sàng cho công việc danh mục cục bộ được cung cấp"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 로컬 카탈로그 작업 준비됨"
          }
        }
      }
    },
    "v30.parts-stock.state-ready-description": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state ready description to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The caller supplied a local projection. Every quantity-affecting action still requires an explicit command and a canonical receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El componente solicitante proporcionó una proyección local. Toda acción que afecte las cantidades sigue requiriendo un comando explícito y un comprobante canónico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "调用方提供了本地投影。每个影响数量的操作仍需明确命令和规范回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "呼叫端提供了本機投影。每項影響數量的動作仍需明確命令及標準回執。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bên gọi đã cung cấp bản chiếu cục bộ. Mọi hành động ảnh hưởng số lượng vẫn cần lệnh rõ ràng và biên nhận chuẩn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호출 측이 로컬 조회용 데이터를 제공했습니다. 수량에 영향을 주는 모든 작업에는 여전히 명시적 명령과 기준 처리 확인서가 필요합니다."
          }
        }
      }
    },
    "v30.parts-stock.state-stale": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state stale to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
