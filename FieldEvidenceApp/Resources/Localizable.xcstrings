    "v30.incumbent-file-adapter.export-description": {
      "comment": "Screen: Data & Portability. Meaning: Explains export description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Data & Portability body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An export result prepares deterministic export bytes and a manifest locally. It never means synced, accepted, ordered, delivered, read, or processed by a provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un resultado de exportación prepara localmente bytes de exportación deterministas y un manifiesto. Nunca significa sincronizado, aceptado, ordenado, entregado, leído ni procesado por un proveedor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "导出结果会在本地准备确定性导出字节和清单。它绝不表示已同步、已接受、已排序、已交付、已阅读或已由提供方处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "匯出結果會在本機準備具決定性的匯出位元組與資訊清單。這絕不表示已同步、接受、排序、交付、讀取或由提供者處理。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết quả xuất chuẩn bị các byte xuất xác định và một tệp kê khai tại chỗ. Điều đó không bao giờ có nghĩa là đã đồng bộ, được chấp nhận, đặt hàng, gửi, đọc hoặc xử lý bởi nhà cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "내보내기 결과는 결정적 내보내기 바이트와 매니페스트를 로컬에서 준비합니다. 공급자가 동기화, 수락, 주문, 납품, 읽기 또는 처리했음을 의미하지 않습니다."
          }
        }
      }
    },
