    "c12.reinspection.disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selection reasons are shown for review. Unchanged attestations are not fresh evidence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los motivos de selección se muestran para revisión. Las declaraciones sin cambios no son evidencia nueva."
          }
