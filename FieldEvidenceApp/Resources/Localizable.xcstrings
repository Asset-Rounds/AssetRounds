    "v30.party.contact.workflow.preferred.contact.notice": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Uses the English default “Preferred status is scoped to one supplied Party and contact kind, such as phone or email. It does not make a person preferred for another kind or prove identity.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Party/contact/Site-role workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferred status is scoped to one supplied Party and contact kind, such as phone or email. It does not make a person preferred for another kind or prove identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El estado preferido se limita a una Parte proporcionada y a un tipo de contacto, como teléfono o correo electrónico. No convierte a una persona en preferida para otro tipo ni prueba identidad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "首选状态限定于一个提供的参与方和联系人类型，例如电话或电子邮件。它不会使某人对另一种类型成为首选，也不证明身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "偏好狀態限定為一個已提供的主體及聯絡人類型，例如電話或電子郵件。它不會使某人對另一類型成為偏好，也不證明身分。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trạng thái ưu tiên chỉ áp dụng cho một Bên và loại liên hệ được cung cấp, chẳng hạn điện thoại hoặc email. Trạng thái này không khiến một người được ưu tiên ở loại khác và không chứng minh danh tính."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선호 상태는 제공된 하나의 관계자와 전화 또는 이메일 같은 연락처 유형에 한정됩니다. 다른 유형에 대해 사람을 선호로 만들거나 신원을 증명하지 않습니다."
          }
        }
      }
    },
    "v30.party.contact.workflow.preferred.scope": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Describes the supplied preferred-contact scope and active contact count. Role: visible preferred-contact status text. Arguments: kind: String, opaqueIdentifier, one value; activeContactCount: Int, aggregateCount, one aggregate count. Plural/select: independent English one/other catalog substitutions for activeContactCount; other arguments are not plural selectors. Accessibility: Visible text is read in normal VoiceOver traversal. Screenshot: Concrete visible preferred-contact status text state on this screen; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplied %1$@ preference scope for one Party; %#@activeContactCount@."
          },
          "substitutions": {
            "activeContactCount": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
