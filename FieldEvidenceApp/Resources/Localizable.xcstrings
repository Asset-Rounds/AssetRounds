    "v30.voice-capture.retry": {
      "comment": "Screen: Voice capture. Meaning: Names the retry action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Voice capture button title state; no screenshot is claimed.",
