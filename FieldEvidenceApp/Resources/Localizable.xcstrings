    "v30.punch.review.findings.boundary": {
      "comment": "Screen: Punch-review workflow screen. Meaning: Uses the English default “This screen does not resolve, approve, or hide findings. Record a basis variation only through a supplied canonical command.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Punch-review workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen does not resolve, approve, or hide findings. Record a basis variation only through a supplied canonical command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta pantalla no resuelve, aprueba ni oculta hallazgos. Registre una variación de fundamento solo mediante un comando canónico proporcionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此屏幕不会解决、批准或隐藏发现的问题。仅可通过提供的规范命令记录依据变更。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此畫面不會解決、核准或隱藏發現事項。僅能透過提供的標準命令記錄依據變更。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màn hình này không giải quyết, phê duyệt hay ẩn các phát hiện. Chỉ ghi nhận thay đổi cơ sở thông qua một lệnh chuẩn được cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 화면은 발견 사항을 해결, 승인 또는 숨기지 않습니다. 제공된 기준 명령을 통해서만 근거 변경을 기록하세요."
          }
        }
      }
    },
