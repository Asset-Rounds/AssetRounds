    "v30.parts-stock.search-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains search description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search uses the Work-local catalog and stock-namespaced product identities. Typing or scanning is query-only and never creates a movement, receipt, or durable scan record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La búsqueda usa el catálogo local de Trabajo y las identidades de producto del espacio de nombres de existencias. Escribir o escanear solo consulta y nunca crea un movimiento, comprobante ni registro duradero de escaneo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "搜索使用工作区本地目录及库存命名空间中的产品标识。键入或扫描仅执行查询，绝不会创建库存变动、回执或持久扫描记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "搜尋使用工作區本機目錄及庫存命名空間中的產品識別碼。鍵入或掃描僅查詢資料，絕不建立庫存異動、回執或持久掃描記錄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tìm kiếm dùng danh mục cục bộ của không gian làm việc và mã định danh sản phẩm thuộc không gian tên kho. Gõ hoặc quét chỉ truy vấn, không bao giờ tạo biến động, biên nhận hay bản ghi quét lâu dài."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "검색은 작업 내 로컬 카탈로그와 재고 네임스페이스의 제품 식별자를 사용합니다. 입력 또는 스캔은 조회만 수행하며 이동, 처리 확인서 또는 영구 스캔 기록을 생성하지 않습니다."
          }
        }
      }
    },
