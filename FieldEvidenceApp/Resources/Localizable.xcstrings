    "v30.punch.review.report.ready.boundary": {
      "comment": "Screen: Punch-review workflow screen. Meaning: Uses the English default “This view exposes a renderer-neutral projection only. Report-ready does not mean rendered, delivered, accepted, identity-verified, safe, compliant, or approved.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Punch-review workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This view exposes a renderer-neutral projection only. Report-ready does not mean rendered, delivered, accepted, identity-verified, safe, compliant, or approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta vista solo muestra una proyección independiente del generador. Estar listo para generar un informe no significa que se haya generado, entregado, aceptado, verificado la identidad, declarado seguro o conforme, ni aprobado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此视图仅提供与渲染器无关的投影。可用于报告不表示已生成、已交付、已接受、身份已验证、安全、合规或已批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此畫面僅提供與轉譯器無關的投影。可供製作報告不代表已產生、已交付、已接受、身分已驗證、安全、合規或已核准。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màn hình này chỉ cung cấp bản chiếu độc lập với bộ kết xuất. Sẵn sàng lập báo cáo không có nghĩa là đã kết xuất, giao, chấp nhận, xác minh danh tính, an toàn, tuân thủ hay phê duyệt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 화면에는 렌더러와 독립적인 조회용 데이터만 표시됩니다. 보고서 작성 준비가 되었다고 해서 렌더링, 전달, 수락, 신원 확인, 안전성, 규정 준수 또는 승인을 의미하지는 않습니다."
          }
        }
      }
    },
    "v30.punch.review.request.cancelled": {
      "comment": "Screen: Punch-review workflow screen. Meaning: Uses the English default “The request was cancelled. Reload the canonical record before retrying; no acceptance is claimed.”. Role: operation-status message. Arguments: none. Plural/select: none. Accessibility: Shown in the operation-status card or status surface; normal VoiceOver traversal reads it, and focused status updates are announced. Screenshot: Punch-review workflow screen. state where this operation-status message is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
