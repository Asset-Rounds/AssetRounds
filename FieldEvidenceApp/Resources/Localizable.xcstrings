        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi được bật cho các không gian làm việc thực đã chọn, tính năng khám phá riêng tư trên thiết bị có thể cung cấp các phím tắt chỉ đọc đã được phê duyệt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 실제 작업 공간에서 활성화하면 비공개 기기 내 검색을 통해 승인된 읽기 전용 단축키를 제공할 수 있습니다."
          }
