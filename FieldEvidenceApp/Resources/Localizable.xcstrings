          }
        }
      }
    },
    "v30.recipient-review.submitting-command": {
      "comment": "Screen: Recipient review. Meaning: Reports submitting command to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Recipient review operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitting the supplied recipient-review command…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enviando el comando de revisión del destinatario proporcionado…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在提交提供的接收方审核命令…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在提交提供的接收者審閱命令…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đang gửi lệnh xem xét của người nhận được cung cấp…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
