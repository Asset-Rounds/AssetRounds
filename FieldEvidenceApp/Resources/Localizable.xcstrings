    "v30.parts-stock.heading-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains heading description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Work-local catalog for explicit count, adjustment, transfer, use, return, and archive actions. It does not prove identity, ownership, valuation, delivery, or authority."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un catálogo local de trabajo para acciones explícitas de contar, ajustar, transferir, usar, devolver y archivar. No prueba identidad, propiedad, valoración, entrega ni autoridad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "用于明确计数、调整、转移、使用、退回和归档操作的工作本地目录。它不能证明身份、所有权、估值、交付或权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這是工作本機目錄，用於明確的計數、調整、轉移、使用、歸還及封存動作。它不證明身分、所有權、估值、交付或權限。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Danh mục cục bộ cho Công việc dành cho các thao tác đếm, điều chỉnh, chuyển, sử dụng, hoàn trả và lưu trữ rõ ràng. Không chứng minh danh tính, quyền sở hữu, định giá, giao nhận hoặc thẩm quyền."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명시적인 수량, 조정, 이동, 사용, 반납 및 보관 작업을 위한 작업 로컬 카탈로그입니다. 신원, 소유권, 평가, 납품 또는 권한을 증명하지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.history-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains history description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History here is caller-supplied immutable context. It does not replay movements, create a new stock event, or make a balance, delivery, approval, identity, or legal-effect claim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El historial aquí es contexto inmutable proporcionado por el llamador. No repite movimientos, no crea un nuevo evento de inventario ni declara saldo, entrega, aprobación, identidad ni efecto legal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这里的历史记录是调用方提供的不可变上下文。它不会重放移动、创建新的库存事件，或作出余额、交付、批准、身份或法律效力声明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此處歷程是呼叫端提供的不可變內容。它不會重播移動、建立新的庫存事件，或宣稱餘額、交付、核准、身分或法律效力。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lịch sử tại đây là ngữ cảnh bất biến do người gọi cung cấp. Nó không phát lại chuyển động, tạo sự kiện tồn kho mới hoặc đưa ra tuyên bố về số dư, chuyển phát, phê duyệt, danh tính hay hiệu lực pháp lý."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기의 이력은 호출자가 제공한 변경 불가 컨텍스트입니다. 이동을 재생하거나 새 재고 이벤트를 만들지 않으며, 잔액, 배달, 승인, 신원 또는 법적 효력을 주장하지 않습니다."
          }
        }
      }
    },
