          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tài liệu này ghi nhận chi tiết bằng chứng đã được xem xét. Đây không phải là chứng nhận và không xác minh thời điểm thu thập, địa điểm hay con người."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 자료는 검토된 증거 세부 정보를 기록합니다. 인증이 아니며 수집 시각, 위치 또는 사람을 검증하지 않습니다."
          }
        }
      }
    },
    "shop.profile.no_delivery_claim": {
