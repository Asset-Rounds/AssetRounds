    "illuminated.playbook.preflight.safe_authorized_position": {
      "comment": "C03 preflight guidance; it does not claim system verification or an accepted acknowledgement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture only from a position you have determined is safe and authorized."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Capture solo desde una posición que haya determinado que es segura y autorizada."
          }
