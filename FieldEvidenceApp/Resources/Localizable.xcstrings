    "v30.service-request.current-state-description": {
      "comment": "Screen: Service request. Meaning: Explains current state description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This status is an existing canonical request-state projection. It does not verify the requester, contact, urgency, delivery, dispatch, work completion, or service result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este estado es una proyección existente del estado canónico de la solicitud. No verifica al solicitante, el contacto, la urgencia, la entrega, el despacho, la finalización del trabajo ni el resultado del servicio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此状态是现有规范请求状态的投影，不验证请求方、联系方式、紧急程度、交付、派工、工作完成或服务结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此狀態是既有標準請求狀態的投影，不驗證請求人、聯絡方式、急迫程度、交付、派工、工作完成或服務結果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trạng thái này là bản chiếu trạng thái yêu cầu chuẩn hiện có. Nó không xác minh người yêu cầu, người liên hệ, mức khẩn cấp, chuyển giao, điều phối, hoàn thành công việc hay kết quả dịch vụ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 상태는 기존 기준 요청 상태를 조회용으로 표시한 것입니다. 요청자, 연락처, 긴급도, 전달, 출동, 작업 완료 또는 서비스 결과를 검증하지 않습니다."
          }
        }
      }
    },
