    "v30.voice-capture.finish-review": {
      "comment": "Screen: Voice capture. Meaning: Names the finish review action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Voice capture button title state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish voice review"
          }
        },
        "es": {
          "stringUnit": {
