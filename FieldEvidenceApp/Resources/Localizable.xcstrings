    "v30.report-correction.correction.disclosure": {
      "comment": "Screen: Report correction. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Report correction rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the note only. Evidence, outcome, time, and report history stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambie solo la nota. La evidencia, el resultado, la hora y el historial del informe permanecen sin cambios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅修改备注。证据、结果、时间和报告历史记录保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅修改備註。證據、結果、時間與報告歷程皆維持不變。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ sửa ghi chú. Bằng chứng, kết quả, thời gian và lịch sử báo cáo không thay đổi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메모만 변경합니다. 증거, 결과, 시간, 보고서 이력은 그대로 유지됩니다."
          }
        }
      }
    },
