            "state": "translated",
            "value": "Requests the separately supplied canonical work action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicita la acción de trabajo canónica proporcionada por separado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求另行提供的规范工作操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
