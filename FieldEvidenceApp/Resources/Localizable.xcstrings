    "v30.party.contact.workflow.history.notice": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Uses the English default “Party and contact history is caller-bounded; Site-role history is append-only. Each supplied snapshot remains historical context rather than current identity proof.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Party/contact/Site-role workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Party and contact history is caller-bounded; Site-role history is append-only. Each supplied snapshot remains historical context rather than current identity proof."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El historial de Parte y contacto está limitado por el llamador; el historial de rol de Sitio es solo de anexado. Cada instantánea proporcionada permanece como contexto histórico en lugar de prueba de identidad actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "参与方和联系人历史由调用方限定；地点角色历史仅追加。每个提供的快照仍为历史上下文，而非当前身份凭证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "主體與聯絡人歷程受呼叫端限制；場所角色歷程僅能附加。每個提供的快照仍是歷史內容，而非目前身分證明。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lịch sử bên và người liên hệ được giới hạn bởi bên gọi; lịch sử vai trò tại Địa điểm chỉ được thêm mới. Mỗi ảnh chụp trạng thái được cung cấp vẫn là ngữ cảnh lịch sử, không phải bằng chứng danh tính hiện tại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "관계자 및 연락처 기록은 호출자 범위로 제한되며 현장 역할 기록은 추가 전용입니다. 제공된 각 스냅샷은 현재 신원 증명이 아닌 과거 컨텍스트로 유지됩니다."
          }
        }
      }
    },
