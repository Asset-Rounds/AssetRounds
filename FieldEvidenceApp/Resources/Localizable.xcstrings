    "v30.voice-capture.stop-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the stop hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops this explicit push-to-talk capture. It does not accept a transcript or write the draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detiene esta captura explícita de pulsar para hablar. No acepta una transcripción ni escribe en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "停止此次明确启动的按键说话采集，不会接受转写文本或写入草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "停止這次明確啟動的按鍵說話擷取，不會接受逐字稿或寫入草稿。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dừng lần nhấn để nói đã chủ động bắt đầu này. Không chấp nhận bản chép lời hoặc ghi bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "직접 눌러 말하는 이 수집을 중지합니다. 전사문을 수락하거나 초안을 기록하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.stop-requested": {
      "comment": "Screen: Voice capture. Meaning: Reports stop requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop requested. Waiting for the caller's final on-device transcript; no proposal or draft effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó detener. Esperando la transcripción final en el dispositivo del componente solicitante; no se confirma ninguna propuesta ni efecto en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求停止。正在等待调用方最终的设备端转写文本；不声称建议或草稿产生了效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求停止。正在等待呼叫端最終的裝置端逐字稿；不聲稱提案或草稿已產生效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu dừng. Đang chờ bản chép lời cuối cùng trên thiết bị từ bên gọi; không khẳng định tác động tới đề xuất hay bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "중지가 요청되었습니다. 호출 측의 최종 기기 내 전사문을 기다리고 있으며 제안 생성이나 초안 변경이 반영되었다고 볼 수 없습니다."
          }
        }
      }
    },
    "v30.voice-capture.stop-speaking": {
      "comment": "Screen: Voice capture. Meaning: Names the stop speaking action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Voice capture button title state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop speaking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
