          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "建立提供的回應"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tạo phản hồi được cung cấp"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 응답 생성"
          }
        }
      }
    },
    "v30.recipient-review.customer-safe-boundary": {
      "comment": "Screen: Recipient review. Meaning: Explains customer safe boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customer-safe exchange excludes stable workspace IDs, raw originals, internal notes, contact records, and local paths."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El intercambio seguro para el cliente excluye ID estables de espacios de trabajo, originales sin procesar, notas internas, registros de contacto y rutas locales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "对客户安全的交换不包含稳定工作区 ID、原始原件、内部备注、联系人记录和本地路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "客戶安全交換不含穩定工作區 ID、原始資料、內部附註、聯絡人記錄和本機路徑。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trao đổi an toàn cho khách hàng loại trừ ID không gian làm việc ổn định, bản gốc thô, ghi chú nội bộ, bản ghi liên hệ và đường dẫn cục bộ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "고객 안전 교환에서는 안정적인 작업 공간 ID, 원본 데이터, 내부 메모, 연락처 기록 및 로컬 경로를 제외합니다."
          }
        }
      }
    },
    "v30.recipient-review.decision-description": {
      "comment": "Screen: Recipient review. Meaning: Explains decision description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one supplied decision after preview: ACCEPT_AND_APPLY, record as history only, discard unimported, or keep quarantined. Quarantine and discard do not create a workspace receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elija una decisión proporcionada después de la vista previa: ACCEPT_AND_APPLY, registrar solo como historial, descartar sin importar o mantener en cuarentena. La cuarentena y el descarte no crean un recibo de espacio de trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "预览后选择一项提供的决定：ACCEPT_AND_APPLY、仅记录为历史、丢弃未导入项，或保留隔离项。隔离和丢弃不会创建工作区回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "預覽後選擇一個提供的決定：ACCEPT_AND_APPLY、僅記錄為歷程、捨棄未匯入項目，或保留隔離項目。隔離與捨棄不會建立工作區回執。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn một quyết định được cung cấp sau khi xem trước: ACCEPT_AND_APPLY, chỉ ghi là lịch sử, loại bỏ chưa nhập hoặc giữ cách ly. Cách ly và loại bỏ không tạo biên nhận không gian làm việc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "미리보기 후 제공된 결정 하나를 선택하십시오: ACCEPT_AND_APPLY, 이력으로만 기록, 가져오지 않은 항목 폐기 또는 격리 유지. 격리와 폐기는 작업 공간 처리 확인서를 만들지 않습니다."
          }
        }
      }
    },
    "v30.recipient-review.encrypted-available": {
      "comment": "Screen: Recipient review. Meaning: Reports the encrypted available state. Role: status label. Arguments: none. Plural/select: none. Accessibility: The combined label exposes this status to VoiceOver. Screenshot: Recipient review status label state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase-encrypted review exchange is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El intercambio de revisión cifrado con frase de contraseña está disponible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可进行口令加密的审核交换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可使用通關密語加密的審查交換。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Có thể trao đổi nội dung xem xét được mã hóa bằng cụm mật khẩu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "암호 문구로 암호화된 검토 교환을 사용할 수 있습니다."
          }
        }
      }
    },
    "v30.recipient-review.encrypted-available-description": {
      "comment": "Screen: Recipient review. Meaning: Explains encrypted available description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a passphrase again only in the native protected operation. This view does not retain a passphrase, key, or capability."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingrese una frase de contraseña nuevamente solo en la operación nativa protegida. Esta vista no conserva una frase de contraseña, clave ni capacidad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在原生受保护操作中再次输入密码短语。此视图不会保留密码短语、密钥或能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅在原生受保護操作中再次輸入密碼片語。此檢視不會保留密碼片語、金鑰或能力。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ nhập lại cụm mật khẩu trong thao tác được bảo vệ gốc. Chế độ xem này không lưu cụm mật khẩu, khóa hoặc khả năng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "암호문은 네이티브 보호 작업에서만 다시 입력하세요. 이 보기는 암호문, 키 또는 기능을 보존하지 않습니다."
          }
        }
      }
    },
    "v30.recipient-review.encrypted-disabled": {
      "comment": "Screen: Recipient review. Meaning: Reports the encrypted disabled state. Role: status label. Arguments: none. Plural/select: none. Accessibility: The combined label exposes this status to VoiceOver. Screenshot: Recipient review status label state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted exchange is disabled. Use only the explicit clear/manual path when appropriate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El intercambio cifrado está desactivado. Use solo la ruta explícita clara o manual cuando corresponda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "加密交换已禁用。适当时仅使用明确的明文/手动路径。"
          }
