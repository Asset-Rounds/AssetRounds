    "v30.my-day.accessibility-description": {
      "comment": "Screen: My Day. Meaning: Explains accessibility description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable labels support VoiceOver, Voice Control, Switch Control, keyboard use, and RTL layout. At Accessibility text sizes, content reflows without truncation; Reduce Motion adds no state-change animation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las etiquetas estables admiten VoiceOver, Control por voz, Control por botón, uso del teclado y diseño de derecha a izquierda. Con los tamaños de texto de accesibilidad, el contenido se redistribuye sin recortes; Reducir movimiento no agrega animaciones de cambio de estado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "稳定标签支持旁白、语音控制、切换控制、键盘和从右到左的布局。在辅助功能字体大小下，内容会重新排布且不被截断；启用“减弱动态效果”时，不添加状态变化动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "固定標籤支援 VoiceOver、語音控制、切換控制、鍵盤與由右至左的版面配置。使用輔助使用字體大小時，內容會重新排列而不截斷；啟用「減少動態效果」時，不加入狀態變更動畫。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhãn ổn định hỗ trợ VoiceOver, Điều khiển bằng giọng nói, Điều khiển công tắc, bàn phím và bố cục từ phải sang trái. Với cỡ chữ trợ năng, nội dung tự bố trí lại mà không bị cắt ngắn; khi bật Giảm chuyển động, không thêm hiệu ứng chuyển trạng thái."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일관된 라벨은 VoiceOver, 음성 명령, 스위치 제어, 키보드 사용 및 RTL 레이아웃을 지원합니다. 손쉬운 사용 텍스트 크기에서는 콘텐츠가 잘리지 않고 재배치되며, 동작 줄이기는 상태 변경 애니메이션을 추가하지 않습니다."
          }
        }
      }
    },
    "v30.my-day.carryover-description": {
      "comment": "Screen: My Day. Meaning: Explains carryover description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carryover is explicit and only uses supplied eligible memberships. It never moves unfinished work across a date or time zone automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El traspaso es explícito y solo usa pertenencias elegibles proporcionadas. Nunca mueve automáticamente trabajo sin terminar entre una fecha o zona horaria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "结转是明确的，并且只使用提供的符合条件成员关系。它绝不会自动跨日期或时区移动未完成工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "延續是明確的，且僅使用提供的符合資格成員資格。絕不會自動將未完成工作跨日期或時區移動。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chuyển tiếp là rõ ràng và chỉ dùng các tư cách thành viên đủ điều kiện được cung cấp. Nó không bao giờ tự động di chuyển công việc chưa hoàn tất qua ngày hoặc múi giờ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이월은 명시적이며 제공된 적격 멤버십만 사용합니다. 미완료 작업을 날짜나 시간대 간에 자동으로 이동하지 않습니다."
          }
        }
      }
    },
    "v30.my-day.carryover-heading": {
      "comment": "Screen: My Day. Meaning: Names the carryover heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: My Day section heading state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit carryover"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traspaso explícito"
          }
        },
        "zh-Hans": {
          "stringUnit": {
