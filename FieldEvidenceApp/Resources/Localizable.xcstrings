    "v30.voice-capture.reject-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the reject hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejects this proposal field through C56 without writing the rejected value to the draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rechaza este campo de propuesta mediante C56 sin escribir el valor rechazado en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过 C56 拒绝此提议字段，而不将被拒绝的值写入草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "透過 C56 拒絕此提案欄位，不會將遭拒的值寫入草稿。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Từ chối trường đề xuất này thông qua C56 mà không ghi giá trị bị từ chối vào bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "거부된 값을 초안에 기록하지 않고 C56을 통해 이 제안 필드를 거부합니다."
          }
        }
      }
    },
    "v30.voice-capture.reject-requested": {
      "comment": "Screen: Voice capture. Meaning: Reject request sent for a field. Role: operation status. Arguments: label String authoredSource x1. Plural/select: none. Accessibility: Read in operation status.. Screenshot: Voice capture visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject request sent for %@. The rejected value remains nonpersistent; no draft effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se envió la solicitud de rechazo para %@. El valor rechazado permanece sin persistir; no se afirma ningún efecto en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已发送对 %@ 的拒绝请求。被拒绝的值仍不持久；不声称有草稿影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已送出針對 %@ 的拒絕要求。遭拒的值仍不會持久保存；不聲稱產生草稿效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu từ chối đã gửi cho %@. Giá trị bị từ chối vẫn không được lưu; không tuyên bố hiệu lực bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에 대한 거부 요청이 전송되었습니다. 거부된 값은 영구 저장되지 않으며 초안 효과는 주장되지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.reject-unavailable": {
      "comment": "Screen: Voice capture. Meaning: Explains reject unavailable in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This proposal field cannot be rejected from the supplied state. Keep the manual path available and reload the review target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede rechazar este campo de propuesta desde el estado proporcionado. Mantenga disponible la vía manual y vuelva a cargar el destino de revisión."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的状态下无法拒绝此建议字段。请保留手动途径并重新加载审核目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的狀態無法拒絕此提案欄位。請保留手動途徑並重新載入審閱目標。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể từ chối trường đề xuất này từ trạng thái được cung cấp. Hãy giữ luồng thủ công khả dụng và tải lại đích xem xét."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 상태에서는 이 제안 필드를 거부할 수 없습니다. 수동 경로를 유지하고 검토 대상을 다시 불러오세요."
          }
        }
      }
    },
