    "v30.subscription.status.no.active.detail": {
      "comment": "Screen: Subscription status screen. Meaning: Uses the English default “Your existing data remains available. Restore Purchases checks Apple purchase history; it does not restore inspection data.”. Role: presentation title. Arguments: none. Plural/select: none. Accessibility: Supplied to the screen’s presentation model and read when that title is rendered. Screenshot: Subscription status screen. state where this presentation title is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your existing data remains available. Restore Purchases checks Apple purchase history; it does not restore inspection data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sus datos existentes siguen disponibles. Restaurar compras consulta el historial de compras de Apple; no restaura datos de inspección."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "现有数据仍然可用。“恢复购买项目”检查 Apple 购买历史，不会恢复检查数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "既有資料仍可使用。「回復購買項目」會檢查 Apple 購買歷程，不會回復檢查資料。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dữ liệu hiện có của bạn vẫn khả dụng. Khôi phục giao dịch mua kiểm tra lịch sử mua hàng của Apple; thao tác này không khôi phục dữ liệu kiểm tra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기존 데이터는 계속 사용할 수 있습니다. 구입 항목 복원은 Apple 구매 이력을 확인하며 점검 데이터를 복원하지 않습니다."
          }
        }
      }
    },
    "v30.subscription.status.no.current.subscription": {
