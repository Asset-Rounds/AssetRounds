    "v30.signoff.enrollment.response.action.status": {
      "comment": "Screen: Signoff response enrollment screen. Meaning: Uses the English default “Record approval response action invoked. This surface does not claim a saved, final, or verified result.”. Role: focused response-status message. Arguments: none. Plural/select: none. Accessibility: Displayed in the relevant status or error surface; the implementation moves VoiceOver focus to the stated target. Screenshot: Signoff response enrollment screen. state where this focused response-status message is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record approval response action invoked. This surface does not claim a saved, final, or verified result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se invocó la acción de registrar respuesta de aprobación. Esta superficie no declara un resultado guardado, final ni verificado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已调用记录批准响应操作。此界面不声称结果已保存、最终或已验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已叫用記錄核准回覆動作。此介面不聲稱結果已儲存、定案或驗證。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã gọi hành động ghi phản hồi phê duyệt. Bề mặt này không tuyên bố kết quả đã lưu, cuối cùng hoặc đã xác minh."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "승인 응답 기록 작업이 호출되었습니다. 이 화면은 저장됨, 최종 또는 검증된 결과를 주장하지 않습니다."
          }
        }
      }
    },
    "v30.signoff.enrollment.revision.binding.notice": {
      "comment": "Screen: Signoff response enrollment screen. Meaning: Uses the English default “This response is bound to the supplied immutable completed-work revision. Review the detail again if the revision becomes stale.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Signoff response enrollment screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This response is bound to the supplied immutable completed-work revision. Review the detail again if the revision becomes stale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta respuesta está vinculada a la revisión inmutable de trabajo completado proporcionada. Revise el detalle de nuevo si la revisión queda desactualizada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此回复绑定到提供的不可变已完成工作修订版。如果该修订版过期，请重新审核详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此回覆綁定提供的不可變已完成工作修訂版。若修訂版過期，請重新審閱詳情。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phản hồi này được ràng buộc với phiên bản công việc đã hoàn thành bất biến được cung cấp. Hãy xem lại phần chi tiết nếu phiên bản đã cũ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 응답은 제공된 불변 완료 작업 개정본에 연결됩니다. 개정본이 오래되면 세부 정보를 다시 검토하세요."
          }
        }
      }
    },
