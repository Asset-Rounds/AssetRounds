    "v30.voice-capture.transcript-description": {
      "comment": "Screen: Voice capture. Meaning: Explains transcript description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transcript is a temporary, on-device review input. It is not a recording archive, correctness proof, diagnosis, compliance finding, identity claim, or final draft result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta transcripción es un dato de revisión temporal en el dispositivo. No es un archivo de grabaciones, prueba de exactitud, diagnóstico, hallazgo de cumplimiento, afirmación de identidad ni resultado final del borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此转写文本是设备端临时审核输入，不是录音档案、正确性证明、诊断、合规结论、身份声明或最终草稿结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此逐字稿為裝置端暫時審閱輸入，不是錄音封存、正確性證明、診斷、合規結論、身分聲明或最終草稿結果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản chép lời này là dữ liệu đầu vào tạm thời để xem xét trên thiết bị. Đây không phải là kho bản ghi, bằng chứng về tính đúng đắn, chẩn đoán, kết luận tuân thủ, khẳng định danh tính hay kết quả bản nháp cuối cùng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 전사문은 기기 내 검토를 위한 임시 입력입니다. 녹음 보관물, 정확성 증거, 진단, 규정 준수 판단, 신원 주장 또는 최종 초안 결과가 아닙니다."
          }
        }
      }
    },
