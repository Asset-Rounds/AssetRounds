        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 현장 역할 되돌리기는 이전 역할 이벤트에 연결된 후속 이벤트를 추가하며 이전 이벤트를 삭제하지 않습니다."
          }
