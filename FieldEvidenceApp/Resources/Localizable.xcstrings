    "shop.profile.limitations": {
      "comment": "C04 no-certification limitation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This material records reviewed evidence details. It is not a certification and does not verify capture time, location, or person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este material registra detalles de evidencia revisados. No es una certificación y no verifica la hora, el lugar ni la persona de la captura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
