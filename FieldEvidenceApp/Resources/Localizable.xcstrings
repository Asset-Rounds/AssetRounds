    "v30.voice-capture.needs-attention-description": {
      "comment": "Screen: Voice capture. Meaning: Explains needs attention description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No partial canonical draft effect is inferred. Review the current supplied state, preserve the typed fallback, and retry the same intent only after the caller reports recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se infiere ningún efecto parcial de borrador canónico. Revise el estado actual proporcionado, conserve la alternativa escrita y vuelva a intentar la misma intención solo después de que el llamador informe la recuperación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不会推断部分规范草稿效果。请审查当前提供的状态，保留输入的备选文本，仅在调用方报告恢复后重试相同意图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不推斷部分標準草稿效果。請審查目前提供的狀態、保留已輸入的備用內容，並僅在呼叫端回報已復原後重試相同意圖。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không suy ra hiệu lực bản nháp chuẩn từng phần nào. Xem xét trạng thái hiện tại được cung cấp, giữ phương án dự phòng đã nhập và chỉ thử lại cùng ý định sau khi bên gọi báo cáo đã khôi phục."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "부분적인 기준 초안 효과를 추론하지 않습니다. 현재 제공된 상태를 검토하고 입력한 대체 항목을 유지한 뒤, 호출자가 복구를 보고한 후에만 같은 의도를 다시 시도하십시오."
          }
        }
      }
    },
    "v30.voice-capture.no-fields": {
      "comment": "Screen: Voice capture. Meaning: Explains no fields in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No structured fields are supplied. Manual entry remains complete; no draft value is inferred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporcionan campos estructurados. La entrada manual permanece completa; no se infiere ningún valor de borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供结构化字段。手动输入仍完整；不推断草稿值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供結構化欄位。手動輸入仍完整；不推斷草稿值。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có trường có cấu trúc nào được cung cấp. Việc nhập thủ công vẫn hoàn chỉnh; không suy ra giá trị bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "구조화된 필드가 제공되지 않았습니다. 수동 입력은 완전하게 유지되며 초안 값을 추론하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.no-proposal": {
      "comment": "Screen: Voice capture. Meaning: Explains no proposal in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No current proposal is supplied. Keep the typed fallback and retry after the caller supplies a current review target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporciona ninguna propuesta actual. Conserve la alternativa escrita y vuelva a intentarlo después de que el llamador proporcione un destino de revisión actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
