    "v30.incumbent-file-adapter.actions-description": {
      "comment": "Screen: Data & Portability. Meaning: Explains actions description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Data & Portability body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canonical import needs the supplied C08 re-entry, session, revision, and source identity. It is never inferred from a file preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La importación canónica necesita la reentrada C08, sesión, revisión e identidad de origen proporcionadas. Nunca se infiere a partir de una vista previa de archivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "规范导入需要提供的 C08 重新进入、会话、修订版和源身份。绝不会从文件预览中推断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "標準匯入需要提供的 C08 重新進入、工作階段、修訂版本與來源識別。絕不會從檔案預覽推斷。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập chuẩn cần mục nhập lại C08, phiên, bản sửa đổi và danh tính nguồn được cung cấp. Không bao giờ suy ra từ bản xem trước tệp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기준 가져오기에는 제공된 C08 재진입, 세션, 개정 및 원본 신원이 필요합니다. 파일 미리보기에서 추론되지 않습니다."
          }
        }
      }
    },
