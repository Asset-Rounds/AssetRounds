    "v30.voice-capture.review-closure-requested": {
      "comment": "Screen: Voice capture. Meaning: Reports review closure requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review closure requested through C56. No Saved or Complete claim is made until the caller returns its validated result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó cerrar la revisión mediante C56. No se confirma Guardado ni Completo hasta que el componente solicitante devuelva su resultado validado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已通过 C56 请求结束审核。在调用方返回经过验证的结果之前，不声明已保存或已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已透過 C56 要求結束審閱。呼叫端傳回驗證結果前，不聲稱已儲存或已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu kết thúc xem xét qua C56. Chưa khẳng định Đã lưu hoặc Hoàn tất cho đến khi bên gọi trả về kết quả đã xác thực."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "C56을 통해 검토 종료가 요청되었습니다. 호출 측이 검증된 결과를 반환하기 전에는 저장됨 또는 완료됨으로 표시하지 않습니다."
          }
        }
      }
    },
