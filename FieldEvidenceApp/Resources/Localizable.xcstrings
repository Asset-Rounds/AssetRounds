    "v30.subscription.status.data.storage.notice": {
      "comment": "Screen: Subscription status screen. Meaning: Uses the English default “Inspection data and photos stay on this device and do not sync with the subscription. Use a data backup to move them.”. Role: VoiceOver hint. Arguments: none. Plural/select: none. Accessibility: The call is assigned directly as the accessibility hint. Screenshot: Subscription status screen. state where this VoiceOver hint is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspection data and photos stay on this device and do not sync with the subscription. Use a data backup to move them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los datos y fotos de inspección permanecen en este dispositivo y no se sincronizan con la suscripción. Use una copia de seguridad de datos para moverlos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "检查数据和照片保留在此设备上，不会与订阅同步。使用数据备份移动它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "檢查資料和照片會留在此裝置上，且不會與訂閱同步。請使用資料備份移動它們。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dữ liệu và ảnh kiểm tra ở lại trên thiết bị này và không đồng bộ với gói đăng ký. Sử dụng bản sao lưu dữ liệu để chuyển chúng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "점검 데이터와 사진은 이 기기에 유지되며 구독과 동기화되지 않습니다. 이동하려면 데이터 백업을 사용하십시오."
          }
        }
      }
    },
    "v30.subscription.status.existing.data.available": {
