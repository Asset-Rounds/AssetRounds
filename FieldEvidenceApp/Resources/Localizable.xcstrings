    "v30.advanced-recurrence.unavailable-command": {
      "comment": "Screen: Advanced recurrence. Meaning: Unavailable scheduling command. Role: visible availability explanation. Arguments: title String formattedPresentation x1. Plural/select: none. Accessibility: Read beside unavailable command.. Screenshot: Advanced recurrence visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unavailable until its prevalidated canonical command is supplied."
          }
        },
        "es": {
