    "v30.feedback.feedback.label5": {
      "comment": "Screen: Feedback. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Feedback rendered state; no screenshot is asserted.",
      "localizations": {
