    "v30.party.contact.workflow.contacts.notice": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Uses the English default “Contacts are local operational records. This surface neither accesses the system Contacts database nor logs communications, grants marketing permission, or verifies identity.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Party/contact/Site-role workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts are local operational records. This surface neither accesses the system Contacts database nor logs communications, grants marketing permission, or verifies identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los contactos son registros operativos locales. Esta superficie no accede a la base de datos de Contactos del sistema, no registra comunicaciones, no concede permiso de marketing ni verifica identidad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "联系人是本地操作记录。此界面既不访问系统“通讯录”数据库，也不记录通信、授予营销权限或验证身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "聯絡人是本機作業記錄。此介面不會存取系統「聯絡人」資料庫，也不會記錄通訊、授予行銷許可或驗證身分。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liên hệ là các bản ghi vận hành cục bộ. Bề mặt này không truy cập cơ sở dữ liệu Danh bạ của hệ thống, không ghi nhật ký liên lạc, cấp quyền tiếp thị hoặc xác minh danh tính."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연락처는 로컬 운영 기록입니다. 이 화면은 시스템 연락처 데이터베이스에 접근하거나 통신을 기록하거나 마케팅 권한을 부여하거나 신원을 검증하지 않습니다."
          }
        }
      }
    },
