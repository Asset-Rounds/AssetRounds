    "v30.my-day.heading-description": {
      "comment": "Screen: My Day. Meaning: Explains heading description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan supplied eligible work in a manual order. Due, readiness, duration, completion, cancellation, and reopen information remains derived from its canonical source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El plan proporcionó trabajo elegible en orden manual. La información de vencimiento, preparación, duración, finalización, cancelación y reapertura sigue derivándose de su origen canónico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "计划以手动顺序提供了符合条件的工作。到期、就绪、时长、完成、取消和重新开启信息仍派生自其规范来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "計畫以手動順序提供符合資格的工作。到期、就緒、持續時間、完成、取消和重新開啟資訊仍衍生自其標準來源。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lập kế hoạch cho công việc đủ điều kiện được cung cấp theo thứ tự thủ công. Thông tin về hạn, mức sẵn sàng, thời lượng, hoàn thành, hủy và mở lại vẫn được suy ra từ nguồn chuẩn của công việc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계획은 수동 순서로 적격 작업을 제공했습니다. 기한, 준비 상태, 기간, 완료, 취소 및 다시 열기 정보는 기준 소스에서 계속 파생됩니다."
          }
        }
      }
    },
