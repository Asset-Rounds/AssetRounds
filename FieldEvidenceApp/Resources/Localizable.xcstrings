    "v30.sign.detail.delete.confirmation.message": {
      "comment": "Screen: Sign detail screen. Meaning: Uses the English default “Delete this sign, its photos, and its reports from this app? This cannot be undone. Your free-report count will not reset. Erase All removes the remaining anonymous count.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Sign detail screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this sign, its photos, and its reports from this app? This cannot be undone. Your free-report count will not reset. Erase All removes the remaining anonymous count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Eliminar de esta app este letrero, sus fotos y sus informes? Esta acción no se puede deshacer. Su conteo de informes gratuitos no se restablecerá. Borrar todo elimina el conteo anónimo restante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要从此应用删除此标牌、其照片和报告吗？此操作无法撤销。您的免费报告计数不会重置。全部擦除会移除剩余匿名计数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要從此 App 刪除此標牌、其照片和報告嗎？此操作無法復原。您的免費報告計數不會重設。清除全部會移除剩餘的匿名計數。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xóa biển hiệu này, ảnh của biển hiệu và báo cáo của biển hiệu khỏi ứng dụng này? Thao tác này không thể hoàn tác. Số báo cáo miễn phí của bạn sẽ không đặt lại. Xóa Tất cả sẽ xóa số lượng ẩn danh còn lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 간판과 사진 및 보고서를 이 앱에서 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다. 무료 보고서 수는 재설정되지 않습니다. 모두 지우기는 남은 익명 개수를 제거합니다."
          }
        }
      }
    },
