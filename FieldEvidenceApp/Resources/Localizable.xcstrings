    "v30.service-request.pdf-handoff-available": {
      "comment": "Screen: Service request. Meaning: Explains pdf handoff available in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A customer-safe status artifact is supplied for the existing handoff route. It does not claim delivery, receipt, reading, identity verification, approval, or a service outcome."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se proporcionó un documento de estado apto para el cliente para la vía de transferencia existente. No confirma entrega, recepción, lectura, verificación de identidad, aprobación ni un resultado del servicio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已为现有交付途径提供适合客户查看的状态文件。这不表示已交付、已收到、已阅读、身份已验证、已批准或已取得服务结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已為現有交接途徑提供適合客戶查看的狀態檔案。這不代表已交付、已收到、已閱讀、身分已驗證、已核准或已達成服務成果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã cung cấp tài liệu trạng thái phù hợp cho khách hàng qua luồng bàn giao hiện có. Điều này không khẳng định đã giao, đã nhận, đã đọc, đã xác minh danh tính, đã phê duyệt hay đã đạt kết quả dịch vụ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기존 전달 경로에 사용할 수 있는 고객 공개용 상태 자료가 제공되었습니다. 전달, 수신, 열람, 신원 확인, 승인 또는 서비스 결과를 의미하지 않습니다."
          }
        }
      }
