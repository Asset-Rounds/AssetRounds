    "v30.parts-stock.review-return-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the review return hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the quantity field for a Return bound to this exact prior Use. It is not a standalone Return."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre el campo de cantidad para una Devolución vinculada a este Uso previo exacto. No es una Devolución independiente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开与此前精确“使用”绑定的“退回”数量字段。它不是独立的“退回”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開啟綁定此精確先前使用記錄之退回的數量欄位。它不是獨立退回。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở trường số lượng cho một Hoàn trả gắn với lần Sử dụng chính xác trước đó này. Đây không phải là Hoàn trả độc lập."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 정확한 이전 사용에 연결된 반품의 수량 필드를 엽니다. 독립된 반품이 아닙니다."
          }
        }
      }
    },
    "v30.parts-stock.scan-code": {
      "comment": "Screen: Parts & Stock. Meaning: Names the scan code action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Parts & Stock button title state; no screenshot is claimed.",
