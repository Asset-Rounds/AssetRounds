    "v30.recipient-review.preview-unavailable": {
      "comment": "Screen: Recipient review. Meaning: Explains preview unavailable in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview write status is unavailable; do not accept or apply until a fresh zero-write preview is supplied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El estado de escritura de vista previa no está disponible; no acepte ni aplique hasta que se proporcione una nueva vista previa sin escrituras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "预览写入状态不可用；在提供新的零写入预览前，请勿接受或应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "預覽寫入狀態不可用；在提供新的零寫入預覽前，請勿接受或套用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trạng thái ghi của bản xem trước không khả dụng; không chấp nhận hay áp dụng cho đến khi có bản xem trước mới không ghi dữ liệu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "미리보기 쓰기 상태를 사용할 수 없습니다. 새 쓰기 0 미리보기가 제공될 때까지 승인하거나 적용하지 마세요."
          }
        }
      }
