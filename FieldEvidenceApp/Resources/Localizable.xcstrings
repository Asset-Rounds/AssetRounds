    "v30.incumbent-file-adapter.profile-description": {
      "comment": "Screen: Data & Portability. Meaning: Explains profile description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Data & Portability body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This token identifies the configured profile only. It does not establish a provider account, connection, acceptance, delivery, security, or success."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este token identifica solo el perfil configurado. No establece una cuenta de proveedor, conexión, aceptación, entrega, seguridad ni éxito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
