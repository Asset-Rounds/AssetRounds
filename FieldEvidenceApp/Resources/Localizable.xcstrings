    "v30.rating-support.rate-hint": {
      "comment": "Screen: Rating and support. Meaning: Guides use of the rate hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Rating and support accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests the verified App Store rating page. The app does not know whether a rating or review is made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicita la página verificada de calificaciones del App Store. La app no sabe si se publica una calificación o reseña."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求打开已验证的 App Store 评分页面。应用无法得知用户是否评分或发表评论。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要求開啟經驗證的 App Store 評分頁面。App 無法得知是否有人評分或撰寫評論。"
          }
        },
        "vi": {
          "stringUnit": {
