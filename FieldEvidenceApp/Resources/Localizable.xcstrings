    "v30.report-detail.detail.report.retry": {
      "comment": "Screen: Report detail. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Report detail rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correction saved, but its PDF couldn’t be created. Retry from the saved report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se guardó la corrección, pero no se pudo crear su PDF. Vuelva a intentarlo desde el informe guardado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更正已保存，但无法创建其 PDF。请从已保存的报告重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
