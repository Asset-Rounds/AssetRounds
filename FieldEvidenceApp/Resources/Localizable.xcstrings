    "evidence.quality.coach.introduction": {
      "comment": "C10 truthful review scope.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review each recorded warning and choose a next step. This review does not change any requirement outcome."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revise cada advertencia registrada y elija el siguiente paso. Esta revisión no cambia el resultado de ningún requisito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请查看每项已记录的警告并选择下一步。此审核不会更改任何要求的结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請審閱每項已記錄的警告，再選擇下一步。本次審閱不會變更任何要求的結果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xem từng cảnh báo đã ghi nhận và chọn bước tiếp theo. Việc xem xét này không thay đổi kết quả của bất kỳ yêu cầu nào."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기록된 각 경고를 검토하고 다음 단계를 선택하세요. 이 검토는 요구 사항의 결과를 변경하지 않습니다."
          }
        }
      }
    },
    "evidence.quality.coach.limitation.heading": {
      "localizations": {
