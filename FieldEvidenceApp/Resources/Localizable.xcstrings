    "v30.paywall.renewal": {
      "comment": "Screen: PaywallView. Meaning: Explains recurring renewal price and duration when no trial is shown. Role: visible subscription-offer detail. Arguments: price: String, formattedPresentation, one value; duration: String, formattedPresentation, one value. Plural/select: none. Accessibility: Visible paywall text is read in normal VoiceOver traversal. Screenshot: Concrete visible subscription-offer detail state on this screen; descriptive context only and not a screenshot-evidence claim.",
