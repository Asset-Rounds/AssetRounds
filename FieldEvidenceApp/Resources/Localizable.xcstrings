    "v30.advanced-recurrence.reduce-motion-description": {
      "comment": "Screen: Advanced recurrence. Meaning: Explains reduce motion description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Advanced recurrence body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Motion is on. State changes are presented without added animation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reducir movimiento está activado. Los cambios de estado se presentan sin animación adicional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“减少动态效果”已开启。状态变更不会附加动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「減少動態效果」已開啟。狀態變更不會加入動畫。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giảm chuyển động đang bật. Các thay đổi trạng thái được trình bày không kèm hoạt ảnh bổ sung."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "동작 줄이기가 켜져 있습니다. 상태 변경은 추가 애니메이션 없이 표시됩니다."
          }
        }
      }
    },
    "v30.advanced-recurrence.reminder-description": {
      "comment": "Screen: Advanced recurrence. Meaning: Explains reminder description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Advanced recurrence body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A projection does not mean a reminder has been set. Reconciliation is available only through a supplied command and its owner receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una proyección no significa que se haya establecido un recordatorio. La conciliación está disponible solo mediante un comando proporcionado y el recibo de su propietario."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "投影并不表示已设置提醒。只有通过提供的命令及其负责方回执才能进行协调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "投影不代表已設定提醒。只能透過提供的命令及其擁有者回執進行對帳。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản chiếu không có nghĩa là lời nhắc đã được đặt. Chỉ có thể đối chiếu qua lệnh được cung cấp và biên nhận của chủ sở hữu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "조회는 알림이 설정되었음을 의미하지 않습니다. 조정은 제공된 명령과 그 소유자 처리 확인서를 통해서만 가능합니다."
          }
        }
      }
    },
    "v30.advanced-recurrence.reminder-heading": {
      "comment": "Screen: Advanced recurrence. Meaning: Names the reminder heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Advanced recurrence section heading state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder projection"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proyección de recordatorio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提醒投影"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提醒投影"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản chiếu lời nhắc"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "알림 조회용 데이터"
          }
        }
      }
    },
    "v30.advanced-recurrence.reminder-reconciled": {
      "comment": "Screen: Advanced recurrence. Meaning: Reports reminder reconciled to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Advanced recurrence operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder reconciliation returned a projection. This view does not claim that a reminder was set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conciliación de recordatorios devolvió una proyección. Esta vista no afirma que se haya establecido un recordatorio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提醒协调返回了投影。此视图不声称已设置提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提醒協調傳回投影。此畫面不聲稱已設定提醒。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đối soát lời nhắc trả về một bản chiếu. Chế độ xem này không tuyên bố rằng lời nhắc đã được đặt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "알림 조정이 조회용 데이터를 반환했습니다. 이 보기는 알림이 설정되었다고 주장하지 않습니다."
          }
        }
