    "v30.rating-support.heading-description": {
      "comment": "Screen: Rating and support. Meaning: Explains heading description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Rating and support body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support and recovery are always available. Rating choices are separate and optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El soporte y la recuperación siempre están disponibles. Las opciones de calificación son independientes y opcionales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "支持与恢复始终可用。评分选项独立且可选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "支援與復原隨時可用。評分選項獨立且可自由選擇。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hỗ trợ và khôi phục luôn khả dụng. Lựa chọn đánh giá ứng dụng là riêng biệt và không bắt buộc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지원 및 복구는 항상 사용할 수 있습니다. 평가 선택은 별개이며 선택 사항입니다."
          }
        }
      }
    },
    "v30.rating-support.help-description": {
      "comment": "Screen: Rating and support. Meaning: Explains help description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Rating and support body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact Support or open Recovery at any time. Neither action depends on rating eligibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Contacte con soporte o abra Recuperación en cualquier momento. Ninguna acción depende de la elegibilidad de calificación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "随时联系支持或打开恢复。两项操作均不依赖评分资格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隨時聯絡支援或開啟復原。兩項操作都不取決於評分資格。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liên hệ Hỗ trợ hoặc mở Khôi phục bất kỳ lúc nào. Không thao tác nào phụ thuộc vào điều kiện đủ để xếp hạng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "언제든 지원팀에 문의하거나 복구를 열 수 있습니다. 어느 작업도 평가 자격에 좌우되지 않습니다."
          }
        }
