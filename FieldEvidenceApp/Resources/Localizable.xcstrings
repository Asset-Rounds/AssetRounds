        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando esté habilitado para espacios de trabajo reales seleccionados, el descubrimiento privado en el dispositivo puede ofrecer accesos directos aprobados de solo lectura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为所选真实工作区启用后，设备端私密发现功能可提供已批准的只读快捷方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
