      }
    },
    "v30.my-day.reconciliation-description": {
      "comment": "Screen: My Day. Meaning: Explains reconciliation description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completion, cancellation, and reopen are reconciled from existing canonical sources. This contained surface does not alter schedule truth, create a route engine, send notifications, dispatch work, or write telemetry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La finalización, la cancelación y la reapertura se concilian a partir de fuentes canónicas existentes. Esta superficie contenida no altera la verdad de programación, crea un motor de rutas, envía notificaciones, asigna trabajo ni escribe telemetría."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完成、取消和重新打开均根据现有规范来源协调。此受限界面不会改变计划事实、创建路线引擎、发送通知、派发工作或写入遥测数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完成、取消與重新開啟會依現有標準來源協調。此受限介面不會更改排程事實、建立路由引擎、傳送通知、派送工作或寫入遙測資料。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoàn tất, hủy và mở lại được đối chiếu từ các nguồn bản ghi chuẩn hiện có. Bề mặt giới hạn này không thay đổi sự thật về lịch trình, tạo công cụ định tuyến, gửi thông báo, điều phối công việc hoặc ghi dữ liệu đo từ xa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "완료, 취소 및 재개는 기존 기준 소스에서 조정됩니다. 이 제한된 화면은 일정 사실을 변경하거나, 경로 엔진을 만들거나, 알림을 보내거나, 작업을 배정하거나, 원격 측정을 기록하지 않습니다."
          }
        }
      }
    },
