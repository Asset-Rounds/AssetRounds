    "v30.voice-capture.unmatched-segments": {
      "comment": "Screen: Voice capture. Meaning: Unmatched transcript segment count. Role: visible warning. Arguments: count Int aggregateCount x1. Plural/select: one/other for count. Accessibility: Read in Transcript.. Screenshot: Voice capture visible state.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transcript segment needs manual handling. No value is inferred for an unmatched segment."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transcript segments need manual handling. No value is inferred for an unmatched segment."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld segmento de transcripción necesita manejo manual. No se infiere ningún valor para un segmento sin coincidencia."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld segmentos de transcripción necesitan manejo manual. No se infiere ningún valor para un segmento sin coincidencia."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld 个转录片段需要人工处理。对于未匹配片段，不推断任何值。"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld 個逐字稿片段需要手動處理。對於不相符的片段不會推斷任何值。"
                }
              }
            }
          }
        },
        "vi": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld phân đoạn bản chép lời cần xử lý thủ công. Không suy diễn giá trị cho các phân đoạn không khớp."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld개의 대화록 세그먼트는 수동 처리가 필요합니다. 일치하지 않는 세그먼트에 대해 값이 추론되지 않습니다."
                }
              }
            }
          }
        }
      }
    },
