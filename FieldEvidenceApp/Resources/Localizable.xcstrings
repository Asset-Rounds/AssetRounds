    "v30.service-request.status-artifact-description": {
      "comment": "Screen: Service request. Meaning: Explains status artifact description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This supplied status artifact does not verify the requester, contact, urgency, delivery, dispatch, work completion, or service result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este documento de estado proporcionado no verifica al solicitante, el contacto, la urgencia, la entrega, el despacho, la finalización del trabajo ni el resultado del servicio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此提供的状态文件不验证请求方、联系方式、紧急程度、交付、派工、工作完成或服务结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此提供的狀態檔案不驗證請求人、聯絡方式、急迫程度、交付、派工、工作完成或服務結果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tài liệu trạng thái được cung cấp này không xác minh người yêu cầu, người liên hệ, mức khẩn cấp, chuyển giao, điều phối, hoàn thành công việc hay kết quả dịch vụ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 이 상태 자료는 요청자, 연락처, 긴급도, 전달, 출동, 작업 완료 또는 서비스 결과를 검증하지 않습니다."
          }
        }
      }
    },
