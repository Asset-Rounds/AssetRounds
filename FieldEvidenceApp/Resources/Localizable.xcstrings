    "v30.parts-stock.work-entry-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains work entry description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible path: Work → Parts & Stock → catalog or search → item detail. Use and Return remain contextual actions in the supplied work/material lineage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruta visible: Trabajo → Piezas y existencias → catálogo o búsqueda → detalle del artículo. Usar y Devolver siguen siendo acciones contextuales dentro de la trazabilidad de trabajo y material proporcionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可见路径：工作 → 零件与库存 → 目录或搜索 → 项目详情。使用和退回仍为所提供工作/材料关联中的上下文操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可見路徑：工作 → 零件與庫存 → 目錄或搜尋 → 項目詳情。使用與退回仍是所提供工作／材料脈絡中的動作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đường dẫn hiển thị: Công việc → Linh kiện & Tồn kho → danh mục hoặc tìm kiếm → chi tiết mục. Sử dụng và Hoàn trả vẫn là thao tác theo ngữ cảnh trong chuỗi công việc/vật tư được cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "표시 경로: 작업 → 부품 및 재고 → 카탈로그 또는 검색 → 항목 세부 정보. 사용과 반납은 제공된 작업·자재 이력의 맥락에 따른 작업으로 유지됩니다."
          }
        }
      }
    },
