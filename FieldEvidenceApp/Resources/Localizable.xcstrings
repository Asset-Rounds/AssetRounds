    "v30.parts-stock.operation-cancelled": {
      "comment": "Screen: Parts & Stock. Meaning: Reports operation cancelled to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation makes no completion or stock-effect claim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cancelación no declara finalización ni efecto en el inventario."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "取消不声称完成或库存效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "取消不宣稱完成或庫存效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc hủy không tuyên bố hoàn tất hoặc ảnh hưởng đến kho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "취소는 완료 또는 재고 효과를 주장하지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.operation-failure": {
      "comment": "Screen: Parts & Stock. Meaning: Reports operation failure to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation did not produce a confirmed canonical effect. Review the error and reload before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La operación no produjo un efecto canónico confirmado. Revise el error y vuelva a cargar antes de reintentar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "操作未产生已确认的规范数据效果。请检查错误并重新加载后再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "操作未產生已確認的標準資料效果。請查看錯誤並重新載入後再重試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thao tác không tạo ra tác động đã xác nhận đối với dữ liệu chuẩn. Hãy xem lỗi và tải lại trước khi thử lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업에서 확인된 기준 데이터 반영 결과가 생성되지 않았습니다. 다시 시도하기 전에 오류를 검토하고 다시 불러오세요."
          }
        }
      }
    },
    "v30.parts-stock.operation-no-status": {
      "comment": "Screen: Parts & Stock. Meaning: Reports operation no status to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
