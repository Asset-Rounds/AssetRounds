    "v30.service-request.portable-description": {
      "comment": "Screen: Service request. Meaning: Explains portable description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portable data is supplied for review. This surface does not claim delivery, sender identity, portal access, monitoring, or a dispatch outcome."
