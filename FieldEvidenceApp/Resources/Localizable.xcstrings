    "v30.installation.workflow.optional.input.notice": {
      "comment": "Screen: Installation workflow screen. Meaning: Uses the English default “When a plan or scan is unavailable, use only the existing recorded manual fallback. Availability is not evidence that a plan or scan succeeded.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Installation workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a plan or scan is unavailable, use only the existing recorded manual fallback. Availability is not evidence that a plan or scan succeeded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando un plan o escaneo no esté disponible, use solo la alternativa manual registrada existente. La disponibilidad no demuestra que un plan o escaneo haya tenido éxito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "计划或扫描不可用时，只能使用现有已记录的手动备用方式。可用性不能证明计划或扫描已成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "計畫或掃描無法使用時，僅可使用既有且已記錄的手動替代方式。可用性不是計畫或掃描成功的證據。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi kế hoạch hoặc bản quét không khả dụng, chỉ sử dụng phương án thủ công thay thế đã được ghi nhận. Khả năng sử dụng không phải là bằng chứng cho thấy kế hoạch hoặc bản quét đã thành công."
          }
        },
        "ko": {
