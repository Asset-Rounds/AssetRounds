          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple 提供了已簽署的寬限期。存取權不會延續至該簽署日期之後。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple đã cung cấp thời gian gia hạn có chữ ký. Quyền truy cập không tiếp tục sau ngày đã ký đó."
          }
        },
        "ko": {
