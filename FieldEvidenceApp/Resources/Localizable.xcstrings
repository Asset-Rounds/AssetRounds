            "value": "Phiên bản đích nhập giọng nói"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음성 대상 개정본"
          }
        }
      }
    },
    "v30.voice-capture.time": {
      "comment": "Screen: Voice capture. Meaning: Elapsed, maximum, and remaining capture time. Role: visible countdown. Arguments: elapsed Int aggregateCount x1; maximum Int aggregateCount x1; remaining Int aggregateCount x1. Plural/select: independent English one/other catalog substitutions for maximum, remaining; other arguments are not plural selectors. Accessibility: Read by the active-capture countdown.. Screenshot: Voice capture visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture time: %1$lld of %#@maximum@; %#@remaining@"
          },
          "substitutions": {
            "maximum": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg second"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg seconds"
                    }
                  }
                }
              }
            },
            "remaining": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg second remaining"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg seconds remaining"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiempo de captura: %1$lld de %#@maximum@; %#@remaining@"
          },
          "substitutions": {
            "maximum": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%arg segundo"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%arg segundos"
                    }
                  }
                }
              }
            },
            "remaining": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%arg segundo restante"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%arg segundos restantes"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
