    "v30.party.contact.workflow.contact.retirement.confirmation": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Uses the English default “Contact retirement is reversible only through a separately supplied reactivation preview. Confirming requests the supplied canonical action; it does not claim completion.”. Role: button label. Arguments: none. Plural/select: none. Accessibility: SwiftUI exposes it as the button label. Screenshot: Party/contact/Site-role workflow screen. state where this button label is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact retirement is reversible only through a separately supplied reactivation preview. Confirming requests the supplied canonical action; it does not claim completion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El retiro de contacto es reversible solo mediante una vista previa de reactivación proporcionada por separado. Confirmar solicita la acción canónica proporcionada; no declara finalización."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "联系人停用只能通过单独提供的重新激活预览撤销。确认会请求提供的规范操作；它不声称完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "聯絡人停用僅能透過另行提供的重新啟用預覽還原。確認會要求提供的標準操作；不宣稱已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ngừng sử dụng liên hệ chỉ có thể đảo ngược qua bản xem trước kích hoạt lại được cung cấp riêng. Xác nhận sẽ yêu cầu hành động bản ghi chuẩn đã cung cấp; không tuyên bố hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연락처 폐기는 별도로 제공된 재활성화 미리보기를 통해서만 되돌릴 수 있습니다. 확인하면 제공된 기준 작업을 요청할 뿐, 완료를 주장하지 않습니다."
          }
        }
      }
    },
