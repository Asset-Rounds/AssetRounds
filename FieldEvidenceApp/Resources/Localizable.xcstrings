    "v30.signoff.enrollment.record.approval.response.hint": {
      "comment": "Screen: Signoff response enrollment screen. Meaning: Uses the English default “Records your self-asserted response after required fields are valid. It does not verify identity or approval.”. Role: VoiceOver hint. Arguments: none. Plural/select: none. Accessibility: The call is assigned directly as the accessibility hint. Screenshot: Signoff response enrollment screen. state where this VoiceOver hint is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records your self-asserted response after required fields are valid. It does not verify identity or approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registra su respuesta autoafirmada después de que los campos obligatorios sean válidos. No verifica identidad ni aprobación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在必填字段有效后记录您自行声明的响应。它不验证身份或批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "必要欄位有效後記錄您自行聲明的回覆，不驗證身分或核准狀態。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ghi phản hồi do bạn tự xác nhận sau khi các trường bắt buộc hợp lệ. Điều này không xác minh danh tính hoặc phê duyệt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "필수 필드가 유효한 후 직접 주장한 응답을 기록합니다. 신원이나 승인을 검증하지 않습니다."
          }
        }
      }
    },
