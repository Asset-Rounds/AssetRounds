      "comment": "Screen: Party/contact/Site-role import screen. Meaning: Uses the English default “Preview only means that no canonical state has been written. A commit is explicit and uses one synthetic aggregate row and one canonical workspace command.”. Role: visible explanatory Text. Arguments: none. Plural/select: none. Accessibility: This visible explanatory Text is available in normal VoiceOver traversal. Screenshot: Party/contact/Site-role import screen. state where this visible explanatory Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview only means that no canonical state has been written. A commit is explicit and uses one synthetic aggregate row and one canonical workspace command."
          }
        }
      }
    },
    "v30.asset.import.validated.preview": {
      "comment": "Screen: PartyContactSiteRoleImportView. Meaning: States the validated preview row/command counts and atomicity state. Role: visible preview-success label. Arguments: rowCount: Int, aggregateCount, one aggregate count; commandCount: Int, aggregateCount, one aggregate count; atomicity: String, opaqueIdentifier, one value. Plural/select: independent English one/other catalog substitutions for rowCount, commandCount; other arguments are not plural selectors. Accessibility: The Label is exposed as one combined VoiceOver element. Screenshot: Concrete visible preview-success label state on this screen; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validated %#@rowCount@, %#@commandCount@, %3$@"
          },
          "substitutions": {
            "rowCount": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg synthetic row"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg synthetic rows"
                    }
                  }
                }
              }
            },
            "commandCount": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg command"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg commands"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "v30.asset.import.value.accessibility": {
      "comment": "Screen: PartyContactSiteRoleImportView. Meaning: Speaks one exact import-binding label and value pair. Role: combined binding-value VoiceOver label. Arguments: label: String, formattedPresentation, one value; value: String, opaqueIdentifier, one value. Plural/select: none. Accessibility: Assigned directly to the combined binding value row. Screenshot: Concrete combined binding-value VoiceOver label state on this screen; descriptive context only and not a screenshot-evidence claim.",
