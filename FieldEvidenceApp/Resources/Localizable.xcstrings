    "v30.manual-work-resource.stock-actions-description": {
      "comment": "Screen: Manual work resources. Meaning: Explains stock actions description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Manual work resources body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use and Return require the supplied exact stock command. Return is linked to its accepted Use and cannot restore more than its remaining quantity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usar y Devolver requieren el comando exacto de existencias proporcionado. La devolución se vincula a su uso aceptado y no puede reponer más que la cantidad restante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用和退回需要提供的确切库存命令。退回关联到其已接受的使用记录，数量不得超过剩余可退数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用與退回需要提供的確切庫存命令。退回連結至其已接受的使用記錄，數量不得超過剩餘可退數量。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sử dụng và Hoàn trả yêu cầu lệnh tồn kho chính xác được cung cấp. Hoàn trả được liên kết với thao tác Sử dụng đã được chấp nhận và không thể khôi phục nhiều hơn số lượng còn lại của thao tác đó."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사용과 반납에는 제공된 정확한 재고 명령이 필요합니다. 반납은 수락된 사용 건에 연결되며 해당 건의 남은 수량보다 많이 복원할 수 없습니다."
          }
        }
      }
    },
