    "v30.feedback.feedback.label2": {
      "comment": "Screen: Feedback. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Feedback rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message stays editable. Only app version, build, device model, and iOS version are prefilled; customer and inspection content is never prefilled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su mensaje sigue siendo editable. Solo se completan previamente la versión de la app, compilación, modelo del dispositivo y versión de iOS; nunca se completa previamente contenido de clientes o inspecciones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您的消息仍可编辑。仅预填应用版本、构建号、设备型号和 iOS 版本；绝不预填客户或检查内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您的訊息仍可編輯。僅預填 App 版本、組建版本、裝置型號及 iOS 版本；絕不預填客戶與檢查內容。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn vẫn có thể chỉnh sửa thông điệp. Chỉ phiên bản ứng dụng, số bản dựng, mẫu thiết bị và phiên bản iOS được điền sẵn; không bao giờ điền sẵn nội dung về khách hàng và kiểm tra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메시지는 계속 편집할 수 있습니다. 앱 버전, 빌드, 기기 모델 및 iOS 버전만 미리 입력되며 고객 및 점검 콘텐츠는 미리 입력되지 않습니다."
          }
        }
      }
    },
    "v30.feedback.feedback.label3": {
      "comment": "Screen: Feedback. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Feedback rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback composer cancelled. No delivery was claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se canceló el editor de comentarios. No se declaró ninguna entrega."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "反馈编辑器已取消。未声明已交付。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
