    "v30.voice-capture.retry-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the retry hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retries only after the caller reports a current valid capture context. Manual entry remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reintenta solo después de que el componente solicitante informe un contexto de captura actual y válido. La entrada manual sigue disponible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在调用方报告当前有效的采集上下文后重试。仍可手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅在呼叫端回報目前有效的擷取脈絡後重試。手動輸入仍可使用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ thử lại sau khi bên gọi báo ngữ cảnh thu thập hiện tại hợp lệ. Vẫn có thể nhập thủ công."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호출 측이 현재 유효한 수집 맥락을 알린 후에만 다시 시도합니다. 수동 입력은 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "v30.voice-capture.retry-requested": {
      "comment": "Screen: Voice capture. Meaning: Reports retry requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry requested. The caller must re-check permission, lifecycle generations, target revision, and scratch state; no effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó reintentar. El componente solicitante debe volver a verificar el permiso, las generaciones del ciclo de vida, la revisión de destino y el estado de los datos temporales; no se confirma ningún efecto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求重试。调用方必须重新检查权限、生命周期代次、目标修订版和临时数据状态；不声称产生了效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求重試。呼叫端必須重新檢查權限、生命週期世代、目標修訂版與暫存狀態；不聲稱已產生效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu thử lại. Bên gọi phải kiểm tra lại quyền, các thế hệ vòng đời, bản sửa đổi đích và trạng thái dữ liệu tạm; không khẳng định có tác động."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재시도가 요청되었습니다. 호출 측은 권한, 수명 주기 세대, 대상 개정본 및 임시 상태를 다시 확인해야 하며 변경이 반영되었다고 볼 수 없습니다."
          }
        }
      }
    },
