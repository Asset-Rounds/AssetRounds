    "v30.diagnostics.photo.label": {
      "comment": "Screen: Diagnostics export. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Diagnostics export rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export includes only app and device versions, local counters, and bounded system metrics when available. It never includes customer or sign details, addresses, notes, photos, reports, backups, paths, hashes, StoreKit details, credentials, or logs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La exportación incluye solo versiones de la app y del dispositivo, contadores locales y métricas limitadas del sistema cuando están disponibles. Nunca incluye datos de clientes o letreros, direcciones, notas, fotos, informes, copias de seguridad, rutas, hashes, detalles de StoreKit, credenciales ni registros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "导出仅包含应用和设备版本、本地计数器及可用时的有限系统指标。绝不包含客户或标牌详情、地址、备注、照片、报告、备份、路径、哈希、StoreKit 详情、凭据或日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "匯出僅包含 App 與裝置版本、本機計數器，以及可取得時的有限系統指標。絕不包含客戶或標牌詳情、地址、備註、照片、報告、備份、路徑、雜湊、StoreKit 詳情、憑證或記錄檔。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dữ liệu xuất chỉ gồm phiên bản ứng dụng và thiết bị, bộ đếm cục bộ cùng chỉ số hệ thống có giới hạn khi có sẵn. Không bao giờ gồm chi tiết khách hàng hoặc biển hiệu, địa chỉ, ghi chú, ảnh, báo cáo, bản sao lưu, đường dẫn, giá trị băm, chi tiết StoreKit, thông tin xác thực hay nhật ký."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "내보내기에는 앱 및 기기 버전, 로컬 카운터와 사용 가능한 경우 제한된 시스템 지표만 포함됩니다. 고객 또는 간판 정보, 주소, 메모, 사진, 보고서, 백업, 경로, 해시, StoreKit 정보, 자격 증명 또는 로그는 포함되지 않습니다."
          }
        }
      }
    },
    "v30.erase-all.all.backup.label": {
      "comment": "Screen: Erase local data. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Erase local data rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not cancel your Apple subscription. Backups saved outside this app are not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto no cancela su suscripción de Apple. Las copias de seguridad guardadas fuera de esta app no se eliminan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这不会取消您的 Apple 订阅。保存在此应用之外的备份不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這不會取消您的 Apple 訂閱。儲存在此 App 以外的備份不會被刪除。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc này không hủy đăng ký Apple của bạn. Các bản sao lưu bên ngoài ứng dụng này không bị xóa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업은 Apple 구독을 취소하지 않습니다. 앱 외부에 저장된 백업은 삭제되지 않습니다."
          }
        }
      }
    },
