    "v30.advanced-recurrence.preview-commit-description": {
      "comment": "Screen: Advanced recurrence. Meaning: Explains preview commit description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Advanced recurrence body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview remains zero-write. Commit only with a separately supplied canonical command that carries this preview and frontier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vista previa permanece sin escrituras. Confirme solo con un comando canónico proporcionado por separado que incluya esta vista previa y límite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "预览保持零写入。仅使用另行提供、携带此预览和前沿的规范命令提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "預覽維持零寫入。僅可使用另行提供且攜帶此預覽及前沿的標準命令提交。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xem trước vẫn không ghi dữ liệu. Chỉ ghi chính thức bằng một lệnh chuẩn được cung cấp riêng có chứa bản xem trước này và mốc thao tác mới nhất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "미리보기는 쓰기 0을 유지합니다. 이 미리보기와 프런티어를 포함한 별도 제공 기준 명령으로만 확정 저장하세요."
          }
        }
      }
    },
    "v30.advanced-recurrence.preview-description": {
      "comment": "Screen: Advanced recurrence. Meaning: Explains preview description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Advanced recurrence body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
