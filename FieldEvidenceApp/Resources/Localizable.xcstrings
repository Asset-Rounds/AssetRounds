        }
      }
    },
    "operational_contact.handoff.claim_boundary": {
      "comment": "C46 truthful platform-outcome boundary.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff does not confirm a call connected, a message or email was sent or delivered, or that anyone arrived."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La transferencia no confirma que se conectó una llamada, que se envió o entregó un mensaje o correo electrónico, ni que alguien llegó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "移交不确认电话已接通、消息或电子邮件已发送或交付，也不确认任何人已到达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "交接不確認通話已接通、訊息或電子郵件已傳送或交付，或任何人已到達。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chuyển giao không xác nhận cuộc gọi đã kết nối, tin nhắn hoặc email đã được gửi hay chuyển phát, hoặc bất kỳ ai đã đến."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "전달은 통화 연결, 메시지 또는 이메일의 전송이나 배달, 또는 누군가의 도착을 확인하지 않습니다."
          }
        }
      }
    },
