    "v30.service-request.no-duplicates": {
      "comment": "Screen: Service request. Meaning: Explains no duplicates in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No supplied duplicate suggestions are available. This is not a uniqueness, search, or monitoring claim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay sugerencias duplicadas proporcionadas disponibles. Esto no es una declaración de unicidad, búsqueda ni supervisión."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有提供重复建议。这不是唯一性、搜索或监控声明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
