    "v30.signoff.enrollment.drawn.mark.notice": {
      "comment": "Screen: Signoff response enrollment screen. Meaning: Uses the English default “You may leave this blank. A drawn mark is not required, is not biometric, is not identity proof, and is not stored as a copy.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Signoff response enrollment screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may leave this blank. A drawn mark is not required, is not biometric, is not identity proof, and is not stored as a copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puede dejar esto en blanco. No se requiere una marca dibujada; no es biométrica, no prueba identidad y no se almacena como copia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您可以留空。手绘标记不是必填项，不属于生物特征，不构成身份证明，也不会作为副本存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您可以留白。手繪記號並非必要，不屬於生物辨識、不構成身分證明，也不會儲存為副本。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn có thể để trống mục này. Dấu vẽ không bắt buộc, không phải dữ liệu sinh trắc học, không phải bằng chứng danh tính và không được lưu thành bản sao."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 항목은 비워 둘 수 있습니다. 직접 그리는 표시는 필수가 아니며 생체 정보나 신원 증거가 아니고 사본으로 저장되지 않습니다."
          }
        }
      }
    },
