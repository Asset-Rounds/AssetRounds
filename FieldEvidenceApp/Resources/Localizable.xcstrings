    "v30.manual-work-resource.output-boundary": {
      "comment": "Screen: Manual work resources. Meaning: Explains output boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Manual work resources body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a timer, inventory balance, invoice, tax, payroll, estimate, price authority, or accounting result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto no es un temporizador, saldo de inventario, factura, impuesto, nómina, estimación, autoridad de precios ni resultado contable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这不是计时器、库存余额、发票、税务、工资、估价、价格授权依据或会计结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這不是計時器、庫存餘額、發票、稅務、薪資、估價、價格授權依據或會計結果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây không phải là bộ đếm thời gian, số dư tồn kho, hóa đơn, thuế, bảng lương, dự toán, căn cứ giá có thẩm quyền hay kết quả kế toán."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "타이머, 재고 잔량, 송장, 세금, 급여, 견적, 공식 가격 근거 또는 회계 결과가 아닙니다."
          }
        }
      }
    },
    "v30.manual-work-resource.output-description": {
      "comment": "Screen: Manual work resources. Meaning: Explains output description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Manual work resources body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The output projects the supplied canonical manual record. Compatible values are shown exactly; mixed units or currencies are not silently totalled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El resultado presenta el registro manual canónico proporcionado. Los valores compatibles se muestran de forma exacta; no se suman silenciosamente unidades ni monedas diferentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输出投影所提供的规范手动记录。兼容值会精确显示；不会默默合计不同单位或货币。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸出投影提供的標準手動記錄。相容的值會精確顯示；不同單位或幣別不會被默默加總。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đầu ra là bản chiếu của bản ghi thủ công chuẩn được cung cấp. Giá trị tương thích được hiển thị chính xác; không âm thầm cộng các đơn vị hoặc tiền tệ khác nhau."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "출력은 제공된 기준 수동 기록을 조회용 데이터로 표시합니다. 호환되는 값은 정확히 표시되며 서로 다른 단위나 통화를 알리지 않고 합산하지 않습니다."
          }
        }
      }
    },
