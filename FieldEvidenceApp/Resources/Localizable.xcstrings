    "v30.parts-stock.write-stale": {
      "comment": "Screen: Parts & Stock. Meaning: Reports write stale to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
