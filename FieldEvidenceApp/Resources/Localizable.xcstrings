    "v30.parts-stock.return-requested": {
      "comment": "Screen: Parts & Stock. Meaning: Requested return destination. Role: operation status. Arguments: destination String formattedPresentation x1. Plural/select: none. Accessibility: Read after Return request.. Screenshot: Parts & Stock visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested a Return against the selected prior Use to %@. The canonical owner must verify the ordered frontier; no return effect is claimed yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó una devolución contra el Uso anterior seleccionado a %@. El propietario canónico debe verificar la frontera ordenada; aún no se afirma ningún efecto de devolución."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求对所选先前“使用”向 %@ 执行“退回”。规范所有者必须验证有序前沿；尚不声称有退回影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求依所選先前使用記錄退回至 %@。標準資料負責方必須驗證有序前緣；尚不聲稱產生退回效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu Hoàn trả đối với lần Sử dụng trước đó đã chọn đến %@. Chủ sở hữu chuẩn phải xác minh biên giới có thứ tự; chưa tuyên bố hiệu lực hoàn trả."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 이전 사용에 대해 %@로 반품을 요청했습니다. 기준 소유자가 정렬된 프런티어를 검증해야 하며 아직 반품 효과는 주장되지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.returning": {
      "comment": "Screen: Parts & Stock. Meaning: Return destination and outstanding quantity. Role: visible return instruction. Arguments: destination String formattedPresentation x1; quantity String formattedPresentation x1. Plural/select: none. Accessibility: Read in return quantity editor.. Screenshot: Parts & Stock visible state.",
