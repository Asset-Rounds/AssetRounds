        }
      }
    },
    "v30.parts-stock.use-button-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the use button hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests the only stock-decrementing action in this surface. A durable canonical receipt must be supplied before any effect is shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicita la única acción que reduce existencias en esta superficie. Debe proporcionarse un recibo canónico duradero antes de mostrar cualquier efecto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求此界面中唯一会扣减库存的操作。在显示任何影响前，必须提供持久的规范回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要求此介面唯一會扣減庫存的動作。在顯示任何效果前，必須提供持久的標準回執。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu hành động duy nhất làm giảm tồn kho trong bề mặt này. Phải cung cấp biên nhận chuẩn bền vững trước khi hiển thị bất kỳ hiệu lực nào."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 화면에서 유일하게 재고를 감소시키는 작업을 요청합니다. 효과를 표시하기 전에 내구성 있는 기준 처리 확인서가 제공되어야 합니다."
          }
        }
      }
    },
    "v30.parts-stock.use-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains use description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use is explicit and contextual to this catalog item and supplied work/material line. The canonical owner must recheck the known source balance and work revision before decrementing stock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El uso es explícito y está vinculado a este artículo del catálogo y a la línea de trabajo o material proporcionada. El componente canónico responsable debe volver a verificar el saldo de origen conocido y la revisión del trabajo antes de descontar existencias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用操作必须明确，且关联到此目录项目及提供的工作/材料行。规范数据负责方必须重新检查已知来源余额和工作修订版后，再扣减库存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用動作須明確，並對應此目錄項目與提供的工作／材料列。標準資料負責方必須重新檢查已知來源餘額與工作修訂版後，才能扣減庫存。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thao tác Sử dụng phải được thực hiện chủ động và gắn với mục danh mục này cùng dòng công việc/vật tư được cung cấp. Bên quản lý dữ liệu chuẩn phải kiểm tra lại số dư nguồn đã biết và phiên bản công việc trước khi trừ tồn kho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사용은 명시적으로 요청되며 이 카탈로그 항목과 제공된 작업·자재 행의 맥락에 연결됩니다. 기준 데이터 담당 주체는 재고를 차감하기 전에 알려진 원본 잔량과 작업 개정본을 다시 확인해야 합니다."
          }
        }
      }
    },
