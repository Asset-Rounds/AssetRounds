    "v30.parts-stock.catalog-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains catalog description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalog definitions are Work-local. Select an item to review its supplied unit, product identities, balance projections, and explicit actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las definiciones del catálogo son locales al trabajo. Seleccione un elemento para revisar su unidad proporcionada, identidades de producto, proyecciones de saldo y acciones explícitas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目录定义仅限当前工作区本地。请选择项目，审核其提供的单位、产品标识、余额投影和明确操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目錄定義為工作本機定義。請選取項目以審核其提供的單位、產品識別、餘額投影與明確動作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các định nghĩa danh mục là cục bộ theo Công việc. Chọn một mục để xem xét đơn vị được cung cấp, danh tính sản phẩm, bản chiếu số dư và các thao tác rõ ràng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카탈로그 정의는 작업 로컬입니다. 항목을 선택하여 제공된 단위, 제품 신원, 잔액 조회용 데이터 및 명시적 작업을 검토하십시오."
          }
        }
      }
    },
