    "v30.manual-work-resource.stock-returned": {
      "comment": "Screen: Manual work resources. Meaning: Reports stock returned to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Manual work resources operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The explicit stock return and its work-material successor have durable receipts. Reload the canonical record to show their current state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La devolución explícita de existencias y su sucesor de material de trabajo tienen comprobantes duraderos. Vuelva a cargar el registro canónico para mostrar su estado actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明确的库存退回及其后续工作材料记录具有持久回执。请重新加载规范记录以显示其当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明確的庫存退回與後續工作材料記錄均有持久回執。請重新載入標準記錄以顯示目前狀態。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc trả kho rõ ràng và bản ghi vật tư công việc kế tiếp có biên nhận bền vững. Hãy tải lại bản ghi chuẩn để hiển thị trạng thái hiện tại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명시적인 재고 반납과 후속 작업 자재 기록에 영구 저장된 처리 확인서가 있습니다. 현재 상태를 표시하려면 기준 기록을 다시 불러오세요."
          }
        }
      }
    },
