    "v30.voice-capture.start-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the start hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts one explicit push-to-talk capture for at most 60 seconds. It does not continuously listen or use a wake word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia una captura explícita de pulsar para hablar de hasta 60 segundos. No escucha continuamente ni usa una palabra de activación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明确启动一次最长 60 秒的按键说话采集，不持续监听或使用唤醒词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明確啟動一次最長 60 秒的按鍵說話擷取，不會持續聆聽或使用喚醒詞。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chủ động bắt đầu một lần nhấn để nói, tối đa 60 giây. Không nghe liên tục hoặc dùng từ đánh thức."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사용자가 직접 눌러 말하는 수집을 최대 60초 동안 한 번 시작합니다. 계속 듣거나 호출어를 사용하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.start-requested": {
      "comment": "Screen: Voice capture. Meaning: Reports start requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak details requested. The caller must start explicit on-device capture; no microphone, transcript, or draft effect is claimed by this button press."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó Dictar detalles. El componente solicitante debe iniciar la captura explícita en el dispositivo; pulsar este botón no confirma ningún efecto en el micrófono, transcripción ni borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求说出详情。调用方必须明确启动设备端采集；按下此按钮不代表麦克风、转写文本或草稿产生了效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求口述詳情。呼叫端必須明確啟動裝置端擷取；按下此按鈕不代表麥克風、逐字稿或草稿已產生效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu nói chi tiết. Bên gọi phải chủ động bắt đầu thu thập trên thiết bị; việc nhấn nút này không khẳng định có tác động tới micrô, bản chép lời hoặc bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "세부 내용 말하기가 요청되었습니다. 호출 측이 명시적인 기기 내 수집을 시작해야 하며, 이 버튼을 눌렀다고 해서 마이크 사용, 전사문 생성 또는 초안 변경이 반영되었음을 의미하지는 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.start-unavailable": {
      "comment": "Screen: Voice capture. Meaning: Explains start unavailable in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak details is unavailable until a current capture context is supplied. Use the manual entry below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dictar detalles no está disponible hasta que se proporcione un contexto de captura actual. Use la entrada manual que aparece abajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供当前采集上下文后才能使用“说出详情”。请使用下方手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供目前擷取脈絡後，才能使用口述詳情。請使用下方的手動輸入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nói chi tiết chưa khả dụng cho đến khi có ngữ cảnh thu thập hiện tại. Hãy dùng phần nhập thủ công bên dưới."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "현재 수집 맥락이 제공될 때까지 세부 내용 말하기를 사용할 수 없습니다. 아래 수동 입력을 사용하세요."
          }
        }
      }
    },
