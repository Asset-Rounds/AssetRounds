    "v30.operational.handoff.truth.boundary": {
      "comment": "Screen: Operational contact handoff screen. Meaning: Uses the English default “Handed off to the system means only that iOS accepted presentation. It does not mean sent, delivered, called, answered, routed, arrived, verified, or consented.”. Role: stored visible status text. Arguments: none. Plural/select: none. Accessibility: The stored string supplies visible maintenance text at its later use. Screenshot: Operational contact handoff screen. state where this stored visible status text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed off to the system means only that iOS accepted presentation. It does not mean sent, delivered, called, answered, routed, arrived, verified, or consented."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transferido al sistema significa solo que iOS aceptó la presentación. No significa enviado, entregado, llamado, respondido, dirigido, llegado, verificado ni consentido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“已移交给系统”仅表示 iOS 已接受展示。它并不表示已发送、已交付、已呼叫、已接听、已路由、已到达、已验证或已同意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "交給系統僅表示 iOS 已接受呈現。它不表示已傳送、交付、通話、接聽、路由、到達、驗證或同意。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã chuyển cho hệ thống chỉ có nghĩa là iOS đã chấp nhận hiển thị. Điều đó không có nghĩa là đã gửi, đã chuyển phát, đã gọi, đã trả lời, đã định tuyến, đã đến, đã xác minh hoặc đã đồng ý."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템으로 전달됨은 iOS가 표시를 수락했음을 뜻할 뿐입니다. 전송, 배달, 통화, 응답, 라우팅, 도착, 확인 또는 동의를 뜻하지 않습니다."
          }
        }
      }
    },
