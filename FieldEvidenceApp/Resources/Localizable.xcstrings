    },
    "v30.voice-capture.edit-value-too-long": {
      "comment": "Screen: Voice capture. Meaning: Explains edit value too long in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edited value is too long for the bounded voice field. Use a shorter value or the manual draft path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este valor editado es demasiado largo para el campo de voz limitado. Use un valor más corto o la vía de borrador manual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此编辑值超出语音字段的长度限制。请使用较短内容或手动草稿途径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此編輯值超過語音欄位長度限制。請縮短內容或使用手動草稿途徑。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giá trị đã chỉnh sửa này quá dài so với giới hạn của trường nhập giọng nói. Hãy dùng giá trị ngắn hơn hoặc luồng bản nháp thủ công."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "편집한 값이 제한된 음성 입력 필드에 사용하기에는 너무 깁니다. 더 짧은 값이나 수동 초안 경로를 사용하세요."
          }
        }
      }
    },
    "v30.voice-capture.enter-edit-value": {
      "comment": "Screen: Voice capture. Meaning: Explains enter edit value in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a value before applying this edit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingrese un valor antes de aplicar esta edición."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入值后再应用此编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "套用此編輯前請輸入值。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập giá trị trước khi áp dụng chỉnh sửa này."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 편집을 적용하기 전에 값을 입력하세요."
          }
        }
      }
    },
    "v30.voice-capture.enter-manual-value": {
      "comment": "Screen: Voice capture. Meaning: Explains enter manual value in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a manual draft value or keep the existing typed text. No empty value was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingrese un valor de borrador manual o conserve el texto escrito existente. No se envió ningún valor vacío."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入手动草稿值或保留现有输入文本。未发送空值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入手動草稿值，或保留既有輸入文字。未傳送空值。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập giá trị bản nháp thủ công hoặc giữ văn bản đã nhập hiện có. Không gửi giá trị trống nào."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수동 초안 값을 입력하거나 기존 입력 텍스트를 유지하세요. 빈 값은 전송되지 않았습니다."
          }
        }
      }
    },
    "v30.voice-capture.existing-work-draft": {
      "comment": "Screen: Voice capture draft target. Meaning: Default presentation label for an existing draft when the caller supplies no authored label. Role: draft target value. Arguments: none. Plural/select: none. Accessibility: The draft summary row reads this label; an explicitly supplied source label is preserved. Screenshot: Voice capture with an existing draft and default label; no screenshot evidence claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing work draft"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Borrador de trabajo existente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "现有工作草稿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現有工作草稿"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản nháp công việc hiện có"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기존 작업 초안"
          }
        }
      }
    },
    "v30.voice-capture.fallback": {
      "comment": "Screen: Voice capture. Meaning: Fallback reason followed by manual-entry assurance. Role: visible recovery message. Arguments: reason String formattedPresentation x1. Plural/select: none. Accessibility: Read in Recovery.. Screenshot: Voice capture visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Manual entry remains complete; no transcript, proposal, or draft effect is inferred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ La entrada manual permanece completa; no se infiere ninguna transcripción, propuesta ni efecto en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 手动录入仍然完整；不推断任何转录、提案或草稿效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 手動輸入仍完整；不會推斷逐字稿、提案或草稿效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Mục nhập thủ công vẫn hoàn chỉnh; không suy diễn bản chép lời, đề xuất hoặc hiệu lực bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 수동 입력은 완전하게 유지되며, 대화록, 제안 또는 초안 효과는 추론되지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.fallback-manual": {
      "comment": "Screen: Voice capture. Meaning: Reports fallback manual to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice path returned to manual entry. No transcript or draft effect is inferred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vía de voz regresó a la entrada manual. No se infiere ninguna transcripción ni efecto en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "语音途径已返回手动输入。不推断转写文本或草稿产生了效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "語音途徑已返回手動輸入。不推斷逐字稿或草稿效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luồng nhập giọng nói đã quay lại nhập thủ công. Không suy ra bản chép lời hay tác động đến bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음성 경로가 수동 입력으로 돌아갔습니다. 전사문 생성이나 초안 반영 결과를 추정하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.fallback-offline": {
      "comment": "Screen: Voice capture. Meaning: Reports fallback offline to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture path has no network fallback. Continue with manual entry while the caller rechecks the local capability state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vía de captura no tiene alternativa de red. Continúe con la entrada manual mientras el componente solicitante vuelve a verificar el estado de las capacidades locales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "采集途径不提供网络回退方式。调用方重新检查本地功能状态期间，请继续手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "擷取途徑沒有網路備援。呼叫端重新檢查本機功能狀態時，請繼續手動輸入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luồng thu thập không có phương án mạng dự phòng. Hãy tiếp tục nhập thủ công trong khi bên gọi kiểm tra lại trạng thái chức năng cục bộ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수집 경로에는 네트워크 대체 수단이 없습니다. 호출 측이 로컬 기능 상태를 다시 확인하는 동안 수동 입력을 계속하세요."
          }
        }
      }
    },
    "v30.voice-capture.fallback-permission": {
      "comment": "Screen: Voice capture. Meaning: Reports fallback permission to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech access is unavailable. Manual entry below is complete and remains usable without another permission prompt or a network fallback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El acceso al reconocimiento de voz no está disponible. La entrada manual que aparece abajo está completa y puede usarse sin otra solicitud de permiso ni una alternativa de red."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "语音权限不可用。下方手动输入功能完整，无需再次请求权限或回退至网络也可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "語音權限無法使用。下方的手動輸入功能完整可用，無須再次要求權限或改用網路備援。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quyền giọng nói không khả dụng. Phần nhập thủ công bên dưới có đầy đủ chức năng và vẫn dùng được mà không cần hỏi quyền lần nữa hay dùng mạng dự phòng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음성 인식을 사용할 수 없습니다. 아래 수동 입력만으로도 모든 입력 기능을 사용할 수 있으며 추가 권한 요청이나 네트워크 대체 수단 없이 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "v30.voice-capture.fallback-ready": {
      "comment": "Screen: Voice capture. Meaning: Reports fallback ready to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Speak details only when you want one explicit utterance. The caller supplies the current lifecycle-fenced context and starts the 60-second on-device session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pulse Hablar detalles solo cuando quiera una expresión explícita. El llamador proporciona el contexto actual limitado por ciclo de vida e inicia la sesión de 60 segundos en el dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅当您需要一次明确的语音表达时，才按“朗读详细信息”。调用方提供当前受生命周期限制的上下文，并启动 60 秒设备端会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅在您想要一次明確發言時按「說明詳情」。呼叫端提供目前受生命週期限制的內容，並啟動 60 秒裝置端工作階段。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ nhấn Đọc chi tiết khi bạn muốn chủ động nhập một lượt nói. Bên gọi cung cấp ngữ cảnh hiện tại được giới hạn theo vòng đời và bắt đầu phiên trên thiết bị dài 60 giây."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명시적 발화를 원할 때만 세부 정보 말하기를 누르세요. 호출자가 현재 수명 주기 경계 컨텍스트를 제공하고 60초 기기 내 세션을 시작합니다."
          }
        }
      }
    },
    "v30.voice-capture.fallback-unsupported": {
      "comment": "Screen: Voice capture. Meaning: Reports fallback unsupported to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device or locale does not report the required on-device recognition capability. No cloud fallback is used; continue manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este dispositivo o configuración regional no informa la capacidad de reconocimiento en el dispositivo requerida. No se usa una alternativa en la nube; continúe manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此设备或语言区域未报告所需的设备端识别能力。不会回退至云端；请手动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此裝置或語言地區未回報所需的裝置端辨識功能。不使用雲端備援；請手動繼續。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thiết bị hoặc ngôn ngữ và vùng này không báo cáo khả năng nhận dạng trên thiết bị được yêu cầu. Không dùng phương án thay thế qua đám mây; hãy tiếp tục thủ công."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 기기 또는 로캘에서는 필요한 기기 내 인식 기능을 사용할 수 있다고 보고하지 않습니다. 클라우드 대체 수단을 사용하지 않으므로 수동으로 계속하세요."
          }
        }
      }
    },
    "v30.voice-capture.field": {
      "comment": "Screen: Voice capture. Meaning: Field position and proposed field label. Role: visible field heading. Arguments: position Int formattedPresentation x1; label String authoredSource x1. Plural/select: none. Accessibility: Read in Review each field.. Screenshot: Voice capture visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Field %lld: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Campo %lld: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "字段 %lld：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "欄位 %lld：%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trường %lld: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "필드 %lld: %@"
          }
        }
      }
    },
    "v30.voice-capture.field-id": {
      "comment": "Screen: Voice capture. Meaning: Names the field id value. Role: value-row label. Arguments: none. Plural/select: none. Accessibility: The combined row exposes this label with its value to VoiceOver. Screenshot: Voice capture value-row label state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Field ID"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ID de campo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "字段 ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "欄位 ID"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ID hiện trường"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "필드 ID"
          }
        }
      }
    },
    "v30.voice-capture.fields-description": {
      "comment": "Screen: Voice capture. Meaning: Explains fields description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each proposal is tied to an exact UTF-8 transcript span. Confidence is informational only and never decides correctness, verification, approval, or acceptance. Every field needs an explicit Accept, Edit, or Reject request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada propuesta está vinculada a un tramo exacto de transcripción UTF-8. La confianza es solo informativa y nunca decide corrección, verificación, aprobación ni aceptación. Cada campo necesita una solicitud explícita de Aceptar, Editar o Rechazar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每项建议均关联到精确的 UTF-8 文本范围。置信度仅供参考，绝不决定正确性、验证、批准或接受。每个字段均需要明确的接受、编辑或拒绝请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每項提案都繫結至確切 UTF-8 逐字稿範圍。信心僅供參考，絕不決定正確性、驗證、核准或接受。每個欄位都需要明確的接受、編輯或拒絕請求。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi đề xuất được gắn với chính xác một đoạn bản chép lời UTF-8. Độ tin cậy chỉ để thông tin và không bao giờ quyết định tính đúng đắn, xác minh, phê duyệt hoặc chấp nhận. Mỗi trường cần một yêu cầu Chấp nhận, Chỉnh sửa hoặc Từ chối rõ ràng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "각 제안은 정확한 UTF-8 기록문 범위에 연결됩니다. 신뢰도는 정보 제공용일 뿐 정확성, 검증, 승인 또는 수락을 결정하지 않습니다. 모든 필드는 명시적인 수락, 편집 또는 거부 요청이 필요합니다."
          }
        }
      }
    },
    "v30.voice-capture.fields-heading": {
      "comment": "Screen: Voice capture. Meaning: Names the fields heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Voice capture section heading state; no screenshot is claimed.",
