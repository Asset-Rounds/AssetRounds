    "v30.parts-stock.catalog-requested": {
      "comment": "Screen: Parts & Stock. Meaning: Explains catalog requested in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested the Parts & Stock catalog. No route-open or live-root adoption is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó el catálogo de Piezas y existencias. No se afirma apertura de ruta ni adopción de raíz activa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求零件和库存目录。不声称路由已打开或实时根已采纳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求零件與庫存目錄。不聲稱路由已開啟或已接入實際根畫面。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu danh mục Bộ phận & Tồn kho. Không tuyên bố mở tuyến hoặc tiếp nhận gốc trực tiếp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
