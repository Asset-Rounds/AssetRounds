    "v30.parts-stock.return-button-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the return button hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests a Return against the selected prior Use. It cannot create a free-form positive movement or exceed the outstanding quantity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicita una devolución contra el Uso anterior seleccionado. No puede crear un movimiento positivo de formato libre ni exceder la cantidad pendiente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求针对所选先前“使用”的退回。它不能创建自由形式的正向移动，也不能超过未结数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要求依所選先前使用記錄退回。無法自由建立正向庫存異動，也不能超過未退數量。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu Hoàn trả đối với lần Sử dụng trước đó đã chọn. Không thể tạo một biến động dương dạng tự do hoặc vượt quá số lượng còn lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 이전 사용에 대해 반품을 요청합니다. 자유 형식의 양수 이동을 만들거나 미결 수량을 초과할 수 없습니다."
          }
        }
      }
    },
    "v30.parts-stock.return-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains return description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return is bound to an eligible prior Use. Each candidate shows its outstanding quantity and destination; the canonical owner rejects stale, concurrent, duplicate, or overflow returns without a partial effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La devolución está vinculada a un uso anterior que cumple los requisitos. Cada candidato muestra su cantidad pendiente y destino; el componente canónico responsable rechaza devoluciones desactualizadas, simultáneas, duplicadas o excesivas sin efectos parciales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "退回绑定到符合条件的先前使用记录。每个候选项显示其未退数量和目标位置；规范数据负责方会拒绝过期、并发、重复或超量退回，不产生部分效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "退回綁定至符合條件的先前使用記錄。每個候選項目都顯示未退數量與目的地；標準資料負責方會拒絕過期、同時進行、重複或超量的退回，不產生部分效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc trả lại gắn với lần sử dụng trước đủ điều kiện. Mỗi lựa chọn hiển thị số lượng còn chưa trả và nơi nhận; bên quản lý dữ liệu chuẩn từ chối yêu cầu lỗi thời, đồng thời, trùng lặp hoặc vượt lượng mà không tạo tác động một phần."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "반납은 조건을 충족하는 이전 사용 건에 연결됩니다. 각 후보에는 남은 수량과 대상이 표시되며, 기준 데이터 담당 주체는 오래된 반납, 동시 반납, 중복 반납 또는 한도를 넘는 반납을 일부만 반영하지 않고 거부합니다."
          }
        }
      }
    },
    "v30.parts-stock.return-heading": {
      "comment": "Screen: Parts & Stock. Meaning: Names the return heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Parts & Stock section heading state; no screenshot is claimed.",
      "localizations": {
