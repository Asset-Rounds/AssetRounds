    "v30.receipt.p.d.f.not.ready.status": {
      "comment": "Screen: Check receipt. Meaning: provides the localized screen-specific label or explanatory guidance. Role: visible heading, label, or guidance. Arguments: none. Plural/select: none. Accessibility: no. Screenshot: Check receipt rendered state; no screenshot is asserted.",
