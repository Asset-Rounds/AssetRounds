    "v30.voice-capture.not-exact-proposal": {
      "comment": "Screen: Voice capture. Meaning: Explains not exact proposal in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This field is not an exact proposal. Edit it manually or reject it; no value was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este campo no es una propuesta exacta. Edítelo manualmente o rechácelo; no se envió ningún valor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此字段不是精确建议。请手动编辑或拒绝；未发送任何值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此欄位不是精確提案。請手動編輯或拒絕；未傳送任何值。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trường này không phải là đề xuất chính xác. Hãy chỉnh sửa thủ công hoặc từ chối; chưa gửi giá trị nào."
          }
        },
        "ko": {
          "stringUnit": {
