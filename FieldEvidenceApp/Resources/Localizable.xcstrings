    "v30.manual-work-resource.boundaries-description": {
      "comment": "Screen: Manual work resources. Meaning: Explains boundaries description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Manual work resources body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a command is interrupted or rejected, reload the canonical record before retrying. This screen never infers a partial save or stock effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si un comando se interrumpe o rechaza, vuelva a cargar el registro canónico antes de reintentar. Esta pantalla nunca infiere un guardado parcial ni efecto de inventario."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果命令被中断或拒绝，请在重试前重新加载规范记录。此屏幕绝不会推断部分保存或库存影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果命令中斷或被拒絕，請在重試前重新載入標準記錄。此畫面絕不推斷部分儲存或庫存效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nếu một lệnh bị gián đoạn hoặc từ chối, hãy tải lại bản ghi chuẩn trước khi thử lại. Màn hình này không suy ra việc lưu một phần hoặc ảnh hưởng đến tồn kho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명령이 중단되거나 거부되면 재시도 전에 기준 기록을 다시 로드하십시오. 이 화면은 부분 저장이나 재고 효과를 추론하지 않습니다."
          }
        }
      }
    },
