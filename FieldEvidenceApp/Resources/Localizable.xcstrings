    "v30.voice-capture.active-accessibility-value": {
      "comment": "Screen: Voice capture. Meaning: Conveys the current active accessibility value state. Role: accessibility value. Arguments: none. Plural/select: none. Accessibility: VoiceOver uses this exact text as the control value. Screenshot: Voice capture accessibility value state; no screenshot is claimed.",
