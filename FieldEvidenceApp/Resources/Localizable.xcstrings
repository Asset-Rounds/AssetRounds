    "v30.service-request.no-preview": {
      "comment": "Screen: Service request. Meaning: Explains no preview in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No resumable preview was supplied. No request record, work, contact, receipt, or delivery effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporcionó ninguna vista previa reanudable. No se declara registro de solicitud, trabajo, contacto, recibo ni efecto de entrega."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
