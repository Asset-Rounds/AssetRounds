    "illuminated.playbook.retake.disclosure": {
      "comment": "C03 immutable history disclosure.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A retake creates a new original. Prior evidence and finalized reports remain unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una nueva toma crea un original nuevo. La evidencia anterior y los informes finalizados permanecen sin cambios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重拍会创建新的原始记录。先前证据和已完成报告保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新拍攝會建立新的原始資料。先前的證據與已定稿報告維持不變。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chụp lại tạo một bản gốc mới. Bằng chứng trước đó và các báo cáo đã hoàn tất không thay đổi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재촬영하면 새 원본이 생성됩니다. 이전 증거와 확정된 보고서는 변경되지 않습니다."
          }
        }
      }
    },
