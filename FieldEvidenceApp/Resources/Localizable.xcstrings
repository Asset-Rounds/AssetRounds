    "lighting.day_inventory.claim_boundary": {
      "comment": "C17 observation-only claim boundary.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This inventory records visible conditions only. It is not photometry, an electrical diagnosis, an adequacy or commissioning determination, or proof of night performance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este inventario registra solo condiciones visibles. No es fotometría, un diagnóstico eléctrico, una determinación de idoneidad o puesta en marcha ni una prueba de rendimiento nocturno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此清单仅记录可见状况，不属于光度测量、电气诊断、适用性或调试判定，也不证明夜间表现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此清單僅記錄可見狀況，不屬於光度測量、電氣診斷、適足性或試運轉判定，也不是夜間表現的證明。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản kiểm kê này chỉ ghi nhận tình trạng nhìn thấy được. Đây không phải là phép đo quang, chẩn đoán điện, kết luận về mức độ đáp ứng hay nghiệm thu đưa vào sử dụng, hoặc bằng chứng về hiệu suất ban đêm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 목록은 눈으로 확인한 상태만 기록합니다. 광도 측정, 전기 진단, 적정성 또는 시운전 판정이나 야간 성능의 증거가 아닙니다."
          }
        }
      }
    },
    "lighting.day_inventory.daylight_caution": {
      "comment": "C17 cautious daylight observation boundary.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This daylight observation does not determine schedule, control operation, failure, or night performance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta observación diurna no determina la programación, el funcionamiento de controles, un fallo ni el rendimiento nocturno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此日间观察不能确定计划、控制运行、故障或夜间表现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此日間觀察不判定排程、控制運作、故障或夜間表現。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quan sát ban ngày này không xác định lịch, hoạt động điều khiển, hư hỏng hay hiệu suất ban đêm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 주간 관찰은 일정, 제어 작동, 고장 또는 야간 성능을 판정하지 않습니다."
          }
        }
      }
    },
    "lighting.day_inventory.daylight_observation": {
