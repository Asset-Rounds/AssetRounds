    "v30.paywall.unavailable.data.notice": {
      "comment": "Screen: Subscription offer paywall screen. Meaning: Uses the English default “Your existing sign details, photos, and reports remain available. No price or trial information has been guessed.”. Role: button label. Arguments: none. Plural/select: none. Accessibility: SwiftUI exposes it as the button label. Screenshot: Subscription offer paywall screen. state where this button label is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your existing sign details, photos, and reports remain available. No price or trial information has been guessed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sus detalles de letreros, fotos e informes existentes siguen disponibles. No se ha supuesto ningún precio ni información de prueba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "现有标牌详情、照片和报告仍然可用。未猜测任何价格或试用信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "既有標牌詳情、照片與報告仍可使用。沒有猜測任何價格或試用資訊。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thông tin biển hiệu, ảnh và báo cáo hiện có của bạn vẫn khả dụng. Không suy đoán thông tin về giá hay dùng thử."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기존 간판 정보, 사진 및 보고서는 계속 사용할 수 있습니다. 가격이나 무료 체험 정보를 추측하지 않았습니다."
          }
        }
      }
    },
