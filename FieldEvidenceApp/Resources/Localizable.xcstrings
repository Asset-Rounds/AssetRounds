    "v30.parts-stock.preview-csv-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the preview csv hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews the exact catalog CSV schema before an explicit canonical import command. It does not write during preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra previamente el esquema CSV exacto del catálogo antes de un comando explícito de importación canónica. No escribe durante la vista previa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在明确的规范导入命令之前预览精确的目录 CSV 架构。预览期间不写入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在明確的標準匯入命令前預覽精確的目錄 CSV 結構描述。預覽期間不會寫入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xem trước đúng lược đồ CSV của danh mục trước một lệnh nhập dữ liệu chuẩn được thực hiện chủ động. Không ghi dữ liệu trong lúc xem trước."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명시적인 기준 가져오기 명령 전에 정확한 카탈로그 CSV 스키마를 미리봅니다. 미리보기 중에는 기록하지 않습니다."
          }
        }
      }
    },
