    "v30.voice-capture.navigation-title": {
      "comment": "Screen: Voice capture. Meaning: Names the Voice capture destination. Role: navigation title. Arguments: none. Plural/select: none. Accessibility: VoiceOver exposes it as the navigation heading. Screenshot: Voice capture navigation title state; no screenshot is claimed.",
      "localizations": {
