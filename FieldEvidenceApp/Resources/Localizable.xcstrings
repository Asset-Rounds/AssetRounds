    "v30.my-day.order-description": {
      "comment": "Screen: My Day. Meaning: Explains order description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order is manual. Drag with Reorder enabled, or use Move up and Move down. Derived cues never change this order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El orden es manual. Arrastre con Reordenar activado o use Mover hacia arriba y Mover hacia abajo. Los indicadores derivados nunca cambian este orden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顺序为手动。启用重新排序后拖动，或使用上移和下移。派生提示绝不会更改此顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "順序為手動設定。啟用「重新排序」後拖移，或使用「上移」及「下移」。衍生提示絕不會變更此順序。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thứ tự là thủ công. Kéo khi bật Sắp xếp lại, hoặc dùng Di chuyển lên và Di chuyển xuống. Các gợi ý dẫn xuất không bao giờ thay đổi thứ tự này."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "순서는 수동입니다. 재정렬을 활성화한 뒤 드래그하거나 위로 이동과 아래로 이동을 사용하세요. 파생 신호는 이 순서를 변경하지 않습니다."
          }
        }
      }
    },
