    "v30.parts-stock.detail-boundary": {
      "comment": "Screen: Parts & Stock. Meaning: Explains detail boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing or scanning a material line only edits the supplied work draft. Stock changes only after an explicit Use from stock request is accepted by the canonical owner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribir o escanear una línea de material solo edita el borrador de trabajo proporcionado. Las existencias cambian únicamente después de que el componente canónico responsable acepte una solicitud explícita de Usar existencias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "键入或扫描材料行仅编辑提供的工作草稿。只有规范数据负责方接受明确的“从库存使用”请求后，库存才会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "鍵入或掃描材料列僅編輯提供的工作草稿。只有標準資料負責方接受明確的「從庫存使用」請求後，庫存才會變更。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập hoặc quét một dòng vật tư chỉ chỉnh sửa bản nháp công việc được cung cấp. Tồn kho chỉ thay đổi sau khi yêu cầu chủ động Sử dụng từ kho được bên quản lý dữ liệu chuẩn chấp nhận."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자재 행을 입력하거나 스캔하면 제공된 작업 초안만 편집됩니다. 명시적인 재고에서 사용 요청을 기준 데이터 담당 주체가 수락한 후에만 재고가 변경됩니다."
          }
        }
      }
    },
