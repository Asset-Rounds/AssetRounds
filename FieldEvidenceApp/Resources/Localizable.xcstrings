    "v30.parts-stock.dynamic-type-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains dynamic type description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At Accessibility Dynamic Type sizes content reflows vertically without truncation. Leading alignment, system controls, and text-based labels support RTL. Reduce Motion removes view-owned state-change animation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En tamaños de Tipo dinámico de Accesibilidad, el contenido se redistribuye verticalmente sin truncarse. La alineación inicial, los controles del sistema y las etiquetas basadas en texto admiten RTL. Reducir movimiento elimina la animación de cambios de estado propia de la vista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在辅助功能动态字体大小下，内容会垂直重排而不截断。前导对齐、系统控件和基于文本的标签支持 RTL。减少动态效果会移除视图拥有的状态更改动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在輔助使用動態字級下，內容會垂直重排而不截斷。前導對齊、系統控制項與文字標籤支援 RTL。減少動態效果會移除檢視所擁有的狀態變更動畫。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ở cỡ Chữ động Trợ năng, nội dung tự xuống dòng theo chiều dọc mà không bị cắt. Căn chỉnh đầu dòng, các điều khiển hệ thống và nhãn dựa trên văn bản hỗ trợ RTL. Giảm chuyển động loại bỏ hoạt ảnh thay đổi trạng thái do chế độ xem sở hữu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "접근성 동적 텍스트 크기에서는 잘림 없이 콘텐츠가 세로로 재배치됩니다. 선행 정렬, 시스템 컨트롤 및 텍스트 기반 레이블은 RTL을 지원합니다. 동작 줄이기는 보기 소유 상태 변경 애니메이션을 제거합니다."
          }
        }
      }
    },
    "v30.parts-stock.enter-code": {
      "comment": "Screen: Parts & Stock. Meaning: Explains enter code in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a stock code for manual lookup. No stock change occurs while typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingrese un código de inventario para la búsqueda manual. No ocurre ningún cambio de inventario mientras escribe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入库存代码以手动查找。输入时不会发生库存变更。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入庫存代碼以進行手動查詢。輸入時不會變更庫存。"
          }
        },
        "vi": {
