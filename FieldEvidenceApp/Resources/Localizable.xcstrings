    "v30.parts-stock.material-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the material hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing this line does not change stock. It is sent only when Use from stock is explicitly requested."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribir esta línea no cambia las existencias. Se envía solo cuando se solicita explícitamente Usar existencias."
