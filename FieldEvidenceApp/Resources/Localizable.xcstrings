    "illuminated.playbook.preflight.after_dark": {
      "comment": "C03 preflight guidance; it does not claim system verification or an accepted acknowledgement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before capture, confirm conditions are dark enough to observe the sign's visible illumination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Antes de capturar, confirme que las condiciones están lo bastante oscuras para observar la iluminación visible del letrero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "采集前，请确认环境足够暗，以便观察标牌的可见照明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "擷取前，請確認環境足夠昏暗，以觀察標牌的可見照明。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trước khi chụp, hãy xác nhận điều kiện đủ tối để quan sát độ chiếu sáng hiển thị của biển hiệu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "캡처하기 전에 간판의 가시 조명을 관찰할 수 있을 만큼 조건이 어두운지 확인하십시오."
          }
        }
      }
    },
