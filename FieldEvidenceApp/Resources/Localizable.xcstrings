    },
    "v30.recipient-review.import-preview-complete": {
      "comment": "Screen: Recipient review. Meaning: Reports import preview complete to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Recipient review operation or state message state; no screenshot is claimed.",
