    "v30.voice-capture.time-limit-reached": {
      "comment": "Screen: Voice capture. Meaning: Conveys the current time limit reached state. Role: accessibility value. Arguments: none. Plural/select: none. Accessibility: VoiceOver uses this exact text as the control value. Screenshot: Voice capture accessibility value state; no screenshot is claimed.",
      "localizations": {
