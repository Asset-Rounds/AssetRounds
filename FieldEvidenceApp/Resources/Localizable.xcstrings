    "v30.parts-stock.part-selected": {
      "comment": "Screen: Parts & Stock. Meaning: The selected catalog part. Role: operation status. Arguments: name String authoredSource x1. Plural/select: none. Accessibility: Read in the catalog selection status.. Screenshot: Parts & Stock visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected %@. The supplied detail remains the source of truth."
          }
        },
        "es": {
