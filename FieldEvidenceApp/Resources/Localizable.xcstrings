    "v30.manual-work-resource.heading-description": {
      "comment": "Screen: Manual work resources. Meaning: Explains heading description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Manual work resources body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
