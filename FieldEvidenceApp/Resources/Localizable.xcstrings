          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明確延續"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chuyển tiếp rõ ràng"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명시적 이월"
          }
        }
      }
    },
    "v30.my-day.carryover-hint": {
      "comment": "Screen: My Day. Meaning: Guides use of the carryover hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: My Day accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests a zero-write carryover preview. It does not carry work forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicita una vista previa de transferencia sin escritura. No transfiere trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求零写入结转预览。它不会结转工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要求零寫入的工作延續預覽，不會實際延續工作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu bản xem trước chuyển tiếp không ghi. Không chuyển tiếp công việc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "쓰기 0 이월 미리보기를 요청합니다. 작업을 이월하지 않습니다."
          }
        }
      }
    },
    "v30.my-day.carryover-preview-available": {
      "comment": "Screen: My Day. Meaning: Explains carryover preview available in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A zero-write carryover preview is supplied. Commit and recovery remain separate coordinator actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se proporciona una vista previa de traspaso sin escrituras. Confirmar y recuperar siguen siendo acciones separadas del coordinador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已提供无写入结转预览。提交和恢复仍是独立的协调器操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已提供零寫入的延續預覽。提交與復原仍是分開的協調員動作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã cung cấp bản xem trước chuyển tiếp không ghi dữ liệu. Ghi chính thức và khôi phục vẫn là các thao tác riêng biệt của bộ điều phối."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "쓰기 없는 이월 미리보기가 제공됩니다. 확정 저장과 복구는 별도의 조정자 작업으로 유지됩니다."
          }
        }
      }
    },
    "v30.my-day.eligible-work-description": {
      "comment": "Screen: My Day. Meaning: Explains eligible work description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecting an item asks the supplied coordinator to update a zero-write draft only. It does not save a plan or change due work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seleccionar un elemento solicita al coordinador proporcionado actualizar solo un borrador sin escrituras. No guarda un plan ni cambia el trabajo pendiente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择项目只会请求所提供的协调器更新零写入草稿，不会保存计划或更改到期工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選取項目只會要求提供的協調器更新零寫入草稿，不會儲存計畫或改變到期工作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn mục chỉ yêu cầu bộ điều phối được cung cấp cập nhật bản nháp không ghi dữ liệu. Không lưu kế hoạch hoặc thay đổi công việc đến hạn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "항목 선택은 제공된 조정자에게 데이터를 기록하지 않는 초안만 업데이트하도록 요청합니다. 계획을 저장하거나 기한이 된 작업을 변경하지 않습니다."
          }
        }
      }
    },
