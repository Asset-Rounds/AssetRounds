    "v30.parts-stock.writes-disabled": {
      "comment": "Screen: Parts & Stock. Meaning: Explains writes disabled in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes are disabled by the supplied feature policy. Catalog reads, export, recovery, and existing drafts remain preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La política de funciones proporcionada deshabilita las escrituras. Se conservan las lecturas del catálogo, la exportación, la recuperación y los borradores existentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的功能政策已禁用写入。目录读取、导出、恢复和现有草稿仍保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的功能政策已停用寫入。目錄讀取、匯出、復原及既有草稿仍予保留。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chính sách tính năng được cung cấp đã tắt thao tác ghi. Việc đọc danh mục, xuất, khôi phục và các bản nháp hiện có vẫn được giữ nguyên."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 기능 정책에 따라 쓰기가 비활성화되었습니다. 카탈로그 읽기, 내보내기, 복구 및 기존 초안은 유지됩니다."
          }
        }
      }
    },
