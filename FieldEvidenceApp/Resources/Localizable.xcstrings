    "v30.recipient-review.offline-boundary": {
      "comment": "Screen: Recipient review. Meaning: Explains offline boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline: this surface makes no network, sent, delivered, or read claim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin conexión: esta superficie no declara red, enviado, entregado ni leído."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "离线：此界面不作出网络、已发送、已交付或已阅读声明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "離線：此介面不主張網路、已傳送、已交付或已讀取。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ngoại tuyến: bề mặt này không đưa ra tuyên bố về mạng, đã gửi, đã giao hoặc đã đọc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오프라인: 이 화면은 네트워크, 전송됨, 배달됨 또는 읽음 상태를 주장하지 않습니다."
          }
        }
      }
    },
    "v30.recipient-review.preview-description": {
      "comment": "Screen: Recipient review. Meaning: Explains preview description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview checks the supplied response and current review basis without a write. Import never applies automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vista previa comprueba la respuesta proporcionada y la base de revisión actual sin escribir. La importación nunca se aplica automáticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "预览会检查所提供的响应和当前审核依据，而不进行写入。导入绝不会自动应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "預覽會檢查提供的回應和目前審查依據，而不寫入。匯入絕不會自動套用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xem trước kiểm tra phản hồi được cung cấp và cơ sở xem xét hiện tại mà không ghi dữ liệu. Việc nhập không bao giờ tự động được áp dụng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "미리보기는 쓰기 없이 제공된 응답과 현재 검토 근거를 점검합니다. 가져오기는 자동으로 적용되지 않습니다."
          }
        }
      }
    },
    "v30.recipient-review.preview-heading": {
      "comment": "Screen: Recipient review. Meaning: Names the preview heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Recipient review section heading state; no screenshot is claimed.",
