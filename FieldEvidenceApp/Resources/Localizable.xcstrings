    "v30.voice-capture.accept-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the accept hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests acceptance of this exact structured proposal through C56. It does not claim Saved or Complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicita la aceptación de esta propuesta estructurada exacta mediante C56. No afirma Guardado ni Completo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求通过 C56 接受此精确结构化提议。它不声称已保存或已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要求透過 C56 接受這份確切的結構化提案，不聲稱已儲存或已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu chấp nhận đề xuất có cấu trúc chính xác này thông qua C56. Không tuyên bố Đã lưu hoặc Hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "C56을 통해 이 정확한 구조화 제안의 승인을 요청합니다. 저장됨 또는 완료됨을 주장하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.accept-requested": {
      "comment": "Screen: Voice capture. Meaning: Accept request sent for a field. Role: operation status. Arguments: label String authoredSource x1. Plural/select: none. Accessibility: Read in operation status.. Screenshot: Voice capture visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept request sent for %@. Waiting for C56's ordinary draft authority; no Saved or Complete claim is made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se envió la solicitud de aceptar para %@. Se espera la autoridad ordinaria del borrador de C56; no se declara Guardado ni Completado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已发送 %@ 的接受请求。正在等待 C56 的常规草稿权限；不声称已保存或已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已傳送 %@ 的接受要求。正在等待 C56 的一般草稿權限；不宣稱已儲存或已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã gửi yêu cầu chấp nhận cho %@. Đang chờ quyền nháp thông thường của C56; không có tuyên bố Đã lưu hoặc Hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에 대한 수락 요청을 보냈습니다. C56의 일반 초안 권한을 기다리는 중이며, 저장됨 또는 완료됨을 주장하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.accept-unavailable-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the accept unavailable hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept is unavailable because this field is ambiguous or unsupported; edit it manually or reject it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aceptar no está disponible porque este campo es ambiguo o no es compatible; edítelo manualmente o rechácelo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由于此字段含糊或不受支持，无法接受；请手动编辑或拒绝它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由於此欄位含糊或不受支援，無法接受；請手動編輯或拒絕。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể chấp nhận vì trường này mơ hồ hoặc không được hỗ trợ; hãy chỉnh sửa thủ công hoặc từ chối."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 필드는 모호하거나 지원되지 않아 수락할 수 없습니다. 수동으로 편집하거나 거부하십시오."
          }
        }
      }
    },
    "v30.voice-capture.accessibility-description": {
      "comment": "Screen: Voice capture. Meaning: Explains accessibility description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every action has a visible text label and a stable VoiceOver/Voice Control identifier. Switch Control, external keyboard, and motor access use the same buttons and text fields; no microphone gesture, wake word, or icon-only action is required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada acción tiene una etiqueta de texto visible y un identificador estable para VoiceOver y Control por voz. Control por botón, el teclado externo y el acceso motor usan los mismos botones y campos de texto; no se requiere un gesto de micrófono, palabra de activación ni acción representada solo por un ícono."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每项操作均有可见文本标签和稳定的旁白/语音控制标识符。切换控制、外接键盘和肢体操作辅助使用相同的按钮和文本框；无需麦克风手势、唤醒词或仅有图标的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每項動作都有可見文字標籤與固定的 VoiceOver／語音控制識別碼。切換控制、外接鍵盤及肢體操作輔助使用相同的按鈕與文字欄位；無須使用麥克風手勢、喚醒詞或僅有圖示的動作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mọi hành động đều có nhãn văn bản hiển thị và mã định danh VoiceOver/Điều khiển bằng giọng nói ổn định. Điều khiển công tắc, bàn phím ngoài và hỗ trợ vận động dùng cùng các nút và ô văn bản; không cần cử chỉ micrô, từ đánh thức hay hành động chỉ có biểu tượng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 작업에는 눈에 보이는 텍스트 라벨과 일관된 VoiceOver/음성 명령 식별자가 있습니다. 스위치 제어, 외부 키보드 및 운동 기능 접근은 동일한 버튼과 텍스트 필드를 사용하며, 마이크 제스처, 호출어 또는 아이콘만 있는 작업은 필요하지 않습니다."
          }
        }
      }
    },
