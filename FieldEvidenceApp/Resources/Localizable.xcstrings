    "v30.parts-stock.camera-denied": {
      "comment": "Screen: Parts & Stock. Meaning: Explains camera denied in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access was not granted for stock lookup. Enter a stock code manually; manual lookup has the same local, zero-write semantics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se concedió acceso a la cámara para buscar inventario. Ingrese un código de inventario manualmente; la búsqueda manual tiene la misma semántica local sin escrituras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未授予用于库存查询的相机访问权限。请手动输入库存代码；手动查询具有相同的本地无写入语义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未授予相機權限以查詢庫存。請手動輸入庫存代碼；手動查詢具有相同的本機零寫入語意。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa cấp quyền truy cập máy ảnh để tra cứu kho. Hãy nhập mã kho thủ công; tra cứu thủ công có cùng ngữ nghĩa cục bộ, không ghi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재고 조회를 위한 카메라 접근 권한이 부여되지 않았습니다. 재고 코드를 수동으로 입력하십시오. 수동 조회도 동일한 로컬, 쓰기 없는 의미를 가집니다."
          }
        }
      }
    },
