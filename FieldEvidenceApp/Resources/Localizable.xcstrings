    "v30.recipient-review.cancelled": {
      "comment": "Screen: Recipient review. Meaning: Reports cancelled to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Recipient review operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was cancelled. Reload the canonical record before retrying; no effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se canceló la solicitud. Vuelva a cargar el registro canónico antes de reintentar; no se confirma ningún efecto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求已取消。请重新加载规范记录后再重试；不声称产生了效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請求已取消。請重新載入標準記錄後再重試；不聲稱產生效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã hủy yêu cầu. Hãy tải lại bản ghi chuẩn trước khi thử lại; không khẳng định có tác động."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "요청이 취소되었습니다. 다시 시도하기 전에 기준 기록을 다시 불러오세요. 변경이 반영되었다고 확인하지 않습니다."
          }
        }
      }
    },
    "v30.recipient-review.clear-request-replayed": {
      "comment": "Screen: Recipient review. Meaning: Reports clear request replayed to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Recipient review operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clear request was replayed after its explicit warning acknowledgement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se repitió la solicitud de borrado después de la confirmación explícita de su advertencia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "清除请求已在明确确认警告后重放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "清除要求已在明確確認警告後重播。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã thực thi lại yêu cầu xóa sau khi chủ động xác nhận cảnh báo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명시적인 경고 확인 후 지우기 요청이 재실행되었습니다."
          }
        }
      }
    },
    "v30.recipient-review.clear-warning-description": {
      "comment": "Screen: Recipient review. Meaning: Explains clear warning description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy clear files require an explicit visible warning acknowledgement before they can be replayed or read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los archivos claros heredados requieren un reconocimiento explícito de advertencia visible antes de poder reproducirse o leerse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "旧版明文文件必须在重放或读取前明确确认可见警告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "舊版清除檔案必須先明確確認可見警告，才能重播或讀取。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các tệp xóa cũ yêu cầu xác nhận cảnh báo rõ ràng, có thể nhìn thấy trước khi chúng có thể được phát lại hoặc đọc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "레거시 일반 파일은 재생하거나 읽기 전에 명시적인 화면 경고 확인이 필요합니다."
          }
        }
      }
    },
    "v30.recipient-review.command-hint": {
      "comment": "Screen: Recipient review. Meaning: Guides use of the command hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Recipient review accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the supplied canonical recipient-review command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa el comando canónico de revisión del destinatario proporcionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用提供的规范接收方审核命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用提供的標準接收者審閱命令。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sử dụng lệnh xem xét của người nhận chuẩn được cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 기준 수신자 검토 명령을 사용합니다."
          }
        }
      }
    },
    "v30.recipient-review.command-not-completed": {
      "comment": "Screen: Recipient review. Meaning: Reports command not completed to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Recipient review operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The supplied command was not completed. The current record remains the source of truth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se completó el comando proporcionado. El registro actual sigue siendo la fuente de verdad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的命令未完成。当前记录仍为事实依据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的命令未完成。目前記錄仍是事實依據。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lệnh được cung cấp chưa hoàn tất. Bản ghi hiện tại vẫn là nguồn thông tin chuẩn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 명령이 완료되지 않았습니다. 현재 기록이 계속 기준 정보로 유지됩니다."
          }
        }
      }
    },
    "v30.recipient-review.create-response": {
      "comment": "Screen: Recipient review. Meaning: Names the create response action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Recipient review button title state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
