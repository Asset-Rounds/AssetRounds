    "v30.parts-stock.accessibility-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains accessibility description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All actions have visible labels and text fallbacks for VoiceOver, Voice Control, Switch Control, keyboard, and motor access. No scan is required; manual lookup is complete. Quantity and revision errors are returned to the caller without a partial canonical effect."
          }
        }
      }
    },
