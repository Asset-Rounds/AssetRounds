    "v30.parts-stock.count-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the count action. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records an explicit opening or physical count through the canonical stock owner. UNKNOWN is never treated as zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registra una apertura explícita o conteo físico mediante el propietario canónico de inventario. UNKNOWN nunca se trata como cero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过规范库存所有者记录明确的开库或实物盘点。绝不会将 UNKNOWN 视为零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "透過標準庫存負責方明確記錄期初數量或實際盤點。絕不將 UNKNOWN 視為零。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ghi một lần mở rõ ràng hoặc đếm thực tế thông qua chủ sở hữu tồn kho chuẩn. UNKNOWN không bao giờ được coi là bằng không."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기준 재고 소유자를 통해 명시적 개시 또는 실사를 기록합니다. UNKNOWN은 절대로 0으로 처리되지 않습니다."
          }
        }
      }
    },
