    "v30.my-day.start-resume-description": {
      "comment": "Screen: My Day. Meaning: Explains start resume description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start and Resume request an existing route only. This view does not claim the route opened or that work began."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iniciar y Reanudar solicitan solo una ruta existente. Esta vista no confirma que se haya abierto la ruta ni iniciado el trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“开始”和“继续”仅请求现有路由。此视图不声称路由已打开或工作已开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「開始」與「繼續」僅要求既有路由。此畫面不聲稱路由已開啟或工作已開始。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bắt đầu và Tiếp tục chỉ yêu cầu tuyến điều hướng hiện có. Màn hình này không khẳng định đã mở tuyến hoặc bắt đầu công việc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시작과 재개는 기존 경로만 요청합니다. 이 화면에서는 경로가 열렸거나 작업이 시작되었다고 확인하지 않습니다."
          }
        }
      }
    },
