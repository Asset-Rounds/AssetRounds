            "value": "보호된 데이터를 사용할 수 없습니다."
          }
        }
      }
    },
    "v30.voice-capture.reason-unavailable": {
      "comment": "Screen: Voice capture. Meaning: Reports reason unavailable to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device capture path is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vía de captura en el dispositivo no está disponible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "设备端采集途径不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "裝置端擷取途徑無法使用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luồng thu thập trên thiết bị không khả dụng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기기 내 수집 경로를 사용할 수 없습니다."
          }
        }
      }
    },
    "v30.voice-capture.reason-unsupported-device": {
      "comment": "Screen: Voice capture. Meaning: Reports reason unsupported device to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not support the required on-device recognition path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este dispositivo no admite la vía de reconocimiento en el dispositivo requerida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此设备不支持所需的设备端识别途径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此裝置不支援所需的裝置端辨識途徑。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thiết bị này không hỗ trợ luồng nhận dạng trên thiết bị được yêu cầu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 기기는 필요한 기기 내 인식 경로를 지원하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.reason-unsupported-locale": {
      "comment": "Screen: Voice capture. Meaning: Reports reason unsupported locale to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected locale is unsupported for on-device recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La configuración regional seleccionada no es compatible con el reconocimiento en el dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "设备端识别不支持所选语言区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "裝置端辨識不支援所選語言地區。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ngôn ngữ và vùng đã chọn không được hỗ trợ cho nhận dạng trên thiết bị."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 로캘은 기기 내 인식에 지원되지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.recovery-backgrounded": {
      "comment": "Screen: Voice capture. Meaning: Reports recovery backgrounded to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app moved to the background. This foreground-only capture does not continue silently; return to manual entry or retry explicitly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La app pasó a segundo plano. Esta captura, exclusiva del primer plano, no continúa de forma silenciosa; vuelva a la entrada manual o reintente explícitamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "应用已转入后台。此采集仅限前台运行，不会静默继续；请返回手动输入或明确重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "App 已移至背景。此擷取僅限前景執行，不會悄悄繼續；請返回手動輸入或明確重試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ứng dụng đã chuyển sang nền. Việc thu thập chỉ chạy ở tiền cảnh này không âm thầm tiếp tục; hãy quay lại nhập thủ công hoặc chủ động thử lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "앱이 백그라운드로 이동했습니다. 포그라운드 전용 수집은 보이지 않는 상태로 계속되지 않습니다. 수동 입력으로 돌아가거나 직접 다시 시도하세요."
          }
        }
      }
    },
    "v30.voice-capture.recovery-cancelled": {
      "comment": "Screen: Voice capture. Meaning: Reports recovery cancelled to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture was cancelled. The unfinished utterance is not a transcript, proposal, or draft write."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se canceló la captura. La frase sin terminar no constituye una transcripción, una propuesta ni una escritura en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "采集已取消。未完成的语音内容不构成转写文本、建议或草稿写入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "擷取已取消。尚未完成的語音不構成逐字稿、提案或草稿寫入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã hủy thu thập. Phần lời nói chưa hoàn tất không phải bản chép lời, đề xuất hay lần ghi bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수집이 취소되었습니다. 완료되지 않은 발화는 전사문, 제안 또는 초안에 기록된 내용이 아닙니다."
          }
        }
      }
    },
    "v30.voice-capture.recovery-default": {
      "comment": "Screen: Voice capture. Meaning: Reports recovery default to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual entry remains available while the caller supplies a current state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La entrada manual sigue disponible mientras el componente solicitante proporciona un estado actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "调用方提供当前状态时，仍可手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "呼叫端提供目前狀態期間，手動輸入仍可使用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vẫn có thể nhập thủ công trong khi bên gọi cung cấp trạng thái hiện tại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호출 측이 현재 상태를 제공하는 동안 수동 입력을 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "v30.voice-capture.recovery-description": {
      "comment": "Screen: Voice capture. Meaning: Explains recovery description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The caller must re-read the current draft/context and fence late callbacks before retrying. This view never infers a partial transcript, proposal, checkpoint, or receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El componente solicitante debe volver a leer el borrador o contexto actual y controlar las devoluciones de llamada tardías antes de reintentar. Esta vista nunca infiere una transcripción, propuesta, punto de guardado ni comprobante parcial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "调用方必须重新读取当前草稿/上下文，并限制延迟回调后再重试。此视图绝不推断部分转写文本、建议、检查点或回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "呼叫端必須重新讀取目前草稿／脈絡並限制延遲回呼，才能重試。此畫面絕不推斷部分逐字稿、提案、檢查點或回執。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bên gọi phải đọc lại bản nháp/ngữ cảnh hiện tại và giới hạn hàm gọi lại đến muộn trước khi thử lại. Màn hình này không bao giờ suy ra bản chép lời, đề xuất, điểm lưu hay biên nhận một phần."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호출 측은 다시 시도하기 전에 현재 초안과 맥락을 다시 읽고 늦게 도착한 콜백의 유효 범위를 제한해야 합니다. 이 화면에서는 일부 전사문, 제안, 저장 지점 또는 처리 확인서가 존재한다고 추정하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.recovery-failed": {
      "comment": "Screen: Voice capture. Meaning: Reports recovery failed to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture or structuring request failed. The caller must report cleanup/retry truth before another attempt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Falló la solicitud de captura o estructuración. El componente solicitante debe informar el estado real de limpieza y reintento antes de otro intento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "采集或结构化请求失败。调用方必须报告实际清理/重试状态后才能再次尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "擷取或結構化要求失敗。呼叫端必須回報實際清理／重試狀態後，才能再次嘗試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu thu thập hoặc cấu trúc hóa thất bại. Bên gọi phải báo đúng trạng thái dọn dẹp/thử lại trước lần thử tiếp theo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수집 또는 구조화 요청이 실패했습니다. 호출 측은 다음 시도 전에 정리 및 재시도의 실제 상태를 알려야 합니다."
          }
        }
      }
    },
    "v30.voice-capture.recovery-heading": {
      "comment": "Screen: Voice capture. Meaning: Names the recovery heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Voice capture section heading state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recuperación"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "復原"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khôi phục"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "복구"
          }
        }
      }
    },
    "v30.voice-capture.recovery-interrupted": {
      "comment": "Screen: Voice capture. Meaning: Reports recovery interrupted to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio capture was interrupted. The caller must fence the callback and clean temporary scratch; manual text remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se interrumpió la captura de audio. El componente solicitante debe controlar la devolución de llamada y limpiar los datos temporales; el texto manual sigue disponible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音频采集已中断。调用方必须限制回调并清理临时数据；仍可手动输入文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音訊擷取已中斷。呼叫端必須限制回呼並清理暫存資料；仍可手動輸入文字。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc thu âm bị gián đoạn. Bên gọi phải giới hạn hàm gọi lại và dọn dữ liệu tạm; vẫn có thể nhập văn bản thủ công."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오디오 수집이 중단되었습니다. 호출 측은 콜백의 유효 범위를 제한하고 임시 데이터를 정리해야 하며, 수동 텍스트 입력은 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "v30.voice-capture.recovery-protected-data": {
      "comment": "Screen: Voice capture. Meaning: Reports recovery protected data to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected local data is unavailable. No transcript, proposal, scratch, or draft effect is reconstructed. Retry after protected data becomes available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los datos locales protegidos no están disponibles. No se reconstruye ninguna transcripción, propuesta, dato temporal ni efecto en el borrador. Reintente cuando los datos protegidos estén disponibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "受保护的本地数据不可用。不会重建任何转写文本、建议、临时数据或草稿效果。请在受保护数据可用后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "受保護的本機資料無法使用。不會重建逐字稿、提案、暫存資料或草稿效果。請待受保護資料可用後重試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dữ liệu cục bộ được bảo vệ không khả dụng. Không dựng lại bản chép lời, đề xuất, dữ liệu tạm hay thay đổi bản nháp. Hãy thử lại khi dữ liệu được bảo vệ khả dụng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보호된 로컬 데이터를 사용할 수 없습니다. 전사문, 제안, 임시 데이터 또는 초안 변경을 재구성하지 않습니다. 보호된 데이터를 사용할 수 있게 되면 다시 시도하세요."
          }
        }
      }
    },
    "v30.voice-capture.recovery-stale": {
      "comment": "Screen: Voice capture. Meaning: Reports recovery stale to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft target revision changed or could not be revalidated. Reload the current draft/context before retrying; keep the typed fallback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La revisión de destino del borrador cambió o no pudo validarse de nuevo. Vuelva a cargar el borrador o contexto actual antes de reintentar; conserve la alternativa de entrada escrita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "草稿目标修订版已更改或无法重新验证。请重新加载当前草稿/上下文后再重试，并保留手动输入方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "草稿目標修訂版已變更或無法重新驗證。請重新載入目前草稿／脈絡後再重試，並保留鍵入替代方式。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản sửa đổi đích của bản nháp đã thay đổi hoặc không thể xác thực lại. Hãy tải lại bản nháp/ngữ cảnh hiện tại trước khi thử lại; giữ lại phương án nhập bằng bàn phím."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초안 대상 개정본이 변경되었거나 다시 검증할 수 없습니다. 다시 시도하기 전에 현재 초안과 맥락을 다시 불러오고, 직접 입력하는 대체 수단을 유지하세요."
          }
        }
      }
    },
    "v30.voice-capture.recovery-storage": {
      "comment": "Screen: Voice capture. Meaning: Reports recovery storage to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage is unavailable or under pressure. No scratch cleanup or draft checkpoint is claimed; retry after storage recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El almacenamiento local no está disponible o tiene poco espacio. No se confirma la limpieza de datos temporales ni un punto de guardado del borrador; reintente cuando se recupere el almacenamiento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本地存储不可用或空间紧张。不能确认临时数据已清理或草稿已设置检查点；请在存储恢复后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本機儲存無法使用或空間吃緊。無法確認暫存資料已清理或草稿檢查點已建立；請在儲存恢復後重試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bộ nhớ cục bộ không khả dụng hoặc thiếu dung lượng. Chưa xác nhận đã dọn dữ liệu tạm hay tạo điểm lưu bản nháp; hãy thử lại sau khi bộ nhớ hoạt động trở lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로컬 저장 공간을 사용할 수 없거나 부족합니다. 임시 데이터 정리나 초안 저장 지점 생성이 완료되었다고 볼 수 없습니다. 저장 공간을 복구한 뒤 다시 시도하세요."
          }
        }
      }
    },
    "v30.voice-capture.reject-field": {
      "comment": "Screen: Voice capture. Meaning: Reject action for a review field. Role: button label. Arguments: label String authoredSource x1. Plural/select: none. Accessibility: Announced for reject button.. Screenshot: Voice capture visible state.",
