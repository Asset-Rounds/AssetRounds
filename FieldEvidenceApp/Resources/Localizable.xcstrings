          }
        }
      }
    },
    "v30.service-request.create-work-no-preview": {
      "comment": "Screen: Service request. Meaning: Explains create work no preview in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create work is unavailable until a supplied preview and triage state are available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crear trabajo no está disponible hasta que haya una vista previa y un estado de clasificación proporcionados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在提供的预览和分诊状态可用前，无法创建工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在提供預覽和分流狀態前，無法建立工作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể tạo công việc cho đến khi có bản xem trước được cung cấp và trạng thái phân loại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 미리보기와 분류 상태를 사용할 수 있을 때까지 작업 생성을 사용할 수 없습니다."
          }
        }
      }
    },
    "v30.service-request.create-work-unavailable": {
      "comment": "Screen: Service request. Meaning: Explains create work unavailable in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
