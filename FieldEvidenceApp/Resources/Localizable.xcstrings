    "v30.parts-stock.no-balance-projection": {
      "comment": "Screen: Parts & Stock. Meaning: Explains no balance projection in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No balance projection is supplied. An absent projection is UNKNOWN, not zero; count is required before a quantity-affecting operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporciona ninguna proyección de saldo. Una proyección ausente es UNKNOWN, no cero; se requiere contar antes de una operación que afecta la cantidad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供余额投影。缺少投影表示“未知”，不是零；执行影响数量的操作前需要计数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供餘額投影。缺少的投影為 UNKNOWN，並非零；在影響數量的操作前需要盤點。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có bản chiếu số dư nào được cung cấp. Bản chiếu vắng mặt là UNKNOWN, không phải bằng không; cần đếm trước thao tác ảnh hưởng đến số lượng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "잔액 투영이 제공되지 않습니다. 투영 부재는 0이 아닌 UNKNOWN이며, 수량에 영향을 주는 작업 전에 실사가 필요합니다."
          }
        }
      }
    },
    "v30.parts-stock.no-catalog-items": {
      "comment": "Screen: Parts & Stock. Meaning: Explains no catalog items in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No catalog items are supplied. This surface does not create a part implicitly from a search, scan, material line, or report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporcionan elementos de catálogo. Esta superficie no crea implícitamente una pieza a partir de una búsqueda, escaneo, línea de material ni informe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供目录项目。此界面不会根据搜索、扫描、物料行或报告隐式创建部件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供目錄項目。此介面不會因搜尋、掃描、材料列或報告而隱含建立零件。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có mục danh mục nào được cung cấp. Bề mặt này không tạo ngầm một bộ phận từ tìm kiếm, quét, dòng vật liệu hoặc báo cáo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카탈로그 항목이 제공되지 않습니다. 이 화면은 검색, 스캔, 자재 항목 또는 보고서에서 부품을 암묵적으로 만들지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.no-draft": {
      "comment": "Screen: Parts & Stock. Meaning: Explains no draft in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No draft is supplied. This surface does not create, discard, or infer a draft from a catalog search or typed material line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporciona ningún borrador. Esta superficie no crea, descarta ni infiere un borrador a partir de una búsqueda de catálogo o línea de material escrita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供草稿。此界面不会根据目录搜索或输入的物料行创建、丢弃或推断草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供草稿。此介面不會從目錄搜尋或輸入的材料列建立、捨棄或推斷草稿。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có bản nháp nào được cung cấp. Bề mặt này không tạo, loại bỏ hoặc suy ra bản nháp từ tìm kiếm danh mục hoặc dòng vật liệu đã nhập."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초안이 제공되지 않았습니다. 이 화면은 카탈로그 검색이나 입력한 자재 항목에서 초안을 만들거나 폐기하거나 추론하지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.no-history": {
      "comment": "Screen: Parts & Stock. Meaning: Explains no history in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No history projection is supplied. This view does not reconstruct events or infer a receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporciona ninguna proyección de historial. Esta vista no reconstruye eventos ni infiere un recibo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供历史记录投影。此视图不会重建事件或推断回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供歷程投影。此檢視不會重建事件或推斷回執。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có bản chiếu lịch sử nào được cung cấp. Chế độ xem này không tái tạo sự kiện hoặc suy ra biên nhận."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이력 투영이 제공되지 않습니다. 이 보기는 이벤트를 재구성하거나 처리 확인서를 추론하지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.no-low-stock-attention": {
      "comment": "Screen: Parts & Stock. Meaning: Explains no low stock attention in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No below-preferred or unknown balance attention is supplied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporciona ninguna atención de saldo inferior al preferido o desconocido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供低于首选或未知余额的注意项。"
          }
        },
        "zh-Hant": {
