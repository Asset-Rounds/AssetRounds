    "v30.report-correction.correction.note.accessibility.hint": {
      "comment": "Screen: Report correction. Meaning: provides localized assistive-technology context for the related control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: yes. Screenshot: Report correction rendered state; no screenshot is asserted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a different note, up to 1,000 characters. Leave it blank to remove the current note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escriba otra nota de hasta 1,000 caracteres. Déjela en blanco para eliminar la nota actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请输入其他备注，最多 1,000 个字符。留空可移除当前备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請輸入不同的備註，最多 1,000 個字元。留白可移除目前備註。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập ghi chú khác, tối đa 1.000 ký tự. Để trống để xóa ghi chú hiện tại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최대 1,000자의 다른 메모를 입력하세요. 현재 메모를 삭제하려면 비워 두세요."
          }
        }
      }
    },
