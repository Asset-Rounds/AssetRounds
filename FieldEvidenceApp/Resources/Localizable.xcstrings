    "v30.party.contact.workflow.party.notice": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Uses the English default “Create and edit require a supplied preview. Party retirement is irreversible in this workflow and is never inferred from a contact or Site-role change.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Party/contact/Site-role workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create and edit require a supplied preview. Party retirement is irreversible in this workflow and is never inferred from a contact or Site-role change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crear y editar requieren una vista previa proporcionada. El retiro de Parte es irreversible en este flujo de trabajo y nunca se infiere de un contacto ni de un cambio de rol de Sitio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "创建和编辑需要提供的预览。在此工作流中，参与方停用不可逆，绝不会从联系人或站点角色更改中推断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "建立與編輯需要提供的預覽。主體停用在此工作流程中不可逆，且絕不從聯絡人或場所角色變更推斷。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tạo và chỉnh sửa cần có bản xem trước được cung cấp. Ngừng sử dụng Bên là không thể đảo ngược trong quy trình này và không bao giờ được suy ra từ thay đổi liên hệ hoặc vai trò Địa điểm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "생성 및 편집에는 제공된 미리보기가 필요합니다. 이 워크플로에서 Party 폐기는 되돌릴 수 없으며 연락처 또는 현장 역할 변경으로 추론되지 않습니다."
          }
        }
      }
    },
    "v30.party.contact.workflow.party.retirement.confirmation": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Uses the English default “Party retirement is irreversible here. Confirming requests the supplied canonical action; this view does not claim it completed.”. Role: button label. Arguments: none. Plural/select: none. Accessibility: SwiftUI exposes it as the button label. Screenshot: Party/contact/Site-role workflow screen. state where this button label is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Party retirement is irreversible here. Confirming requests the supplied canonical action; this view does not claim it completed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El retiro de Parte es irreversible aquí. Confirmar solicita la acción canónica proporcionada; esta vista no declara que se haya completado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此处退役参与方不可撤销。确认会请求所提供的规范操作；此视图不声称操作已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此處停用主體不可逆。確認會請求提供的標準動作；此檢視不主張已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể đảo ngược việc ngừng sử dụng bên tại đây. Xác nhận sẽ yêu cầu thao tác chuẩn được cung cấp; màn hình này không khẳng định thao tác đã hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기서 관계자 폐기는 되돌릴 수 없습니다. 확인하면 제공된 기준 작업을 요청하며 이 보기는 완료를 주장하지 않습니다."
          }
        }
      }
    },
