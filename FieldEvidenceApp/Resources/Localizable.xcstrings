      }
    },
    "v30.parts-stock.no-return-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains no return description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No eligible prior Use is supplied. No standalone Return action is available. A Return can appear only after one exact Use receipt, its work-material lineage, an outstanding quantity, and a known destination are supplied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se proporciona ningún Uso previo elegible. No hay ninguna acción independiente de Devolver disponible. Una Devolución puede aparecer solo después de que se proporcionen un recibo exacto de Uso, su linaje de trabajo-material, una cantidad pendiente y un destino conocido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供符合条件的先前“使用”。没有独立的“退回”操作。只有在提供一个精确的“使用”回执、其工作物料谱系、未结数量和已知目的地后，才会显示“退回”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未提供符合資格的先前使用。無法使用獨立的退回動作。只有在提供一份確切使用回執、其工作材料脈絡、未結數量及已知目的地後，才可顯示退回。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có lần Sử dụng đủ điều kiện trước đó nào được cung cấp. Không có hành động Hoàn trả độc lập nào. Hoàn trả chỉ có thể xuất hiện sau khi có đúng một biên nhận Sử dụng, dòng dõi công việc-vật liệu của nó, số lượng còn lại và đích đến đã biết."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "적격한 이전 사용이 제공되지 않았습니다. 독립 실행형 반납 작업은 사용할 수 없습니다. 반납은 정확한 하나의 사용 처리 확인서, 해당 작업-자재 계보, 미반납 수량 및 알려진 목적지가 제공된 후에만 표시될 수 있습니다."
          }
        }
      }
    },
