    "v30.voice-capture.finish-review-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the finish review hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests C56 review closure. It does not claim the ordinary draft is Saved or Complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicita el cierre de revisión C56. No afirma que el borrador ordinario esté Guardado ni Completo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求 C56 审核关闭。它不声称常规草稿已保存或已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要求 C56 結束審閱，不聲稱一般草稿已儲存或已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu đóng xem xét C56. Không tuyên bố bản nháp thông thường là Đã lưu hoặc Hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "C56 검토 종료를 요청합니다. 일반 초안이 저장됨 또는 완료됨을 주장하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.finish-review-unavailable-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the finish review unavailable hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review every field with Accept, Edit, or Reject before requesting closure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revise cada campo con Aceptar, Editar o Rechazar antes de solicitar el cierre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请逐一选择接受、编辑或拒绝每个字段后，再请求结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請為每個欄位選擇接受、編輯或拒絕後，再要求結束。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn Chấp nhận, Sửa hoặc Từ chối cho từng trường trước khi yêu cầu kết thúc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "종료를 요청하기 전에 각 필드를 수락, 편집 또는 거부하여 검토하세요."
          }
        }
      }
    },
    "v30.voice-capture.heading": {
      "comment": "Screen: Voice capture. Meaning: Explains heading in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak details"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dictar detalles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "说出详情"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "口述詳情"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nói chi tiết"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "세부 내용 말하기"
          }
        }
      }
    },
    "v30.voice-capture.heading-description": {
      "comment": "Screen: Voice capture. Meaning: Explains heading description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional push-to-talk assistance for this existing draft. Press Speak details to start one explicit, on-device capture; there is no continuous listening or wake word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Asistencia opcional de pulsar para hablar para este borrador existente. Pulse Hablar detalles para iniciar una captura explícita en el dispositivo; no hay escucha continua ni palabra de activación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为此现有草稿提供可选的按住说话辅助。按“说出详情”开始一次明确的设备端捕获；没有持续监听或唤醒词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此現有草稿可選用按住說話協助。按「說明詳情」以開始一次明確的裝置端擷取；沒有持續聆聽或喚醒詞。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hỗ trợ nhấn để nói tùy chọn cho bản nháp hiện có này. Nhấn Chi tiết nói để bắt đầu một lần thu thập rõ ràng trên thiết bị; không có lắng nghe liên tục hoặc từ đánh thức."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 기존 초안을 위한 선택적 푸시 투 토크 지원입니다. 세부 정보 말하기를 눌러 명시적인 기기 내 캡처 한 번을 시작하세요. 지속적인 청취나 웨이크 워드는 없습니다."
          }
        }
      }
    },
    "v30.voice-capture.manual-draft-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the manual draft hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type or edit the existing draft with the full keyboard path. Text changes do not start speech and do not write until you explicitly continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escriba o edite el borrador existente con la vía completa de teclado. Los cambios de texto no inician el reconocimiento de voz ni se escriben hasta que continúe explícitamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用完整键盘途径键入或编辑现有草稿。文本更改不会启动语音，也不会在您明确继续之前写入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "透過完整鍵盤途徑鍵入或編輯既有草稿。文字變更不會啟動語音，也不會在您明確繼續前寫入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập hoặc chỉnh sửa bản nháp hiện có bằng toàn bộ luồng bàn phím. Thay đổi văn bản không bắt đầu nhập giọng nói và không ghi dữ liệu cho đến khi bạn chủ động tiếp tục."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키보드의 전체 입력 경로로 기존 초안을 입력하거나 편집하세요. 텍스트 변경은 음성 입력을 시작하지 않으며 사용자가 명시적으로 계속하기 전에는 데이터를 기록하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.manual-draft-label": {
      "comment": "Screen: Voice capture. Meaning: Names the manual draft label control. Role: accessibility label. Arguments: none. Plural/select: none. Accessibility: VoiceOver uses this exact text as the control label. Screenshot: Voice capture accessibility label state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual draft entry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entrada manual de borrador"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手动草稿输入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手動草稿輸入"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập bản nháp thủ công"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수동 초안 입력"
          }
        }
      }
    },
    "v30.voice-capture.manual-entry-description": {
      "comment": "Screen: Voice capture. Meaning: Explains manual entry description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual entry is the complete fallback for permission denial or revocation, unsupported locale/device, offline use, interruption, backgrounding, cancellation, stale targets, protected data, storage pressure, and relaunch. Your typed text is not treated as Saved until the ordinary draft authority returns its result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La entrada manual es la alternativa completa para denegación o revocación de permisos, configuración regional o dispositivo no compatible, uso sin conexión, interrupción, segundo plano, cancelación, destinos desactualizados, datos protegidos, presión de almacenamiento y relanzamiento. El texto escrito no se trata como Guardado hasta que la autoridad ordinaria de borrador devuelva su resultado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手动输入是权限被拒绝或撤销、不支持的区域设置/设备、离线使用、中断、后台运行、取消、陈旧目标、受保护数据、存储压力和重新启动时的完整备选方案。您的输入文本在常规草稿权限返回结果前不视为“已保存”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手動輸入是權限遭拒或撤銷、不支援的地區設定或裝置、離線使用、中斷、背景執行、取消、過期目標、受保護資料、儲存壓力及重新啟動時的完整備援。您的輸入文字在一般草稿權限傳回結果前，不會視為已儲存。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập thủ công là phương án dự phòng đầy đủ khi quyền bị từ chối hoặc thu hồi, ngôn ngữ/khu vực hoặc thiết bị không được hỗ trợ, sử dụng ngoại tuyến, gián đoạn, chạy nền, hủy, mục tiêu cũ, dữ liệu được bảo vệ, áp lực bộ nhớ và khởi chạy lại. Văn bản bạn nhập không được coi là Đã lưu cho đến khi cơ quan bản nháp thông thường trả về kết quả."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수동 입력은 권한 거부 또는 철회, 지원되지 않는 로캘/기기, 오프라인 사용, 중단, 백그라운드 전환, 취소, 오래된 대상, 보호된 데이터, 저장 공간 부족 및 재실행에 대한 완전한 대체 방법입니다. 일반 초안 권한에서 결과를 반환할 때까지 입력한 텍스트는 저장됨으로 처리되지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.manual-entry-heading": {
      "comment": "Screen: Voice capture. Meaning: Names the manual entry heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Voice capture section heading state; no screenshot is claimed.",
