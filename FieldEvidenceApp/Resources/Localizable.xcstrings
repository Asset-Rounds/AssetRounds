    "v30.recipient-review.heading-description": {
      "comment": "Screen: Recipient review. Meaning: Explains heading description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review a portable request offline, without entitlement and outside normal workspaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revise una solicitud portátil sin conexión, sin derechos de acceso y fuera de los espacios de trabajo normales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "离线审阅可移植请求，无需权益，且位于常规工作区之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
