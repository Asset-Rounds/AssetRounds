    "v30.parts-stock.manual-lookup-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the manual lookup hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual lookup is the complete fallback when scanning is unavailable. It does not change stock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La búsqueda manual es la alternativa completa cuando el escaneo no está disponible. No cambia el inventario."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扫描不可用时，手动查找是完整备选方案。它不会更改库存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "掃描無法使用時，手動查找是完整備援。它不會變更庫存。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tra cứu thủ công là phương án dự phòng đầy đủ khi quét không khả dụng. Nó không thay đổi tồn kho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스캔을 사용할 수 없을 때 수동 조회가 완전한 대체 방법입니다. 재고는 변경되지 않습니다."
          }
        }
      }
    },
