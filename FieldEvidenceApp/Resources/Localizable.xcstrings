    "v30.recipient-review.session-decision-complete": {
      "comment": "Screen: Recipient review. Meaning: Reports session decision complete to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Recipient review operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The supplied session-only decision was recorded without canonical workspace application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La decisión proporcionada, válida solo para la sesión, se registró sin aplicarse al espacio de trabajo canónico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已记录提供的仅限会话的决定，未应用到规范工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已記錄提供的僅限工作階段的決定，未套用至標準工作區。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quyết định chỉ áp dụng trong phiên được cung cấp đã được ghi nhận mà không áp dụng vào không gian làm việc chuẩn."
          }
        },
        "ko": {
