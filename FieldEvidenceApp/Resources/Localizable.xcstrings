    "v30.parts-stock.return-quantity-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the return quantity hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a positive quantity no greater than this Use's outstanding amount. The canonical owner checks the ordered return frontier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingrese una cantidad positiva no mayor que el monto pendiente de este Uso. El propietario canónico comprueba el límite ordenado de devolución."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入不大于此“使用”未结数量的正数数量。规范所有者会检查有序退回边界。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入不大於此用途未結清數量的正數數量。標準擁有者會檢查有序退回前沿。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập số lượng dương không lớn hơn số lượng chưa xử lý của Lần sử dụng này. Chủ sở hữu bản ghi chuẩn kiểm tra biên trả lại đã sắp thứ tự."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Use의 미처리 수량을 넘지 않는 양수를 입력하세요. 기준 소유자가 순서가 지정된 반납 경계를 점검합니다."
          }
        }
      }
    },
    "v30.parts-stock.return-quantity-label": {
      "comment": "Screen: Parts & Stock. Meaning: Destination-specific return quantity label. Role: accessibility label. Arguments: destination String formattedPresentation x1. Plural/select: none. Accessibility: VoiceOver label for return quantity input.. Screenshot: Parts & Stock visible state.",
      "localizations": {
        "en": {
