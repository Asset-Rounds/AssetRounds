          }
        }
      }
    },
    "v30.recipient-review.encrypted-unavailable": {
      "comment": "Screen: Recipient review. Meaning: Reports the encrypted unavailable state. Role: status label. Arguments: none. Plural/select: none. Accessibility: The combined label exposes this status to VoiceOver. Screenshot: Recipient review status label state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted exchange is unavailable. A typed manual fallback remains explicit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El intercambio cifrado no está disponible. Una alternativa manual escrita permanece explícita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "加密交换不可用。已明确提供输入式手动备选方案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "加密交換不可用。輸入的手動備援仍為明確操作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trao đổi được mã hóa không khả dụng. Phương án dự phòng nhập thủ công vẫn rõ ràng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "암호화된 교환을 사용할 수 없습니다. 입력된 수동 대체 경로는 명시적으로 유지됩니다."
          }
        }
      }
    },
    "v30.recipient-review.encryption-description": {
      "comment": "Screen: Recipient review. Meaning: Explains encryption description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong passphrase and damaged encrypted-envelope failures are intentionally presented as one neutral error. Encryption does not establish identity, authority, delivery, approval, or legal effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los fallos por frase de contraseña incorrecta y contenedor cifrado dañado se presentan intencionalmente como un solo error neutral. El cifrado no establece identidad, autoridad, entrega, aprobación ni efecto legal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "错误口令和加密封装损坏会有意显示为同一种中性错误。加密不代表身份、权限、交付、批准或法律效果成立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密語錯誤與加密封裝損毀刻意顯示為同一中性錯誤。加密不構成身分、授權、交付、核准或法律效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lỗi sai cụm mật khẩu và lỗi gói mã hóa bị hỏng được chủ ý hiển thị bằng cùng một thông báo lỗi trung lập. Mã hóa không xác lập danh tính, thẩm quyền, chuyển giao, phê duyệt hay hiệu lực pháp lý."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "잘못된 암호 문구와 손상된 암호화 데이터 포장 오류는 의도적으로 하나의 중립적 오류로 표시됩니다. 암호화는 신원, 권한, 전달, 승인 또는 법적 효력을 확립하지 않습니다."
          }
        }
      }
    },
