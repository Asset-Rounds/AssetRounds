    "evidence.curation.item.retake.review_required": {
      "comment": "C02 retake disclosure requiring renewed review for media-dependent descriptive text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retake stages a new original and requires review of the caption and accessibility description for the new pixels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Repetir la captura prepara un nuevo original y requiere revisar la leyenda y la descripción de accesibilidad de los nuevos píxeles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新拍摄会暂存新的原始内容，并要求审核新图像的说明文字和辅助功能描述。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新拍攝會暫存新的原始內容，並要求審閱新影像的說明文字與輔助使用描述。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chụp lại sẽ lưu tạm bản gốc mới và yêu cầu xem xét chú thích cùng mô tả trợ năng cho hình ảnh mới."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다시 촬영하면 새 원본이 준비되며 새 이미지의 캡션과 접근성 설명을 검토해야 합니다."
          }
        }
      }
    },
