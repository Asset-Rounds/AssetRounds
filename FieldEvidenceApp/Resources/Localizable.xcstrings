    "private.system.discovery.settings.disclosure": {
      "comment": "C14 disclosure that discovery is private, opt-in, and restricted to selected real workspaces.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled for selected real workspaces, private on-device discovery can make approved read-only shortcuts available."
