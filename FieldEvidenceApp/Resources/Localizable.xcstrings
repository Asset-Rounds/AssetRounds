    "v30.manual-work-resource.stock-used": {
      "comment": "Screen: Manual work resources. Meaning: Reports stock used to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Manual work resources operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The explicit stock use and its frozen work-material successor have durable receipts. Reload the canonical record to show their current state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El uso explícito de existencias y su sucesor congelado de material de trabajo tienen comprobantes duraderos. Vuelva a cargar el registro canónico para mostrar su estado actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明确的库存使用及其冻结的后续工作材料记录具有持久回执。请重新加载规范记录以显示其当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明確的庫存使用與已凍結的後續工作材料記錄均有持久回執。請重新載入標準記錄以顯示目前狀態。"
          }
        },
        "vi": {
