    "v30.parts-stock.containment-boundary": {
      "comment": "Screen: Parts & Stock. Meaning: Explains containment boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This contained surface has zero live root adoption before S10.6. It does not claim a route, store write, network lookup, camera permission, receipt, delivery, approval, identity, or legal effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta interfaz aislada no tiene ninguna incorporación a la raíz activa antes de S10.6. No confirma una ruta, escritura en el almacén, búsqueda de red, permiso de cámara, comprobante, entrega, aprobación, identidad ni efecto legal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S10.6 之前，此独立界面未接入实际根界面。不声称路由、存储写入、网络查询、相机权限、回执、交付、批准、身份或法律效果已成立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S10.6 之前，此獨立介面尚未接入實際根畫面。不聲稱路由、儲存寫入、網路查找、相機權限、回執、交付、核准、身分或法律效果成立。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giao diện biệt lập này chưa được tích hợp vào luồng gốc đang hoạt động trước S10.6. Giao diện không khẳng định có tuyến điều hướng, ghi vào kho dữ liệu, tra cứu mạng, quyền camera, biên nhận, chuyển giao, phê duyệt, danh tính hay hiệu lực pháp lý."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 격리된 화면은 S10.6 이전에 실제 루트 화면에 통합되지 않습니다. 경로, 저장소 기록, 네트워크 조회, 카메라 권한, 처리 확인서, 전달, 승인, 신원 또는 법적 효력을 의미하지 않습니다."
          }
        }
      }
    },
