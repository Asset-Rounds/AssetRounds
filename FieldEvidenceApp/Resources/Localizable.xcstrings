    "v30.signoff.enrollment.introduction": {
      "comment": "Screen: Signoff response enrollment screen. Meaning: Uses the English default “Add your typed response about this completed work. The response is your own local assertion and does not change the work record.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Signoff response enrollment screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your typed response about this completed work. The response is your own local assertion and does not change the work record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agregue su respuesta escrita sobre este trabajo completado. La respuesta es su propia afirmación local y no cambia el registro de trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "添加您对此已完成工作的输入回复。该回复是您自己的本地陈述，不会更改工作记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新增您對此已完成工作的輸入回應。該回應是您自己的本機聲明，不會變更工作記錄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thêm phản hồi đã nhập của bạn về công việc đã hoàn thành này. Phản hồi là khẳng định cục bộ của riêng bạn và không thay đổi hồ sơ công việc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "완료한 이 작업에 대한 입력 응답을 추가하십시오. 응답은 사용자의 로컬 주장일 뿐 작업 기록을 변경하지 않습니다."
          }
        }
      }
    },
