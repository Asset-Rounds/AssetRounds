    "v30.advanced-recurrence.reconciliation-suppressed": {
      "comment": "Screen: Advanced recurrence. Meaning: Reports the reconciliation suppressed state. Role: status label. Arguments: none. Plural/select: none. Accessibility: The combined label exposes this status to VoiceOver. Screenshot: Advanced recurrence status label state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder reconciliation is suppressed because the clock basis moved backward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conciliación de recordatorios se suprime porque la base del reloj retrocedió."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由于时钟依据向后移动，提醒协调被抑制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由於時間依據倒退，提醒協調已暫停。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đối soát lời nhắc bị chặn vì cơ sở đồng hồ đã lùi lại."
          }
