    "v30.voice-capture.capability-check-hint": {
      "comment": "App-owned source default; preserve the existing meaning and typed arguments.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech and grammar availability for the selected language are checked when you start. Manual entry remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La disponibilidad del reconocimiento de voz y de la gramática para el idioma seleccionado se verifica al comenzar. La entrada manual sigue disponible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "开始时会检查所选语言的语音和语法可用性。仍可手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開始時會檢查所選語言的語音與文法可用性。手動輸入仍可使用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khả năng giọng nói và ngữ pháp của ngôn ngữ đã chọn được kiểm tra khi bắt đầu. Vẫn có thể nhập thủ công."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시작할 때 선택한 언어의 음성 인식 및 문법 기능 사용 가능 여부를 확인합니다. 수동 입력은 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "v30.voice-capture.capture-cancellation-requested": {
      "comment": "Screen: Voice capture. Meaning: Reports capture cancellation requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation requested. Temporary capture scratch and any unfinished utterance remain subject to the caller's cleanup result; no draft effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó la cancelación. El espacio temporal de captura y cualquier expresión sin terminar permanecen sujetos al resultado de limpieza del llamador; no se declara efecto en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求取消。临时采集暂存内容和任何未完成的话语仍取决于调用方的清理结果；不声称草稿效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求取消。暫時擷取暫存資料及任何未完成話語仍取決於呼叫端的清理結果；不宣稱草稿效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu hủy. Bản nháp tạm thời của việc thu và mọi lời nói chưa hoàn tất vẫn tuân theo kết quả dọn dẹp của bên gọi; không tuyên bố ảnh hưởng đến bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "취소가 요청되었습니다. 임시 캡처 스크래치와 미완료 발화는 호출자의 정리 결과에 따릅니다. 초안 효과는 주장되지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.capture-heading": {
      "comment": "Screen: Voice capture. Meaning: Names the capture heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Voice capture section heading state; no screenshot is claimed.",
      "localizations": {
