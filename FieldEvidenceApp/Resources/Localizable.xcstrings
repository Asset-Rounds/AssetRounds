    "v30.advanced-recurrence.boundaries-description": {
      "comment": "Screen: Advanced recurrence. Meaning: Explains boundaries description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Advanced recurrence body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This surface does not request calendar permission, create a cloud schedule, run in the background, or claim a server result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta interfaz no solicita permiso de calendario, crea una programación en la nube, se ejecuta en segundo plano ni confirma un resultado del servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此界面不会请求日历权限、创建云端计划、在后台运行或声称取得了服务器结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此介面不會要求行事曆權限、建立雲端排程、在背景執行或聲稱取得伺服器結果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giao diện này không yêu cầu quyền truy cập lịch, tạo lịch trên đám mây, chạy nền hay khẳng định kết quả từ máy chủ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 화면은 캘린더 권한을 요청하거나 클라우드 일정을 만들거나 백그라운드에서 실행하거나 서버 결과를 확인하지 않습니다."
          }
        }
