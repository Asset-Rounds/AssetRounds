    "v30.service-request.dispositions-description": {
      "comment": "Screen: Service request. Meaning: Explains dispositions description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose only a separately supplied canonical disposition after reviewing the preview. This screen does not choose or persist one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elija solo una disposición canónica proporcionada por separado después de revisar la vista previa. Esta pantalla no elige ni conserva ninguna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "审核预览后，只选择单独提供的规范处置。此屏幕不会选择或持久保存处置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "審核預覽後，只能選擇另外提供的標準處置。此畫面不會選擇或保存處置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ chọn một cách xử lý chuẩn được cung cấp riêng sau khi xem xét bản xem trước. Màn hình này không chọn hoặc lưu một cách xử lý."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "미리보기를 검토한 후 별도로 제공된 기준 처리만 선택하십시오. 이 화면은 하나를 선택하거나 지속 저장하지 않습니다."
          }
        }
      }
    },
