    "v30.recipient-review.response-unavailable": {
      "comment": "Screen: Recipient review. Meaning: Explains response unavailable in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Recipient review body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A response cannot be created until the supplied manifest and request package are available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede crear una respuesta hasta que estén disponibles el manifiesto y el paquete de solicitud proporcionados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在提供的清单和请求包可用前，无法创建响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的資訊清單和請求套件可用後才能建立回應。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể tạo phản hồi cho đến khi có tệp kê khai và gói yêu cầu đã cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 매니페스트와 요청 패키지를 사용할 수 있을 때까지 응답을 만들 수 없습니다."
          }
        }
