    "import.preview.no_receipt_claim": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview does not claim saved, complete, rolled back, or exported results. Review accepted receipts and published files separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vista previa no declara resultados guardados, completados, revertidos ni exportados. Revise por separado los recibos aceptados y archivos publicados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "预览不声称已保存、已完成、已回滚或已导出的结果。请分别审核已接受的回执和已发布的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "預覽不主張已儲存、已完成、已復原或已匯出的結果。請分別審查已接受的回執和已發佈檔案。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xem trước không khẳng định kết quả đã được lưu, hoàn tất, hoàn tác hay xuất. Hãy xem xét riêng các biên nhận được chấp nhận và tệp đã công bố."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "미리보기는 저장, 완료, 롤백 또는 내보낸 결과를 주장하지 않습니다. 승인된 처리 확인서와 게시된 파일은 별도로 검토하세요."
          }
        }
      }
    },
