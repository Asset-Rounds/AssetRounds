    "v30.my-day.readiness-description": {
      "comment": "Screen: My Day. Meaning: Explains readiness description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: My Day body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due and readiness cues are derived at the supplied evaluation time. They do not prioritize, schedule, or mutate work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los indicadores de vencimiento y preparación se derivan en el momento de evaluación proporcionado. No priorizan, programan ni modifican trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "到期和就绪提示基于所提供的评估时间得出。它们不对工作进行优先级排序、安排或更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "到期與準備狀態提示會在提供的評估時間衍生。它們不會排定優先順序、排程或變更工作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tín hiệu đến hạn và sẵn sàng được dẫn xuất tại thời điểm đánh giá được cung cấp. Chúng không ưu tiên, lên lịch hoặc thay đổi công việc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기한 및 준비 상태 신호는 제공된 평가 시점에서 파생됩니다. 작업의 우선순위를 정하거나 일정을 잡거나 변경하지 않습니다."
          }
        }
      }
    },
    "v30.my-day.readiness-heading": {
      "comment": "Screen: My Day. Meaning: Names the readiness heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: My Day section heading state; no screenshot is claimed.",
      "localizations": {
