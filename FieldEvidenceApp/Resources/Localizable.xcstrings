    "v30.advanced-recurrence.unavailable-description": {
      "comment": "Screen: Advanced recurrence. Meaning: Explains unavailable description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Advanced recurrence body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The supplied schedule context could not be validated. No scheduling or reminder action is available from this screen."
