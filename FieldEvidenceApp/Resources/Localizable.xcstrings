    "v30.manual-work-resource.draft-boundary-description": {
      "comment": "Screen: Manual work resources. Meaning: Explains draft boundary description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Manual work resources body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stock movement is attempted only by the explicit Use from stock or Return to stock action. A saved entry or stock movement is shown only after its durable receipt returns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un movimiento de inventario se intenta solo mediante la acción explícita Usar del inventario o Devolver al inventario. Una entrada guardada o un movimiento de inventario se muestra solo después de que se devuelva su recibo duradero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有通过明确的“从库存使用”或“退回库存”操作才会尝试库存移动。只有在持久回执返回后才会显示已保存条目或库存移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有透過明確的「從庫存使用」或「退回庫存」動作才會嘗試庫存移動。只有在收到其持久回執後，才會顯示已儲存項目或庫存移動。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Di chuyển hàng tồn kho chỉ được thực hiện bằng thao tác rõ ràng Dùng từ kho hoặc Trả về kho. Mục đã lưu hoặc di chuyển kho chỉ hiển thị sau khi biên nhận bền vững của nó trả về."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재고 이동은 명시적인 재고 사용 또는 재고 반납 작업을 통해서만 시도됩니다. 저장된 항목 또는 재고 이동은 영구 처리 확인서가 반환된 후에만 표시됩니다."
          }
        }
      }
    },
