    "v30.voice-capture.privacy-boundary": {
      "comment": "Screen: Voice capture. Meaning: Explains privacy boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture is on-device only, nonpersistent, and has no cloud/network fallback or recording archive. Accepted or edited fields request the existing C56 ordinary draft authority; this screen never claims Saved, Complete, Verified, Approved, identity, authority, diagnosis, compliance, delivery, or legal effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La captura se realiza solo en el dispositivo, no es persistente y no tiene alternativa de nube o red ni archivo de grabación. Los campos aceptados o editados solicitan la autoridad ordinaria de borrador C56 existente; esta pantalla nunca declara Guardado, Completado, Verificado, Aprobado, identidad, autoridad, diagnóstico, cumplimiento, entrega ni efecto legal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "采集仅在设备上进行、非持久化，且没有云端/网络回退或录制存档。已接受或编辑的字段会请求现有 C56 常规草稿权限；此屏幕绝不声称已保存、已完成、已验证、已批准、身份、权限、诊断、合规、交付或法律效力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "擷取僅在裝置上進行、不具持久性，且沒有雲端／網路備援或錄製封存。已接受或編輯的欄位會要求既有 C56 一般草稿權限；此畫面絕不宣稱已儲存、已完成、已驗證、已核准、身分、權限、診斷、合規、交付或法律效力。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc thu thập chỉ diễn ra trên thiết bị, không bền vững và không có phương án dự phòng đám mây/mạng hoặc kho lưu trữ bản ghi. Các trường được chấp nhận hoặc chỉnh sửa yêu cầu quyền nháp thông thường C56 hiện có; màn hình này không bao giờ tuyên bố Đã lưu, Hoàn tất, Đã xác minh, Đã phê duyệt, danh tính, thẩm quyền, chẩn đoán, tuân thủ, gửi giao hoặc hiệu lực pháp lý."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "캡처는 기기 내 전용이며 비영속적이고 클라우드/네트워크 대체 수단이나 녹음 보관소가 없습니다. 수락하거나 편집한 필드는 기존 C56 일반 초안 권한을 요청합니다. 이 화면은 저장됨, 완료됨, 검증됨, 승인됨, 신원, 권한, 진단, 규정 준수, 납품 또는 법적 효력을 주장하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.processing-cancellation-requested": {
      "comment": "Screen: Voice capture. Meaning: Reports processing cancellation requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation requested. No transcript, proposal, or draft effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó la cancelación. No se declara transcripción, propuesta ni efecto en el borrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求取消。不声称转录、提案或草稿效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求取消。不宣稱逐字稿、提案或草稿效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu hủy. Không tuyên bố bản chép lời, đề xuất hoặc ảnh hưởng đến bản nháp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "취소가 요청되었습니다. 대화록, 제안 또는 초안 효과는 주장되지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.processing-description": {
      "comment": "Screen: Voice capture. Meaning: Explains processing description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The caller is processing the stopped capture on device. Review begins only after a validated StructuredVoiceProposalV1 is supplied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El componente solicitante está procesando en el dispositivo la captura detenida. La revisión comienza solo después de que se proporcione una StructuredVoiceProposalV1 validada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "调用方正在设备上处理已停止的采集。仅在提供经过验证的 StructuredVoiceProposalV1 后才开始审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "呼叫端正在裝置上處理已停止的擷取。只有在提供經驗證的 StructuredVoiceProposalV1 後，才會開始審閱。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bên gọi đang xử lý dữ liệu thu thập đã dừng trên thiết bị. Việc xem xét chỉ bắt đầu sau khi có StructuredVoiceProposalV1 đã được xác thực."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호출 측이 중지된 수집 데이터를 기기에서 처리하고 있습니다. 검증된 StructuredVoiceProposalV1이 제공된 후에만 검토가 시작됩니다."
          }
        }
      }
    },
    "v30.voice-capture.proposal-ready": {
      "comment": "Screen: Voice capture. Meaning: Explains proposal ready in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A validated proposal is ready. Review every field and choose Accept, Edit, or Reject before requesting review closure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hay una propuesta validada lista. Revise cada campo y elija Aceptar, Editar o Rechazar antes de solicitar el cierre de la revisión."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已验证的提案已就绪。请求审核关闭前，请检查每个字段并选择接受、编辑或拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已備妥已驗證的提案。請審核每個欄位，並在要求結束審核前選擇「接受」、「編輯」或「拒絕」。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đề xuất đã xác thực đã sẵn sàng. Hãy xem xét mọi trường và chọn Chấp nhận, Chỉnh sửa hoặc Từ chối trước khi yêu cầu đóng phiên xem xét."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "검증된 제안이 준비되었습니다. 검토 종료를 요청하기 전에 모든 필드를 검토하고 수락, 편집 또는 거부를 선택하십시오."
          }
        }
      }
    },
