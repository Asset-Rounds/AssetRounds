    "v30.voice-capture.operation-receipt": {
      "comment": "Screen: Voice capture. Meaning: Reports operation receipt to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The caller supplied an operation result. This view does not infer Saved, Complete, or any additional canonical effect."
