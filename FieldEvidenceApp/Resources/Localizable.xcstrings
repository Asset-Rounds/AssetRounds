    "lighting.night_workflow.claim_boundary": {
      "comment": "C18 cautious report limitation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report records field observations and attributed measurements. It is not an app-originated safety, compliance, code, ADA, IES, electrical diagnosis, adequacy, or commissioning determination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este informe registra observaciones de campo y mediciones atribuidas. No es una determinación de seguridad, cumplimiento, normativa, ADA, IES, diagnóstico eléctrico, idoneidad ni puesta en marcha emitida por la app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此报告记录现场观察和注明来源的测量，不属于应用作出的安全、合规、法规、ADA、IES、电气诊断、适用性或调试判定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此報告記錄現場觀察與註明來源的測量，不是 App 作出的安全、合規、法規、ADA、IES、電氣診斷、適足性或試運轉判定。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Báo cáo này ghi nhận quan sát thực địa và các phép đo có nêu nguồn. Đây không phải là kết luận do ứng dụng đưa ra về an toàn, tuân thủ, quy chuẩn, ADA, IES, chẩn đoán điện, mức độ đáp ứng hay nghiệm thu đưa vào sử dụng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 보고서는 현장 관찰과 출처가 명시된 측정값을 기록합니다. 앱이 내리는 안전성, 규정 준수, 법규, ADA, IES, 전기 진단, 적정성 또는 시운전 판정이 아닙니다."
          }
        }
      }
    },
