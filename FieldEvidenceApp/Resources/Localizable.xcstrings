    "activity.contract.claim_boundary": {
      "comment": "C47 truthful completion boundary.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completion does not claim approval, certification, compliance, commissioning, or safety clearance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La finalización no declara aprobación, certificación, cumplimiento, puesta en servicio ni autorización de seguridad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完成不声称批准、认证、合规、调试验收或安全许可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完成不宣稱核准、認證、合規、驗收或安全許可。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc hoàn tất không tuyên bố phê duyệt, chứng nhận, tuân thủ, nghiệm thu đưa vào vận hành hoặc xác nhận an toàn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "완료는 승인, 인증, 규정 준수, 시운전 또는 안전 허가를 주장하지 않습니다."
          }
        }
      }
    },
