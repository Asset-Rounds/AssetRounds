    "v30.parts-stock.use-requested": {
      "comment": "Screen: Parts & Stock. Meaning: Requested use against selected part. Role: operation status. Arguments: name String authoredSource x1. Plural/select: none. Accessibility: Read after Use from stock.. Screenshot: Parts & Stock visible state.",
