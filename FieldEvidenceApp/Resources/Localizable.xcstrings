    "v30.parts-stock.write-disabled": {
      "comment": "Screen: Parts & Stock. Meaning: Reports write disabled to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parts & Stock writes are disabled. Catalog reads, exact export, recovery, and existing drafts remain available; no stock effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las escrituras de Piezas e inventario están desactivadas. Las lecturas de catálogo, la exportación exacta, la recuperación y los borradores existentes permanecen disponibles; no se declara efecto en el inventario."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "零件和库存写入已禁用。目录读取、精确导出、恢复和现有草稿仍可用；不声称有库存影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已停用零件與庫存寫入。目錄讀取、精確匯出、復原及現有草稿仍可使用；不主張庫存效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã tắt thao tác ghi trong Linh kiện & Tồn kho. Vẫn có thể đọc danh mục, xuất chính xác, khôi phục và dùng bản nháp hiện có; không khẳng định tác động đến tồn kho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "부품 및 재고 쓰기가 비활성화되었습니다. 카탈로그 읽기, 정확한 내보내기, 복구 및 기존 초안은 계속 사용할 수 있으며 재고 효과는 주장되지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.write-protected-data-unavailable": {
      "comment": "Screen: Parts & Stock. Meaning: Reports write protected data unavailable to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected data is unavailable. No write was attempted; the existing draft and canonical state remain the source of truth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los datos protegidos no están disponibles. No se intentó ninguna escritura; el borrador existente y el estado canónico permanecen como fuente de verdad."
