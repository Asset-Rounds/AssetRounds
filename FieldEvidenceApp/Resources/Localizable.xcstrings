          }
        }
      }
    },
    "v30.parts-stock.state-feature-disabled": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state feature disabled to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes disabled; read, export, and recovery preserved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escrituras deshabilitadas; se conservan la lectura, exportación y recuperación"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "写入已禁用；保留读取、导出和恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "寫入已停用；保留讀取、匯出與復原"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã tắt ghi dữ liệu; vẫn giữ chức năng đọc, xuất và khôi phục"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "쓰기 비활성화됨; 읽기, 내보내기 및 복구 유지됨"
          }
        }
      }
    },
    "v30.parts-stock.state-feature-disabled-description": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state feature disabled description to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The feature policy preserves catalog reads, exact export, recovery, and existing drafts while blocking new Count, Adjust, Transfer, Use, Return, and Archive writes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La política de funciones conserva las lecturas del catálogo, la exportación exacta, la recuperación y los borradores existentes, y bloquea nuevas escrituras de Contar, Ajustar, Transferir, Usar, Devolver y Archivar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "功能政策保留目录读取、精确导出、恢复和现有草稿，同时阻止新增盘点、调整、转移、使用、退回和归档写入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "功能政策保留目錄讀取、精確匯出、復原及既有草稿，同時阻擋新的盤點、調整、轉移、使用、退回與封存寫入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chính sách chức năng giữ lại việc đọc danh mục, xuất chính xác, khôi phục và bản nháp hiện có, đồng thời chặn các lần ghi mới cho Kiểm kê, Điều chỉnh, Chuyển, Sử dụng, Trả lại và Lưu trữ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기능 정책은 카탈로그 읽기, 정확한 내보내기, 복구 및 기존 초안을 유지하면서 새로운 실사, 조정, 이동, 사용, 반납 및 보관 쓰기를 차단합니다."
          }
        }
      }
    },
    "v30.parts-stock.state-interrupted": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state interrupted to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupted; recovery needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Interrumpido; se necesita recuperación"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已中断；需要恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已中斷；需要復原"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bị gián đoạn; cần khôi phục"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "중단됨; 복구 필요"
          }
        }
      }
    },
    "v30.parts-stock.state-interrupted-description": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state interrupted description to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation was interrupted. Reload canonical projections before retrying; this view never infers a partial effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se interrumpió una operación. Vuelva a cargar las proyecciones canónicas antes de reintentar; esta vista nunca infiere un efecto parcial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "操作已中断。请重新加载规范投影后再重试；此视图绝不推断部分效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "作業已中斷。重試前請重新載入標準投影；此檢視絕不推斷部分效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một thao tác đã bị gián đoạn. Hãy tải lại các bản chiếu chuẩn trước khi thử lại; chế độ xem này không bao giờ suy ra hiệu ứng một phần."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업이 중단되었습니다. 다시 시도하기 전에 기준 조회용 데이터를 다시 불러오십시오. 이 보기는 부분 효과를 추론하지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.state-loading": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state loading to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading supplied local state"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cargando estado local proporcionado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在加载所提供的本地状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在載入提供的本機狀態"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đang tải trạng thái cục bộ đã cung cấp"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 로컬 상태 로드 중"
          }
        }
      }
    },
    "v30.parts-stock.state-loading-description": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state loading description to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The projection is not ready. No catalog mutation, draft save, import, return, or stock effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La proyección no está lista. No se confirma ninguna modificación del catálogo, guardado de borrador, importación, devolución ni efecto en existencias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "投影尚未就绪。不声称目录已变更、草稿已保存、已导入、已退回或库存产生了效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "投影尚未就緒。不聲稱目錄已變更、草稿已儲存、已匯入、已退回或庫存已產生效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản chiếu chưa sẵn sàng. Không khẳng định đã đổi danh mục, lưu bản nháp, nhập, trả lại hay tác động tới kho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "조회용 데이터가 준비되지 않았습니다. 카탈로그 변경, 초안 저장, 가져오기, 반납 또는 재고 반영 결과를 확인하지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.state-offline": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state offline to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline local operation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Operación local sin conexión"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "离线本地操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "離線本機操作"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thao tác cục bộ ngoại tuyến"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오프라인 로컬 작업"
          }
        }
      }
    },
    "v30.parts-stock.state-offline-description": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state offline description to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workflow is device-local and has no network dependency. Local reads, manual lookup, drafts, and owner-approved writes can remain available; no remote availability is inferred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este flujo de trabajo es local al dispositivo y no depende de la red. Las lecturas locales, la búsqueda manual, los borradores y las escrituras aprobadas por el responsable pueden seguir disponibles; no se infiere disponibilidad remota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此工作流仅在设备本地运行，不依赖网络。本地读取、手动查找、草稿和负责方批准的写入可保持可用；不推断远端可用性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此工作流程在裝置本機執行，不依賴網路。本機讀取、手動查找、草稿及負責方核准的寫入可保持可用；不推斷遠端可用性。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quy trình này chạy cục bộ trên thiết bị và không phụ thuộc mạng. Việc đọc cục bộ, tra cứu thủ công, bản nháp và ghi dữ liệu được chủ sở hữu phê duyệt có thể vẫn khả dụng; không suy ra khả năng truy cập từ xa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 워크플로는 기기 내에서 실행되며 네트워크에 의존하지 않습니다. 로컬 읽기, 수동 조회, 초안 및 담당 주체가 승인한 쓰기는 계속 사용할 수 있으나 원격 사용 가능 여부를 추정하지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.state-protected-data": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state protected data to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
