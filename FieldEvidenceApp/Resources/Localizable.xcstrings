    "v30.parts-stock.state-stale-description": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state stale description to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The supplied revision is stale. Reload the catalog and operation frontier before retrying the same intent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La revisión proporcionada está desactualizada. Vuelva a cargar el catálogo y el límite actual de operaciones antes de reintentar la misma intención."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的修订版已过期。请重新加载目录和操作边界后，再重试同一意图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的修訂版已過期。請重新載入目錄及操作前緣後，再重試同一意圖。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phiên bản được cung cấp đã cũ. Hãy tải lại danh mục và mốc thao tác mới nhất trước khi thử lại cùng ý định."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 개정본이 오래되었습니다. 같은 의도로 다시 시도하기 전에 카탈로그와 최신 작업 경계를 다시 불러오세요."
          }
        }
      }
    },
    "v30.parts-stock.state-storage-unavailable": {
      "comment": "Screen: Parts & Stock. Meaning: Reports state storage unavailable to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Parts & Stock operation or state message state; no screenshot is claimed.",
