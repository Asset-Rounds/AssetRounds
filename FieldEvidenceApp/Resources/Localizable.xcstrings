    "v30.rating-support.not-eligible-description": {
      "comment": "Screen: Rating and support. Meaning: Explains not eligible description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Rating and support body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue using the app normally. Support and Recovery remain available without waiting for rating eligibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siga usando la app normalmente. Soporte y Recuperación permanecen disponibles sin esperar la elegibilidad de calificación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
