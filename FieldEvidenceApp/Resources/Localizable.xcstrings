    "v30.service-request.preview-description": {
      "comment": "Screen: Service request. Meaning: Explains preview description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing the supplied preview must remain zero-write. It does not accept, import, link, dispatch, or create work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La actualización de la vista previa proporcionada debe mantenerse sin escritura. No acepta, importa, vincula, envía ni crea trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "刷新所提供的预览必须保持零写入。它不会接受、导入、链接、派送或创建工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更新提供的預覽必須維持零寫入，不會接受、匯入、連結、派工或建立工作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Việc làm mới bản xem trước được cung cấp phải vẫn là không ghi. Nó không chấp nhận, nhập, liên kết, gửi đi hoặc tạo công việc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 미리보기를 새로 고쳐도 쓰기 0을 유지해야 합니다. 승인, 가져오기, 연결, 발송 또는 작업 생성을 하지 않습니다."
          }
        }
      }
    },
