        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This attempt is interrupted. Recover only by replaying the same supplied mutation identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este intento está interrumpido. Recupérelo solo repitiendo la misma identidad de modificación proporcionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此次尝试已中断。仅可通过重放提供的同一变更标识来恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此次嘗試已中斷。只能重播提供的相同變更識別碼來復原。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lần thử này đã bị gián đoạn. Chỉ khôi phục bằng cách thực hiện lại cùng mã định danh thay đổi được cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이번 시도가 중단되었습니다. 제공된 동일한 변경 식별자로 재실행하는 방법으로만 복구하세요."
          }
        }
      }
    },
    "v30.punch.review.introduction": {
      "comment": "Screen: Punch-review workflow screen. Meaning: Uses the English default “Prepare and record the standalone review from its canonical activity record. Installation context is optional and read-only.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Punch-review workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare and record the standalone review from its canonical activity record. Installation context is optional and read-only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepare y registre la revisión independiente a partir de su registro de actividad canónico. El contexto de instalación es opcional y de solo lectura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从其规范活动记录准备并记录独立审核。安装上下文是可选且只读的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從其標準活動記錄準備並記錄獨立審查。安裝內容為選填且唯讀。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chuẩn bị và ghi nhận lượt xem xét độc lập từ bản ghi hoạt động chuẩn của nó. Ngữ cảnh lắp đặt là tùy chọn và chỉ đọc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기준 활동 기록에서 독립형 검토를 준비하고 기록합니다. 설치 컨텍스트는 선택 사항이며 읽기 전용입니다."
          }
        }
      }
    },
