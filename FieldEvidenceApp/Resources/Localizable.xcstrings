    "v30.asset.import.truth.boundary": {
      "comment": "Screen: Party/contact/Site-role import screen. Meaning: Uses the English default “Preview only means that no canonical state has been written. A commit is explicit and uses one synthetic aggregate row and one canonical workspace command.”. Role: visible explanatory Text. Arguments: none. Plural/select: none. Accessibility: This visible explanatory Text is available in normal VoiceOver traversal. Screenshot: Party/contact/Site-role import screen. state where this visible explanatory Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview only means that no canonical state has been written. A commit is explicit and uses one synthetic aggregate row and one canonical workspace command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vista previa solo significa que no se ha escrito ningún estado canónico. Una confirmación es explícita y usa una fila agregada sintética y un comando canónico de espacio de trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "预览仅表示未写入规范状态。提交必须明确，并使用一行合成聚合行和一个规范工作区命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅預覽表示尚未寫入任何標準狀態。提交是明確的，並使用一個合成彙總列和一個標準工作區命令。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ xem trước nghĩa là chưa ghi trạng thái chuẩn nào. Việc ghi chính thức là chủ động và sử dụng một dòng tổng hợp giả lập cùng một lệnh không gian làm việc chuẩn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "미리보기만은 기준 상태가 기록되지 않았음을 의미합니다. 확정 저장은 명시적이며 합성 집계 행 하나와 기준 작업 공간 명령 하나를 사용합니다."
          }
        }
      }
    },
