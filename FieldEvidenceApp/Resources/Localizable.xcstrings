        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择原因会显示以供审核。未更改的声明不属于新证据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選取原因會顯示供審閱。未變更的聲明不是新的證據。"
          }
        },
        "vi": {
