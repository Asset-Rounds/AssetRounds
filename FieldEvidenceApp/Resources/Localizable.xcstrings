        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribir o editar este borrador nunca cambia las existencias. Guardar un punto de control sigue siendo una acción explícita del componente solicitante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "键入或编辑此草稿绝不会更改库存。设置检查点仍需调用方明确操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "鍵入或編輯此草稿絕不變更庫存。建立檢查點仍需呼叫端明確操作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập hoặc chỉnh sửa bản nháp này không bao giờ thay đổi tồn kho. Lưu mốc vẫn là thao tác do bên gọi chủ động thực hiện."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 초안을 입력하거나 편집해도 재고는 변경되지 않습니다. 저장 지점 생성은 호출 측의 명시적인 작업으로 유지됩니다."
          }
        }
      }
    },
