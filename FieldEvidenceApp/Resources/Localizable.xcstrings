    "v30.party.contact.workflow.site.role.notice": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Uses the English default “Assign and end Site roles through append-only supplied events. Customer is a presentation label for a Site; this view does not create a Party from that label.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Party/contact/Site-role workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign and end Site roles through append-only supplied events. Customer is a presentation label for a Site; this view does not create a Party from that label."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Asigne y finalice roles de Sitio mediante eventos proporcionados de solo anexado. Cliente es una etiqueta de presentación para un Sitio; esta vista no crea una Parte a partir de esa etiqueta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过仅追加的提供事件分配和结束站点角色。客户是站点的展示标签；此视图不会根据该标签创建参与方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "透過僅附加的提供事件指派及結束場所角色。客戶是場所的呈現標籤；此檢視不會從該標籤建立對象。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gán và kết thúc vai trò Địa điểm thông qua các sự kiện được cung cấp chỉ thêm. Khách hàng là nhãn trình bày cho một Địa điểm; chế độ xem này không tạo Bên từ nhãn đó."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "추가 전용 제공 이벤트를 통해 현장 역할을 할당하고 종료합니다. 고객은 현장의 표시 레이블이며, 이 보기는 해당 레이블에서 당사자를 만들지 않습니다."
          }
        }
      }
    },
    "v30.party.contact.workflow.site.role.reversal.confirmation": {
      "comment": "Screen: Party/contact/Site-role workflow screen. Meaning: Uses the English default “Site-role reversal preserves the historical predecessor and requests one supplied successor action. It does not erase history or claim completion.”. Role: button label. Arguments: none. Plural/select: none. Accessibility: SwiftUI exposes it as the button label. Screenshot: Party/contact/Site-role workflow screen. state where this button label is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Site-role reversal preserves the historical predecessor and requests one supplied successor action. It does not erase history or claim completion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La reversión de rol del sitio conserva el predecesor histórico y solicita una acción sucesora proporcionada. No borra el historial ni confirma finalización."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "撤销场所角色会保留历史前项，并请求一个提供的后续操作，不会抹掉历史或声称已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "撤銷場所角色會保留歷史前項，並要求一項提供的後續動作；不會清除歷程或聲稱已完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đảo ngược vai trò tại địa điểm giữ lại bản ghi lịch sử trước đó và yêu cầu một hành động kế tiếp được cung cấp. Không xóa lịch sử hay khẳng định hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "현장 역할 되돌리기는 이전 이력을 유지하고 제공된 후속 작업 하나를 요청합니다. 이력을 삭제하거나 완료를 확인하지 않습니다."
          }
        }
      }
    },
