    "v30.rating-support.status-ineligible": {
      "comment": "Screen: Rating and support. Meaning: Reports status ineligible to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Rating and support operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The supplied natural-stop state was not eligible, so no native rating request was made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El estado de pausa natural proporcionado no cumplía los requisitos, por lo que no se hizo ninguna solicitud nativa de calificación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的自然停止状态不符合条件，因此未发起原生评分请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提供的自然停止狀態不符合條件，因此未提出原生評分要求。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trạng thái điểm dừng tự nhiên được cung cấp không đủ điều kiện nên không gửi yêu cầu đánh giá bằng giao diện hệ thống."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 자연스러운 중단 시점의 상태가 조건을 충족하지 않아 시스템 평가 요청을 하지 않았습니다."
          }
        }
      }
    },
    "v30.rating-support.status-pending": {
      "comment": "Screen: Rating and support. Meaning: Reports status pending to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Rating and support operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AssetRounds conservatively recorded a request attempt while its final local status is pending. The system may show nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AssetRounds registró prudentemente un intento de solicitud mientras su estado local final está pendiente. Es posible que el sistema no muestre nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在最终本地状态待定时，AssetRounds 已谨慎记录请求尝试。系统可能不会显示任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AssetRounds 在最終本機狀態待定時，保守地記錄了要求嘗試。系統可能不會顯示任何內容。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AssetRounds đã thận trọng ghi nhận một lần thử yêu cầu trong khi trạng thái cục bộ cuối cùng đang chờ xử lý. Hệ thống có thể không hiển thị gì."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AssetRounds가 최종 로컬 상태가 보류 중인 동안 요청 시도를 보수적으로 기록했습니다. 시스템에 아무것도 표시되지 않을 수 있습니다."
          }
        }
      }
    },
    "v30.rating-support.status-requested": {
      "comment": "Screen: Rating and support. Meaning: Reports status requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Rating and support operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AssetRounds asked the system to consider a rating request. The system may show nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AssetRounds pidió al sistema que considere una solicitud de calificación. Es posible que el sistema no muestre nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AssetRounds 已请求系统考虑评分请求。系统可能不会显示任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AssetRounds 已要求系統考慮評分要求。系統可能不會顯示任何內容。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AssetRounds đã yêu cầu hệ thống xem xét yêu cầu đánh giá. Hệ thống có thể không hiển thị gì."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AssetRounds가 시스템에 평가 요청을 고려하도록 요청했습니다. 시스템에 아무것도 표시되지 않을 수 있습니다."
          }
        }
      }
    },
    "v30.rating-support.system-boundary": {
      "comment": "Screen: Rating and support. Meaning: Explains system boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Rating and support body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system controls whether a native rating request appears. The App Store link and the existing support/recovery routes remain separate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El sistema controla si aparece una solicitud nativa de calificación. El enlace al App Store y las vías existentes de soporte y recuperación permanecen separados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系统决定是否显示原生评分请求。App Store 链接与现有支持/恢复途径保持独立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系統決定是否顯示原生評分要求。App Store 連結與既有支援／復原途徑保持獨立。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hệ thống quyết định có hiển thị yêu cầu đánh giá bằng giao diện hệ thống hay không. Liên kết App Store và các đường dẫn hỗ trợ/khôi phục hiện có vẫn tách biệt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템이 자체 평가 요청의 표시 여부를 결정합니다. App Store 링크와 기존 지원 및 복구 경로는 별개로 유지됩니다."
          }
        }
      }
    },
