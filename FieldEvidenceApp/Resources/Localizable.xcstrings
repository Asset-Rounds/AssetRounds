        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La jurisdicción del sitio de trabajo sigue limitada a la jurisdicción de Estados Unidos registrada; el idioma y el formato no habilitan otra jurisdicción."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作地点的管辖范围仍限于已记录的美国管辖区域；语言和格式不会启用其他管辖区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
