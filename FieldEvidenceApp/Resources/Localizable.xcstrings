    },
    "v30.parts-stock.archive-blocked": {
      "comment": "Screen: Parts & Stock. Meaning: Explains archive blocked in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive is blocked until all affected locations are known zero. UNKNOWN is not a zero balance and is never silently abandoned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El archivo está bloqueado hasta que todas las ubicaciones afectadas se conozcan como cero. UNKNOWN no es un saldo cero y nunca se abandona silenciosamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在所有受影响位置均已知为零之前，归档会被阻止。UNKNOWN 不是零余额，绝不会被悄然放弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在所有受影響位置皆已知為零之前，無法封存。UNKNOWN 不是零餘額，絕不會被悄悄放棄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể lưu trữ cho đến khi mọi địa điểm bị ảnh hưởng được biết là bằng không. UNKNOWN không phải là số dư bằng không và không bao giờ bị bỏ qua một cách im lặng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "영향을 받는 모든 위치가 알려진 영이 될 때까지 보관이 차단됩니다. UNKNOWN은 영 잔액이 아니며 절대 조용히 포기되지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.archive-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Explains archive hint in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives only after every affected location is supplied as known zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Archiva solo después de que cada ubicación afectada se proporcione como cero conocido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在每个受影响位置均提供为已知零后归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有在每個受影響位置都提供為已知零值後才會封存。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ lưu trữ sau khi mọi địa điểm bị ảnh hưởng được cung cấp là bằng không đã biết."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "영향을 받는 모든 위치가 알려진 영으로 제공된 후에만 보관합니다."
          }
        }
      }
    },
    "v30.parts-stock.archive-unavailable-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Explains archive unavailable hint in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive is unavailable until every affected location is known zero or its explicit unknown disposition is handled by the canonical owner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Archivar no está disponible hasta que cada ubicación afectada se conozca como cero o el propietario canónico gestione su disposición explícita de desconocido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在每个受影响位置均已知为零，或其明确未知处置已由规范所有者处理之前，归档不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "直到每個受影響位置皆已知為零，或其明確的未知處置已由標準擁有者處理前，無法封存。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể lưu trữ cho đến khi mọi địa điểm bị ảnh hưởng được biết là bằng không hoặc việc xử lý rõ ràng tình trạng không xác định của chúng được chủ sở hữu chuẩn xử lý."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "영향을 받는 모든 위치가 알려진 영이 되거나 명시적 미확인 처리가 기준 소유자에 의해 처리될 때까지 보관을 사용할 수 없습니다."
          }
        }
      }
    },
