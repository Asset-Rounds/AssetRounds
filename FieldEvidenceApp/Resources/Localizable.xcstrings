        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple provided a signed grace period. Access does not continue beyond that signed date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple proporcionó un período de gracia firmado. El acceso no continúa después de esa fecha firmada."
          }
