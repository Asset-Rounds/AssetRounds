    "v30.parts-stock.scan-hint": {
      "comment": "Screen: Parts & Stock. Meaning: Guides use of the scan hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Parts & Stock accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans a stock-namespaced code for local lookup. Manual lookup remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escanea un código del espacio de nombres de existencias para buscarlo localmente. La búsqueda manual sigue disponible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扫描库存命名空间中的代码以在本地查找。仍可手动查找。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "掃描庫存命名空間代碼以進行本機查找。仍可手動查找。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quét mã thuộc không gian tên kho để tra cứu cục bộ. Vẫn có thể tra cứu thủ công."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재고 네임스페이스의 코드를 스캔하여 로컬에서 조회합니다. 수동 조회도 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "v30.parts-stock.scan-requested": {
      "comment": "Screen: Parts & Stock. Meaning: Explains scan requested in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested a stock-code scan. Scanning remains query-only; no stock effect is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó un escaneo de código de existencias. El escaneo continúa siendo solo de consulta; no se afirma ningún efecto sobre las existencias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求库存代码扫描。扫描仍仅作查询；不声称有库存影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求掃描庫存代碼。掃描仍僅供查詢；不聲稱產生庫存效果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu quét mã tồn kho. Việc quét vẫn chỉ là truy vấn; không tuyên bố ảnh hưởng tồn kho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재고 코드 스캔을 요청했습니다. 스캔은 조회 전용으로 유지되며 재고 효과는 주장되지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.scan-unavailable": {
      "comment": "Screen: Parts & Stock. Meaning: Explains scan unavailable in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan is unavailable here. Enter a stock code manually; no scan permission or network lookup is required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El escaneo no está disponible aquí. Ingrese manualmente un código de existencias; no se requiere permiso de escaneo ni búsqueda de red."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此处无法扫描。请手动输入库存代码；无需扫描权限或网络查询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此處無法掃描。請手動輸入庫存代碼；不需要掃描權限或網路查找。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể quét ở đây. Hãy nhập mã kho thủ công; không cần quyền quét hay tra cứu qua mạng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기에서는 스캔을 사용할 수 없습니다. 재고 코드를 직접 입력하세요. 스캔 권한이나 네트워크 조회는 필요하지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.search-boundary": {
      "comment": "Screen: Parts & Stock. Meaning: Explains search boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing or scanning a material line changes no stock. Only the explicit Use from stock action can request a stock mutation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribir o escanear una línea de material no cambia las existencias. Solo la acción explícita Usar existencias puede solicitar una modificación de existencias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "键入或扫描材料行不会更改库存。只有明确的“从库存使用”操作才能请求库存变更。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "鍵入或掃描材料列不變更庫存。只有明確的「從庫存使用」動作可要求庫存異動。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập hoặc quét một dòng vật tư không thay đổi tồn kho. Chỉ thao tác chủ động Sử dụng từ kho mới có thể yêu cầu thay đổi tồn kho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자재 행을 입력하거나 스캔해도 재고는 변경되지 않습니다. 명시적인 재고에서 사용 작업만 재고 변경을 요청할 수 있습니다."
          }
        }
      }
    },
    "v30.parts-stock.search-catalog": {
      "comment": "Screen: Parts & Stock. Meaning: Names the search catalog action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Parts & Stock button title state; no screenshot is claimed.",
