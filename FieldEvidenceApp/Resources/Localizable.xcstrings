    "v30.service-request.heading-description": {
      "comment": "Screen: Service request. Meaning: Explains heading description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review a supplied request, its zero-write preview, and explicit next actions. Requester, contact, urgency, and source details remain unverified assertions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revise una solicitud proporcionada, su vista previa sin escrituras y las siguientes acciones explícitas. El solicitante, contacto, urgencia y detalles de origen siguen siendo declaraciones no verificadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "审阅提供的请求、其零写入预览及明确的后续操作。请求方、联系方式、紧急程度和来源详情仍为未经验证的声明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "審閱提供的請求、零寫入預覽及明確的下一步動作。請求人、聯絡方式、急迫程度與來源詳情仍是未驗證的聲明。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xem xét yêu cầu được cung cấp, bản xem trước không ghi dữ liệu và các bước tiếp theo rõ ràng. Người yêu cầu, liên hệ, mức khẩn cấp và chi tiết nguồn vẫn là lời khai chưa xác minh."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제공된 요청, 데이터를 기록하지 않는 미리보기 및 명시적인 다음 작업을 검토합니다. 요청자, 연락처, 긴급도 및 출처 세부 정보는 검증되지 않은 주장으로 유지됩니다."
          }
        }
      }
    },
    "v30.service-request.manual-description": {
      "comment": "Screen: Service request. Meaning: Explains manual description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Service request body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual intake is a supplied local source. This surface does not claim a call, message, requester identity, contact verification, urgency verification, or dispatch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La recepción manual es un origen local proporcionado. Esta superficie no declara una llamada, mensaje, identidad del solicitante, verificación de contacto, verificación de urgencia ni envío."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手动接收是所提供的本地来源。此界面不作出电话、消息、请求方身份、联系人验证、紧急性验证或派遣声明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手動接收是提供的本機來源。此介面不聲稱有通話、訊息、請求者身分、聯絡驗證、緊急性驗證或派遣。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiếp nhận thủ công là nguồn cục bộ được cung cấp. Bề mặt này không tuyên bố về cuộc gọi, tin nhắn, danh tính người yêu cầu, xác minh liên hệ, xác minh tính khẩn cấp hoặc điều phối."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수동 접수는 제공된 로컬 원본입니다. 이 화면은 통화, 메시지, 요청자 신원, 연락처 확인, 긴급성 확인 또는 파견을 주장하지 않습니다."
          }
        }
