    "v30.parts-stock.export-requested": {
      "comment": "Screen: Parts & Stock. Meaning: Requested catalog CSV export. Role: operation status. Arguments: identifier String opaqueIdentifier x1. Plural/select: none. Accessibility: Read after Export catalog CSV.. Screenshot: Parts & Stock visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested deterministic %@ export. No delivery, sync, or provider result is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó una exportación determinista de %@. No se afirma ningún resultado de entrega, sincronización ni proveedor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求确定性 %@ 导出。不声称有交付、同步或提供者结果。"
          }
