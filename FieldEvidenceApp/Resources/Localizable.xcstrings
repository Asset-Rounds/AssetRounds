    "v30.incumbent-file-adapter.truth-boundary-description": {
      "comment": "Screen: Data & Portability. Meaning: Explains truth boundary description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Data & Portability body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No adapter profile is selected automatically, and no command here browses a provider, creates an account, opens a network connection, or claims a provider result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se selecciona automáticamente ningún perfil de adaptador y ningún comando aquí explora un proveedor, crea una cuenta, abre una conexión de red ni declara un resultado de proveedor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不会自动选择适配器配置文件，此处没有命令可浏览提供商、创建帐户、打开网络连接或声明提供商结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未自動選取任何轉接器設定檔，且此處的命令不會瀏覽提供者、建立帳戶、開啟網路連線或聲稱提供者結果。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có cấu hình bộ điều hợp nào được chọn tự động và không có lệnh nào ở đây duyệt nhà cung cấp, tạo tài khoản, mở kết nối mạng hoặc tuyên bố kết quả từ nhà cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "어댑터 프로필은 자동으로 선택되지 않으며, 여기의 어떤 명령도 제공자를 탐색하거나 계정을 만들거나 네트워크 연결을 열거나 제공자 결과를 주장하지 않습니다."
          }
        }
      }
