    "v30.voice-capture.operation-status-heading": {
      "comment": "Screen: Voice capture. Meaning: Names the operation status heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Voice capture section heading state; no screenshot is claimed.",
      "localizations": {
