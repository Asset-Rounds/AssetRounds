    "v30.voice-capture.speak-details": {
      "comment": "Screen: Voice capture. Meaning: Names the speak details action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Voice capture button title state; no screenshot is claimed.",
