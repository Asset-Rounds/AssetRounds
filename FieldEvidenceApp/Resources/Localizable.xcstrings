    "v30.parts-stock.recovery-description": {
      "comment": "Screen: Parts & Stock. Meaning: Explains recovery description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No partial stock, catalog, draft, import, or return effect is inferred. Review the supplied projection and retry the same typed command when the owner reports a recoverable state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se infiere ningún efecto parcial en existencias, catálogo, borrador, importación o devolución. Revise la proyección proporcionada y reintente el mismo comando tipado cuando el componente responsable informe un estado recuperable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不推断任何部分库存、目录、草稿、导入或退回效果。请查看提供的投影，并在负责方报告可恢复状态时重试同一类型化命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不推斷任何部分庫存、目錄、草稿、匯入或退回效果。請審閱提供的投影，並於負責方回報可復原狀態時，重試相同的型別化命令。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không suy ra thay đổi một phần nào đối với kho, danh mục, bản nháp, nhập dữ liệu hoặc trả lại. Hãy xem bản chiếu được cung cấp và thử lại cùng lệnh có kiểu khi bên quản lý báo trạng thái có thể khôi phục."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재고, 카탈로그, 초안, 가져오기 또는 반품이 일부만 반영되었다고 추정하지 않습니다. 제공된 조회용 데이터를 검토하고 담당 주체가 복구 가능한 상태임을 알리면 같은 형식의 명령을 다시 시도하세요."
          }
        }
      }
    },
    "v30.parts-stock.report-boundary": {
      "comment": "Screen: Parts & Stock. Meaning: Explains report boundary in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customer-safe work-material reports contain only reviewed material snapshots. They never contain stock balances or internal storage locations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los informes de materiales de trabajo aptos para el cliente contienen solo instantáneas revisadas de materiales. Nunca contienen saldos de inventario ni ubicaciones internas de almacenamiento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "适合客户查看的工作材料报告仅包含已审核的材料快照，绝不包含库存余额或内部存放位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "適合客戶查看的工作材料報告僅包含經審閱的材料快照，絕不包含庫存餘額或內部存放位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Báo cáo vật tư công việc dành cho khách hàng chỉ chứa ảnh chụp dữ liệu vật tư đã được xem xét. Báo cáo không bao giờ chứa số dư tồn kho hoặc vị trí lưu trữ nội bộ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "고객 공개용 작업 자재 보고서에는 검토된 자재 스냅샷만 포함됩니다. 재고 잔량이나 내부 보관 위치는 포함되지 않습니다."
          }
        }
      }
    },
