    "v30.voice-capture.discard-hint": {
      "comment": "Screen: Voice capture. Meaning: Guides use of the discard hint control. Role: accessibility hint. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this hint after the associated control label. Screenshot: Voice capture accessibility hint state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejects the complete proposal through the existing review authority without changing the existing draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rechaza la propuesta completa mediante la autoridad de revisión existente sin cambiar el borrador actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过现有审核权限拒绝完整提议，而不更改现有草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "透過既有審閱授權拒絕整份提案，不變更既有草稿。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Từ chối toàn bộ đề xuất thông qua quyền xem xét hiện có mà không thay đổi bản nháp hiện có."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기존 초안을 변경하지 않고 기존 검토 권한을 통해 전체 제안을 거부합니다."
          }
        }
      }
    },
    "v30.voice-capture.discard-requested": {
      "comment": "Screen: Voice capture. Meaning: Reports discard requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard requested. Rejected suggestions remain nonpersistent; no draft rollback or completion is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se solicitó el descarte. Las sugerencias rechazadas permanecen no persistentes; no se declara reversión del borrador ni finalización."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已请求丢弃。被拒绝的建议仍不持久保存；不声称草稿回滚或完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已要求捨棄。已拒絕的建議仍不會保存；不宣稱草稿還原或完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã yêu cầu loại bỏ. Các đề xuất bị từ chối vẫn không được lưu; không tuyên bố hoàn tác bản nháp hoặc hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "폐기를 요청했습니다. 거부된 제안은 비영속 상태로 유지되며 초안 롤백이나 완료를 주장하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.discard-suggestions": {
      "comment": "Screen: Voice capture. Meaning: Names the discard suggestions action. Role: button title. Arguments: none. Plural/select: none. Accessibility: VoiceOver announces this title for the control. Screenshot: Voice capture button title state; no screenshot is claimed.",
