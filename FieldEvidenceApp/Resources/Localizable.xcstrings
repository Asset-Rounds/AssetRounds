    "v30.rating-support.rate-description": {
      "comment": "Screen: Rating and support. Meaning: Explains rate description in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Rating and support body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the verified App Store rating link when you choose. This is separate from any automatic system request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra el enlace de calificación verificado de App Store cuando lo elija. Esto es independiente de cualquier solicitud automática del sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您选择时可打开已验证的 App Store 评分链接。这与任何自动系统请求分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您選擇時可開啟已驗證的 App Store 評分連結。這與任何自動系統請求分開。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở liên kết đánh giá App Store đã xác minh khi bạn chọn. Liên kết này tách biệt với mọi yêu cầu hệ thống tự động."
          }
        },
        "ko": {
