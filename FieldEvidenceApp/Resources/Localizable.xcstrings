    "v30.voice-capture.manual-requested": {
      "comment": "Screen: Voice capture. Meaning: Reports manual requested to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Voice capture operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual-entry request sent to the existing draft authority. No Saved or Complete claim is made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se envió la solicitud de entrada manual a la autoridad de borrador existente. No se declara Guardado ni Completado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手动输入请求已发送至现有草稿权限。未作出“已保存”或“完成”声明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手動輸入請求已傳送至現有草稿權限。未聲稱已儲存或完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu nhập thủ công đã gửi đến quyền bản nháp hiện có. Không đưa ra tuyên bố Đã lưu hoặc Hoàn tất."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기존 초안 권한에 수동 입력 요청을 보냈습니다. 저장됨 또는 완료됨을 주장하지 않습니다."
          }
        }
      }
    },
    "v30.voice-capture.manual-value-too-long": {
      "comment": "Screen: Voice capture. Meaning: Explains manual value too long in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The manual draft text is above the bounded input limit. Use a shorter value and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El texto del borrador manual supera el límite de entrada. Use un valor más corto e inténtelo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手动草稿文本超出输入限制。请使用较短内容后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手動草稿文字超過輸入上限。請縮短內容後重試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Văn bản bản nháp thủ công vượt giới hạn đầu vào. Hãy rút ngắn và thử lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수동 초안 텍스트가 입력 한도를 초과했습니다. 더 짧은 값을 사용하여 다시 시도하세요."
          }
        }
      }
    },
    "v30.voice-capture.material-quantity": {
      "comment": "Screen: Voice capture. Meaning: Material quantity and material text. Role: visible proposed value. Arguments: value String formattedPresentation x1; unit String formattedPresentation x1; material String authoredSource x1. Plural/select: none. Accessibility: Read in Review each field.. Screenshot: Voice capture visible state.",
