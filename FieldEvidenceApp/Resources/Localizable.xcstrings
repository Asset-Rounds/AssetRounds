    "v30.recipient-review.application-complete": {
      "comment": "Screen: Recipient review. Meaning: Reports application complete to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Recipient review operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The explicit canonical application completed. Refresh from the current workspace record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La aplicación canónica explícita finalizó. Actualice desde el registro actual del espacio de trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明确的规范数据应用操作已完成。请从当前工作区记录刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明確的標準資料套用已完成。請從目前工作區記錄更新資料。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã hoàn tất việc áp dụng rõ ràng vào dữ liệu chuẩn. Hãy làm mới từ bản ghi không gian làm việc hiện tại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명시적인 기준 데이터 적용이 완료되었습니다. 현재 작업 공간 기록에서 새로 고치세요."
          }
        }
      }
    },
    "v30.recipient-review.boundaries-heading": {
      "comment": "Screen: Recipient review. Meaning: Names the boundaries heading section. Role: section heading. Arguments: none. Plural/select: none. Accessibility: The header trait and VoiceOver announce it as a section heading. Screenshot: Recipient review section heading state; no screenshot is claimed.",
