    "v30.parts-stock.catalog-summary": {
      "comment": "Screen: Parts & Stock. Meaning: Catalog item unit, identity count, and revision. Role: visible catalog summary. Arguments: unit String formattedPresentation x1; identityCount Int aggregateCount x1; revision String opaqueIdentifier x1. Plural/select: independent English one/other catalog substitutions for identityCount; other arguments are not plural selectors. Accessibility: Read for each catalog item.. Screenshot: Parts & Stock visible state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unit: %1$@; %#@identityCount@; revision: %3$@"
          },
          "substitutions": {
            "identityCount": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "product identity: %arg"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "product identities: %arg"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unidad: %1$@; %#@identityCount@; revisión: %3$@"
          },
          "substitutions": {
            "identityCount": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "identidad de producto: %arg"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "identidades de producto: %arg"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
