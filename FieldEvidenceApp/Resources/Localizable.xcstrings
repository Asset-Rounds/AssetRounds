    "v30.rating-support.reason-active-context": {
      "comment": "Screen: Rating and support. Meaning: Reports reason active context to the user. Role: operation or state message. Arguments: none. Plural/select: none. Accessibility: Read as status content when the current operation or state is presented. Screenshot: Rating and support operation or state message state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An active task or recovery context keeps automatic requests paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una tarea activa o un contexto de recuperación mantiene en pausa las solicitudes automáticas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "活动任务或恢复上下文会使自动请求保持暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "作用中的工作或復原情境會使自動要求維持暫停。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
