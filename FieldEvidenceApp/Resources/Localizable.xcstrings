    "v30.asset.import.begin.disclosure": {
      "comment": "Screen: Party/contact/Site-role import screen. Meaning: Uses the English default “Starting a session records resumable import progress; it does not write canonical Party, contact, or Site-role state.”. Role: VoiceOver hint. Arguments: none. Plural/select: none. Accessibility: Passed to an accessibilityHint modifier; VoiceOver reads it after the associated control label. Screenshot: Party/contact/Site-role import screen. state where this VoiceOver hint is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting a session records resumable import progress; it does not write canonical Party, contact, or Site-role state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iniciar una sesión registra el progreso de importación que se puede reanudar; no escribe el estado canónico de partes, contactos ni roles del sitio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "启动会话会记录可继续的导入进度，不会写入规范的主体、联系人或场所角色状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "啟動工作階段會記錄可繼續的匯入進度，不會寫入標準主體、聯絡人或場所角色狀態。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bắt đầu phiên sẽ ghi lại tiến trình nhập có thể tiếp tục; không ghi trạng thái chuẩn của chủ thể, liên hệ hoặc vai trò tại địa điểm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "세션을 시작하면 재개 가능한 가져오기 진행 상황이 기록되며 관계 당사자, 연락처 또는 현장 역할의 기준 상태는 기록하지 않습니다."
          }
        }
      }
    },
