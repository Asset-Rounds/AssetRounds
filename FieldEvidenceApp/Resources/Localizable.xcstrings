    "v30.asset.import.binding.disclosure": {
      "comment": "Screen: Party/contact/Site-role import screen. Meaning: Uses the English default “These digests bind the source manifest, source rows, workspace revision, import plan, and synthetic command.”. Role: visible explanatory Text. Arguments: none. Plural/select: none. Accessibility: This visible explanatory Text is available in normal VoiceOver traversal. Screenshot: Party/contact/Site-role import screen. state where this visible explanatory Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These digests bind the source manifest, source rows, workspace revision, import plan, and synthetic command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estos resúmenes criptográficos vinculan el manifiesto de origen, las filas de origen, la revisión del espacio de trabajo, el plan de importación y el comando sintético."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这些摘要绑定来源清单、源行、工作区修订版、导入计划和合成命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這些摘要綁定來源清單、來源列、工作區修訂版、匯入計畫與合成命令。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các giá trị băm này ràng buộc bản kê nguồn, các dòng nguồn, phiên bản không gian làm việc, kế hoạch nhập dữ liệu và lệnh tổng hợp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 해시 요약은 원본 명세, 원본 행, 작업 공간 개정본, 가져오기 계획 및 가상 명령을 연결합니다."
          }
        }
      }
    },
