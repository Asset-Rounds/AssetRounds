          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "승인되어 기록된 마감 정보가 기존 렌더러의 보고서 작성에 사용할 준비가 되었습니다."
          }
        }
      }
    },
    "v30.installation.workflow.report.ready.boundary": {
      "comment": "Screen: Installation workflow screen. Meaning: Uses the English default “Report-ready does not mean rendered, sent, delivered, received, reviewed, verified, safe, compliant, permitted, commissioned, approved, or in service.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Installation workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report-ready does not mean rendered, sent, delivered, received, reviewed, verified, safe, compliant, permitted, commissioned, approved, or in service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estar listo para generar un informe no significa que se haya generado, enviado, entregado, recibido, revisado, verificado, declarado seguro o conforme, autorizado, puesto en marcha, aprobado ni puesto en servicio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可用于报告不表示已生成、已发送、已交付、已收到、已审核、已验证、安全、合规、已获许可、已调试、已批准或已投入使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可供製作報告不代表已產生、已傳送、已交付、已收到、已審閱、已驗證、安全、合規、已獲許可、已試運轉、已核准或已投入使用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sẵn sàng lập báo cáo không có nghĩa là đã kết xuất, gửi, giao, nhận, xem xét, xác minh, an toàn, tuân thủ, được cấp phép, nghiệm thu vận hành, phê duyệt hoặc đưa vào sử dụng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보고서 작성 준비가 되었다고 해서 렌더링, 전송, 전달, 수신, 검토, 검증, 안전성, 규정 준수, 허가, 시운전, 승인 또는 가동 중임을 의미하지는 않습니다."
          }
        }
      }
    },
    "v30.installation.workflow.request.cancelled": {
      "comment": "Screen: Installation workflow screen. Meaning: Uses the English default “The request was cancelled. Reload the canonical record before retrying; no acceptance is claimed.”. Role: operation-status message. Arguments: none. Plural/select: none. Accessibility: Shown in the operation-status card or status surface; normal VoiceOver traversal reads it, and focused status updates are announced. Screenshot: Installation workflow screen. state where this operation-status message is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was cancelled. Reload the canonical record before retrying; no acceptance is claimed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se canceló la solicitud. Vuelva a cargar el registro canónico antes de reintentar; no se confirma aceptación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求已取消。请重新加载规范记录后再重试；不声称已接受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請求已取消。請重新載入標準記錄後再重試；不聲稱已接受。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã hủy yêu cầu. Hãy tải lại bản ghi chuẩn trước khi thử lại; không khẳng định đã chấp nhận."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "요청이 취소되었습니다. 다시 시도하기 전에 기준 기록을 다시 불러오세요. 수락되었다고 확인하지 않습니다."
          }
        }
      }
    },
