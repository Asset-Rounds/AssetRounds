    "lighting.day_inventory.safety_stop_detail": {
      "comment": "C17 hard-stop copy precedes unsafe or energized work.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not climb, open, touch, probe, repair, or enter traffic exposure. Follow the recorded authorized procedure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No suba, abra, toque, examine, repare ni se exponga al tránsito. Siga el procedimiento autorizado registrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请勿攀爬、打开、触摸、探查、维修或进入交通暴露区域。请遵循已记录的获授权程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請勿攀爬、開啟、碰觸、探測、修理或進入交通曝露區域。請遵守記錄的授權程序。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không leo trèo, mở, chạm, thăm dò, sửa chữa hoặc đi vào khu vực có phương tiện lưu thông. Hãy tuân theo quy trình được ủy quyền đã ghi nhận."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오르거나, 열거나, 만지거나, 탐침하거나, 수리하거나, 교통 노출 구역에 진입하지 마세요. 기록된 승인 절차를 따르세요."
          }
        }
