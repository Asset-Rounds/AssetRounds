          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phạm vi pháp lý tại nơi làm việc vẫn giới hạn trong phạm vi Hoa Kỳ đã ghi nhận; ngôn ngữ và định dạng không mở thêm phạm vi pháp lý khác."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 현장의 관할은 기록된 미국 관할로 제한됩니다. 언어와 서식은 다른 관할을 활성화하지 않습니다."
          }
        }
      }
    },
