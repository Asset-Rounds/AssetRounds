    "v30.voice-capture.no-transcript": {
      "comment": "Screen: Voice capture. Meaning: Explains no transcript in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Voice capture body copy state; no screenshot is claimed.",
