            "value": "Nhập mã tồn kho để tra cứu thủ công. Không có thay đổi tồn kho khi nhập."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수동 조회를 위해 재고 코드를 입력하세요. 입력하는 동안 재고는 변경되지 않습니다."
          }
        }
      }
    },
    "v30.parts-stock.enter-return-quantity": {
      "comment": "Screen: Parts & Stock. Meaning: Explains enter return quantity in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a positive return quantity no greater than the outstanding amount for this Use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingrese una cantidad de devolución positiva no mayor que el monto pendiente de este Uso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入不大于此“使用”未结数量的正数退回数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入不大於此用途未結清數量的正數退回數量。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập số lượng trả lại dương không lớn hơn số lượng chưa xử lý của Lần sử dụng này."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Use의 미처리 수량을 넘지 않는 양의 반납 수량을 입력하세요."
          }
        }
      }
    },
    "v30.parts-stock.enter-use-quantity": {
      "comment": "Screen: Parts & Stock. Meaning: Explains enter use quantity in the current screen state. Role: body copy. Arguments: none. Plural/select: none. Accessibility: Read as static content by VoiceOver. Screenshot: Parts & Stock body copy state; no screenshot is claimed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a quantity before requesting Use from stock. Typing the material line alone never changes stock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingrese una cantidad antes de solicitar Usar del inventario. Escribir solo la línea de material nunca cambia el inventario."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在从库存请求“使用”前输入数量。仅输入物料行绝不会更改库存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "向庫存要求用途前請輸入數量。僅輸入材料列絕不會變更庫存。"
          }
        },
        "vi": {
          "stringUnit": {
