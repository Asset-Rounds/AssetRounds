    "v30.voice-capture.needs-attention": {
      "comment": "Screen: Voice capture. Meaning: Reports the needs attention state. Role: status label. Arguments: none. Plural/select: none. Accessibility: The combined label exposes this status to VoiceOver. Screenshot: Voice capture status label state; no screenshot is claimed.",
      "localizations": {
