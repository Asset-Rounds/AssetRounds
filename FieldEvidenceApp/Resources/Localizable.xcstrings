    "v30.installation.workflow.interrupted.notice": {
      "comment": "Screen: Installation workflow screen. Meaning: Uses the English default “This attempt is interrupted. Relaunch does not restore unrecorded scratch work; recover only by replaying the same supplied mutation identity.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Installation workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This attempt is interrupted. Relaunch does not restore unrecorded scratch work; recover only by replaying the same supplied mutation identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este intento está interrumpido. Volver a abrir la app no restaura el trabajo temporal no registrado; recupérelo solo repitiendo la misma identidad de modificación proporcionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此次尝试已中断。重新启动不会恢复未记录的临时工作；仅可通过重放提供的同一变更标识来恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此次嘗試已中斷。重新啟動不會回復未記錄的暫存工作；只能重播提供的相同變更識別碼來復原。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lần thử này đã bị gián đoạn. Khởi chạy lại không khôi phục công việc tạm chưa được ghi nhận; chỉ khôi phục bằng cách thực hiện lại cùng mã định danh thay đổi được cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이번 시도가 중단되었습니다. 다시 실행해도 기록되지 않은 임시 작업은 복원되지 않습니다. 제공된 동일한 변경 식별자로 재실행하는 방법으로만 복구하세요."
          }
        }
      }
    },
    "v30.installation.workflow.introduction": {
      "comment": "Screen: Installation workflow screen. Meaning: Uses the English default “Recorded readiness, tasks, as-built facts, and closeout are shown from the current local activity record.”. Role: visible Text. Arguments: none. Plural/select: none. Accessibility: This call itself adds visible Text; the enclosing view controls any combined accessibility exposure. Screenshot: Installation workflow screen. state where this visible Text is visible or announced; descriptive context only and not a screenshot-evidence claim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded readiness, tasks, as-built facts, and closeout are shown from the current local activity record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La preparación, las tareas, los hechos conforme a lo construido y el cierre registrados se muestran a partir del registro de actividad local actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已从当前本地活动记录显示已记录的就绪度、任务、竣工事实和收尾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從目前本機活動記錄顯示已記錄的就緒狀態、任務、竣工事實與收尾內容。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trạng thái sẵn sàng, tác vụ, sự kiện hoàn công và kết thúc đã ghi được hiển thị từ bản ghi hoạt động cục bộ hiện tại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기록된 준비 상태, 작업, 준공 사실 및 완료 정리는 현재 로컬 활동 기록에서 표시됩니다."
          }
        }
      }
    },
