{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetrounds.local/v23/controller-selection.schema.json",
  "title": "ControllerSelectionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "cardID",
    "attemptID",
    "candidateHead",
    "candidateTree",
    "branch",
    "workKind",
    "requestedPool",
    "requestedJobs",
    "failFast",
    "exhaustiveDiagnostics",
    "transportActivated"
  ],
  "properties": {
    "schema": {"const": "ControllerSelectionV1"},
    "schemaVersion": {"const": 1},
    "cardID": {"type": "string", "pattern": "^V23-P[0-9]{2}-C[0-9]{2}$"},
    "attemptID": {"type": "integer", "minimum": 1},
    "candidateHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidateTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"const": "phase/v23-expansion"},
    "workKind": {"enum": ["PRODUCT_OFFICIAL", "PRODUCT_DIAGNOSTIC", "PROTECTED_RELEASE"]},
    "requestedPool": {"enum": ["STANDARD_GITHUB", "GETMAC"]},
    "requestedJobs": {"type": "integer", "minimum": 1},
    "failFast": {"type": "boolean"},
    "exhaustiveDiagnostics": {"type": "boolean"},
    "transportActivated": {"type": "boolean"}
  }
}
