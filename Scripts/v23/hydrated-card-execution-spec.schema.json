{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetrounds.local/schemas/v23/hydrated-card-execution-spec.schema.json",
  "title": "HydratedCardExecutionSpecV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "cardID", "attemptID", "registerOrdinal", "classification",
    "planningStatus", "title", "lineage", "contextDigest", "pathFenceDigest", "authorityDigests", "programAuthority", "authorityContextDigest",
    "directPrerequisiteEdges", "directPrerequisiteEvidence", "directPrerequisiteEvidenceValidated", "readinessDisposition",
    "selectors", "relations", "contractFacets", "contractOwnership", "contractSymbols", "dependencyDispositions",
    "repositoryPaths", "repositoryPathOwners", "generatedOutputs", "namedChecks", "lifecycleOwner",
    "declarationOwner", "writerAuthority", "ledgerDigest", "ledgerCASSequence", "executionMode",
    "phase10PollingDuringParallelExecution", "acceptanceEnabled", "releaseCredit", "adoptionEnabled",
    "prohibitions", "specDigest"
  ],
  "properties": {
    "schema": { "const": "HydratedCardExecutionSpecV2" },
    "schemaVersion": { "const": 2 },
    "cardID": { "type": "string", "pattern": "^V23-P[0-9]{2}-C[0-9]{2}$" },
    "attemptID": { "type": "integer", "minimum": 1 },
    "registerOrdinal": { "type": "integer", "minimum": 1, "maximum": 146 },
    "classification": { "type": "string", "minLength": 1 },
    "planningStatus": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "lineage": { "type": "string", "minLength": 1 },
    "contextDigest": { "$ref": "#/$defs/digest" },
    "pathFenceDigest": { "$ref": "#/$defs/digest" },
    "authorityDigests": { "type": "object", "minProperties": 7, "additionalProperties": false, "required": ["register", "graph", "impact", "selectors", "relations", "facets", "dependencyDispositions"], "properties": { "register": { "$ref": "#/$defs/digest" }, "graph": { "$ref": "#/$defs/digest" }, "impact": { "$ref": "#/$defs/digest" }, "selectors": { "$ref": "#/$defs/digest" }, "relations": { "$ref": "#/$defs/digest" }, "facets": { "$ref": "#/$defs/digest" }, "dependencyDispositions": { "$ref": "#/$defs/digest" } } },
    "programAuthority": { "$ref": "#/$defs/programAuthority" },
    "authorityContextDigest": { "$ref": "#/$defs/digest" },
    "directPrerequisiteEdges": { "type": "array", "items": { "$ref": "#/$defs/directEdge" } },
    "directPrerequisiteEvidence": { "type": "array", "items": { "$ref": "#/$defs/directEvidence" } },
    "directPrerequisiteEvidenceValidated": { "type": "boolean" },
    "readinessDisposition": { "enum": ["READY", "PROVISIONAL_IMPLEMENTATION_ONLY_NOT_READY_FOR_ACCEPTANCE"] },
    "selectors": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "contractFacets": { "type": "array", "items": { "$ref": "#/$defs/facet" } },
    "contractOwnership": { "type": "array", "items": { "$ref": "#/$defs/ownership" } },
    "contractSymbols": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "dependencyDispositions": { "type": "array", "items": { "$ref": "#/$defs/disposition" } },
    "repositoryPaths": { "$ref": "#/$defs/paths" },
    "repositoryPathOwners": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "owner"], "properties": { "path": { "$ref": "#/$defs/path" }, "owner": { "type": "string", "minLength": 1 } } } },
    "generatedOutputs": { "$ref": "#/$defs/paths" },
    "namedChecks": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "lifecycleOwner": { "type": "string", "minLength": 1 },
    "declarationOwner": { "type": "string", "minLength": 1 },
    "writerAuthority": { "type": "object", "additionalProperties": false, "required": ["ownerID", "writerGeneration"], "properties": { "ownerID": { "type": "string" }, "writerGeneration": { "type": "integer", "minimum": 0 } } },
    "ledgerDigest": { "$ref": "#/$defs/digest" },
    "ledgerCASSequence": { "type": "integer", "minimum": 0 },
    "executionMode": { "type": "string", "minLength": 1 },
    "phase10PollingDuringParallelExecution": { "const": false },
    "acceptanceEnabled": { "const": false },
    "releaseCredit": { "const": false },
    "adoptionEnabled": { "const": false },
    "prohibitions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "specDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "programAuthority": { "type": "object", "additionalProperties": false, "required": ["packageDigest", "overrideID", "overrideSemanticDigest", "overrideReceiptDigest", "frozenS10ReservationDigest", "phase10PollingDuringParallelExecution", "officialAcceptanceEnabled", "releaseCredit"], "properties": { "packageDigest": { "$ref": "#/$defs/digest" }, "overrideID": { "const": "V23-OWNER-PARALLEL-IMPLEMENTATION-004" }, "overrideSemanticDigest": { "$ref": "#/$defs/digest" }, "overrideReceiptDigest": { "$ref": "#/$defs/digest" }, "frozenS10ReservationDigest": { "$ref": "#/$defs/digest" }, "phase10PollingDuringParallelExecution": { "const": false }, "officialAcceptanceEnabled": { "const": false }, "releaseCredit": { "const": false } } },
    "directEdge": { "type": "object", "additionalProperties": false, "required": ["source", "target", "edgeOrdinal"], "properties": { "source": { "type": "string" }, "target": { "type": "string" }, "edgeOrdinal": { "type": "integer", "minimum": 1 } } },
    "directEvidence": { "type": "object", "additionalProperties": false, "required": ["sourceCardID", "targetCardID", "edgeOrdinal", "evidenceKind", "artifacts"], "properties": { "sourceCardID": { "type": "string" }, "targetCardID": { "type": "string" }, "edgeOrdinal": { "type": "integer", "minimum": 1 }, "evidenceKind": { "enum": ["ORDINARY_ACCEPTED_COMPATIBLE", "SATISFIED_GO_EVIDENCE"] }, "artifacts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "compatibilityContext": { "$ref": "#/$defs/directContext" }, "releaseCredit": { "const": false } } },
    "directContext": { "type": "object", "additionalProperties": false, "required": ["kind", "sourceCardID", "targetCardID", "edgeOrdinal", "directGraphDigest"], "properties": { "kind": { "const": "DIRECT_EDGE" }, "sourceCardID": { "type": "string" }, "targetCardID": { "type": "string" }, "edgeOrdinal": { "type": "integer", "minimum": 1 }, "directGraphDigest": { "$ref": "#/$defs/digest" } } },
    "selector": { "type": "object", "additionalProperties": false, "required": ["id", "members", "consumers", "predicate", "rowDigest"], "properties": { "id": { "type": "string" }, "members": { "type": "array", "items": { "type": "string" } }, "consumers": { "type": "array", "items": { "type": "string" } }, "predicate": { "type": "string" }, "rowDigest": { "$ref": "#/$defs/digest" } } },
    "relation": { "type": "object", "additionalProperties": false, "required": ["source", "kind", "target", "evidence", "activation", "fallback", "invalidates", "authority"], "properties": { "source": { "type": "string" }, "kind": { "enum": ["AGGREGATE_ACCEPTANCE_MEMBER", "CONFORMANCE_SUBJECT", "CONTRACT_INPUT_PROVIDER", "INVALIDATION_CONSUMER", "OPTIONAL_CAPABILITY_PROVIDER", "PROVENANCE_REFERENCE"] }, "target": { "type": "string" }, "evidence": { "type": "string" }, "activation": { "type": "string" }, "fallback": { "type": "string" }, "invalidates": { "type": "string" }, "authority": { "type": "string" } } },
    "facet": { "type": "object", "additionalProperties": false, "required": ["source", "target", "selector", "sourceAuthorityRefs", "activation", "fallback"], "properties": { "source": { "type": "string" }, "target": { "type": "string" }, "selector": { "type": "string" }, "sourceAuthorityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "activation": { "type": "string" }, "fallback": { "type": "string" } } },
    "ownership": { "type": "object", "additionalProperties": false, "required": ["familyMembers", "declarationOwner", "canonicalRecordWriter", "artifactWriter", "semanticLifecycleOwner", "lifecycleEnrollmentOwner", "primaryConsumers"], "properties": { "familyMembers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "declarationOwner": { "type": "string" }, "canonicalRecordWriter": { "type": "string" }, "artifactWriter": { "type": "string" }, "semanticLifecycleOwner": { "type": "string" }, "lifecycleEnrollmentOwner": { "type": "string" }, "primaryConsumers": { "type": "string" } } },
    "disposition": { "type": "object", "additionalProperties": false, "required": ["predecessorConsumer", "predecessorProvider", "currentConsumer", "currentProvider", "disposition", "authority"], "properties": { "predecessorConsumer": { "type": "string" }, "predecessorProvider": { "type": "string" }, "currentConsumer": { "type": "string" }, "currentProvider": { "type": "string" }, "disposition": { "type": "string" }, "authority": { "type": "string" } } }
  }
}
