{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetrounds.invalid/schemas/v23/kernel-conformance-fixture.schema.json",
  "title": "V23 P03 C10 strict fixture, graph, and portable-corpus union",
  "oneOf": [
    {"allOf": [{"$ref": "#/$defs/manifest"}, {"properties": {"schema": {"const": "V21P03C10ChecklistFixtureManifestV1"}}}]},
    {"allOf": [{"$ref": "#/$defs/manifest"}, {"properties": {"schema": {"const": "V21P03C10MeasurementRepeatFixtureManifestV1"}}}]},
    {"$ref": "#/$defs/graph"},
    {"$ref": "#/$defs/corpus"}
  ],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/nonempty"}},
    "stringList": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/nonempty"}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["sequence", "action", "adapter", "inputState", "outputState", "persistentConsumers", "brandState"], "properties": {"sequence": {"type": "integer", "minimum": 1, "maximum": 16}, "action": {"enum": ["VALIDATE", "START", "RESUME", "RESPOND", "EVIDENCE", "FIND", "WORK", "RECHECK", "FINALIZE", "PROJECT", "ARCHIVE", "RESTORE", "SEARCH", "DELETE", "ERASE", "RECOVER"]}, "adapter": {"$ref": "#/$defs/nonempty"}, "inputState": {"$ref": "#/$defs/nonempty"}, "outputState": {"$ref": "#/$defs/nonempty"}, "persistentConsumers": {"$ref": "#/$defs/strings"}, "brandState": {"$ref": "#/$defs/nonempty"}}},
    "fault": {"type": "object", "additionalProperties": false, "required": ["boundary", "faultClass", "recoveryAction", "expectedDisposition", "selectors", "evidenceIDs"], "properties": {"boundary": {"$ref": "#/$defs/nonempty"}, "faultClass": {"$ref": "#/$defs/nonempty"}, "recoveryAction": {"enum": ["RESUME", "RECOVER"]}, "expectedDisposition": {"$ref": "#/$defs/nonempty"}, "selectors": {"$ref": "#/$defs/strings"}, "evidenceIDs": {"$ref": "#/$defs/strings"}}},
    "schedule": {"type": "object", "additionalProperties": false, "required": ["id", "replicas", "deliveries", "expectedSemanticSHA256", "replayCount", "expectedNormalizedSHA256"], "properties": {"id": {"enum": ["two-replica-golden", "three-replica-adversarial"]}, "replicas": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-C]$"}}, "deliveries": {"$ref": "#/$defs/strings"}, "expectedSemanticSHA256": {"$ref": "#/$defs/digest"}, "replayCount": {"const": 2}, "expectedNormalizedSHA256": {"$ref": "#/$defs/digest"}}},
    "projection": {"type": "object", "additionalProperties": false, "required": ["canonicalUTF8Hex", "sha256", "recordIDs"], "properties": {"canonicalUTF8Hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"}, "sha256": {"$ref": "#/$defs/digest"}, "recordIDs": {"$ref": "#/$defs/strings"}}},
    "release": {"type": "object", "additionalProperties": false, "required": ["testOnly", "shippingAdoptionEnabled", "nativeCompileRan", "hostedDispatchRan", "acceptanceCredit", "releaseCredit", "requiresAcceptedS10_6Reconciliation"], "properties": {"testOnly": {"const": true}, "shippingAdoptionEnabled": {"const": false}, "nativeCompileRan": {"const": false}, "hostedDispatchRan": {"const": false}, "acceptanceCredit": {"const": false}, "releaseCredit": {"const": false}, "requiresAcceptedS10_6Reconciliation": {"const": true}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["selector", "evidenceID", "covers"], "properties": {"selector": {"$ref": "#/$defs/nonempty"}, "evidenceID": {"type": "string", "pattern": "^V23-P03-C10-(G01|A01|H01|I01|R01)$"}, "covers": {"$ref": "#/$defs/strings"}}},
    "manifest": {"type": "object", "additionalProperties": false, "required": ["schema", "schemaVersion", "fixtureID", "shapeID", "productionAdapters", "lifecycleTransitions", "faultInjections", "replicaSchedules", "expectedNormalizedProjection", "releaseAbsence", "evidenceBindings"], "properties": {"schema": {"enum": ["V21P03C10ChecklistFixtureManifestV1", "V21P03C10MeasurementRepeatFixtureManifestV1"]}, "schemaVersion": {"const": 1}, "fixtureID": {"$ref": "#/$defs/nonempty"}, "shapeID": {"$ref": "#/$defs/nonempty"}, "productionAdapters": {"$ref": "#/$defs/strings"}, "lifecycleTransitions": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/transition"}}, "faultInjections": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/fault"}}, "replicaSchedules": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/schedule"}}, "expectedNormalizedProjection": {"$ref": "#/$defs/projection"}, "releaseAbsence": {"$ref": "#/$defs/release"}, "evidenceBindings": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/binding"}}}},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "phase", "adapter", "persistentConsumers", "brandState"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "phase": {"$ref": "#/$defs/nonempty"}, "adapter": {"$ref": "#/$defs/nonempty"}, "persistentConsumers": {"$ref": "#/$defs/strings"}, "brandState": {"$ref": "#/$defs/nonempty"}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["id", "from", "to", "action", "boundary"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "from": {"$ref": "#/$defs/nonempty"}, "to": {"$ref": "#/$defs/nonempty"}, "action": {"$ref": "#/$defs/nonempty"}, "boundary": {"$ref": "#/$defs/nonempty"}}},
    "selectorBinding": {"type": "object", "additionalProperties": false, "required": ["selector", "evidenceID", "nodeIDs", "boundaries"], "properties": {"selector": {"$ref": "#/$defs/nonempty"}, "evidenceID": {"type": "string", "pattern": "^V23-P03-C10-(G01|A01|H01|I01|R01)$"}, "nodeIDs": {"$ref": "#/$defs/stringList"}, "boundaries": {"$ref": "#/$defs/stringList"}}},
    "consumer": {"type": "object", "additionalProperties": false, "required": ["id", "adapter", "publicationAuthority", "recoveryDisposition"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "adapter": {"$ref": "#/$defs/nonempty"}, "publicationAuthority": {"$ref": "#/$defs/nonempty"}, "recoveryDisposition": {"$ref": "#/$defs/nonempty"}}},
    "brandState": {"type": "object", "additionalProperties": false, "required": ["id", "changedUI", "nodeIDs"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "changedUI": {"const": false}, "nodeIDs": {"$ref": "#/$defs/stringList"}}},
    "graph": {"type": "object", "additionalProperties": false, "required": ["schema", "schemaVersion", "nodes", "edges", "selectorBindings", "persistentConsumers", "brandStates"], "properties": {"schema": {"const": "V21P03C10KernelConformanceScenarioGraphV1"}, "schemaVersion": {"const": 1}, "nodes": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/node"}}, "edges": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/edge"}}, "selectorBindings": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/selectorBinding"}}, "persistentConsumers": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/consumer"}}, "brandStates": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/brandState"}}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["id", "input", "expectedClass", "instancePath", "schemaPath", "goldenUTF8Hex"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "input": {"$ref": "#/$defs/nonempty"}, "expectedClass": {"enum": ["ACCEPTED", "REJECTED"]}, "instancePath": {"type": "string", "maxLength": 4096}, "schemaPath": {"type": "string", "maxLength": 4096}, "goldenUTF8Hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"}}},
    "corpus": {"type": "object", "additionalProperties": false, "required": ["schema", "schemaVersion", "cases"], "properties": {"schema": {"const": "V21P03C10PortableContractCorpusV1"}, "schemaVersion": {"const": 1}, "cases": {"type": "array", "minItems": 5, "maxItems": 4096, "items": {"$ref": "#/$defs/case"}}}},
    "portableEnvelope": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schemaVersion", "kind", "payload"],
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "CHECK"}}, "required": ["kind"]},
          "then": {"properties": {"payload": {"not": {"anyOf": [{"required": ["value"]}, {"required": ["unit"]}]}}}}
        },
        {
          "if": {"properties": {"kind": {"const": "MEASUREMENT"}}, "required": ["kind"]},
          "then": {"properties": {"payload": {"required": ["value", "unit"], "not": {"required": ["label"]}}}}
        }
      ],
      "properties": {
        "schema": {"const": "KernelPortableEnvelopeV1"}, "schemaVersion": {"const": 1},
        "kind": {"enum": ["CHECK", "MEASUREMENT"]},
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["id", "status"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 256},
            "status": {"enum": ["OPEN", "COMPLETE"]},
            "value": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
            "unit": {"type": "string", "enum": ["mm"]},
            "label": {"type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"}
          }
        }
      },
      "languageNeutralStringPolicy": {
        "forbiddenUnicodeScalars": ["U+0000-U+001F", "U+007F-U+009F", "U+202A-U+202E", "U+2066-U+2069"]
      }
    }
  }
}
