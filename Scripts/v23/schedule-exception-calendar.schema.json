{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assetrounds:v23:p03:c51:schedule-exception-calendar:v1",
  "title": "ExceptionCalendarReleaseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseID",
    "releaseSHA256",
    "name",
    "calendarSystem",
    "ianaTimeZone",
    "effectiveInterval",
    "baseIncludedWeekdays",
    "excludedDates",
    "excludedRanges",
    "includedOverrideDates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseID": { "type": "string", "minLength": 1, "maxLength": 160 },
    "releaseSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "calendarSystem": { "const": "GREGORIAN_V1" },
    "ianaTimeZone": { "type": "string", "minLength": 1, "maxLength": 160 },
    "effectiveInterval": { "type": "object", "additionalProperties": false },
    "baseIncludedWeekdays": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true },
    "excludedDates": { "type": "array", "maxItems": 366, "uniqueItems": true },
    "excludedRanges": { "type": "array", "maxItems": 32 },
    "includedOverrideDates": { "type": "array", "maxItems": 366, "uniqueItems": true }
  },
  "$comment": "Swift constructor validation is authoritative for canonical date encodings, effective interval ordering, IANA zone resolution, and release SHA-256 recomputation. Included overrides take precedence over exclusions, which take precedence over base weekdays."
}
