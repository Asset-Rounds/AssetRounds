{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compatibility-run-receipt.schema.json",
  "title": "CompatibilityRunReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runID",
    "corpusSHA256",
    "selection",
    "mode",
    "affectedFamilies",
    "selectedCaseIDs",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runID": { "$ref": "#/$defs/token" },
    "corpusSHA256": { "$ref": "#/$defs/sha256" },
    "selection": {
      "enum": ["representative_sentinel", "dependency_closure", "full_corpus"]
    },
    "mode": { "enum": ["accepting_fail_fast", "diagnostic_continue"] },
    "affectedFamilies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactFamily" }
    },
    "selectedCaseIDs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseResult" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "selection": { "const": "dependency_closure" } }, "required": ["selection"] },
      "then": { "properties": { "affectedFamilies": { "type": "array", "minItems": 1 } } },
      "else": { "properties": { "affectedFamilies": { "type": "array", "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/+\\-]+$"
    },
    "artifactFamily": {
      "enum": [
        "live_store",
        "current_generation_pointer",
        "store_generation_manifest",
        "store_migration_journal",
        "backup_package",
        "streaming_archive",
        "report_open_json",
        "report_pdf",
        "finalization_intent",
        "sign_pack",
        "durable_media",
        "deletion_ledger",
        "deletion_intent",
        "erase_intent",
        "restore_intent"
      ]
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseID", "caseManifestSHA256", "outcome"],
      "properties": {
        "caseID": { "$ref": "#/$defs/token" },
        "caseManifestSHA256": { "$ref": "#/$defs/sha256" },
        "outcome": { "enum": ["passed", "failed", "interrupted"] },
        "normalizedOutputSHA256": { "$ref": "#/$defs/sha256" },
        "failureCode": { "$ref": "#/$defs/token" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "passed" } }, "required": ["outcome"] },
          "then": {
            "required": ["normalizedOutputSHA256"],
            "properties": {
              "normalizedOutputSHA256": { "$ref": "#/$defs/sha256" },
              "failureCode": false
            }
          },
          "else": { "required": ["failureCode"] }
        }
      ]
    }
  }
}
