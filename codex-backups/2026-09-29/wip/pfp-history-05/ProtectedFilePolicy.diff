+/// Pure payload-work accounting for the actual checked pair readers. These
+/// constants grant no scope, inode sharing, policy, storage or effect authority.
+/// Fresh issuer/control/metadata IO and the scanner's own reads are separate.
+enum EraseC16TemporalPairReadWorkKindV1 {
+    case currentCanonicalPair
+    case firstPImmutablePair
+    case initialOpaquePair
+    case firstCaptureOpaquePair
+    case observedOwnedGenericAliases
+}
+
+enum EraseC16TemporalPairReadWorkV1 {
+    static func payloadBytePassesPerInvocation(
+        kind: EraseC16TemporalPairReadWorkKindV1
+    ) -> UInt64 {
+        switch kind {
+        case .currentCanonicalPair:
+            // Both descriptors are read before and after each of two policies.
+            return 8
+        case .firstPImmutablePair, .initialOpaquePair,
+             .firstCaptureOpaquePair, .observedOwnedGenericAliases:
+            // One shared-inode descriptor is streamed before and after each
+            // of two policies; exact both-name facts bind each complete pass.
+            return 4
+        }
+    }
+
+    static func maximumPayloadReadBytes(expectedByteCount: Int64,
+        kind: EraseC16TemporalPairReadWorkKindV1
+    ) throws -> UInt64 {
+        guard expectedByteCount >= 0,
+              let byteCount = UInt64(exactly: expectedByteCount) else {
+            throw ProtectedFilePolicyError.invalidURL
+        }
+        let (work, overflow) = byteCount.multipliedReportingOverflow(
+            by: payloadBytePassesPerInvocation(kind: kind))
+        guard !overflow else { throw ProtectedFilePolicyError.invalidURL }
+        // Each real observer independently retains its existing per-leaf
+        // limit. This pure arithmetic never enlarges it or a tree envelope.
+        return work
+    }
+}
