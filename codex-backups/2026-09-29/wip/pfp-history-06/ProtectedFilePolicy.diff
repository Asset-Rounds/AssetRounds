+    fileprivate func rememberOpened(_ descriptor: Int32,
+        scope: OriginalEraseC16InitialObservationScopeV1,
+        retainUncertainDescriptor: (Int32) -> Void) throws {
+        try requireObserving()
+        guard descriptor >= 0 else { throw ProtectedFilePolicyError.invalidURL }
+        guard !openDescriptors.contains(descriptor) else {
+            // A duplicate integer cannot establish which open is owned. Drop
+            // it from all usable slots before retaining the uncertainty.
+            openDescriptors.removeAll { $0 == descriptor }
+            state = .uncertain
+            uncertainDescriptors.append(descriptor)
+            scope.poisonOnUncertainObservation()
+            retainUncertainDescriptor(descriptor)
+            throw ProtectedFilePolicyError.identityChanged
+        }
+        openDescriptors.append(descriptor)
+    }
+
+    fileprivate func finish(scope: OriginalEraseC16InitialObservationScopeV1,
+        retainUncertainDescriptor: (Int32) -> Void) throws {
+        guard state == .observing || !openDescriptors.isEmpty else {
+            throw ProtectedFilePolicyError.identityChanged
+        }
+        // Permanent fence, including during callbacks and successful closes.
+        if state == .observing { state = .terminal }
+        var firstFailure: Error?
+        while let descriptor = openDescriptors.popLast() {
+            do { try scope.requireCurrentBinding() }
+            catch {
+                if firstFailure == nil { firstFailure = error }
+                scope.poisonOnUncertainObservation()
+            }
+            // Only this owned slot is consumed. Even when binding failed, its
+            // one terminal close is attempted; it is never used for more IO.
+            let closeResult = Darwin.close(descriptor)
+            if closeResult != 0 {
+                state = .uncertain
+                uncertainDescriptors.append(descriptor)
+                scope.poisonOnUncertainObservation()
+                retainUncertainDescriptor(descriptor)
+                if firstFailure == nil {
+                    firstFailure = ProtectedFilePolicyError.identityChanged
+                }
+            }
+            do { try scope.requireCurrentBinding() }
+            catch {
+                if firstFailure == nil { firstFailure = error }
+                scope.poisonOnUncertainObservation()
+            }
+        }
+        if let firstFailure { throw firstFailure }
+    }
