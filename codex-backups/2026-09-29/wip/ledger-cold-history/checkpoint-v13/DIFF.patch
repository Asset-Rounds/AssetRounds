+            for value in prepare.targets {
+                switch try originalEraseC16InitialTargetCut(.init(value)) {
+                case .absent: if sawLive { valid = false }
+                case .tombstone: if sawLive { valid = false }; sawLive = true
+                case .original: sawLive = true
