+    ) throws -> [OriginalEraseC16BornProducerSlotV1] {
+        var slots: [OriginalEraseC16BornProducerSlotV1] = []
+        try enumerateOriginalEraseC16BornProducerSlots(plan: plan) { slots.append($0) }
+        return slots
+    }
