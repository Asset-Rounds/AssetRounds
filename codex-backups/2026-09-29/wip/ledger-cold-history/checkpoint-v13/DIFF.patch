+                $0.hasPrefix("ProtectedIngressReceiptsV1/")
+            }) else {
+                throw ScratchDataLeaseStoreFailureV1.leaseCollision
+            }
+            try requireOriginalEraseBorrowedOwner()
+            try originalEraseBorrowedExclusiveCheck?()
