    @MainActor
    func publishSchema2ColdCleanupTerminal(sources: EraseSchema2ColdCleanupSourcesV1,
        progress: EraseSchema2ColdCleanupProgressV1,
        notification: EraseSchema2ColdSurvivingNotificationObservationV1,
        expected: EraseIntentV1, retirement: ErasedRegistryRetirementProofV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws -> EraseSchema2ColdCleanupTerminalObservationV1 {
        // Construct the proposed terminal from already held exact data first;
        // no observation creates a drain/retirement/OS-absence capability.
        guard expected.phase == .cleanupComplete, progress.stage == .phaseCASComplete,
              progress.isTerminal,
              let intentLeaf = try readRetirementLeaf(Self.intentName, kind: .journal),
              let preparationLeaf = try readRetirementLeaf(Self.preparationName, kind: .journal) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let rawNames = Set(sources.sources.map(\.leafName) + progress.births.map { $0.source.leafName })
        let fixed = [sources.c16PlanLeafName, EraseSchema2ColdCleanupGrammarV1.transferName,
            EraseSchema2ColdCleanupGrammarV1.sourcesName,
            EraseSchema2ColdCleanupGrammarV1.progressName,
            EraseSchema2ColdCleanupGrammarV1.notificationName,
            Self.originalRetiredStageIdentityName, Self.originalRetiredCommitmentName,
            Self.rosterName, Self.auxiliaryRosterName, Self.preparationName, Self.intentName]
        let names = try coldNamesChecked()
        let ordered = rawNames.sorted() + fixed.filter(names.contains)
        guard ordered.suffix(2) == [Self.preparationName, Self.intentName],
              Set(names.filter { $0 != EraseSchema2ColdCleanupGrammarV1.terminalName
                && $0 != EraseSchema2ColdCleanupGrammarV1.temporaryName(
                    EraseSchema2ColdCleanupGrammarV1.terminalName) }) == Set(ordered) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var leaves: [EraseSchema2ColdCleanupTerminalV1.Leaf] = []
        for name in ordered {
            let leaf: EraseColdExistingControlObservationV1.OpaqueOriginalRetiredLeafV1
            if name == Self.intentName || name == Self.preparationName {
                let bytes = name == Self.intentName ? intentLeaf.data : preparationLeaf.data
                var value = stat()
                guard Darwin.fstatat(eraseDescriptor, name, &value, AT_SYMLINK_NOFOLLOW) == 0 else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                leaf = .init(bytes: bytes, fact: EraseColdControlLeafFactV1(value), policy: nil)
            } else if let expected = coldCleanupProjectedLeaves[name] {
                leaf = expected
            } else if let retired = coldCapturedOpaqueOriginalRetired[name] {
                leaf = retired
            } else if name == Self.auxiliaryRosterName,
                      let bytes = coldCapturedOpaqueAuxiliaryRosterBytes,
                      let fact = coldProjectedAuxiliaryRosterFact ?? coldCapturedOpaqueAuxiliaryRosterFact {
                leaf = .init(bytes: bytes, fact: fact, policy: coldCapturedOpaqueAuxiliaryRosterPolicy)
            } else if name == Self.rosterName, let bytes = coldOwnRosterBytes,
                      let fact = coldOwnRosterFact {
                leaf = .init(bytes: bytes, fact: fact, policy: nil)
            } else if name == Self.rosterName,
                      let observed = coldFirstObservedRosterCut?.published {
                leaf = .init(bytes: observed.bytes, fact: observed.fact, policy: observed.policy)
            } else { throw EraseIntentStoreError.invalidAuthority }
            leaves.append(.init(name: name,
                fullFact: EraseSchema2ColdCleanupGrammarV1.fullFact(leaf.fact),
                sha256: StoreMigrationCanonicalJSONV1.sha256(leaf.bytes), byteCount: leaf.bytes.count))
        }
        let value = EraseSchema2ColdCleanupTerminalV1(schemaVersion: 1, sources: sources,
            progress: progress, notificationProvenance: notification.value,
            cleanupIntentBytes: intentLeaf.data, preparationBytes: preparationLeaf.data,
            deletionOrder: leaves)
        let bytes = try value.canonicalBytes()
        try bindSchema2ColdCleanupEffect(EraseSchema2ColdCleanupCommitmentV1.makeEffect(
            kind: .publishTerminal, inputSHA256: [StoreMigrationCanonicalJSONV1.sha256(bytes)],
            path: EraseSchema2ColdCleanupGrammarV1.terminalName), permit: permit)
        try beginSchema2ColdCleanupControlScope(permit)
        try retirement.requireCompletionControlRemoval(expected: expected)
        try requireRetirementRoot(retirement)
        try requireSchema2CleanupSourceIndex(sources, indexFullFact: progress.sourcesFullFact, permit: permit)
        guard try loadSchema2ColdCleanupProgressInternal(sources: sources, permit: permit) == progress else {
            throw EraseIntentStoreError.invalidAuthority
        }
        _ = try requireSchema2CleanupLeaf(EraseSchema2ColdCleanupGrammarV1.notificationName,
            bytes: notification.bytes,
            fullFact: EraseSchema2ColdCleanupGrammarV1.fullFact(notification.fact),
            maximumBytes: EraseSchema2ColdCleanupGrammarV1.maximumEncodedBytes, permit: permit)
        for leaf in value.deletionOrder { try requireSchema2ColdTerminalLeaf(leaf, permit: permit) }
        let written = try publishSchema2CleanupLeaf(EraseSchema2ColdCleanupGrammarV1.terminalName,
            bytes: bytes, expectedBytes: nil,
            maximumBytes: EraseSchema2ColdCleanupGrammarV1.maximumEncodedBytes, permit: permit)
        let observation = EraseSchema2ColdCleanupTerminalObservationV1(value: value,
            bytes: written.bytes, fact: written.fact, policy: written.policy)
        coldCleanupTerminalObservation = observation
        try requireSchema2ColdCleanupEffect(permit)
        return observation
    }

