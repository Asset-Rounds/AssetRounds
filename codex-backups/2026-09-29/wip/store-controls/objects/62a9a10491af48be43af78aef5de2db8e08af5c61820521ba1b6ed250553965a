    @MainActor
    private func bindSchema2ColdCleanupEffect(_ effect: EraseSchema2ColdControlEffectV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws {
        try permit.requireEffect(effect)
        coldCleanupEffect = effect
    }
    @MainActor
    private func requireSchema2ColdCleanupEffect(_ permit: EraseSchema2ColdControlPermitV1) throws {
        guard let effect = coldCleanupEffect else { throw EraseIntentStoreError.invalidAuthority }
        try permit.requireHeld(); try permit.requireEffect(effect)
    }

    @MainActor
    func loadSchema2ColdCleanupSources(permit: EraseSchema2ColdControlPermitV1)
        throws -> EraseSchema2ColdCleanupSourcesReceiptV1? {
        // The permit's commitment binds the exact first-held index SHA.
        let name = EraseSchema2ColdCleanupGrammarV1.sourcesName
        guard let first = coldCleanupProjectedLeaves[name] else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let effect = try EraseSchema2ColdCleanupCommitmentV1.makeEffect(kind: .loadSources,
            inputSHA256: [StoreMigrationCanonicalJSONV1.sha256(first.bytes)], path: name)
        try bindSchema2ColdCleanupEffect(effect, permit: permit)
        try beginSchema2ColdCleanupControlScope(permit)
        let sources = try EraseSchema2ColdCleanupSourcesV1.decodeCanonical(first.bytes)
        let receipt = try EraseSchema2ColdCleanupSourcesReceiptV1(store: self, sources: sources,
            indexFullFact: EraseSchema2ColdCleanupGrammarV1.fullFact(first.fact))
        try requireSchema2CleanupSourceIndex(sources, indexFullFact: receipt.indexFullFact, permit: permit)
        coldCleanupSourcesReceipt = receipt
        try requireSchema2ColdCleanupEffect(permit)
        return receipt
    }

    @MainActor
    func loadSchema2ColdSurvivingNotificationProvenance(permit: EraseSchema2ColdControlPermitV1)
        throws -> EraseSchema2ColdSurvivingNotificationObservationV1? {
        let name = EraseSchema2ColdCleanupGrammarV1.notificationName
        guard let first = coldCleanupProjectedLeaves[name] else {
