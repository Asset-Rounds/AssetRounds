    @MainActor
    func removeSchema2ColdCleanupControlsAfterCompletion(expected: EraseIntentV1,
        progress: EraseSchema2ColdCleanupProgressV1,
        retirement: ErasedRegistryRetirementProofV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws {
        try beginSchema2ColdCleanupControlScope(permit)
        try retirement.requireCompletionControlRemoval(expected: expected)
        try requireRetirementRoot(retirement)
        guard expected.phase == .cleanupComplete, progress.stage == .phaseCASComplete,
              progress.isTerminal, progress.eraseID == expected.eraseID.uuidString.lowercased() else {
            throw EraseIntentStoreError.invalidAuthority
        }
        if !coldCleanupTerminalRemovalStarted {
            guard let indexLeaf = try readSchema2CleanupOpaqueLeaf(EraseSchema2ColdCleanupGrammarV1.sourcesName) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let sources = try EraseSchema2ColdCleanupSourcesV1.decodeCanonical(indexLeaf.bytes)
            try progress.validate(sources: sources)
            guard try loadSchema2ColdCleanupProgress(sources: sources, permit: permit) == progress,
                  let notification = try readSchema2CleanupOpaqueLeaf(
                    EraseSchema2ColdCleanupGrammarV1.notificationName) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let provenance = try StoreMigrationCanonicalJSONV1.decodeCanonical(
                EraseSchema2ColdSurvivingNotificationProvenanceV1.self, from: notification.bytes)
            guard try provenance.canonicalBytes() == notification.bytes,
                  provenance.eraseID == sources.eraseID,
                  provenance.originalPAuxiliaryRosterSHA256 == sources.originalPAuxiliaryRosterSHA256,
                  provenance.preparationSHA256 == sources.preparationSHA256,
                  provenance.targetPointerSHA256 == sources.targetPointerSHA256 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            // Sources/births remain authenticated until all downstream work
            // and the actual OS-absence/namespace-retirement consumer finish.
            let leaves = Set(sources.sources.map(\.leafName) + progress.births.map { $0.source.leafName })
            coldCleanupTerminalRemovalNames = leaves.sorted() + [sources.c16PlanLeafName,
                EraseSchema2ColdCleanupGrammarV1.sourcesName,
                EraseSchema2ColdCleanupGrammarV1.progressName,
                EraseSchema2ColdCleanupGrammarV1.notificationName]
            guard Set(coldCleanupProjectedLeaves.keys) == Set(coldCleanupTerminalRemovalNames) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            coldCleanupTerminalRemovalStarted = true
        }
        while coldCleanupTerminalRemovalIndex < coldCleanupTerminalRemovalNames.count {
            let name = coldCleanupTerminalRemovalNames[coldCleanupTerminalRemovalIndex]
            try permit.requireHeld()
            try retirement.requireCompletionControlRemoval(expected: expected)
            try requireRetirementRoot(retirement)
            guard let retained = coldCleanupProjectedLeaves[name] else {
                throw EraseIntentStoreError.invalidAuthority
            }
            _ = try authenticateSchema2CleanupLeaf(name, expected: retained, permit: permit,
                maximumBytes: max(1, retained.bytes.count))
            try removeSchema2CleanupLeafExact(name, expected: retained, permit: permit)
            coldCleanupTerminalRemovalIndex += 1
            try retirement.requireCompletionControlRemoval(expected: expected)
        }
        guard coldCleanupProjectedLeaves.isEmpty else { throw EraseIntentStoreError.cleanupFailed }
        try requireRetirementRoot(retirement)
        try retirement.requireCompletionControlRemoval(expected: expected)
        try permit.requireHeld()
    }
