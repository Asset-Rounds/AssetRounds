"""Arithmetic only; no product execution or compiler proof."""
import json
from pathlib import Path
U64=(1<<64)-1
MIB=1024*1024

def add(*xs):
    n=0
    for x in xs:
        assert 0<=x<=U64 and n<=U64-x
        n+=x
    return n

def mul(a,b):
    assert 0<=a<=U64 and 0<=b<=U64 and (not a or b<=U64//a)
    return a*b

def ceildiv(n,d):
    assert d>0 and n>=0
    return n//d+(1 if n%d else 0)

def table(rows,body):
    logical=add(17,mul(rows,add(8,body))) if rows else 0
    leaves=ceildiv(logical,MIB-128)
    total=leaves; layer=leaves; level=0
    while layer>1:
        layer=ceildiv(layer,128); total=add(total,layer); level+=1
    assert level<=10
    return dict(maximumRows=rows,maximumRowBodyBytes=body,logicalByteUpper=logical,
        leafUpper=leaves,totalPageUpper=total,treeLevelUpper=level,
        physicalByteUpperConservative=mul(total,MIB))

