frontier=mul(mul(mul(12,127),10),514) # level+position+descriptor512 per wire
heap=add(2*MIB,2*65536,2*65664,frontier,8*16*MIB,8*65536,2*32*MIB,2*96*MIB)
# Exact field-width envelopes from WIRE_SCHEMAS; optional fields assumed present.
table_commitment_bytes=90
sources_frame=add(10,32,11*32,5*8,1,7*(table_commitment_bytes+513),512)
pending_producer_bytes=add(8,8,2,8,72,1,32,8,32,32,32)
progress_header=add(16,9*32,1,8,9,32,2*table_commitment_bytes,32,1,pending_producer_bytes,9,33,33,1)
progress_frame=add(10,progress_header,1,3*(table_commitment_bytes+513),513)
registry_frame=add(10,32,4*32,1,8,1,2*(table_commitment_bytes+513),2*32)
origin_source_descriptor=add(1,88,32,8,32)
owned_ids_frame=add(10,32,32,32,88,32,32,1,1,2*origin_source_descriptor)
origin_raw_frame=add(1,2*add(1,8,MIB))
capsule_exact=add(10,16,32,8,1548,1,8,909,origin_raw_frame,1,2*origin_source_descriptor,8,1,table_commitment_bytes,512,2,8,8,8,1)
checkpoint_builder=add(1,6*8,1,513,2,1270*514)
