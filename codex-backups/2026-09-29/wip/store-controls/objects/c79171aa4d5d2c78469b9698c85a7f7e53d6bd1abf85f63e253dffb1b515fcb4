            }
#endif
            guard Darwin.fsync(eraseDescriptor) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 stage=generic-parent-synced")
            }
#endif
            if borrowsColdObservation {
                coldOwnPublishingName = Self.intentName
                coldOwnPublishedIdentity = replacementIdentity
                coldPublishedVerified = false
                coldExpectedIntentBytes = replacementData
            }
            try verifyPublishedPolicy(
                .journal,
                name: Self.intentName,
                failure: .writeFailed,
                expectedIdentity: replacementIdentity
            )
            try verifyPublishedPolicy(
                .journalTemporary,
                name: Self.nextName,
                failure: .writeFailed,
                expectedIdentity: current.identity
            )
            guard
                  let published = try readIfPresent(Self.intentName),
                  let displaced = try readIfPresent(Self.nextName),
                  published.identity == replacementIdentity,
                  published.data == replacementData,
                  displaced.identity == current.identity,
                  displaced.data == expectedData else {
                throw EraseIntentStoreError.writeFailed
            }
            try removeExact(Self.nextName, expected: displaced)
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 stage=generic-displaced-removed")
            }
#endif
            if borrowsColdObservation {
                coldOwnPublishingName = nil
                coldOwnPublishedIdentity = nil
                coldDisplacedBytes = nil
                coldDisplacedFact = nil
                coldPublishedVerified = false
                coldOwnTemporaryName = nil
                coldOwnTemporaryIdentity = nil
                coldOwnTemporaryBytes = nil
            }
            swapped = false
            try verifyAuthority()
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 stage=generic-complete")
            }
#endif
        } catch {
            if borrowsColdObservation {
                coldEffectUncertain = true
                throw error
            }
            if swapped {
                do {
                    if let published = try readIfPresent(Self.intentName),
                       let displaced = try readIfPresent(Self.nextName),
                       published.identity == replacementIdentity,
                       published.data == replacementData,
                       displaced.identity == current.identity,
                       displaced.data == expectedData {
                        _ = Darwin.renameatx_np(
                            eraseDescriptor,
                            Self.nextName,
                            eraseDescriptor,
                            Self.intentName,
                            UInt32(RENAME_SWAP)
                        )
                        _ = Darwin.fsync(eraseDescriptor)
                    }
                } catch {
                    // Preserve the exact failure and leave uncertain state for recovery.
                }
            }
            try? removeIfExact(
                Self.nextName,
                expected: replacementIdentity
            )
            throw error
        }
    }

    func remove(expected: EraseIntentV1) throws {
        try verifyAuthority()
        try verifyExistingPolicy(.journal, name: Self.intentName)
        let data = try encode(expected)
        guard let current = try readIfPresent(Self.intentName) else {
            throw EraseIntentStoreError.intentMissing
        }
        guard current.data == data else {
            throw EraseIntentStoreError.intentMismatch
        }
        try removeExact(Self.intentName, expected: current)
        try verifyAuthority()
    }
}

private extension EraseIntentStore {
    func coldRootFact() throws -> EraseColdControlLeafFactV1 {
        guard (borrowsColdObservation || hasOriginalCleanupPrimitiveScope),
              !coldCloseAttempted, !coldClosed,
              coldActiveFD == nil, coldUncertainFDs.isEmpty else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var held = stat(), named = stat()
        guard Darwin.fstat(eraseDescriptor, &held) == 0,
              Darwin.fstatat(applicationSupportDescriptor,
                Self.directoryName, &named,
                AT_SYMLINK_NOFOLLOW) == 0,
              held.st_mode & S_IFMT == S_IFDIR,
              EraseColdControlLeafFactV1(held)
                == EraseColdControlLeafFactV1(named) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return EraseColdControlLeafFactV1(held)
    }

    func policyRelativePath(_ name: String) -> String {
        "\(Self.directoryName)/\(name)"
    }

    func observeBorrowedColdPolicy(_ kind: OwnedFileKindV1,
        at url: URL) throws -> TemporalPolicyObservationV1 {
        guard (borrowsColdObservation || hasOriginalCleanupPrimitiveScope), !coldCloseAttempted, !coldClosed,
              coldUncertainFDs.isEmpty, !coldEffectUncertain else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return try ProtectedFilePolicyV1.observeTemporalPolicyWithCheckedClose(
            kind, at: url, retainUncertainDescriptor: { descriptor in
                // A failed close is terminal; never retry the numeric FD.
                self.coldUncertainFDs.append(descriptor)
            })
    }

    func verifyExistingPolicy(
        _ kind: OwnedFileKindV1,
        name: String
    ) throws {
        do {
            try verifyAuthority()
            if let originalRecoveryCheckedIO {
                var named = stat()
                if Darwin.fstatat(eraseDescriptor, name, &named,
                                  AT_SYMLINK_NOFOLLOW) != 0 {
                    guard errno == ENOENT else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                    return
                }
                try originalRecoveryCheckedIO.withOpen(parent: eraseDescriptor,
                    name: name, flags: O_RDONLY | O_NONBLOCK) { descriptor in
                    let expected = try Self.fileIdentity(descriptor)
                    let url = applicationSupportURL
                        .appendingPathComponent(Self.directoryName, isDirectory: true)
                        .appendingPathComponent(name)
                    _ = try ProtectedFilePolicyV1
                        .verifyEraseColdTemporalPolicyWithCheckedRequest(
                            kind, at: url,
                            retainUncertainDescriptor: { [self] in
                                retainOriginalRecoveryUncertainDescriptor($0)
                            },
                            unchangedWitness: {
                                try self.originalRecoveryPolicyWitness(
                                    name: name, descriptor: descriptor,
                                    expected: expected)
                            })
                }
                try verifyAuthority()
                return
            }
            if borrowsColdObservation {
                guard (kind == .journal &&
                    [Self.intentName, Self.preparationName].contains(name)) ||
                    (kind == .journalTemporary &&
                    [Self.nextName, Self.preparationNextName].contains(name)) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                // Cold observation may never repair an existing policy or
                // use the ordinary unchecked-close descriptor path.
                _ = try readColdLeafIfPresent(name)
                return
            }
            let descriptor = Darwin.openat(
                eraseDescriptor,
                name,
                O_RDONLY | O_NOFOLLOW
            )
            if descriptor < 0, errno == ENOENT { return }
            guard descriptor >= 0 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            defer { _ = Darwin.close(descriptor) }
            let expected = try Self.fileIdentity(descriptor)
            if originalRecoveryCheckedIO != nil {
                let url = applicationSupportURL
                    .appendingPathComponent(Self.directoryName, isDirectory: true)
                    .appendingPathComponent(name)
                _ = try ProtectedFilePolicyV1
                    .applyAndVerifyEraseColdPrivateWithCheckedClose(
                        kind, at: url,
                        retainUncertainDescriptor: { [self] in
                            retainOriginalRecoveryUncertainDescriptor($0)
                        },
                        authorityCheck: {
                            try self.verifyAuthority()
                            try self.verifyLeaf(name,
                                descriptor: descriptor, expected: expected)
                        })
                return
            }
            try ProtectedFilePolicyV1.applyAndVerify(
                kind,
                relativePath: policyRelativePath(name),
                within: applicationSupportURL
            ) {
                try self.verifyAuthority()
                try self.verifyLeaf(
                    name,
                    descriptor: descriptor,
                    expected: expected
                )
            }
        } catch {
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    func applyTemporaryPolicy(
        _ kind: OwnedFileKindV1,
        name: String,
        descriptor: Int32
    ) throws {
        do {
            let expected = try Self.fileIdentity(descriptor)
            if borrowsColdObservation || hasOriginalCleanupPrimitiveScope {
                guard kind == .journalTemporary,
                      ([Self.nextName, Self.preparationNextName,
                       Self.rosterNextName].contains(name) ||
                       (coldCleanupPermit != nil && EraseSchema2ColdCleanupGrammarV1.isControlName(name))),
                      coldOwnTemporaryName == name,
                      coldActiveFD == descriptor else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                let url = applicationSupportURL
                    .appendingPathComponent(Self.directoryName,
                        isDirectory: true)
                    .appendingPathComponent(name)
                try ProtectedFilePolicyV1
                    .applyAndVerifyEraseColdPrivateWithCheckedClose(
                        kind, at: url,
                        retainUncertainDescriptor: { uncertain in
                            // Never retry a failed close by numeric FD. The
                            // operation retains this Store and refuses later
                            // mutation or publication when this is nonempty.
                            self.coldUncertainFDs.append(uncertain)
                        },
                        authorityCheck: {
                            try self.requireColdActiveTemporary(
                                name: name, descriptor: descriptor,
                                expected: expected)
                        }, beforeFirstEffect: {
                            try self.requireColdActiveTemporary(
                                name: name, descriptor: descriptor,
                                expected: expected)
                        })
                return
            }
            try ProtectedFilePolicyV1.applyAndVerify(
                kind,
                relativePath: policyRelativePath(name),
                within: applicationSupportURL
            ) {
                try self.verifyAuthority()
                try self.verifyLeaf(
                    name,
                    descriptor: descriptor,
                    expected: expected
                )
            }
        } catch {
            throw EraseIntentStoreError.writeFailed
        }
    }

    /// A newly O_EXCL-created cold temporary has an active writable FD, so
    /// the ordinary settled-store guard intentionally cannot run here. This
    /// check binds the sole operation-owned FD and named leaf before and after
    /// each policy effect without accepting a fresh descriptor as authority.
    private func requireColdActiveTemporary(
        name: String, descriptor: Int32, expected: Identity
    ) throws {
        try requireSchema2ColdCleanupPrimitiveEffect()
        guard (borrowsColdObservation || hasOriginalCleanupPrimitiveScope), !coldCloseAttempted, !coldClosed,
              !coldEffectUncertain, coldOwnTemporaryName == name,
              coldActiveFD == descriptor, coldUncertainFDs.isEmpty,
              coldEnumerationFD == nil, coldDirectoryStream == nil,
              !coldUncertainStreamClose else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try Self.requireDirectory(applicationSupportDescriptor,
            identity: applicationSupportIdentity)
        try Self.requireDirectory(eraseDescriptor,
            identity: eraseIdentity)
        var namedSupport = stat(), namedErase = stat()
        guard Darwin.lstat(applicationSupportURL.path,
                &namedSupport) == 0,
              namedSupport.st_mode & S_IFMT == S_IFDIR,
              Identity(device: namedSupport.st_dev,
                  inode: namedSupport.st_ino)
                == applicationSupportIdentity,
              Darwin.fstatat(applicationSupportDescriptor,
                  Self.directoryName, &namedErase,
                  AT_SYMLINK_NOFOLLOW) == 0,
              namedErase.st_mode & S_IFMT == S_IFDIR,
              Identity(device: namedErase.st_dev,
                  inode: namedErase.st_ino) == eraseIdentity else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try verifyLeaf(name, descriptor: descriptor, expected: expected)
    }

    private func verifyLeaf(
        _ name: String,
        descriptor: Int32,
        expected: Identity
    ) throws {
        guard try Self.fileIdentity(descriptor) == expected else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var info = stat()
        guard Darwin.fstatat(
            eraseDescriptor,
            name,
            &info,
            AT_SYMLINK_NOFOLLOW
        ) == 0,
              (info.st_mode & S_IFMT) == S_IFREG,
              info.st_nlink == 1,
              Identity(device: info.st_dev, inode: info.st_ino) == expected else {
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    private func verifyPublishedPolicy(
        _ kind: OwnedFileKindV1,
        name: String,
        failure: EraseIntentStoreError,
        expectedIdentity: Identity
    ) throws {
        if let originalRecoveryCheckedIO {
            do {
                try originalRecoveryCheckedIO.withOpen(
                    parent: eraseDescriptor, name: name,
                    flags: O_RDONLY | O_NONBLOCK) { descriptor in
                    let url = applicationSupportURL
                        .appendingPathComponent(Self.directoryName, isDirectory: true)
                        .appendingPathComponent(name)
                    _ = try ProtectedFilePolicyV1
                        .verifyEraseColdTemporalPolicyWithCheckedRequest(
                            kind, at: url,
                            retainUncertainDescriptor: { [self] in
                                retainOriginalRecoveryUncertainDescriptor($0)
                            },
                            unchangedWitness: {
                                try self.originalRecoveryPolicyWitness(
                                    name: name, descriptor: descriptor,
                                    expected: expectedIdentity)
                            })
                }
                try verifyAuthority()
                return
            } catch { throw failure }
        }
        if borrowsColdObservation {
            do {
                guard let published = try readColdLeafIfPresent(name),
                      published.identity == expectedIdentity else {
                    throw failure
                }
                return
            } catch { throw failure }
        }
        let descriptor = Darwin.openat(
            eraseDescriptor,
            name,
            O_RDONLY | O_NOFOLLOW
        )
        guard descriptor >= 0 else { throw failure }
        defer { _ = Darwin.close(descriptor) }
        do {
            try verifyAuthority()
            try verifyLeaf(
                name,
                descriptor: descriptor,
                expected: expectedIdentity
            )
            try ProtectedFilePolicyV1.verify(
                kind,
                at: applicationSupportURL
                    .appendingPathComponent(Self.directoryName, isDirectory: true)
                    .appendingPathComponent(name)
            )
            try verifyAuthority()
            try verifyLeaf(
                name,
                descriptor: descriptor,
                expected: expectedIdentity
            )
        } catch {
            throw failure
        }
    }

    private func originalRecoveryPolicyWitness(
        name: String, descriptor: Int32, expected: Identity
    ) throws -> OriginalRecoveryPolicyWitness {
        try verifyAuthority()
        try verifyLeaf(name, descriptor: descriptor, expected: expected)
        var held = stat(), named = stat()
        guard Darwin.fstat(descriptor, &held) == 0,
              Darwin.fstatat(eraseDescriptor, name, &named,
                             AT_SYMLINK_NOFOLLOW) == 0,
              RetirementLeafFact(held) == RetirementLeafFact(named),
              let readback = try readIfPresent(name),
              readback.identity == expected,
              let originalRecoveryCheckedIO else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return OriginalRecoveryPolicyWitness(
            fact: RetirementLeafFact(held), bytes: readback.data,
            names: try originalRecoveryCheckedIO.names(in: eraseDescriptor))
    }

    func verifyAuthority() throws {
        guard !coldCleanupCompletionControlsRemoved,
              !originalRecoveryCloseAttempted, !coldCloseAttempted, !coldClosed,
              (!originalAuxiliaryPublicationStarted ||
                originalAuxiliaryPublishedReceipt != nil),
              !originalAuxiliaryPublicationUncertain,
              (!originalRetiredCommitmentStarted ||
                originalRetiredCommitmentReceipt != nil),
              !originalRetiredCommitmentUncertain,
              (!originalRetiredStageIdentityStarted ||
                originalRetiredStageIdentityReceipt != nil),
              !originalRetiredStageIdentityUncertain,
              originalAuxiliaryActiveFD == nil,
              originalAuxiliaryUncertainFDs.isEmpty,
              originalAuxiliaryEnumerationFD == nil,
              originalAuxiliaryDirectoryStream == nil,
              !originalAuxiliaryUncertainStreamClose,
              coldActiveFD == nil, coldUncertainFDs.isEmpty,
              !coldEffectUncertain, !coldRosterInFlight,
              coldEnumerationFD == nil,
              coldDirectoryStream == nil, !coldUncertainStreamClose else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try Self.requireDirectory(
            applicationSupportDescriptor,
            identity: applicationSupportIdentity
        )
        try Self.requireDirectory(eraseDescriptor, identity: eraseIdentity)
        if let originalRecoveryCheckedIO {
            guard originalRecoveryUncertainPolicyDescriptors.isEmpty else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try originalRecoveryCheckedIO.requireSettled()
            var named = stat()
            guard Darwin.fstatat(applicationSupportDescriptor,
                      Self.directoryName, &named, AT_SYMLINK_NOFOLLOW) == 0,
                  (named.st_mode & S_IFMT) == S_IFDIR,
                  named.st_dev == eraseIdentity.device,
                  named.st_ino == eraseIdentity.inode else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return
        }
        if borrowsColdObservation {
            var support = stat(), erase = stat(), heldBefore = stat()
            guard Darwin.lstat(applicationSupportURL.path, &support) == 0,
                  support.st_mode & S_IFMT == S_IFDIR,
                  support.st_dev == applicationSupportIdentity.device,
                  support.st_ino == applicationSupportIdentity.inode,
                  Darwin.fstat(eraseDescriptor, &heldBefore) == 0,
                  Darwin.fstatat(applicationSupportDescriptor,
                      Self.directoryName, &erase, AT_SYMLINK_NOFOLLOW) == 0,
                  erase.st_mode & S_IFMT == S_IFDIR,
                  erase.st_dev == eraseIdentity.device,
                  erase.st_ino == eraseIdentity.inode,
                  EraseColdControlLeafFactV1(erase)
                    == EraseColdControlLeafFactV1(heldBefore) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let names = try coldNamesChecked()
            var heldAfter = stat(), namedAfter = stat()
            guard Darwin.fstat(eraseDescriptor, &heldAfter) == 0,
                  Darwin.fstatat(applicationSupportDescriptor,
                      Self.directoryName, &namedAfter,
                      AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(heldBefore)
                    == EraseColdControlLeafFactV1(heldAfter),
                  EraseColdControlLeafFactV1(heldAfter)
                    == EraseColdControlLeafFactV1(namedAfter) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            guard names.allSatisfy({
                $0 == Self.intentName || $0 == Self.preparationName ||
                    $0 == coldOwnTemporaryName ||
                    ($0 == Self.rosterName &&
                        (coldOwnRosterFact != nil ||
                            coldCapturedOpaqueRosterPresent)) ||
                    ($0 == Self.rosterNextName &&
                        coldCapturedOpaqueRosterNextPresent &&
                        !coldObservedRosterTempSettled) ||
                    ($0 == Self.auxiliaryRosterName &&
                        coldCapturedOpaqueAuxiliaryRosterBytes != nil) ||
                    ($0 == Self.originalRetiredCommitmentName &&
                        coldCapturedOpaqueOriginalRetired[$0] != nil) ||
                    ($0 == Self.originalRetiredCommitmentNextName &&
                        coldCapturedOpaqueOriginalRetired[$0] != nil) ||
                    ($0 == Self.originalRetiredStageIdentityName &&
                        coldCapturedOpaqueOriginalRetired[$0] != nil) ||
                    ($0 == Self.originalRetiredStageIdentityNextName &&
                        coldCapturedOpaqueOriginalRetired[$0] != nil) ||
                    ($0 == Self.auxiliaryRosterNextName &&
                        coldCapturedOpaqueAuxiliaryRosterNextPresent) ||
                    ($0 == Self.nextName &&
                        coldCapturedOpaqueNextBytes != nil) ||
                    (EraseSchema2ColdCleanupGrammarV1.isControlName($0) &&
                        (coldCleanupProjectedLeaves[$0] != nil ||
                         coldCleanupOwnBytes[$0] != nil))
            }) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            if let coldOwnRosterFact {
                var roster = stat()
                guard names.contains(Self.rosterName),
                      Darwin.fstatat(eraseDescriptor,
                        Self.rosterName, &roster,
                        AT_SYMLINK_NOFOLLOW) == 0,
                      EraseColdControlLeafFactV1(roster)
                        == coldOwnRosterFact,
                      roster.st_mode & S_IFMT == S_IFREG,
                      roster.st_nlink == 1 else {
                    throw EraseIntentStoreError.invalidAuthority
                }
            }
            try requireCapturedOpaqueNextNoRepair()
            return
        }
        let reopenedApp = Darwin.open(
            applicationSupportURL.path,
            O_RDONLY | O_DIRECTORY | O_NOFOLLOW
        )
        guard reopenedApp >= 0 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        defer { _ = Darwin.close(reopenedApp) }
        guard try Self.directoryIdentity(reopenedApp) == applicationSupportIdentity else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let reopenedErase = Darwin.openat(
            reopenedApp,
            Self.directoryName,
            O_RDONLY | O_DIRECTORY | O_NOFOLLOW
        )
        guard reopenedErase >= 0 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        defer { _ = Darwin.close(reopenedErase) }
        guard try Self.directoryIdentity(reopenedErase) == eraseIdentity else {
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    func encode(_ value: EraseIntentV1) throws -> Data {
        do { return try EraseIntentCodecV1.encode(value) }
        catch { throw EraseIntentStoreError.invalidIntent }
    }

    func decode(_ data: Data) throws -> EraseIntentV1 {
        do { return try EraseIntentCodecV1.decode(data) }
        catch { throw EraseIntentStoreError.invalidIntent }
    }

    func encodePreparation(_ value: ErasePreparationV2) throws -> Data {
        do { return try ErasePreparationCodecV2.encode(value) }
        catch { throw EraseIntentStoreError.invalidPreparation }
    }

    func decodePreparation(_ data: Data) throws -> ErasePreparationV2 {
        do { return try ErasePreparationCodecV2.decode(data) }
        catch { throw EraseIntentStoreError.invalidPreparation }
    }

    func isPreparationTransition(
        _ current: ErasePreparationV2,
        _ next: ErasePreparationV2
    ) -> Bool {
        current.oldPointer == next.oldPointer
            && current.sourceLedger == next.sourceLedger
            && current.targetGenerationID == next.targetGenerationID
            && current.targetWorkspaceID == next.targetWorkspaceID
            && current.targetReplicaID == next.targetReplicaID
            && current.targetPointer == nil
            && next.targetPointer != nil
    }

    func sameOperation(_ lhs: EraseIntentV1, _ rhs: EraseIntentV1) -> Bool {
        lhs.auxiliaryRoots == rhs.auxiliaryRoots
            && lhs.eraseID == rhs.eraseID
            && lhs.generationIDsToDelete == rhs.generationIDsToDelete
            && lhs.newGenerationID == rhs.newGenerationID
            && lhs.oldGenerationID == rhs.oldGenerationID
            && lhs.oldPointer == rhs.oldPointer
            && lhs.schemaVersion == rhs.schemaVersion
            && lhs.sourceLedger == rhs.sourceLedger
            && lhs.targetEmptyProof == rhs.targetEmptyProof
            && lhs.targetPointer == rhs.targetPointer
    }

    func nextPhase(after phase: EraseIntentPhaseV1) -> EraseIntentPhaseV1? {
        switch phase {
        case .emptyGenerationPrepared: .pointerSwitched
        case .pointerSwitched: .sessionActivated
        case .sessionActivated: .cleanupComplete
        case .cleanupComplete: nil
        }
    }

    private func readIfPresent(
        _ name: String
    ) throws -> (data: Data, identity: Identity)? {
        if let originalRecoveryCheckedIO {
            var named = stat()
            if Darwin.fstatat(eraseDescriptor, name, &named,
                              AT_SYMLINK_NOFOLLOW) != 0 {
                guard errno == ENOENT else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                return nil
            }
            return try originalRecoveryCheckedIO.withOpen(
                parent: eraseDescriptor, name: name,
                flags: O_RDONLY | O_NONBLOCK) { descriptor in
                var before = stat(), after = stat(), namedAfter = stat()
                guard Darwin.fstat(descriptor, &before) == 0,
                      before.st_mode & S_IFMT == S_IFREG,
                      before.st_nlink == 1, before.st_size >= 0,
                      before.st_size <= 1_048_576,
                      before.st_dev == named.st_dev,
                      before.st_ino == named.st_ino else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                var data = Data()
                var buffer = [UInt8](repeating: 0, count: 16 * 1024)
                while true {
                    let count = buffer.withUnsafeMutableBytes {
                        Darwin.read(descriptor, $0.baseAddress, $0.count)
                    }
                    if count > 0 {
                        guard data.count <= 1_048_576 - count else {
                            throw EraseIntentStoreError.invalidAuthority
                        }
                        data.append(contentsOf: buffer.prefix(count))
                    } else if count == 0 { break }
                    else if errno != EINTR {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                }
                guard Darwin.fstat(descriptor, &after) == 0,
                      Darwin.fstatat(eraseDescriptor, name, &namedAfter,
                                     AT_SYMLINK_NOFOLLOW) == 0,
                      RetirementLeafFact(before) == RetirementLeafFact(after),
                      RetirementLeafFact(before) == RetirementLeafFact(namedAfter),
                      data.count == Int(before.st_size) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                return (data, Identity(device: before.st_dev,
                                       inode: before.st_ino))
            }
        }
        if borrowsColdObservation {
            return try readColdLeafIfPresent(name)
        }
        let descriptor = Darwin.openat(
            eraseDescriptor,
            name,
            O_RDONLY | O_NOFOLLOW
        )
        if descriptor < 0, errno == ENOENT { return nil }
        guard descriptor >= 0 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        defer { _ = Darwin.close(descriptor) }
        var before = stat()
        guard Darwin.fstat(descriptor, &before) == 0,
              (before.st_mode & S_IFMT) == S_IFREG,
              before.st_nlink == 1 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var data = Data()
        var buffer = [UInt8](repeating: 0, count: 16 * 1024)
        while true {
            let count = buffer.withUnsafeMutableBytes {
                Darwin.read(descriptor, $0.baseAddress, $0.count)
            }
            if count > 0 {
                data.append(contentsOf: buffer.prefix(count))
                guard data.count <= Self.maximumJournalBytes else {
                    throw EraseIntentStoreError.invalidAuthority
                }
            } else if count == 0 {
                break
            } else if errno != EINTR {
                throw EraseIntentStoreError.invalidAuthority
            }
        }
        var after = stat()
        guard Darwin.fstat(descriptor, &after) == 0,
              before.st_dev == after.st_dev,
              before.st_ino == after.st_ino,
              before.st_size == after.st_size,
              data.count == Int(after.st_size) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return (
            data,
            Identity(device: after.st_dev, inode: after.st_ino)
        )
    }

    private func closeColdActiveChecked() throws {
        guard let descriptor = coldActiveFD else {
