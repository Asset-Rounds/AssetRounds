    /// A decoded original-P roster may request complete protection once on
    /// the exact first canonical inode. The witness excludes only ctime,
    /// which the checked request itself can change. It never accepts raw
    /// pending Simulator policy as replay authority.
    @MainActor
    func requireSchema2ColdVerifiedObservedOriginalAuxiliaryRosterPolicy(
        roster: EraseSchema2ColdAuxiliaryPhysicalRosterV1,
        intent: EraseIntentV1,
        preparation: ErasePreparationV2,
        operation: EraseColdPreparationOperationV1
    ) throws -> EraseColdControlLeafFactV1 {
        guard !coldObservedAuxiliaryPolicyInFlight,
              !coldEffectUncertain,
              let firstBytes = coldCapturedOpaqueAuxiliaryRosterBytes,
              let firstFact = coldCapturedOpaqueAuxiliaryRosterFact,
              roster.canonicalBytes == firstBytes,
              roster.canonicalSHA256 ==
                StoreMigrationCanonicalJSONV1.sha256(firstBytes) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        func witness() throws
            -> Schema2ColdOriginalAuxiliaryPolicyWitnessV1 {
            try operation.requireSchema2ColdRosterObservationOwner(
                store: self)
            let controls = try requireSchema2ColdCanonicalControls(
                intent: intent, preparation: preparation,
                operation: operation)
            guard controls.names.contains(Self.auxiliaryRosterName),
                  !controls.names.contains(Self.auxiliaryRosterNextName),
                  let leaf = try readColdLeafIfPresent(
                    Self.auxiliaryRosterName,
                    maximumBytes: Self.maximumJournalBytes),
                  leaf.data == firstBytes else {
                throw EraseIntentStoreError.invalidAuthority
            }
            var named = stat()
            guard Darwin.fstatat(eraseDescriptor,
                    Self.auxiliaryRosterName, &named,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  named.st_mode & S_IFMT == S_IFREG,
                  named.st_nlink == 1,
                  named.st_dev == firstFact.device,
                  named.st_ino == firstFact.inode,
                  named.st_mode == firstFact.mode,
                  named.st_uid == firstFact.user,
                  named.st_gid == firstFact.group,
                  named.st_uid == Darwin.getuid(),
                  named.st_gid == Darwin.getgid(),
                  named.st_size == firstFact.size,
                  Int64(named.st_mtimespec.tv_sec)
                    == firstFact.modifiedSeconds,
                  Int64(named.st_mtimespec.tv_nsec)
                    == firstFact.modifiedNanoseconds,
                  try coldRootFact() == controls.eraseRoot,
                  try coldNamesChecked() == controls.names else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return .init(intentBytes: controls.intentBytes,
                preparationBytes: controls.preparationBytes,
                recordBytes: leaf.data, device: named.st_dev,
                inode: named.st_ino, mode: named.st_mode,
                user: named.st_uid, group: named.st_gid,
                links: named.st_nlink, size: named.st_size,
                modifiedSeconds:
                    Int64(named.st_mtimespec.tv_sec),
                modifiedNanoseconds:
                    Int64(named.st_mtimespec.tv_nsec),
                eraseRoot: controls.eraseRoot,
                names: controls.names)
        }
        let before = try witness()
        if let disposition = coldVerifiedAuxiliaryDisposition {
            guard try witness() == before else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let policy = try observeBorrowedColdPolicy(.journal,
                at: applicationSupportURL.appendingPathComponent(
                    policyRelativePath(Self.auxiliaryRosterName)))
            guard policy.device == UInt64(firstFact.device),
                  policy.inode == UInt64(firstFact.inode),
                  policy.linkCount == 1,
                  policy.backupExcluded == true,
                  (disposition == .verifiedComplete
                    ? policy.state == .strictComplete
                    : (policy.state == .pendingSimulatorRequest ||
                        policy.state == .strictComplete)),
                  try witness() == before else {
                throw EraseIntentStoreError.invalidAuthority
            }
            guard let projected = coldProjectedAuxiliaryRosterFact else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return projected
        }
        // The first full physical fact, including ctime, is bound before the
        // request. Only this checked request may subsequently project ctime.
        _ = try requireSchema2ColdObservedOriginalAuxiliaryRosterCut(
            intent: intent, preparation: preparation,
            operation: operation)
        coldObservedAuxiliaryPolicyInFlight = true
        do {
            let disposition = try ProtectedFilePolicyV1
                .verifyEraseColdTemporalPolicyWithCheckedRequest(
                    .journal,
                    at: applicationSupportURL.appendingPathComponent(
                        policyRelativePath(Self.auxiliaryRosterName)),
                    retainUncertainDescriptor: { value in
                        self.coldUncertainFDs.append(value)
                    }, unchangedWitness: { try witness() })
            guard coldUncertainFDs.isEmpty,
                  try witness() == before else {
                throw EraseIntentStoreError.invalidAuthority
            }
            var named = stat()
            guard Darwin.fstatat(eraseDescriptor,
                    Self.auxiliaryRosterName, &named,
                    AT_SYMLINK_NOFOLLOW) == 0 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let policy = try observeBorrowedColdPolicy(.journal,
                at: applicationSupportURL.appendingPathComponent(
                    policyRelativePath(Self.auxiliaryRosterName)))
            guard policy.device == UInt64(firstFact.device),
                  policy.inode == UInt64(firstFact.inode),
                  policy.linkCount == 1,
                  policy.backupExcluded == true,
                  (disposition == .verifiedComplete
                    ? policy.state == .strictComplete
                    : (policy.state == .pendingSimulatorRequest ||
                        policy.state == .strictComplete)),
                  try witness() == before else {
                throw EraseIntentStoreError.invalidAuthority
            }
            coldProjectedAuxiliaryRosterFact =
                EraseColdControlLeafFactV1(named)
            coldVerifiedAuxiliaryDisposition = disposition
            coldObservedAuxiliaryPolicyInFlight = false
            return EraseColdControlLeafFactV1(named)
        } catch {
            coldEffectUncertain = true
            throw error
        }
    }

    /// The roster publisher consumes these exact held control bytes, not a
