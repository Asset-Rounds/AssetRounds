        guard borrowsColdObservation,
              expectedIntent.schemaVersion == 2,
              expectedPreparation.matches(expectedIntent) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try verifyAuthority()
        var before = stat(), named = stat()
        guard Darwin.fstat(eraseDescriptor, &before) == 0,
              Darwin.fstatat(applicationSupportDescriptor,
                  Self.directoryName, &named, AT_SYMLINK_NOFOLLOW) == 0,
              EraseColdControlLeafFactV1(before)
                == EraseColdControlLeafFactV1(named),
              let intentLeaf = try readIfPresent(Self.intentName),
              let preparationLeaf = try readIfPresent(Self.preparationName),
              try decode(intentLeaf.data) == expectedIntent,
              try decodePreparation(preparationLeaf.data)
                == expectedPreparation,
              try EraseIntentCodecV1.encode(expectedIntent)
                == intentLeaf.data,
              try ErasePreparationCodecV2.encode(expectedPreparation)
                == preparationLeaf.data else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let names = try coldNamesChecked()
        var after = stat(), namedAfter = stat()
        guard Darwin.fstat(eraseDescriptor, &after) == 0,
              Darwin.fstatat(applicationSupportDescriptor,
                  Self.directoryName, &namedAfter,
                  AT_SYMLINK_NOFOLLOW) == 0,
