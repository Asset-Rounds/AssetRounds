        defer { coldCleanupPermit = nil; coldCleanupEffect = nil }
        guard coldCleanupCompletionControlsRemoved, coldCleanupTerminalRootRemoved,
              coldCleanupTerminalObservation == terminal,
              coldCleanupTerminalRetirement === retirement,
              terminal.value.cleanupIntentBytes == (try EraseIntentCodecV1.encode(expected)) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try bindSchema2ColdCleanupEffect(EraseSchema2ColdCleanupCommitmentV1.makeEffect(
            kind: .closeTerminalStore,
            inputSHA256: [StoreMigrationCanonicalJSONV1.sha256(terminal.bytes)],
            path: Self.directoryName), permit: permit)
        try requireSchema2ColdCleanupEffect(permit)
        if let receipt = coldCleanupTerminalCloseReceipt {
            try receipt.requireBound(store: self, expected: expected, retirement: retirement)
            return receipt // memory only; neither numeric descriptor is used.
        }
        guard borrowsColdObservation, !coldCloseAttempted, !coldClosed,
              coldActiveFD == nil, coldEnumerationFD == nil, coldDirectoryStream == nil,
              coldUncertainFDs.isEmpty, !coldUncertainStreamClose, !coldEffectUncertain else {
            throw EraseIntentStoreError.invalidAuthority
        }
