                Self.originalRetiredStageIdentityName,
                maximumBytes: receipt.canonicalBytes.count),
              leaf.0 == receipt.canonicalBytes,
              leaf.1 == receipt.recordFact,
              let physical = try? originalAuxiliaryRootFactAndNames(),
              physical.0 == receipt.projectedRoot,
              physical.1 == receipt.published.eraseNames else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try io.requireSettled()
    }

    /// Publishes the prospective P-cut record before Factory may create its
    /// retired-pointer temp. Only this operation's original Store, roster,
    /// retained EX and checked G scope can perform the one-way publication.
    func publishOriginalRecoveryRetiredCommitment(
        namespace: OriginalEraseRecoveryNamespaceSnapshotV1,
        replacementBytes: Data,
        sourceAuthority: StoreRestoreGenerationAuthority,
        operation: EraseRouterOperationV1,
        owner: StoreOriginalEraseRecoveryPreOpenOwnerV1,
        registry: GenerationLeaseRegistryV1,
        activity: GenerationTemporalActivityHandleV1,
        permit: OriginalEraseRecoveryRetiredCommitmentPermitV1,
        support: StoreTemporalPhysicalRootExclusionV1,
        firstObservation: OriginalRecoveryObservation,
        io: EraseAbortCheckedSnapshotIOV1,
        retainUncertainDescriptor: (Int32) -> Void
    ) throws -> OriginalRecoveryRetiredCommitmentReceiptV1 {
        guard let roster = originalAuxiliaryPublishedReceipt,
              roster.operation === operation,
              let intent = firstObservation.intent,
              intent.schemaVersion == 2,
              intent.phase == .emptyGenerationPrepared,
              firstObservation.preparation?.matches(intent) == true,
              namespace.retiredState == .prior,
              !originalRetiredCommitmentStarted,
              originalRetiredCommitmentReceipt == nil,
              !originalRetiredCommitmentUncertain,
              !originalAuxiliaryPhaseInFlight,
              !originalAuxiliaryPhaseUncertain,
              originalAuxiliaryProjectedIntentBytes == (try encode(intent)),
              let beforeRoot = originalAuxiliaryProjectedRoot,
              let firstIntent = firstObservation.leaves.first(where: {
                $0.name == Self.intentName }),
              let firstPreparation = firstObservation.leaves.first(where: {
                $0.name == Self.preparationName }),
              let firstRoster = firstObservation.leaves.first(where: {
                $0.name == Self.auxiliaryRosterName }),
              let firstErase = firstObservation.eraseFact,
              let firstEraseOwnership = firstObservation.eraseOwnership,
              replacementBytes.count <= 1_048_576 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try owner.requireRetainedOriginalRecoveryStoreEffect(
            registry: registry, activity: activity, support: support)
        try permit.requireHeld()
        try requireOriginalEraseAuxiliaryPublishedRoster(roster)
        let before = try Self.observeOriginalRecoveryNoCreate(
            support: support, applicationSupportURL: applicationSupportURL,
            io: io, retainUncertainDescriptor: retainUncertainDescriptor)
        guard before == firstObservation else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try before.requireOriginalAuxiliaryRoster(roster, store: self,
            operation: operation, seal: roster.seal)
        let complete = try StoreMigrationCanonicalJSONV1.decodeCanonical(
            RetiredPointerV1.self, from: replacementBytes)
        let prior = try StoreMigrationCanonicalJSONV1.decodeCanonical(
            RetiredPointerV1.self, from: namespace.retiredBytes)
        try StorePointerSchemaRegistry.requireRetired(complete.schemaVersion)
        guard complete.schemaVersion == prior.schemaVersion,
              complete.generationIDs == intent.generationIDsToDelete.map({
                $0.uuidString.lowercased() }),
              prior.generationIDs == intent.generationIDsToDelete
                .filter({ $0 != intent.oldGenerationID })
                .map({ $0.uuidString.lowercased() }),
              namespace.currentFact.device == namespace.data.device,
              namespace.retiredFact.device == namespace.data.device,
              firstObservation.supportDevice == Int64(applicationSupportIdentity.device),
              firstObservation.supportInode == UInt64(applicationSupportIdentity.inode) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        typealias Fact = OriginalRecoveryRetiredCommitmentRecordV1.Fact
        func leafFact(_ leaf: OriginalRecoveryObservation.Leaf) -> Fact {
            Fact(device: leaf.fact.device, inode: leaf.fact.inode,
                mode: leaf.fact.mode, links: leaf.fact.links,
                user: leaf.ownership.user, group: leaf.ownership.group,
                size: leaf.fact.size,
                modifiedSeconds: leaf.fact.modifiedSeconds,
                modifiedNanoseconds: leaf.fact.modifiedNanoseconds,
                changedSeconds: leaf.fact.changedSeconds,
                changedNanoseconds: leaf.fact.changedNanoseconds)
        }
        let firstSupport = firstObservation.supportFact
        let firstSupportOwner = firstObservation.supportOwnership
        let record = OriginalRecoveryRetiredCommitmentRecordV1(
            schemaVersion: 2,
            eraseID: intent.eraseID.uuidString.lowercased(),
            sourceGenerationID: intent.oldGenerationID.uuidString.lowercased(),
            targetGenerationID: intent.newGenerationID.uuidString.lowercased(),
            support: Fact(device: firstSupport.device,
                inode: firstSupport.inode, mode: firstSupport.mode,
                links: firstSupport.links,
                user: firstSupportOwner.user, group: firstSupportOwner.group,
                size: firstSupport.size,
                modifiedSeconds: firstSupport.modifiedSeconds,
                modifiedNanoseconds: firstSupport.modifiedNanoseconds,
                changedSeconds: firstSupport.changedSeconds,
                changedNanoseconds: firstSupport.changedNanoseconds),
            supportNames: firstObservation.supportNames,
            erase: Fact(device: firstErase.device,
                inode: firstErase.inode, mode: firstErase.mode,
                links: firstErase.links,
                user: firstEraseOwnership.user,
                group: firstEraseOwnership.group, size: firstErase.size,
                modifiedSeconds: firstErase.modifiedSeconds,
                modifiedNanoseconds: firstErase.modifiedNanoseconds,
                changedSeconds: firstErase.changedSeconds,
                changedNanoseconds: firstErase.changedNanoseconds),
            firstEraseNames: firstObservation.eraseNames,
            intentBytes: firstIntent.data, intentFact: leafFact(firstIntent),
            preparationBytes: firstPreparation.data,
            preparationFact: leafFact(firstPreparation),
            auxiliaryRosterBytes: firstRoster.data,
            auxiliaryRosterFact: leafFact(firstRoster),
            namespace: .init(namespace),
            privateStageName: ".retired.json.original-erase-\(intent.eraseID.uuidString.lowercased()).stage",
            canonicalTempName: ".retired.json.restore-next",
            firstPrivateStageAbsent: true,
            firstCanonicalTempAbsent: true,
            replacementBytes: replacementBytes,
            replacementSHA256: StoreMigrationCanonicalJSONV1.sha256(
                replacementBytes))
        try record.validate()
        let bytes = try StoreMigrationCanonicalJSONV1.encode(record)
        guard bytes.count <= Self.maximumJournalBytes * 3 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let firstNames = [Self.intentName, Self.preparationName,
            Self.auxiliaryRosterName].sorted()
        let tempNames = (firstNames +
            [Self.originalRetiredCommitmentNextName]).sorted()
        let publishedNames = (firstNames +
            [Self.originalRetiredCommitmentName]).sorted()
        guard firstObservation.eraseNames == firstNames,
              beforeRoot.device == firstErase.device,
              beforeRoot.inode == firstErase.inode,
              beforeRoot.mode == firstErase.mode,
              beforeRoot.links == firstErase.links,
              beforeRoot.size == firstErase.size,
              beforeRoot.modifiedSeconds == firstErase.modifiedSeconds,
              beforeRoot.modifiedNanoseconds == firstErase.modifiedNanoseconds,
              beforeRoot.changedSeconds == firstErase.changedSeconds,
              beforeRoot.changedNanoseconds == firstErase.changedNanoseconds,
              try requireOriginalAuxiliaryRoot(
                names: firstNames, exact: beforeRoot) == beforeRoot else {
            throw EraseIntentStoreError.invalidAuthority
        }
        do { return try operation.withOriginalRecoveryRetiredCommitmentInsideHeldG(
            store: self, expected: intent, registry: registry,
            activity: activity, permit: permit) {
            // Reobserve the held/named Data parents and both exact canonical
            // leaves inside this same G, immediately before the Erase effect.
            // A caller-supplied snapshot alone is never a first-image proof.
            guard try sourceAuthority.originalRecoveryNamespaceSnapshot(
                    intent: intent) == namespace else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try owner.requireObservationUnchangedInsideOriginalRecoveryG()
            try requireOriginalEraseAuxiliaryPublishedRoster(roster)
            guard try requireOriginalAuxiliaryRoot(
                    names: firstNames, exact: beforeRoot) == beforeRoot else {
                throw EraseIntentStoreError.invalidAuthority
            }
            originalRetiredCommitmentStarted = true
            do {
                let eraseURL = applicationSupportURL
                    .appendingPathComponent(Self.directoryName,
                        isDirectory: true)
                let tempURL = eraseURL.appendingPathComponent(
                    Self.originalRetiredCommitmentNextName)
                var ownIdentity: Identity?
                let (disposition, root) = try io.withOpen(parent: eraseDescriptor,
                    name: Self.originalRetiredCommitmentNextName,
                    flags: O_WRONLY | O_CREAT | O_EXCL,
                    mode: mode_t(0o600)) { descriptor in
                    let identity = try Self.fileIdentity(descriptor)
                    ownIdentity = identity
                    let (root, names, user, group) = try
                        originalAuxiliaryRootFactAndNames()
                    guard names == tempNames,
                          root.device == beforeRoot.device,
                          root.inode == beforeRoot.inode,
                          root.mode == beforeRoot.mode,
                          originalAuxiliaryRootUser == user,
                          originalAuxiliaryRootGroup == group,
                          (originalAuxiliaryRootLinkLaw == 0 &&
                            root.links == 2 ||
                           originalAuxiliaryRootLinkLaw == 1 &&
                            UInt64(root.links) == UInt64(2 + names.count)) else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                    let disposition = try ProtectedFilePolicyV1
                        .applyAndVerifyEraseColdPrivateWithCheckedClose(
                            .journalTemporary, at: tempURL,
                            retainUncertainDescriptor: { [self] in
                                retainOriginalRecoveryUncertainDescriptor($0)
                            }, authorityCheck: {
                                var held = stat(), named = stat()
                                guard Darwin.fstat(descriptor, &held) == 0,
                                      Darwin.fstatat(eraseDescriptor,
                                        Self.originalRetiredCommitmentNextName,
                                        &named, AT_SYMLINK_NOFOLLOW) == 0,
                                      held.st_dev == identity.device,
                                      held.st_ino == identity.inode,
                                      held.st_mode & S_IFMT == S_IFREG,
                                      held.st_mode & 0o777 == 0o600,
                                      held.st_nlink == 1,
                                      held.st_size == 0,
                                      held.st_uid == Darwin.getuid(),
                                      held.st_gid == firstEraseOwnership.group,
                                      held.st_uid == named.st_uid,
                                      held.st_gid == named.st_gid,
                                      EraseColdControlLeafFactV1(held)
                                        == EraseColdControlLeafFactV1(named),
                                      let bracket = try?
                                        originalAuxiliaryRootFactAndNames(),
                                      bracket.0 == root,
                                      bracket.1 == tempNames,
                                      bracket.2 == firstEraseOwnership.user,
                                      bracket.3 == firstEraseOwnership.group else {
                                    throw EraseIntentStoreError.invalidAuthority
                                }
                            })
                    try bytes.withUnsafeBytes { raw in
                        guard let base = raw.baseAddress else {
                            throw EraseIntentStoreError.writeFailed
                        }
                        var offset = 0
                        while offset < raw.count {
                            let count = Darwin.write(descriptor,
                                base.advanced(by: offset), raw.count - offset)
                            if count > 0 { offset += count }
                            else if count == 0 || errno != EINTR {
                                throw EraseIntentStoreError.writeFailed
                            }
                        }
                    }
                    guard Darwin.fsync(descriptor) == 0 else {
                        throw EraseIntentStoreError.writeFailed
                    }
                    return (disposition, root)
                }
                guard let ownIdentity,
                      let temporary = try readOriginalAuxiliaryLeaf(
                        Self.originalRetiredCommitmentNextName,
                        maximumBytes: bytes.count),
                      temporary.0 == bytes,
                      temporary.1.device == ownIdentity.device,
                      temporary.1.inode == ownIdentity.inode else {
                    throw EraseIntentStoreError.writeFailed
                }
                let beforeRename = try originalAuxiliaryRootFactAndNames()
                guard beforeRename.0 == root,
                      beforeRename.1 == tempNames,
                      beforeRename.2 == firstEraseOwnership.user,
                      beforeRename.3 == firstEraseOwnership.group,
                      Darwin.renameatx_np(eraseDescriptor,
                        Self.originalRetiredCommitmentNextName,
                        eraseDescriptor,
                        Self.originalRetiredCommitmentName,
                        UInt32(RENAME_EXCL)) == 0 else {
                    throw EraseIntentStoreError.writeFailed
                }
                let (afterRoot, names, user, group) = try
                    originalAuxiliaryRootFactAndNames()
                guard names == publishedNames,
                      afterRoot.device == beforeRoot.device,
                      afterRoot.inode == beforeRoot.inode,
                      afterRoot.mode == beforeRoot.mode,
                      originalAuxiliaryRootUser == user,
                      originalAuxiliaryRootGroup == group,
                      (originalAuxiliaryRootLinkLaw == 0 &&
                        afterRoot.links == 2 ||
                       originalAuxiliaryRootLinkLaw == 1 &&
                        UInt64(afterRoot.links)
                            == UInt64(2 + names.count)),
                      Darwin.fsync(eraseDescriptor) == 0,
                      try originalAuxiliaryRootFactAndNames().0 == afterRoot,
                      let published = try readOriginalAuxiliaryLeaf(
                        Self.originalRetiredCommitmentName,
                        maximumBytes: bytes.count),
                      published.0 == bytes,
                      published.1.device == temporary.1.device,
                      published.1.inode == temporary.1.inode,
                      published.1.mode == temporary.1.mode,
                      published.1.links == temporary.1.links,
                      published.1.size == temporary.1.size else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                let policy = try ProtectedFilePolicyV1
                    .observeTemporalPolicyWithCheckedClose(
                        .journal, at: eraseURL.appendingPathComponent(
                            Self.originalRetiredCommitmentName),
                        retainUncertainDescriptor: { [self] in
                            retainOriginalRecoveryUncertainDescriptor($0)
                        })
                guard policy.device == UInt64(published.1.device),
                      policy.inode == UInt64(published.1.inode),
                      policy.linkCount == UInt64(published.1.links),
                      policy.backupExcluded == true,
                      (policy.state == .strictComplete ||
                       (policy.state == .pendingSimulatorRequest &&
                        disposition == .simulatorFileProtectionUnsupported)) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                let after = try Self.observeOriginalRecoveryNoCreate(
                    support: support, applicationSupportURL: applicationSupportURL,
                    io: io, retainUncertainDescriptor:
                        retainUncertainDescriptor)
                guard after.sameOwnedRetiredCommitmentNonRecordNamespace(
                        as: before),
                      let observedRecord = after.leaves.first(where: {
                        $0.name == Self.originalRetiredCommitmentName }),
                      observedRecord.data == bytes,
                      observedRecord.fact.device == published.1.device,
                      observedRecord.fact.inode == published.1.inode,
                      observedRecord.fact.mode == published.1.mode,
                      observedRecord.fact.links == published.1.links,
                      observedRecord.fact.size == published.1.size,
                      observedRecord.fact.modifiedSeconds
                        == published.1.modifiedSeconds,
                      observedRecord.fact.modifiedNanoseconds
                        == published.1.modifiedNanoseconds,
                      observedRecord.fact.changedSeconds
                        == published.1.changedSeconds,
                      observedRecord.fact.changedNanoseconds
                        == published.1.changedNanoseconds else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                originalAuxiliaryProjectedRoot = afterRoot
                let receipt = OriginalRecoveryRetiredCommitmentReceiptV1(
                    store: self, operation: operation, owner: owner,
                    namespace: namespace, replacementBytes: replacementBytes,
                    record: record, canonicalBytes: bytes,
                    recordFact: published.1,
                    first: before, published: after,
                    projectedRoot: afterRoot, support: support)
                originalRetiredCommitmentReceipt = receipt
                try io.requireSettled()
                return receipt
            } catch {
                originalRetiredCommitmentUncertain = true
                throw error
            }
        }
        } catch {
            // The Registry's post-effect census can fail after a fully
            // published leaf. No caller may then reuse this receipt.
            if originalRetiredCommitmentStarted {
                originalRetiredCommitmentUncertain = true
            }
            throw error
        }
    }

    func requireOriginalRecoveryRetiredCommitment(
        _ receipt: OriginalRecoveryRetiredCommitmentReceiptV1
    ) throws {
        guard originalRetiredCommitmentReceipt === receipt,
              !originalRetiredStageIdentityUncertain,
              (!originalRetiredStageIdentityStarted
                || originalRetiredStageIdentityReceipt != nil),
              receipt.store === self,
              receipt.checkedSettled,
              !originalRetiredCommitmentUncertain,
              !originalAuxiliaryPhaseInFlight,
              !originalAuxiliaryPhaseUncertain,
              originalAuxiliaryProjectedRoot ==
                (originalRetiredStageIdentityReceipt?.projectedRoot
                    ?? receipt.projectedRoot),
              let roster = originalAuxiliaryPublishedReceipt,
              let io = originalRecoveryCheckedIO else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try requireOriginalEraseAuxiliaryPublishedRoster(roster)
        try receipt.record.validate()
        guard try StoreMigrationCanonicalJSONV1.encode(receipt.record)
                == receipt.canonicalBytes,
              let leaf = try readOriginalAuxiliaryLeaf(
                Self.originalRetiredCommitmentName,
                maximumBytes: receipt.canonicalBytes.count),
              leaf.0 == receipt.canonicalBytes,
              leaf.1 == receipt.recordFact,
              let physical = try? originalAuxiliaryRootFactAndNames(),
              physical.0 == originalAuxiliaryProjectedRoot,
              physical.1 == (originalRetiredStageIdentityReceipt?
                .published.eraseNames ?? receipt.published.eraseNames) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try io.requireSettled()
    }

    /// This is an in-memory ownership check for the narrow interval after
    /// full roster preflight and before Registry acquires G. Ordinary roster
    /// reproof continues to reject every in-flight call.
    func requireOriginalEraseAuxiliaryPhaseInFlight(
        receipt: OriginalAuxiliaryRosterPublicationReceiptV1,
        operation: EraseRouterOperationV1,
        expected: EraseIntentV1,
        replacement: EraseIntentV1
    ) throws {
        guard originalAuxiliaryPhaseInFlight,
              !originalAuxiliaryPhaseUncertain,
              originalAuxiliaryPublishedReceipt === receipt,
              receipt.store === self,
              receipt.operation === operation,
              receipt.checkedSettled,
              originalAuxiliaryProjectedIntentBytes == (try encode(expected)),
              replacement == expected.advancing(to:
                expected.phase == .emptyGenerationPrepared
                    ? .pointerSwitched : .sessionActivated),
              expected.phase == .emptyGenerationPrepared
                || expected.phase == .pointerSwitched else {
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    /// Projects only this Store's checked P→Q or Q→R intent CAS. The immutable
    /// roster leaf and preparation keep their first full facts; a failed or
    /// ambiguous phase effect permanently withholds later auxiliary effects.
    func replaceOriginalEraseAuxiliaryPhase(
        expected: EraseIntentV1,
        with replacement: EraseIntentV1,
        operation: EraseRouterOperationV1
    ) throws {
#if DEBUG
        originalAuxiliaryPhaseTracingForTesting = true
        defer { originalAuxiliaryPhaseTracingForTesting = false }
        print("ORIGINAL_AUX_PHASE_V1 stage=entry")
#endif
        guard let receipt = originalAuxiliaryPublishedReceipt,
              receipt.operation === operation else {
#if DEBUG
            print("ORIGINAL_AUX_PHASE_V1 refusal=receipt-binding")
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
        guard
              !originalRetiredStageIdentityUncertain,
              (!originalRetiredStageIdentityStarted
                || originalRetiredStageIdentityReceipt != nil),
              !originalAuxiliaryPhaseInFlight,
              !originalAuxiliaryPhaseUncertain else {
#if DEBUG
            print("ORIGINAL_AUX_PHASE_V1 refusal=phase-state")
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
        guard
              expected.schemaVersion == 2,
              (expected.phase == .emptyGenerationPrepared
                && replacement == expected.advancing(to: .pointerSwitched)
                || expected.phase == .pointerSwitched
                && replacement == expected.advancing(to: .sessionActivated)) else {
#if DEBUG
            print("ORIGINAL_AUX_PHASE_V1 refusal=phase-lineage")
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
        guard
              let beforeRoot = originalAuxiliaryProjectedRoot,
              let beforeIntent = originalAuxiliaryProjectedIntentBytes,
              let beforeIntentFact = originalAuxiliaryProjectedIntentFact else {
#if DEBUG
            print("ORIGINAL_AUX_PHASE_V1 refusal=projected-controls")
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
        guard beforeIntent == (try encode(expected)) else {
#if DEBUG
            print("ORIGINAL_AUX_PHASE_V1 refusal=intent-bytes")
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
#if DEBUG
        print("ORIGINAL_AUX_PHASE_V1 stage=store-guard-complete")
#endif
        try operation.requireOriginalEraseAuxiliaryPhaseOwner(
            store: self, expected: expected, replacement: replacement)
#if DEBUG
        print("ORIGINAL_AUX_PHASE_V1 stage=router-owner-complete")
#endif
        try requireOriginalEraseAuxiliaryPublishedRoster(receipt)
#if DEBUG
        print("ORIGINAL_AUX_PHASE_V1 stage=roster-preflight-complete")
#endif
        var names = ([Self.intentName, Self.preparationName,
            Self.auxiliaryRosterName] +
            (originalRetiredCommitmentReceipt == nil ? [] :
                [Self.originalRetiredCommitmentName]) +
            (originalRetiredStageIdentityReceipt == nil ? [] :
                [Self.originalRetiredStageIdentityName])).sorted()
        let phaseAdmission = try operation.admitOriginalEraseAuxiliaryPhaseCAS(
            store: self, expected: expected, replacement: replacement)
        originalAuxiliaryPhaseInFlight = true
        do {
#if DEBUG
            print("ORIGINAL_AUX_PHASE_V1 stage=registry-cas-enter")
#endif
            try operation.withOriginalEraseAuxiliaryPhaseCAS(
                admission: phaseAdmission,
                store: self, expected: expected,
                replacement: replacement) {
#if DEBUG
                print("ORIGINAL_AUX_PHASE_V1 stage=generic-cas-enter")
#endif
                try replaceWithoutMigrationReservation(
                    expected: expected, with: replacement)
#if DEBUG
                print("ORIGINAL_AUX_PHASE_V1 stage=generic-cas-complete")
#endif
                let (afterRoot, afterNames, user, group) = try
                    originalAuxiliaryRootFactAndNames()
#if DEBUG
                print("ORIGINAL_AUX_PHASE_V1 stage=post-root-observed")
#endif
                guard afterNames == names,
                      afterRoot.device == beforeRoot.device,
                      afterRoot.inode == beforeRoot.inode,
                      afterRoot.mode == beforeRoot.mode,
                      afterRoot.links == beforeRoot.links,
                      originalAuxiliaryRootUser == user,
                      originalAuxiliaryRootGroup == group,
                      let nextIntent = try readOriginalAuxiliaryLeaf(
                        Self.intentName,
                        maximumBytes: (try encode(replacement)).count),
                      nextIntent.0 == (try encode(replacement)),
                      nextIntent.1 != beforeIntentFact,
                      let rosterLeaf = try readOriginalAuxiliaryLeaf(
                        Self.auxiliaryRosterName,
                        maximumBytes: receipt.canonicalBytes.count),
                      rosterLeaf.0 == receipt.canonicalBytes,
                      rosterLeaf.1 == receipt.recordFact,
                      let preparationLeaf = try readOriginalAuxiliaryLeaf(
                        Self.preparationName,
                        maximumBytes: receipt.preparationBytes.count),
                      preparationLeaf.0 == receipt.preparationBytes,
                      preparationLeaf.1 == receipt.preparationFact else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                originalAuxiliaryProjectedRoot = afterRoot
                originalAuxiliaryProjectedIntentBytes = nextIntent.0
                originalAuxiliaryProjectedIntentFact = nextIntent.1
                originalAuxiliaryPhaseInFlight = false
            }
#if DEBUG
            print("ORIGINAL_AUX_PHASE_V1 stage=registry-cas-complete")
#endif
            try requireOriginalEraseAuxiliaryPublishedRoster(receipt)
#if DEBUG
            print("ORIGINAL_AUX_PHASE_V1 stage=final-roster-complete")
#endif
        } catch {
#if DEBUG
            switch error {
            case EraseIntentStoreError.retirementPolicyEffectUnavailable:
                print("ORIGINAL_AUX_PHASE_V1 error=retirement-policy")
            case EraseIntentStoreError.invalidAuthority:
                print("ORIGINAL_AUX_PHASE_V1 error=invalid-authority")
            case EraseIntentStoreError.invalidIntent:
                print("ORIGINAL_AUX_PHASE_V1 error=invalid-intent")
            case EraseIntentStoreError.invalidPreparation:
                print("ORIGINAL_AUX_PHASE_V1 error=invalid-preparation")
            case EraseIntentStoreError.intentAlreadyExists:
                print("ORIGINAL_AUX_PHASE_V1 error=intent-already-exists")
            case EraseIntentStoreError.intentMissing:
                print("ORIGINAL_AUX_PHASE_V1 error=intent-missing")
            case EraseIntentStoreError.intentMismatch:
                print("ORIGINAL_AUX_PHASE_V1 error=intent-mismatch")
            case EraseIntentStoreError.preparationAlreadyExists:
                print("ORIGINAL_AUX_PHASE_V1 error=preparation-already-exists")
            case EraseIntentStoreError.preparationMissing:
                print("ORIGINAL_AUX_PHASE_V1 error=preparation-missing")
            case EraseIntentStoreError.preparationMismatch:
                print("ORIGINAL_AUX_PHASE_V1 error=preparation-mismatch")
            case EraseIntentStoreError.writeFailed:
                print("ORIGINAL_AUX_PHASE_V1 error=write-failed")
            case EraseIntentStoreError.cleanupFailed:
                print("ORIGINAL_AUX_PHASE_V1 error=cleanup-failed")
            default:
                print("ORIGINAL_AUX_PHASE_V1 error=other")
            }
#endif
            originalAuxiliaryPhaseUncertain = true
            throw error
        }
    }

    /// The same original-P Store publishes its P→Q CAS inside the private
    /// recovery owner's already held G. Its first roster, preparation and
    /// complete lease cohort remain the original operation's witnesses;
    /// there is no second Store or nested Registry acquisition.
    func replaceOriginalEraseAuxiliaryPhaseForOriginalRecovery(
        expected: EraseIntentV1,
        with replacement: EraseIntentV1,
        operation: EraseRouterOperationV1,
        owner: StoreOriginalEraseRecoveryPreOpenOwnerV1,
        registry: GenerationLeaseRegistryV1,
        activity: GenerationTemporalActivityHandleV1,
        permit: OriginalEraseRecoveryFirstEffectPermitV1,
        support: StoreTemporalPhysicalRootExclusionV1,
        firstObservation: OriginalRecoveryObservation,
        io: EraseAbortCheckedSnapshotIOV1,
        retainUncertainDescriptor: (Int32) -> Void
    ) throws -> OriginalRecoveryFirstPointerCASReceiptV1 {
        guard let roster = originalAuxiliaryPublishedReceipt,
              roster.operation === operation,
              !originalRetiredStageIdentityUncertain,
              (!originalRetiredStageIdentityStarted
                || originalRetiredStageIdentityReceipt != nil),
              expected.schemaVersion == 2,
              expected.phase == .emptyGenerationPrepared,
              replacement == expected.advancing(to: .pointerSwitched),
              firstObservation.intent == expected,
              !originalAuxiliaryPhaseInFlight,
              !originalAuxiliaryPhaseUncertain,
              originalAuxiliaryProjectedIntentBytes == (try encode(expected)),
              originalAuxiliaryProjectedRoot != nil else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try owner.requireRetainedOriginalRecoveryStoreEffect(
            registry: registry, activity: activity, support: support)
        try permit.requireHeld()
        try requireOriginalEraseAuxiliaryPublishedRoster(roster)
        let before = try Self.observeOriginalRecoveryNoCreate(
            support: support, applicationSupportURL: applicationSupportURL,
            io: io, retainUncertainDescriptor: retainUncertainDescriptor)
        guard before == firstObservation else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try before.requireOriginalAuxiliaryRoster(roster, store: self,
            operation: operation, seal: roster.seal)
        originalAuxiliaryPhaseInFlight = true
        do {
            let after = try operation.withOriginalRecoveryAuxiliaryPhaseInsideHeldG(
                store: self, expected: expected,
                replacement: replacement, registry: registry,
                activity: activity, permit: permit) {
                try replaceWithoutMigrationReservation(
                    expected: expected, with: replacement)
                try permit.requireHeld()
                let observed = try Self.observeOriginalRecoveryNoCreate(
                    support: support, applicationSupportURL: applicationSupportURL,
                    io: io, retainUncertainDescriptor: retainUncertainDescriptor)
                guard observed.intent == replacement,
                      observed.sameOwnedFirstCASNonIntentNamespace(as: before),
                      observed.eraseNames == before.eraseNames else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                let names = ([Self.intentName, Self.preparationName,
                    Self.auxiliaryRosterName] +
                    (originalRetiredCommitmentReceipt == nil ? [] :
                        [Self.originalRetiredCommitmentName]) +
                    (originalRetiredStageIdentityReceipt == nil ? [] :
                        [Self.originalRetiredStageIdentityName])).sorted()
                let (root, observedNames, user, group) = try
                    originalAuxiliaryRootFactAndNames()
                guard observedNames == names,
                      let priorRoot = originalAuxiliaryProjectedRoot,
                      root.device == priorRoot.device,
                      root.inode == priorRoot.inode,
                      root.mode == priorRoot.mode,
                      root.links == priorRoot.links,
                      originalAuxiliaryRootUser == user,
                      originalAuxiliaryRootGroup == group,
                      let nextIntent = try readOriginalAuxiliaryLeaf(
                        Self.intentName,
                        maximumBytes: (try encode(replacement)).count),
                      nextIntent.0 == (try encode(replacement)),
                      nextIntent.1 != originalAuxiliaryProjectedIntentFact,
                      let rosterLeaf = try readOriginalAuxiliaryLeaf(
                        Self.auxiliaryRosterName,
                        maximumBytes: roster.canonicalBytes.count),
                      rosterLeaf.0 == roster.canonicalBytes,
                      rosterLeaf.1 == roster.recordFact,
                      let preparationLeaf = try readOriginalAuxiliaryLeaf(
                        Self.preparationName,
                        maximumBytes: roster.preparationBytes.count),
                      preparationLeaf.0 == roster.preparationBytes,
                      preparationLeaf.1 == roster.preparationFact else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                originalAuxiliaryProjectedRoot = root
                originalAuxiliaryProjectedIntentBytes = nextIntent.0
                originalAuxiliaryProjectedIntentFact = nextIntent.1
                return observed
            }
            try io.requireSettled()
            originalAuxiliaryPhaseInFlight = false
            try requireOriginalEraseAuxiliaryPublishedRoster(roster)
            return OriginalRecoveryFirstPointerCASReceiptV1(
                store: self, before: before, after: after)
        } catch {
            originalAuxiliaryPhaseUncertain = true
            throw error
        }
    }

    func requireOriginalEraseAuxiliaryPublishedRoster(
        _ receipt: OriginalAuxiliaryRosterPublicationReceiptV1
    ) throws {
#if DEBUG
        if originalAuxiliaryPhaseTracingForTesting {
            print("ORIGINAL_AUX_PHASE_V1 stage=roster-reproof-enter")
        }
#endif
        guard let projectedRoot = originalAuxiliaryProjectedRoot,
              !originalRetiredStageIdentityUncertain,
              (!originalRetiredStageIdentityStarted
                || originalRetiredStageIdentityReceipt != nil),
              let projectedIntentBytes = originalAuxiliaryProjectedIntentBytes,
              let projectedIntentFact = originalAuxiliaryProjectedIntentFact,
              !originalAuxiliaryPhaseInFlight,
              !originalAuxiliaryPhaseUncertain else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=roster-projection-state")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
        guard !borrowsColdObservation,
              originalAuxiliaryPublicationStarted,
              !originalAuxiliaryPublicationUncertain,
              originalAuxiliaryPublishedReceipt === receipt,
              receipt.store === self,
              receipt.checkedSettled,
              originalAuxiliaryActiveFD == nil,
              originalAuxiliaryUncertainFDs.isEmpty,
              originalAuxiliaryTemporaryDisposition != nil else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=roster-publication-state")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
#if DEBUG
        if originalAuxiliaryPhaseTracingForTesting {
            print("ORIGINAL_AUX_PHASE_V1 stage=roster-state-complete")
        }
#endif
        let names = ([Self.intentName, Self.preparationName,
            Self.auxiliaryRosterName] +
            (originalRetiredCommitmentReceipt == nil ? [] :
                [Self.originalRetiredCommitmentName]) +
            (originalRetiredStageIdentityReceipt == nil ? [] :
                [Self.originalRetiredStageIdentityName])).sorted()
        if originalCleanupRegistered {
            guard originalCleanupRoster === receipt, originalCleanupOperation === receipt.operation else {
                throw EraseIntentStoreError.invalidAuthority
            }
            names += coldCleanupProjectedLeaves.keys.filter(EraseSchema2ColdCleanupGrammarV1.isControlName)
            if let temporary = coldOwnTemporaryName,
               coldCleanupOwnBytes[temporary] != nil, !names.contains(temporary) {
                names.append(temporary)
            }
            names.sort()
        }
        guard try requireOriginalAuxiliaryRoot(
                names: names, exact: projectedRoot)
                == projectedRoot else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=roster-root-before")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
#if DEBUG
        if originalAuxiliaryPhaseTracingForTesting {
            print("ORIGINAL_AUX_PHASE_V1 stage=roster-root-before-complete")
        }
#endif
        guard let leaf = try readOriginalAuxiliaryLeaf(
                Self.auxiliaryRosterName,
                maximumBytes: receipt.canonicalBytes.count),
              leaf.0 == receipt.canonicalBytes,
              leaf.1 == receipt.recordFact else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=roster-leaf")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
#if DEBUG
        if originalAuxiliaryPhaseTracingForTesting {
            print("ORIGINAL_AUX_PHASE_V1 stage=roster-leaf-complete")
        }
#endif
        guard try requireOriginalAuxiliaryRoot(
                names: names, exact: projectedRoot)
                == projectedRoot else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=roster-root-after")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
#if DEBUG
        if originalAuxiliaryPhaseTracingForTesting {
            print("ORIGINAL_AUX_PHASE_V1 stage=roster-root-after-complete")
        }
#endif
        try requireOriginalAuxiliaryControlLeaves(
            intent: (projectedIntentBytes, projectedIntentFact),
            preparation: (receipt.preparationBytes,
                receipt.preparationFact))
#if DEBUG
        if originalAuxiliaryPhaseTracingForTesting {
            print("ORIGINAL_AUX_PHASE_V1 stage=roster-controls-complete")
        }
#endif
        let policy = try ProtectedFilePolicyV1
            .observeTemporalPolicyWithCheckedClose(
                .journal,
                at: applicationSupportURL
                    .appendingPathComponent(Self.directoryName,
                        isDirectory: true)
                    .appendingPathComponent(Self.auxiliaryRosterName),
                retainUncertainDescriptor: { uncertain in
                    self.originalAuxiliaryUncertainFDs.append(uncertain)
                })
        guard policy.device == UInt64(receipt.recordFact.device),
              policy.inode == UInt64(receipt.recordFact.inode),
              policy.linkCount == UInt64(receipt.recordFact.links),
              policy.backupExcluded == true,
              (policy.state == .strictComplete ||
                (policy.state == .pendingSimulatorRequest &&
                 originalAuxiliaryTemporaryDisposition
                    == .simulatorFileProtectionUnsupported)) else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=roster-policy")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
#if DEBUG
        if originalAuxiliaryPhaseTracingForTesting {
            print("ORIGINAL_AUX_PHASE_V1 stage=roster-policy-complete")
        }
#endif
        guard try requireOriginalAuxiliaryRoot(
                names: names, exact: projectedRoot)
                == projectedRoot else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=roster-final-root")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
#if DEBUG
        if originalAuxiliaryPhaseTracingForTesting {
            print("ORIGINAL_AUX_PHASE_V1 stage=roster-reproof-complete")
        }
#endif
    }

    /// This accepts only the original, retained prepared-P owner. It is a
    /// prospective record before any target pointer or auxiliary mutation;
    /// an observed R survivor cut never enters this writer.
    func publishOriginalEraseAuxiliaryRoster(
        seal: EraseSchema2OriginalAuxiliaryRosterPublicationSealV1,
        intent: EraseIntentV1,
        preparation: ErasePreparationV2,
        operation: EraseRouterOperationV1,
        coordinator: StoreSessionCoordinator
    ) throws -> OriginalAuxiliaryRosterPublicationReceiptV1 {
        guard !borrowsColdObservation,
              !originalAuxiliaryPublicationStarted,
              originalAuxiliaryPublishedReceipt == nil,
              originalAuxiliaryActiveFD == nil,
              originalAuxiliaryUncertainFDs.isEmpty,
              !originalAuxiliaryPublicationUncertain,
              intent.schemaVersion == 2,
              intent.phase == .emptyGenerationPrepared,
              preparation.matches(intent),
              !seal.canonicalBytes.isEmpty,
              seal.canonicalSHA256 ==
                StoreMigrationCanonicalJSONV1.sha256(seal.canonicalBytes),
              seal.canonicalBytes.count <= Self.maximumJournalBytes else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try operation.requireOriginalAuxiliaryRosterSourceFactsBeforeRename(
            seal: seal, store: self)
        let initialNames = [Self.intentName,
            Self.preparationName].sorted()
        let temporaryNames = [Self.intentName,
            Self.preparationName,
            Self.auxiliaryRosterNextName].sorted()
        let publishedNames = [Self.intentName,
            Self.preparationName,
            Self.auxiliaryRosterName].sorted()
        let beforeRoot = try requireOriginalAuxiliaryRoot(
            names: initialNames, exact: nil)
        guard let firstIntent = try readOriginalAuxiliaryLeaf(
                Self.intentName, maximumBytes: Self.maximumJournalBytes),
              let firstPreparation = try readOriginalAuxiliaryLeaf(
                Self.preparationName,
                maximumBytes: Self.maximumJournalBytes),
              firstIntent.0 == (try encode(intent)),
              firstPreparation.0 == (try encodePreparation(preparation)),
              try requireOriginalAuxiliaryRoot(
                names: initialNames, exact: beforeRoot) == beforeRoot else {
            throw EraseIntentStoreError.invalidAuthority
        }
        originalAuxiliaryPublicationStarted = true
        let eraseURL = applicationSupportURL
            .appendingPathComponent(Self.directoryName, isDirectory: true)
        // A checked complete request may authenticate an exact pinned DEBUG
        // Simulator policy disposition. Raw pending is never publication
        // authority, and every request is bracketed by the first full cut.
        for (name, kind, bytes, fact) in [
            (Self.intentName, OwnedFileKindV1.journal,
                firstIntent.0, firstIntent.1),
            (Self.preparationName, OwnedFileKindV1.journal,
                firstPreparation.0, firstPreparation.1),
        ] {
            _ = try ProtectedFilePolicyV1
                .verifyEraseColdTemporalPolicyWithCheckedRequest(
                    kind, at: eraseURL.appendingPathComponent(name),
                    retainUncertainDescriptor: { descriptor in
                        self.originalAuxiliaryUncertainFDs.append(descriptor)
                    }, unchangedWitness: {
                        guard try self.requireOriginalAuxiliaryRoot(
                                names: initialNames,
                                exact: beforeRoot) == beforeRoot,
                              let leaf = try self.readOriginalAuxiliaryLeaf(
                                name, maximumBytes: bytes.count),
                              leaf.0 == bytes,
                              leaf.1 == fact else {
                            throw EraseIntentStoreError.invalidAuthority
                        }
                        return fact
                    })
        }
        _ = try ProtectedFilePolicyV1
            .verifyEraseColdTemporalPolicyWithCheckedRequest(
                .stagingDirectory, at: eraseURL,
                retainUncertainDescriptor: { descriptor in
                    self.originalAuxiliaryUncertainFDs.append(descriptor)
                }, unchangedWitness: {
                    try self.requireOriginalAuxiliaryRoot(
                        names: initialNames, exact: beforeRoot)
                })
        try operation.requireOriginalAuxiliaryRosterSourceFactsBeforeRename(
            seal: seal, store: self)
        guard try requireOriginalAuxiliaryRoot(
                names: initialNames, exact: beforeRoot) == beforeRoot else {
            throw EraseIntentStoreError.invalidAuthority
        }

        // From here even an O_EXCL failure leaves this one publication
        // attempt terminal. Retain every ambiguous close rather than retrying
        // a numeric descriptor or reading a replacement as our own temp.
        do {
            let descriptor = Darwin.openat(eraseDescriptor,
                Self.auxiliaryRosterNextName,
                O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
                mode_t(0o600))
            guard descriptor >= 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            originalAuxiliaryActiveFD = descriptor
            let identity = try Self.fileIdentity(descriptor)
            let afterOpenRoot = try
                projectOriginalAuxiliaryRootAfterOwnedNameEffect(
                    prior: beforeRoot,
                    names: temporaryNames, allowActive: true)
            try requireOriginalAuxiliaryActiveTemporary(
                descriptor: descriptor, identity: identity,
                names: temporaryNames)
            originalAuxiliaryTemporaryDisposition = try ProtectedFilePolicyV1
                .applyAndVerifyEraseColdPrivateWithCheckedClose(
                    .journalTemporary,
                    at: eraseURL.appendingPathComponent(
                        Self.auxiliaryRosterNextName),
                    retainUncertainDescriptor: { uncertain in
                        self.originalAuxiliaryUncertainFDs.append(uncertain)
                    }, authorityCheck: {
                        try self.requireOriginalAuxiliaryActiveTemporary(
                            descriptor: descriptor, identity: identity,
                            names: temporaryNames)
                    }, beforeFirstEffect: {
                        try self.requireOriginalAuxiliaryActiveTemporary(
                            descriptor: descriptor, identity: identity,
                            names: temporaryNames)
                    })
            guard try requireOriginalAuxiliaryRoot(
                names: temporaryNames, exact: afterOpenRoot,
                allowActive: true) == afterOpenRoot else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try seal.canonicalBytes.withUnsafeBytes { raw in
                guard let base = raw.baseAddress else {
                    throw EraseIntentStoreError.writeFailed
                }
                var offset = 0
                while offset < raw.count {
                    let count = Darwin.write(descriptor,
                        base.advanced(by: offset), raw.count - offset)
                    if count > 0 { offset += count }
                    else if errno != EINTR {
                        throw EraseIntentStoreError.writeFailed
                    }
                }
            }
            guard Darwin.fsync(descriptor) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            try closeOriginalAuxiliaryActiveChecked()
            let afterTemporaryRoot = try requireOriginalAuxiliaryRoot(
                names: temporaryNames, exact: afterOpenRoot)
            guard let temporary = try readOriginalAuxiliaryLeaf(
                    Self.auxiliaryRosterNextName,
                    maximumBytes: seal.canonicalBytes.count),
                  temporary.0 == seal.canonicalBytes,
                  temporary.1.device == identity.device,
                  temporary.1.inode == identity.inode,
                  temporary.1.mode & S_IFMT == S_IFREG,
                  temporary.1.links == 1,
                  try requireOriginalAuxiliaryRoot(
                    names: temporaryNames,
                    exact: afterTemporaryRoot) == afterTemporaryRoot else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try operation.requireOriginalAuxiliaryRosterSourceFactsBeforeRename(
                seal: seal, store: self)
            try requireOriginalAuxiliaryControlLeaves(
                intent: firstIntent, preparation: firstPreparation)
            guard try requireOriginalAuxiliaryRoot(
                    names: temporaryNames,
                    exact: afterTemporaryRoot) == afterTemporaryRoot,
                  Darwin.renameatx_np(eraseDescriptor,
                    Self.auxiliaryRosterNextName,
                    eraseDescriptor, Self.auxiliaryRosterName,
                    UInt32(RENAME_EXCL)) == 0,
                  Darwin.fsync(eraseDescriptor) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            let afterPublishedRoot = try
                projectOriginalAuxiliaryRootAfterOwnedNameEffect(
                    prior: afterTemporaryRoot,
                    names: publishedNames, allowActive: false)
            guard let published = try readOriginalAuxiliaryLeaf(
                    Self.auxiliaryRosterName,
                    maximumBytes: seal.canonicalBytes.count),
                  published.0 == seal.canonicalBytes,
                  published.1.device == temporary.1.device,
                  published.1.inode == temporary.1.inode,
                  published.1.mode == temporary.1.mode,
                  published.1.links == temporary.1.links,
                  published.1.size == temporary.1.size,
                  try requireOriginalAuxiliaryRoot(
                    names: publishedNames,
                    exact: afterPublishedRoot) == afterPublishedRoot else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let publishedPolicy = try ProtectedFilePolicyV1
                .observeTemporalPolicyWithCheckedClose(
                    .journal,
                    at: eraseURL.appendingPathComponent(
                        Self.auxiliaryRosterName),
                    retainUncertainDescriptor: { uncertain in
                        self.originalAuxiliaryUncertainFDs.append(uncertain)
                    })
            guard publishedPolicy.device == UInt64(published.1.device),
                  publishedPolicy.inode == UInt64(published.1.inode),
                  publishedPolicy.linkCount == UInt64(published.1.links),
                  publishedPolicy.backupExcluded == true,
                  (publishedPolicy.state == .strictComplete ||
                    (publishedPolicy.state == .pendingSimulatorRequest &&
                     originalAuxiliaryTemporaryDisposition
                        == .simulatorFileProtectionUnsupported)),
                  try requireOriginalAuxiliaryRoot(
                    names: publishedNames,
                    exact: afterPublishedRoot) == afterPublishedRoot else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try operation.requireOriginalAuxiliaryRosterSourceFactsBeforeRename(
                seal: seal, store: self)
            try requireOriginalAuxiliaryControlLeaves(
                intent: firstIntent, preparation: firstPreparation)
            guard try requireOriginalAuxiliaryRoot(
                    names: publishedNames,
                    exact: afterPublishedRoot) == afterPublishedRoot else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let receipt = OriginalAuxiliaryRosterPublicationReceiptV1(
                store: self, operation: operation, seal: seal,
                beforeRoot: beforeRoot,
                afterRoot: afterPublishedRoot,
                recordFact: published.1,
                intent: firstIntent,
                preparation: firstPreparation)
            originalAuxiliaryProjectedIntentBytes = firstIntent.0
            originalAuxiliaryProjectedIntentFact = firstIntent.1
            originalAuxiliaryPublishedReceipt = receipt
            return receipt
        } catch {
            let failure = error
            if originalAuxiliaryActiveFD != nil {
                do { try closeOriginalAuxiliaryActiveChecked() }
                catch {
                    originalAuxiliaryPublicationUncertain = true
                    throw error
                }
            }
            originalAuxiliaryPublicationUncertain = true
            throw failure
        }
    }
}

// The ordinary Store initializer may create FieldEvidenceErase and its load()
// may promote or unlink a pending leaf. Original recovery needs the opposite
// contract before its first source validation: a complete, no-create witness
// under the already retained Support-root EX.
extension EraseIntentStore {
    struct OriginalRecoveryObservation: Equatable {
        fileprivate struct Ownership: Equatable {
            let user: uid_t
            let group: gid_t

            init(_ value: stat) {
                user = value.st_uid
                group = value.st_gid
            }
        }
        fileprivate struct Leaf: Equatable {
            let name: String
            let fact: RetirementLeafFact
            let ownership: Ownership
            let data: Data
            let policy: TemporalPolicyObservationV1
        }
        let supportDevice: Int64
        let supportInode: UInt64
        fileprivate let supportFact: RetirementLeafFact
        fileprivate let supportOwnership: Ownership
        fileprivate let supportNames: [String]
        fileprivate let eraseFact: RetirementLeafFact?
        fileprivate let eraseOwnership: Ownership?
        fileprivate let erasePolicy: TemporalPolicyObservationV1?
        fileprivate let eraseNames: [String]
        fileprivate let leaves: [Leaf]
        let intent: EraseIntentV1?
        let preparation: ErasePreparationV2?

        /// Bind the additional physical leaf to the already published
        /// original-operation P roster. Its presence alone is data, never
        /// authority to reconstruct a roster from current survivors.
        @MainActor
        func requireOriginalAuxiliaryRoster(
            _ receipt: OriginalAuxiliaryRosterPublicationReceiptV1,
            store: EraseIntentStore,
            operation: EraseRouterOperationV1,
            seal: EraseSchema2OriginalAuxiliaryRosterPublicationSealV1
        ) throws {
            try receipt.requireBound(store: store, operation: operation,
                seal: seal)
            guard let leaf = leaves.first(where: {
                    $0.name == EraseIntentStore.auxiliaryRosterName
                }),
                (eraseNames == [EraseIntentStore.intentName,
                    EraseIntentStore.preparationName,
                    EraseIntentStore.auxiliaryRosterName].sorted() ||
                 eraseNames == [EraseIntentStore.intentName,
                    EraseIntentStore.preparationName,
                    EraseIntentStore.auxiliaryRosterName,
                    EraseIntentStore.originalRetiredCommitmentName].sorted() ||
                 eraseNames == [EraseIntentStore.intentName,
                    EraseIntentStore.preparationName,
                    EraseIntentStore.auxiliaryRosterName,
                    EraseIntentStore.originalRetiredCommitmentName,
                    EraseIntentStore.originalRetiredStageIdentityName].sorted()),
                leaf.data == receipt.canonicalBytes,
                leaf.fact.device == receipt.recordFact.device,
                leaf.fact.inode == receipt.recordFact.inode,
                leaf.fact.mode == receipt.recordFact.mode,
                leaf.fact.links == receipt.recordFact.links,
                leaf.fact.size == receipt.recordFact.size,
                leaf.fact.modifiedSeconds ==
                    receipt.recordFact.modifiedSeconds,
                leaf.fact.modifiedNanoseconds ==
                    receipt.recordFact.modifiedNanoseconds,
                leaf.fact.changedSeconds ==
                    receipt.recordFact.changedSeconds,
                leaf.fact.changedNanoseconds ==
                    receipt.recordFact.changedNanoseconds,
                leaf.ownership.user == Darwin.getuid(),
                leaf.ownership.group == Darwin.getgid() else {
                throw EraseIntentStoreError.invalidAuthority
            }
        }

        /// Data-only cold replay projection. A matching durable record does
        /// not adopt a Data temp or mint a new original operation capability.
        func observedOriginalRetiredCommitment()
            throws -> OriginalRecoveryRetiredCommitmentRecordV1? {
            guard let leaf = leaves.first(where: {
                $0.name == EraseIntentStore.originalRetiredCommitmentName
            }) else { return nil }
            let record = try OriginalRecoveryRetiredCommitmentRecordV1
                .decodeCanonical(leaf.data)
            typealias Fact = OriginalRecoveryRetiredCommitmentRecordV1.Fact
            func fact(_ leaf: Leaf) -> Fact {
                Fact(device: leaf.fact.device, inode: leaf.fact.inode,
                    mode: leaf.fact.mode, links: leaf.fact.links,
                    user: leaf.ownership.user, group: leaf.ownership.group,
                    size: leaf.fact.size,
                    modifiedSeconds: leaf.fact.modifiedSeconds,
                    modifiedNanoseconds: leaf.fact.modifiedNanoseconds,
                    changedSeconds: leaf.fact.changedSeconds,
                    changedNanoseconds: leaf.fact.changedNanoseconds)
            }
            guard let intent,
                  intent.schemaVersion == 2,
                  intent.phase == .emptyGenerationPrepared,
                  record.eraseID == intent.eraseID.uuidString.lowercased(),
                  record.sourceGenerationID
                    == intent.oldGenerationID.uuidString.lowercased(),
                  record.targetGenerationID
                    == intent.newGenerationID.uuidString.lowercased(),
                  record.support.device == supportDevice,
                  record.support.inode == supportInode,
                  record.support == Fact(device: supportFact.device,
                    inode: supportFact.inode, mode: supportFact.mode,
                    links: supportFact.links,
                    user: supportOwnership.user,
                    group: supportOwnership.group,
                    size: supportFact.size,
                    modifiedSeconds: supportFact.modifiedSeconds,
                    modifiedNanoseconds: supportFact.modifiedNanoseconds,
                    changedSeconds: supportFact.changedSeconds,
                    changedNanoseconds: supportFact.changedNanoseconds),
                  record.supportNames == supportNames,
                  ((record.firstEraseNames +
                    [EraseIntentStore.originalRetiredCommitmentName]).sorted()
                    == eraseNames ||
                   (record.firstEraseNames +
                    [EraseIntentStore.originalRetiredCommitmentName,
                     EraseIntentStore.originalRetiredStageIdentityName])
                    .sorted() == eraseNames),
                  let eraseFact,
                  record.erase.device == Int64(eraseFact.device),
                  record.erase.inode == UInt64(eraseFact.inode),
                  record.erase.mode == UInt32(eraseFact.mode),
                  let p = leaves.first(where: {
                    $0.name == EraseIntentStore.intentName }),
                  let preparation = leaves.first(where: {
                    $0.name == EraseIntentStore.preparationName }),
                  let roster = leaves.first(where: {
                    $0.name == EraseIntentStore.auxiliaryRosterName }),
                  p.data == record.intentBytes,
                  fact(p) == record.intentFact,
                  preparation.data == record.preparationBytes,
                  fact(preparation) == record.preparationFact,
                  roster.data == record.auxiliaryRosterBytes,
                  fact(roster) == record.auxiliaryRosterFact,
                  fact(leaf).device == Int64(eraseFact.device),
                  fact(leaf).size == Int64(leaf.data.count) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return record
        }

        /// Data-only cross-binding of the two durable Erase controls. A fresh
        /// owner must still prove the recorded Data inode under its own EX/G.
        func observedOriginalRetiredStageIdentity()
            throws -> OriginalRecoveryRetiredStageIdentityRecordV1? {
            guard let stageLeaf = leaves.first(where: {
                $0.name == EraseIntentStore.originalRetiredStageIdentityName
