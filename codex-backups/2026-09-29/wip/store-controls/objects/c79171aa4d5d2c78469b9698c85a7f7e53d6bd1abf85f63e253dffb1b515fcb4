// The original P publisher has its own checked transient ownership. The
// ordinary journal APIs deliberately remain unchanged for their callers.
private extension EraseIntentStore {
    func closeOriginalAuxiliaryActiveChecked() throws {
        guard let descriptor = originalAuxiliaryActiveFD else {
            throw EraseIntentStoreError.invalidAuthority
        }
        originalAuxiliaryActiveFD = nil
        if Darwin.close(descriptor) != 0 {
            originalAuxiliaryUncertainFDs.append(descriptor)
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    func originalAuxiliaryRootFactAndNames(allowActive: Bool = false)
        throws -> (EraseColdControlLeafFactV1, [String], uid_t, gid_t) {
        guard !coldCleanupCompletionControlsRemoved, !coldCloseAttempted,
              !coldClosed, !originalRecoveryCloseAttempted,
              !borrowsColdObservation,
              (allowActive || originalAuxiliaryActiveFD == nil),
              originalAuxiliaryEnumerationFD == nil,
              originalAuxiliaryDirectoryStream == nil,
              originalAuxiliaryUncertainFDs.isEmpty,
              !originalAuxiliaryUncertainStreamClose else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try Self.requireDirectory(applicationSupportDescriptor,
            identity: applicationSupportIdentity)
        try Self.requireDirectory(eraseDescriptor, identity: eraseIdentity)
        var support = stat(), heldBefore = stat(), namedBefore = stat()
        guard Darwin.lstat(applicationSupportURL.path, &support) == 0,
              support.st_mode & S_IFMT == S_IFDIR,
              support.st_dev == applicationSupportIdentity.device,
              support.st_ino == applicationSupportIdentity.inode,
              Darwin.fstat(eraseDescriptor, &heldBefore) == 0,
              Darwin.fstatat(applicationSupportDescriptor,
                Self.directoryName, &namedBefore,
                AT_SYMLINK_NOFOLLOW) == 0,
              heldBefore.st_mode & S_IFMT == S_IFDIR,
              EraseColdControlLeafFactV1(heldBefore)
                == EraseColdControlLeafFactV1(namedBefore) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let duplicate = Darwin.openat(eraseDescriptor, ".",
            O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
        guard duplicate >= 0 else { throw EraseIntentStoreError.invalidAuthority }
        originalAuxiliaryEnumerationFD = duplicate
        guard let stream = Darwin.fdopendir(duplicate) else {
            originalAuxiliaryEnumerationFD = nil
            if Darwin.close(duplicate) != 0 {
                originalAuxiliaryUncertainFDs.append(duplicate)
            }
            throw EraseIntentStoreError.invalidAuthority
        }
        originalAuxiliaryEnumerationFD = nil
        originalAuxiliaryDirectoryStream = stream
        var names: [String] = []
        errno = 0
        while let entry = Darwin.readdir(stream) {
            guard let name = OwnedStorageDirectoryEntryNameV1.decode(entry) else {
                originalAuxiliaryDirectoryStream = nil
                if Darwin.closedir(stream) != 0 {
                    originalAuxiliaryUncertainStreamClose = true
                }
                throw EraseIntentStoreError.invalidAuthority
            }
            if name != "." && name != ".." { names.append(name) }
            errno = 0
        }
        let readError = errno
        originalAuxiliaryDirectoryStream = nil
        guard Darwin.closedir(stream) == 0 else {
            originalAuxiliaryUncertainStreamClose = true
            throw EraseIntentStoreError.invalidAuthority
        }
        guard readError == 0 else { throw EraseIntentStoreError.invalidAuthority }
        var heldAfter = stat(), namedAfter = stat()
        guard Darwin.fstat(eraseDescriptor, &heldAfter) == 0,
              Darwin.fstatat(applicationSupportDescriptor,
                Self.directoryName, &namedAfter,
                AT_SYMLINK_NOFOLLOW) == 0,
              EraseColdControlLeafFactV1(heldBefore)
                == EraseColdControlLeafFactV1(heldAfter),
              EraseColdControlLeafFactV1(heldAfter)
                == EraseColdControlLeafFactV1(namedAfter) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return (EraseColdControlLeafFactV1(heldAfter), names.sorted(),
            heldAfter.st_uid, heldAfter.st_gid)
    }

    func requireOriginalAuxiliaryRoot(
        names expectedNames: [String],
        exact expectedFact: EraseColdControlLeafFactV1?,
        allowActive: Bool = false
    ) throws -> EraseColdControlLeafFactV1 {
        let (fact, names, user, group) = try originalAuxiliaryRootFactAndNames(
            allowActive: allowActive)
        guard names == expectedNames.sorted() else {
            throw EraseIntentStoreError.invalidAuthority
        }
        if let expectedFact, fact != expectedFact {
            throw EraseIntentStoreError.invalidAuthority
        }
        if let projected = originalAuxiliaryProjectedRoot {
            guard fact == projected,
                  originalAuxiliaryRootUser == user,
                  originalAuxiliaryRootGroup == group else {
                throw EraseIntentStoreError.invalidAuthority
            }
        } else {
            guard expectedFact == nil,
                  names == [Self.intentName,
                    Self.preparationName].sorted() else {
                throw EraseIntentStoreError.invalidAuthority
            }
            originalAuxiliaryProjectedRoot = fact
            originalAuxiliaryRootUser = user
            originalAuxiliaryRootGroup = group
        }
        let supportedAllEntries = UInt64(fact.links)
            == UInt64(2 + names.count)
        let supportedSubdirectories = UInt64(fact.links) == 2
        if let law = originalAuxiliaryRootLinkLaw {
            guard (law == 1 && supportedAllEntries) ||
                  (law == 0 && supportedSubdirectories) else {
                throw EraseIntentStoreError.invalidAuthority
            }
        } else {
            // If the first two-entry cut distinguishes the filesystem laws,
            // retain the actual one. Neither rule permits an arbitrary link
            // count change after our owned O_EXCL/rename transition.
            guard supportedAllEntries || supportedSubdirectories else {
                throw EraseIntentStoreError.invalidAuthority
            }
            originalAuxiliaryRootLinkLaw = supportedAllEntries ? 1 : 0
        }
        return fact
    }

    /// The only full-Fact projection points follow this operation's exact
    /// O_EXCL or no-replace rename. A caller may not call the normal census
    /// with an absent expected Fact to adopt arbitrary directory metadata.
    func projectOriginalAuxiliaryRootAfterOwnedNameEffect(
        prior: EraseColdControlLeafFactV1,
        names expectedNames: [String],
        allowActive: Bool
    ) throws -> EraseColdControlLeafFactV1 {
        guard originalAuxiliaryProjectedRoot == prior,
              originalAuxiliaryPublicationStarted,
              expectedNames.sorted() == [Self.intentName,
                Self.preparationName,
                allowActive ? Self.auxiliaryRosterNextName
                    : Self.auxiliaryRosterName].sorted() else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let (next, names, user, group) = try
            originalAuxiliaryRootFactAndNames(allowActive: allowActive)
        guard names == expectedNames.sorted(),
              next.device == prior.device,
              next.inode == prior.inode,
              next.mode == prior.mode,
              originalAuxiliaryRootUser == user,
              originalAuxiliaryRootGroup == group,
              (originalAuxiliaryRootLinkLaw == 0 && next.links == 2 ||
                originalAuxiliaryRootLinkLaw == 1 &&
                    UInt64(next.links) == UInt64(2 + names.count)) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        originalAuxiliaryProjectedRoot = next
        return next
    }

    func readOriginalAuxiliaryLeaf(
        _ name: String, maximumBytes: Int
    ) throws -> (Data, EraseColdControlLeafFactV1)? {
        guard originalAuxiliaryActiveFD == nil,
              originalAuxiliaryUncertainFDs.isEmpty else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let descriptor = Darwin.openat(eraseDescriptor, name,
            O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)
        if descriptor < 0, errno == ENOENT { return nil }
        guard descriptor >= 0 else { throw EraseIntentStoreError.invalidAuthority }
        originalAuxiliaryActiveFD = descriptor
        do {
            var before = stat(), named = stat()
            guard Darwin.fstat(descriptor, &before) == 0,
                  Darwin.fstatat(eraseDescriptor, name, &named,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  before.st_mode & S_IFMT == S_IFREG,
                  before.st_nlink == 1,
                  EraseColdControlLeafFactV1(before)
                    == EraseColdControlLeafFactV1(named),
                  before.st_size >= 0,
                  before.st_size <= off_t(maximumBytes) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            var bytes = Data()
            var buffer = [UInt8](repeating: 0, count: 16 * 1024)
            while true {
                let count = buffer.withUnsafeMutableBytes {
                    Darwin.read(descriptor, $0.baseAddress, $0.count)
                }
                if count > 0 {
                    bytes.append(contentsOf: buffer.prefix(count))
                    guard bytes.count <= maximumBytes else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                } else if count == 0 { break }
                else if errno != EINTR {
                    throw EraseIntentStoreError.invalidAuthority
                }
            }
            var after = stat(), namedAfter = stat()
            guard Darwin.fstat(descriptor, &after) == 0,
                  Darwin.fstatat(eraseDescriptor, name,
                    &namedAfter, AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(before)
                    == EraseColdControlLeafFactV1(after),
                  EraseColdControlLeafFactV1(after)
                    == EraseColdControlLeafFactV1(namedAfter),
                  bytes.count == Int(after.st_size) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let fact = EraseColdControlLeafFactV1(after)
            try closeOriginalAuxiliaryActiveChecked()
            return (bytes, fact)
        } catch {
            let failure = error
            if originalAuxiliaryActiveFD != nil {
                try closeOriginalAuxiliaryActiveChecked()
            }
            throw failure
        }
    }

    private func requireOriginalAuxiliaryActiveTemporary(
        descriptor: Int32, identity: Identity,
        names: [String]
    ) throws {
        guard originalAuxiliaryActiveFD == descriptor,
              originalAuxiliaryUncertainFDs.isEmpty,
              let projected = originalAuxiliaryProjectedRoot else {
            throw EraseIntentStoreError.invalidAuthority
        }
        _ = try requireOriginalAuxiliaryRoot(names: names,
            exact: projected, allowActive: true)
        var held = stat(), named = stat()
        guard Darwin.fstat(descriptor, &held) == 0,
              Darwin.fstatat(eraseDescriptor,
                Self.auxiliaryRosterNextName, &named,
                AT_SYMLINK_NOFOLLOW) == 0,
              held.st_dev == identity.device,
              held.st_ino == identity.inode,
              named.st_dev == identity.device,
              named.st_ino == identity.inode,
              held.st_mode == named.st_mode,
              held.st_mode & S_IFMT == S_IFREG,
              held.st_mode & 0o777 == 0o600,
              held.st_nlink == 1, named.st_nlink == 1,
              held.st_size == 0, named.st_size == 0 else {
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    func requireOriginalAuxiliaryControlLeaves(
        intent: (Data, EraseColdControlLeafFactV1),
        preparation: (Data, EraseColdControlLeafFactV1)
    ) throws {
        guard let currentIntent = try readOriginalAuxiliaryLeaf(
                Self.intentName, maximumBytes: intent.0.count),
              let currentPreparation = try readOriginalAuxiliaryLeaf(
                Self.preparationName,
                maximumBytes: preparation.0.count) else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=control-leaf-presence")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
        guard currentIntent.0 == intent.0,
              currentIntent.1 == intent.1 else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=intent-control")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
        guard currentPreparation.0 == preparation.0,
              currentPreparation.1 == preparation.1 else {
#if DEBUG
            if originalAuxiliaryPhaseTracingForTesting {
                print("ORIGINAL_AUX_PHASE_V1 refusal=preparation-control")
            }
#endif
            throw EraseIntentStoreError.invalidAuthority
        }
    }
}

