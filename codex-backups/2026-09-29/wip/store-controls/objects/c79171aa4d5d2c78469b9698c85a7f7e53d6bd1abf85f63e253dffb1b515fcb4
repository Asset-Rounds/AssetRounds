        /// Policy requests may change only the protection observation. The
        /// first held objects, complete physical facts, names and bytes stay
        /// fixed until the authenticated first-effect permit is consumed.
        fileprivate func samePhysicalNamespace(
            as prior: OriginalRecoveryObservation
