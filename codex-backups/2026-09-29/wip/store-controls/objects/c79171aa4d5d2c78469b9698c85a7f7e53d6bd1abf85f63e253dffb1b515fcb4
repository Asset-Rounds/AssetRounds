                  let commitmentLeaf = leaves.first(where: {
                    $0.name == EraseIntentStore.originalRetiredCommitmentName
                  }) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let record = try OriginalRecoveryRetiredStageIdentityRecordV1
                .decodeCanonical(stageLeaf.data)
            let fact = commitmentLeaf.fact
            let ownership = commitmentLeaf.ownership
            guard record.eraseID == first.eraseID,
                  record.commitmentSHA256 ==
                    StoreMigrationCanonicalJSONV1.sha256(
                        commitmentLeaf.data),
                  record.commitmentFact ==
                    OriginalRecoveryRetiredCommitmentRecordV1.Fact(
                        device: fact.device, inode: fact.inode,
                        mode: fact.mode, links: fact.links,
                        user: ownership.user, group: ownership.group,
                        size: fact.size,
                        modifiedSeconds: fact.modifiedSeconds,
                        modifiedNanoseconds: fact.modifiedNanoseconds,
                        changedSeconds: fact.changedSeconds,
                        changedNanoseconds: fact.changedNanoseconds),
                  record.replacementSHA256 == first.replacementSHA256,
                  record.firstDataFact == first.namespace.data,
                  record.firstDataChildren == [
