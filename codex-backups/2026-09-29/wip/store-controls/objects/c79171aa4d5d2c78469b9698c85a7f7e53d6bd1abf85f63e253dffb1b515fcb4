                (coldCleanupPermit != nil && [Self.intentName, Self.nextName, Self.preparationName,
                 Self.originalRetiredStageIdentityName, Self.originalRetiredCommitmentName,
                 Self.rosterName, Self.auxiliaryRosterName].contains(name))),
              coldActiveFD == nil, coldUncertainFDs.isEmpty,
              !coldCloseAttempted, !coldClosed, !coldEffectUncertain,
              maximumBytes > 0 else { throw EraseIntentStoreError.invalidAuthority }
