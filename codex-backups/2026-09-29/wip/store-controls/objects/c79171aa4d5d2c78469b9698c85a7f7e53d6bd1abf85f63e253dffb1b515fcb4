    private func openOpaqueIntentNext(at erase: Int32,
        root: URL) throws -> Data? {
        let name = ".erase.json.next"
        let fd = Darwin.openat(erase, name,
            O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
        if fd < 0 {
            guard errno == ENOENT else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return nil
