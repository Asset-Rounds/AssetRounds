                    guard count <= maximumBytes - bytes.count else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                    bytes.append(contentsOf: buffer.prefix(count))
                } else if count == 0 { break }
                else if errno != EINTR { throw EraseIntentStoreError.invalidAuthority }
            }
            guard bytes.count == Int(first.size),
                  Darwin.fstat(descriptor, &held) == 0,
                  Darwin.fstatat(eraseDescriptor, name, &named,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(held) == first,
                  EraseColdControlLeafFactV1(named) == first,
                  try ProtectedFilePolicyV1.observeTemporalPolicyWithCheckedClose(kind,
                    at: url, retainUncertainDescriptor: {
                        self.coldUncertainFDs.append($0)
                    }) == policy else { throw EraseIntentStoreError.invalidAuthority }
            try closeColdActiveChecked()
            return .init(bytes: bytes, fact: first, policy: policy,
                contentSHA256: EraseSchema2ColdCleanupGrammarV1.isSourceName(name)
