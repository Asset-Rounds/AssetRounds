    private func requireLeaf(_ name: String, at erase: Int32,
        root: URL, descriptor: Int32?, expected: Data?) throws {
        var named = stat()
        let found = Darwin.fstatat(erase, name, &named,
            AT_SYMLINK_NOFOLLOW)
        if expected == nil {
            guard descriptor == nil, found != 0,
                  errno == ENOENT else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return
        }
        guard found == 0, let descriptor, let expected,
              same(try regular(descriptor), named) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let capturedFact = name == "erase.json"
            ? capturedIntentFact : capturedPreparationFact
        var heldFact = stat()
        guard let capturedFact,
              Darwin.fstat(descriptor, &heldFact) == 0,
              EraseColdControlLeafFactV1(heldFact) == capturedFact,
              EraseColdControlLeafFactV1(named) == capturedFact else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let policy = try observeColdPolicy(.journal,
            at: root.appendingPathComponent(name))
        guard policy.state == .strictComplete,
              policy.device == UInt64(named.st_dev),
              policy.inode == UInt64(named.st_ino),
              try exactBytes(descriptor, parent: erase, name: name)
                == expected else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var heldAfterRead = stat(), namedAfterRead = stat()
        let policyAfterRead = try observeColdPolicy(.journal,
            at: root.appendingPathComponent(name))
        guard Darwin.fstat(descriptor, &heldAfterRead) == 0,
              Darwin.fstatat(erase, name, &namedAfterRead,
                  AT_SYMLINK_NOFOLLOW) == 0,
              EraseColdControlLeafFactV1(heldAfterRead) == capturedFact,
              EraseColdControlLeafFactV1(namedAfterRead) == capturedFact,
              policyAfterRead.state == .strictComplete,
              policyAfterRead.device == UInt64(namedAfterRead.st_dev),
              policyAfterRead.inode == UInt64(namedAfterRead.st_ino) else {
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    private func exactBytes(_ fd: Int32, parent: Int32,
        name: String) throws -> Data {
        let before = try regular(fd)
        guard before.st_size > 0, before.st_size <= 96 * 1024 * 1024,
              Darwin.lseek(fd, 0, SEEK_SET) == 0 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var bytes = Data(count: Int(before.st_size))
        try bytes.withUnsafeMutableBytes { raw in
            var offset = 0
            while offset < raw.count {
                let count = Darwin.read(fd,
                    raw.baseAddress!.advanced(by: offset),
                    raw.count - offset)
                if count < 0 && errno == EINTR { continue }
                guard count > 0 else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                offset += count
            }
        }
        let after = try regular(fd)
        var named = stat()
        guard same(before, after),
              after.st_size == before.st_size,
              Darwin.fstatat(parent, name, &named,
                AT_SYMLINK_NOFOLLOW) == 0,
              same(before, named),
              named.st_size == before.st_size else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return bytes
    }

    private func directory(_ fd: Int32) throws -> stat {
        var value = stat()
        guard Darwin.fstat(fd, &value) == 0,
              value.st_mode & S_IFMT == S_IFDIR,
              value.st_nlink >= 1 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return value
    }
    private func regular(_ fd: Int32) throws -> stat {
        var value = stat()
        guard Darwin.fstat(fd, &value) == 0,
              value.st_mode & S_IFMT == S_IFREG,
              value.st_nlink == 1 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return value
    }
    private func same(_ lhs: stat, _ rhs: stat) -> Bool {
        lhs.st_dev == rhs.st_dev && lhs.st_ino == rhs.st_ino
            && lhs.st_mode == rhs.st_mode && lhs.st_nlink == rhs.st_nlink
    }
    private func sameStableDirectory(_ lhs: stat, _ rhs: stat) -> Bool {
        same(lhs, rhs)
            && lhs.st_mtimespec.tv_sec == rhs.st_mtimespec.tv_sec
            && lhs.st_mtimespec.tv_nsec == rhs.st_mtimespec.tv_nsec
            && lhs.st_ctimespec.tv_sec == rhs.st_ctimespec.tv_sec
            && lhs.st_ctimespec.tv_nsec == rhs.st_ctimespec.tv_nsec
    }

    private func observeColdPolicy(_ kind: OwnedFileKindV1,
        at url: URL) throws -> TemporalPolicyObservationV1 {
        guard uncertainFDs.isEmpty, !closeAttempted else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return try ProtectedFilePolicyV1.observeTemporalPolicyWithCheckedClose(
            kind, at: url, retainUncertainDescriptor: { descriptor in
                // The retained operation keeps this exact ambiguous descriptor
                // and can never use this observer for a subsequent effect.
                self.uncertainFDs.append(descriptor)
            })
    }

}

@MainActor
final class EraseC05ColdPreparationJournalReaderV1 {
    private enum ObservationOwner: Equatable { case cold, original }
    private var observationOwner: ObservationOwner?
    private var supportFD: Int32?
    private var eraseFD: Int32?
    private var preparationFD: Int32?
    private var nextFD: Int32?
    private enum ReplacementPhase { case initial, tempCreated, tempPrepared, swapped, oldRemoved }
    private var replacementPhase: ReplacementPhase = .initial
    private var capturedPreparation: ErasePreparationV2?
    private var capturedBytes: Data?
    private var replacementPreparation: ErasePreparationV2?
    private var replacementBytes: Data?
    private var supportURL: URL?
    private var eraseURL: URL?
    private var opened = false
    private var closeAttempted = false
    private var closeUncertain = false
    private var uncertainPolicyFDs: [Int32] = []

    func openExisting(applicationSupportURL: URL,
        operation: EraseColdPreparationOperationV1) throws {
        try operation.requireServiceAccess()
        try operation.requireC05ColdJournalReader(self)
        try openExisting(applicationSupportURL: applicationSupportURL, owner: .cold)
    }

    /// Classification only. Original retry cannot call the cold predecessor
    /// CAS methods or inherit a startup operation's authority.
    func openExisting(applicationSupportURL: URL,
        operation: EraseRouterOperationV1,
        coordinator: StoreSessionCoordinator) throws {
        try operation.requireOriginalC05NoRepairReader(
            self, coordinator: coordinator, applicationSupportURL: applicationSupportURL)
        try openExisting(applicationSupportURL: applicationSupportURL, owner: .original)
    }

    private func openExisting(applicationSupportURL: URL,
        owner: ObservationOwner) throws {
        guard !opened, !closeAttempted, !closeUncertain,
              observationOwner == nil, applicationSupportURL.isFileURL else {
            throw EraseIntentStoreError.invalidAuthority
        }
        observationOwner = owner
        opened = true
        let root = applicationSupportURL.standardizedFileURL
        let support = Darwin.open(root.path,
            O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
        guard support >= 0 else { throw EraseIntentStoreError.invalidAuthority }
        supportFD = support
        _ = try directory(support)
        let erase = Darwin.openat(support, "FieldEvidenceErase",
            O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
        guard erase >= 0 else { throw EraseIntentStoreError.invalidAuthority }
        eraseFD = erase
        let eraseInfo = try directory(erase)
        let erasePath = root.appendingPathComponent("FieldEvidenceErase", isDirectory: true)
        let policy = try observeColdPolicy(.stagingDirectory,
            at: erasePath)
        guard policy.state == .strictComplete,
              policy.device == UInt64(eraseInfo.st_dev),
              policy.inode == UInt64(eraseInfo.st_ino) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let preparation = Darwin.openat(erase, "preparation.json",
            O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
        guard preparation >= 0 else { throw EraseIntentStoreError.invalidAuthority }
        preparationFD = preparation
        _ = try regular(preparation)
        supportURL = root
        eraseURL = erasePath
        try requireHeldNamed()
    }

    func readPreparation(operation: EraseColdPreparationOperationV1)
        throws -> (preparation: ErasePreparationV2, bytes: Data) {
        try operation.requireServiceAccess()
        try operation.requireC05ColdJournalReader(self)
        guard observationOwner == .cold else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return try readPreparationHeld()
    }

    func readPreparation(operation: EraseRouterOperationV1,
        coordinator: StoreSessionCoordinator)
        throws -> (preparation: ErasePreparationV2, bytes: Data) {
        try operation.requireOriginalC05NoRepairReader(
            self, coordinator: coordinator, applicationSupportURL: supportURL)
        guard observationOwner == .original else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return try readPreparationHeld()
    }

    private func readPreparationHeld()
        throws -> (preparation: ErasePreparationV2, bytes: Data) {
        guard !closeAttempted, !closeUncertain,
              replacementPhase == .initial,
              capturedPreparation == nil, capturedBytes == nil,
              let supportFD, let preparationFD else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try requireHeldNamed()
        let before = try regular(preparationFD)
        guard before.st_size > 0, before.st_size <= 96 * 1024 * 1024,
              Darwin.lseek(preparationFD, 0, SEEK_SET) == 0 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var bytes = Data(count: Int(before.st_size))
        try bytes.withUnsafeMutableBytes { raw in
            var offset = 0
            while offset < raw.count {
                let count = Darwin.read(preparationFD,
                    raw.baseAddress!.advanced(by: offset), raw.count - offset)
                if count < 0 && errno == EINTR { continue }
                guard count > 0 else { throw EraseIntentStoreError.invalidAuthority }
                offset += count
            }
        }
        guard same(before, try regular(preparationFD)) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let decoded = try ErasePreparationCodecV2.decode(bytes)
        if let c05 = decoded.c05JobDrainV3 {
            guard decoded.targetPointer == nil,
                  decoded.oldPointer.generationID
                    == c05.sourceGenerationID else {
                throw EraseIntentStoreError.invalidPreparation
            }
            let heldSupport = try directory(supportFD)
            guard UInt64(heldSupport.st_dev) == c05.supportDevice,
                  UInt64(heldSupport.st_ino) == c05.supportInode else {
                throw EraseIntentStoreError.invalidAuthority
            }
        } else if decoded.coldPredecessorReclaim != nil {
            throw EraseIntentStoreError.invalidPreparation
        }
        try requireHeldNamed()
        capturedPreparation = decoded
        capturedBytes = bytes
        return (decoded, bytes)
    }

    /// Recheck the held and named leaf at each registry phase boundary. The
    /// caller cannot use an earlier decoded value after another disk effect.
    func currentPredecessorPreparation(
        operation: EraseColdPreparationOperationV1
    ) throws -> ErasePreparationV2 {
        try operation.requireServiceAccess()
        try operation.requireC05ColdJournalReader(self)
        guard observationOwner == .cold else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return try currentCapturedPreparationHeld()
    }

    func currentOriginalPreparation(
        operation: EraseRouterOperationV1,
        coordinator: StoreSessionCoordinator
    ) throws -> ErasePreparationV2 {
        try operation.requireOriginalC05NoRepairReader(
            self, coordinator: coordinator, applicationSupportURL: supportURL)
        guard observationOwner == .original else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return try currentCapturedPreparationHeld()
    }

    func originalHeldPreparationIdentity(
        operation: EraseRouterOperationV1,
        coordinator: StoreSessionCoordinator
    ) throws -> (device: UInt64, inode: UInt64) {
        _ = try currentOriginalPreparation(
            operation: operation, coordinator: coordinator)
        guard let preparationFD else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let held = try regular(preparationFD)
        return (UInt64(held.st_dev), UInt64(held.st_ino))
    }

    private func currentCapturedPreparationHeld() throws -> ErasePreparationV2 {
        guard !closeAttempted, !closeUncertain,
            replacementPhase == .initial,
              let capturedPreparation, let capturedBytes,
              let preparationFD else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try requireHeldNamed()
        guard try readExact(preparationFD, expected: capturedBytes),
              try ErasePreparationCodecV2.decode(capturedBytes)
                == capturedPreparation else {
            throw EraseIntentStoreError.preparationMismatch
        }
        return capturedPreparation
    }

    /// Only an exact predecessor-marker transition is accepted. The caller
    /// holds the genuine C05 SH→G owner across this synchronous CAS.
    func replacePredecessorPreparation(
        expected: ErasePreparationV2,
        with replacement: ErasePreparationV2,
        operation: EraseColdPreparationOperationV1
    ) throws {
        try operation.requireServiceAccess()
        try operation.requireC05ColdJournalReader(self)
        guard !closeAttempted, !closeUncertain,
              capturedPreparation == expected,
              let capturedBytes,
              capturedBytes == (try ErasePreparationCodecV2.encode(expected)),
              let eraseFD else { throw EraseIntentStoreError.preparationMismatch }
        let allowed: Bool
        if let nextRecord = replacement.coldPredecessorReclaim,
           expected.coldPredecessorReclaim == nil {
            allowed = (try? expected.recordingColdPredecessorReclaim(
                nextRecord)) == replacement
        } else if let currentRecord = expected.coldPredecessorReclaim,
                  let nextRecord = replacement.coldPredecessorReclaim {
            allowed = (try? expected.advancingColdPredecessorReclaim(
                to: nextRecord.phase)) == replacement
                && currentRecord.retainsSource(nextRecord)
        } else { allowed = false }
        guard allowed else { throw EraseIntentStoreError.preparationMismatch }
        try replaceCapturedPreparation(expected: expected,
            with: replacement, operation: operation)
    }

    func replaceC05PendingWithDrained(
        expected: ErasePreparationV2,
        emptySnapshot: LocalJobStoreV1.OriginalEraseNoRepairSnapshotV1,
        absentTransientSHA256: String,
        operation: EraseColdPreparationOperationV1
    ) throws -> ErasePreparationV2 {
        guard expected.c05JobDrainV3?.phase == .pending,
              expected.coldPredecessorReclaim?.phase == .guardsRemoved,
              expected.targetPointer == nil else {
            throw EraseIntentStoreError.preparationMismatch
        }
        let replacement = try expected.recordingC05JobDrain(
            with: emptySnapshot,
            absentTransientSHA256: absentTransientSHA256)
        try replaceCapturedPreparation(expected: expected,
            with: replacement, operation: operation)
        return replacement
    }

    func replaceC05DrainedWithRootRemoved(
        expected: ErasePreparationV2,
        operation: EraseColdPreparationOperationV1
    ) throws -> ErasePreparationV2 {
        guard expected.c05JobDrainV3?.phase == .drained,
              expected.coldPredecessorReclaim?.phase == .guardsRemoved,
              expected.targetPointer == nil else {
            throw EraseIntentStoreError.preparationMismatch
        }
        let replacement = try expected.recordingC05RootRemoved()
        try replaceCapturedPreparation(expected: expected,
            with: replacement, operation: operation)
        return replacement
    }

    private func replaceCapturedPreparation(
        expected: ErasePreparationV2,
        with replacement: ErasePreparationV2,
        operation: EraseColdPreparationOperationV1
    ) throws {
        try operation.requireServiceAccess()
        try operation.requireC05ColdJournalReader(self)
        guard observationOwner == .cold, !closeAttempted, !closeUncertain,
              capturedPreparation == expected,
              let capturedBytes,
              capturedBytes == (try ErasePreparationCodecV2.encode(expected)),
              let eraseFD else {
            throw EraseIntentStoreError.preparationMismatch
        }
        let encoded = try ErasePreparationCodecV2.encode(replacement)
        if let prior = replacementPreparation {
            guard prior == replacement, replacementBytes == encoded else {
                throw EraseIntentStoreError.preparationMismatch
            }
        } else {
            replacementPreparation = replacement
            replacementBytes = encoded
        }
        try requireCASPhysicalPhase()
        if replacementPhase == .initial {
            let fd = Darwin.openat(eraseFD, ".preparation.json.next",
                O_RDWR | O_CREAT | O_EXCL | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC,
                mode_t(0o600))
            guard fd >= 0 else { throw EraseIntentStoreError.writeFailed }
            nextFD = fd // before fstat, policy, write, or any other throw
            replacementPhase = .tempCreated
        }
        if replacementPhase == .tempCreated {
            try requireCASPhysicalPhase()
            guard let nextFD, let eraseURL else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let tempPath = eraseURL.appendingPathComponent(
                ".preparation.json.next")
            try ProtectedFilePolicyV1.applyAndVerify(
                .journalTemporary, at: tempPath,
                authorityCheck: { try self.requireCASPhysicalPhase() })
            guard Darwin.ftruncate(nextFD, 0) == 0,
                  Darwin.lseek(nextFD, 0, SEEK_SET) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            try encoded.withUnsafeBytes { raw in
                var offset = 0
                while offset < raw.count {
                    let count = Darwin.write(nextFD,
                        raw.baseAddress!.advanced(by: offset), raw.count - offset)
                    if count < 0 && errno == EINTR { continue }
                    guard count > 0 else { throw EraseIntentStoreError.writeFailed }
                    offset += count
                }
            }
            guard Darwin.fsync(nextFD) == 0,
                  try readExact(nextFD, expected: encoded) else {
                throw EraseIntentStoreError.writeFailed
            }
            replacementPhase = .tempPrepared
        }
        if replacementPhase == .tempPrepared {
            try requireCASPhysicalPhase()
            guard Darwin.renameatx_np(eraseFD, ".preparation.json.next",
                eraseFD, "preparation.json", UInt32(RENAME_SWAP)) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            replacementPhase = .swapped
        }
        if replacementPhase == .swapped {
            try requireCASPhysicalPhase()
            guard Darwin.fsync(eraseFD) == 0,
                  Darwin.unlinkat(eraseFD, ".preparation.json.next", 0) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            replacementPhase = .oldRemoved
        }
        guard replacementPhase == .oldRemoved else {
            throw EraseIntentStoreError.writeFailed
        }
        try requireCASPhysicalPhase()
        guard Darwin.fsync(eraseFD) == 0 else {
            throw EraseIntentStoreError.writeFailed
        }
        try requireCASPhysicalPhase()
        // The old preparation FD is still held but unlinked. Close it once
        // before allowing a Registry effect or another phase CAS.
        guard let oldFD = preparationFD, let newFD = nextFD else {
            throw EraseIntentStoreError.invalidAuthority
        }
        preparationFD = nil
        guard Darwin.close(oldFD) == 0 else {
            closeUncertain = true
            throw EraseIntentStoreError.invalidAuthority
        }
        preparationFD = newFD
        nextFD = nil
        capturedPreparation = replacement
        self.capturedBytes = encoded
        replacementPreparation = nil
        replacementBytes = nil
        replacementPhase = .initial
        try requireHeldNamed()
    }

    private func requireCASPhysicalPhase() throws {
        guard let eraseFD, let preparationFD,
              let oldBytes = capturedBytes,
              let newBytes = replacementBytes else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try requireBaseDirectories()
        var current = stat(), temporary = stat()
        switch replacementPhase {
        case .initial:
            try requireHeldNamed()
        case .tempCreated, .tempPrepared:
            guard let nextFD,
                  Darwin.fstatat(eraseFD, "preparation.json",
                      &current, AT_SYMLINK_NOFOLLOW) == 0,
                  same(try regular(preparationFD), current),
                  Darwin.fstatat(eraseFD, ".preparation.json.next",
                      &temporary, AT_SYMLINK_NOFOLLOW) == 0,
                  same(try regular(nextFD), temporary),
                  try readExact(preparationFD, expected: oldBytes) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try requireNamedPolicy(.journal,
                name: "preparation.json", held: current)
            if replacementPhase == .tempPrepared {
                guard try readExact(nextFD, expected: newBytes) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                try requireNamedPolicy(.journalTemporary,
                    name: ".preparation.json.next", held: temporary)
            }
        case .swapped:
            guard let nextFD,
                  Darwin.fstatat(eraseFD, "preparation.json",
                      &current, AT_SYMLINK_NOFOLLOW) == 0,
                  same(try regular(nextFD), current),
                  Darwin.fstatat(eraseFD, ".preparation.json.next",
                      &temporary, AT_SYMLINK_NOFOLLOW) == 0,
                  same(try regular(preparationFD), temporary),
                  try readExact(nextFD, expected: newBytes),
                  try readExact(preparationFD, expected: oldBytes) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try requireNamedPolicy(.journal,
                name: "preparation.json", held: current)
            try requireNamedPolicy(.journalTemporary,
                name: ".preparation.json.next", held: temporary)
        case .oldRemoved:
            guard let nextFD,
                  Darwin.fstatat(eraseFD, "preparation.json",
                      &current, AT_SYMLINK_NOFOLLOW) == 0,
                  same(try regular(nextFD), current),
                  Darwin.fstatat(eraseFD, ".preparation.json.next",
                      &temporary, AT_SYMLINK_NOFOLLOW) != 0,
                  errno == ENOENT,
                  try unlinkedRegular(preparationFD),
                  try readExact(nextFD, expected: newBytes),
                  try readExact(preparationFD, expected: oldBytes,
                      allowUnlinked: true) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try requireNamedPolicy(.journal,
                name: "preparation.json", held: current)
        }
    }

    private func observeColdPolicy(_ kind: OwnedFileKindV1,
        at url: URL) throws -> TemporalPolicyObservationV1 {
        guard !closeAttempted, !closeUncertain,
              uncertainPolicyFDs.isEmpty else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return try ProtectedFilePolicyV1.observeTemporalPolicyWithCheckedClose(
            kind, at: url, retainUncertainDescriptor: { descriptor in
                self.uncertainPolicyFDs.append(descriptor)
                self.closeUncertain = true
            })
    }

    private func requireNamedPolicy(_ kind: OwnedFileKindV1,
        name: String, held: stat) throws {
        guard let eraseURL else { throw EraseIntentStoreError.invalidAuthority }
        let policy = try observeColdPolicy(kind,
            at: eraseURL.appendingPathComponent(name))
        guard policy.state == .strictComplete,
              policy.device == UInt64(held.st_dev),
              policy.inode == UInt64(held.st_ino) else {
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    private func requireBaseDirectories() throws {
        guard let supportFD, let eraseFD, let supportURL,
              let eraseURL else { throw EraseIntentStoreError.invalidAuthority }
        let heldSupport = try directory(supportFD)
        let heldErase = try directory(eraseFD)
        var namedSupport = stat(), namedErase = stat(), intent = stat()
        guard Darwin.lstat(supportURL.path, &namedSupport) == 0,
              same(heldSupport, namedSupport),
              Darwin.fstatat(supportFD, "FieldEvidenceErase",
                  &namedErase, AT_SYMLINK_NOFOLLOW) == 0,
              same(heldErase, namedErase),
              Darwin.fstatat(eraseFD, "erase.json",
                  &intent, AT_SYMLINK_NOFOLLOW) != 0, errno == ENOENT else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let policy = try observeColdPolicy(.stagingDirectory,
            at: eraseURL)
        guard policy.state == .strictComplete,
              policy.device == UInt64(heldErase.st_dev),
              policy.inode == UInt64(heldErase.st_ino) else {
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    private func readExact(_ fd: Int32, expected: Data,
        allowUnlinked: Bool = false) throws -> Bool {
        var before = stat(), after = stat()
        guard Darwin.fstat(fd, &before) == 0,
              before.st_mode & S_IFMT == S_IFREG,
              before.st_nlink == (allowUnlinked ? 0 : 1),
              before.st_size == off_t(expected.count),
              Darwin.lseek(fd, 0, SEEK_SET) == 0 else { return false }
        var observed = Data(count: expected.count)
        try observed.withUnsafeMutableBytes { raw in
            var offset = 0
            while offset < raw.count {
                let count = Darwin.read(fd,
                    raw.baseAddress!.advanced(by: offset), raw.count - offset)
                if count < 0 && errno == EINTR { continue }
                guard count > 0 else { throw EraseIntentStoreError.invalidAuthority }
                offset += count
            }
        }
        guard Darwin.fstat(fd, &after) == 0,
              same(before, after),
              before.st_size == after.st_size else { return false }
        return observed == expected
    }

    private func unlinkedRegular(_ fd: Int32) throws -> Bool {
        var held = stat()
        guard Darwin.fstat(fd, &held) == 0 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return held.st_mode & S_IFMT == S_IFREG && held.st_nlink == 0
    }

    func closeChecked() throws {
        guard opened, !closeAttempted else {
            throw EraseIntentStoreError.invalidAuthority
        }
        closeAttempted = true
        for keyPath in [\EraseC05ColdPreparationJournalReaderV1.nextFD,
                        \EraseC05ColdPreparationJournalReaderV1.preparationFD,
                        \EraseC05ColdPreparationJournalReaderV1.eraseFD,
                        \EraseC05ColdPreparationJournalReaderV1.supportFD] {
            if let fd = self[keyPath: keyPath] {
                self[keyPath: keyPath] = nil
                if Darwin.close(fd) != 0 { closeUncertain = true }
            }
        }
        guard !closeUncertain else { throw EraseIntentStoreError.invalidAuthority }
    }

    private func requireHeldNamed() throws {
        guard let supportFD, let eraseFD, let preparationFD,
              let supportURL, let eraseURL else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let heldSupport = try directory(supportFD)
        let heldErase = try directory(eraseFD)
        let heldPreparation = try regular(preparationFD)
        var namedSupport = stat(), namedErase = stat(), namedPreparation = stat()
        var pending = stat(), intent = stat()
        guard Darwin.lstat(supportURL.path, &namedSupport) == 0,
              same(heldSupport, namedSupport),
              Darwin.fstatat(supportFD, "FieldEvidenceErase",
                  &namedErase, AT_SYMLINK_NOFOLLOW) == 0,
              same(heldErase, namedErase),
              Darwin.fstatat(eraseFD, "preparation.json",
