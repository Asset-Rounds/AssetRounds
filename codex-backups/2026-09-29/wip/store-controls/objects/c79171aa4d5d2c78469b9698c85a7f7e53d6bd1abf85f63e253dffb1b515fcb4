/// Published before the first raw source/plan leaf. The complete immutable
/// table is the only admissible bootstrap namespace; exact prefix recovery
/// still requires matching physical original-P source admission under EX/G.
struct EraseSchema2ColdCleanupTransferV1: Codable, Equatable {
    let schemaVersion: Int
    let sources: EraseSchema2ColdCleanupSourcesV1
    func canonicalBytes() throws -> Data {
