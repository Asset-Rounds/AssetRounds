    @MainActor
    static func observeOriginalRecoveryNoCreate(
        support: StoreTemporalPhysicalRootExclusionV1,
        applicationSupportURL: URL,
        io: EraseAbortCheckedSnapshotIOV1,
        retainUncertainDescriptor: (Int32) -> Void
    ) throws -> OriginalRecoveryObservation {
        try io.requireSettled()
        let result = try support.withOriginalEraseRecoverySupport(
            at: applicationSupportURL) { supportFD -> OriginalRecoveryObservation in
            var heldSupport = stat(), namedSupport = stat()
            guard Darwin.fstat(supportFD, &heldSupport) == 0,
                  Darwin.lstat(applicationSupportURL.path, &namedSupport) == 0,
                  heldSupport.st_mode & S_IFMT == S_IFDIR,
                  RetirementLeafFact(namedSupport)
                    == RetirementLeafFact(heldSupport),
                  OriginalRecoveryObservation.Ownership(namedSupport)
                    == OriginalRecoveryObservation.Ownership(heldSupport) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let supportFact = RetirementLeafFact(heldSupport)
            let supportOwnership = OriginalRecoveryObservation.Ownership(heldSupport)
            let supportNames = try io.names(in: supportFD)
            var namedErase = stat()
            if Darwin.fstatat(supportFD, directoryName,
                              &namedErase, AT_SYMLINK_NOFOLLOW) != 0 {
                guard errno == ENOENT,
                      !supportNames.contains(directoryName) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                var heldAfter = stat(), namedAfter = stat(), absent = stat()
                guard Darwin.fstat(supportFD, &heldAfter) == 0,
                      Darwin.lstat(applicationSupportURL.path,
                          &namedAfter) == 0,
                      RetirementLeafFact(heldAfter) == supportFact,
                      RetirementLeafFact(namedAfter) == supportFact,
                      OriginalRecoveryObservation.Ownership(heldAfter)
                        == supportOwnership,
                      OriginalRecoveryObservation.Ownership(namedAfter)
                        == supportOwnership,
                      try io.names(in: supportFD) == supportNames,
                      Darwin.fstatat(supportFD, directoryName,
                          &absent, AT_SYMLINK_NOFOLLOW) != 0,
                      errno == ENOENT else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                let observation = OriginalRecoveryObservation(
                    supportDevice: Int64(heldSupport.st_dev),
                    supportInode: UInt64(heldSupport.st_ino),
                    supportFact: supportFact,
                    supportOwnership: supportOwnership,
                    supportNames: supportNames,
                    eraseFact: nil, eraseOwnership: nil,
                    erasePolicy: nil,
                    eraseNames: [], leaves: [],
                    intent: nil, preparation: nil)
            }
            guard namedErase.st_mode & S_IFMT == S_IFDIR,
                  supportNames.contains(directoryName) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return try io.withOpen(parent: supportFD, name: directoryName,
                                   flags: O_RDONLY | O_DIRECTORY) { eraseFD in
                var heldErase = stat()
                guard Darwin.fstat(eraseFD, &heldErase) == 0,
                      RetirementLeafFact(namedErase) == RetirementLeafFact(heldErase),
                      OriginalRecoveryObservation.Ownership(namedErase)
                        == OriginalRecoveryObservation.Ownership(heldErase) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                let eraseFact = RetirementLeafFact(heldErase)
                let eraseOwnership = OriginalRecoveryObservation.Ownership(heldErase)
                let eraseURL = applicationSupportURL.appendingPathComponent(directoryName)
                let names = try io.names(in: eraseFD)
                let erasePolicy = try ProtectedFilePolicyV1
                    .observeTemporalPolicyWithCheckedClose(
                        .stagingDirectory, at: eraseURL,
                        retainUncertainDescriptor: retainUncertainDescriptor)
                var policyHeldErase = stat(), policyNamedErase = stat()
                guard Darwin.fstat(eraseFD, &policyHeldErase) == 0,
                      Darwin.fstatat(supportFD, directoryName,
                          &policyNamedErase, AT_SYMLINK_NOFOLLOW) == 0,
                      RetirementLeafFact(policyHeldErase) == eraseFact,
                      RetirementLeafFact(policyNamedErase) == eraseFact,
                      OriginalRecoveryObservation.Ownership(policyHeldErase)
                        == eraseOwnership,
                      OriginalRecoveryObservation.Ownership(policyNamedErase)
                        == eraseOwnership,
                      try io.names(in: eraseFD) == names,
                      erasePolicy.device == UInt64(heldErase.st_dev),
                      erasePolicy.inode == UInt64(heldErase.st_ino),
                      erasePolicy.linkCount == UInt64(heldErase.st_nlink),
                      erasePolicy.mode == UInt16(heldErase.st_mode) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
