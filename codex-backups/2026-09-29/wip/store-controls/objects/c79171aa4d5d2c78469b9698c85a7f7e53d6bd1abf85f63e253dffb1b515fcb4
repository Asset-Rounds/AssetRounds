    /// Bind only the physical R roster namespace observed before Support EX
    /// to this held Store after genuine EX/G. These bytes are opaque: the
    /// Manifest owner must decode and bind them to the canonical R controls
    /// and complete survivor cut before any deletion or temp replay.
    @MainActor
    func requireSchema2ColdObservedRosterCut(
        intent: EraseIntentV1,
        preparation: ErasePreparationV2,
        operation: EraseColdPreparationOperationV1,
        registryGAlreadyHeld: Bool = false
    ) throws -> Schema2ColdObservedRosterCutV1 {
        try operation.requireSchema2ColdRosterObservationOwner(
            store: self, registryGAlreadyHeld: registryGAlreadyHeld)
        guard borrowsColdObservation,
              intent.schemaVersion == 2,
              intent.phase == .sessionActivated,
              preparation.matches(intent),
              try load() == intent,
              try loadPreparation() == preparation,
              !coldRosterInFlight,
              coldRosterPublication == nil,
              coldOwnRosterFact == nil,
              coldActiveFD == nil,
              coldUncertainFDs.isEmpty,
              !coldEffectUncertain else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try verifyAuthority()
        let firstRoot = try coldRootFact()
        let names = try coldNamesChecked()
        guard names.contains(Self.rosterName)
                == coldCapturedOpaqueRosterPresent,
              names.contains(Self.rosterNextName)
                == (coldCapturedOpaqueRosterNextPresent &&
                    !coldObservedRosterTempSettled),
              names.allSatisfy({
                $0 == Self.intentName ||
                $0 == Self.preparationName ||
                ($0 == Self.nextName &&
                    coldCapturedOpaqueNextBytes != nil) ||
                ($0 == Self.auxiliaryRosterName &&
                    coldCapturedOpaqueAuxiliaryRosterBytes != nil) ||
                ($0 == Self.originalRetiredCommitmentName &&
                    coldCapturedOpaqueOriginalRetired[$0] != nil) ||
                ($0 == Self.originalRetiredStageIdentityName &&
                    coldCapturedOpaqueOriginalRetired[$0] != nil) ||
                $0 == Self.rosterName ||
                $0 == Self.rosterNextName
              }) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let published = try observeSchema2ColdOpaqueRosterLeaf(
            Self.rosterName, expectedPresent:
                coldCapturedOpaqueRosterPresent)
        let temporary = try observeSchema2ColdOpaqueRosterLeaf(
            Self.rosterNextName, expectedPresent:
                coldCapturedOpaqueRosterNextPresent &&
                    !coldObservedRosterTempSettled)
        try verifyAuthority()
        guard try coldRootFact() == firstRoot,
              try coldNamesChecked() == names,
              try load() == intent,
              try loadPreparation() == preparation else {
            throw EraseIntentStoreError.invalidAuthority
        }
        // The final canonical leaf reads above are fallible observations.
        // Bind their result to the same held/named Erase root and closed name
        // set before retaining this cut as replay's sole physical baseline.
        try verifyAuthority()
        guard try coldRootFact() == firstRoot,
              try coldNamesChecked() == names else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let cut = Schema2ColdObservedRosterCutV1(
            published: published, temporary: temporary,
            eraseRoot: firstRoot, names: names)
        if let first = coldFirstObservedRosterCut {
            // A checked complete request may change only the policy
            // observation. The first opaque bytes, inode, full file fact,
            // Erase root, and names remain the sole physical baseline.
            guard first.published?.bytes == cut.published?.bytes,
                  first.published?.fact == cut.published?.fact,
                  (coldObservedRosterTempSettled
                    ? (first.temporary != nil &&
                        cut.temporary == nil &&
                        cut.eraseRoot ==
                            coldObservedRosterTempSettledRoot &&
                        cut.names == schema2ColdRosterNames())
                    : (first.temporary?.bytes == cut.temporary?.bytes &&
                        first.temporary?.fact == cut.temporary?.fact &&
                        first.eraseRoot == cut.eraseRoot &&
                        first.names == cut.names)) else {
                throw EraseIntentStoreError.invalidAuthority
            }
        } else {
            coldFirstObservedRosterCut = cut
        }
        return cut
    }

    /// A fresh R roster is data until its canonical record has been decoded
    /// against the held intent, preparation, and generations parent. Only
    /// then may this same operation request complete protection on the exact
    /// first observed inode. Pending policy alone is never replay authority.
    @MainActor
    func requireSchema2ColdVerifiedObservedRosterPolicy(
        roster: EraseSchema2ColdDeletionRosterV1,
        intent: EraseIntentV1,
        preparation: ErasePreparationV2,
        operation: EraseColdPreparationOperationV1,
        registryGAlreadyHeld: Bool = false
    ) throws {
        try operation.requireSchema2ColdRosterObservationOwner(
            store: self, registryGAlreadyHeld: registryGAlreadyHeld)
        guard borrowsColdObservation,
              intent.schemaVersion == 2,
              intent.phase == .sessionActivated,
              preparation.matches(intent),
              !coldObservedRosterPolicyRequestInFlight,
              !coldEffectUncertain,
              coldRosterPublication == nil,
              coldOwnRosterFact == nil,
              coldActiveFD == nil,
              coldUncertainFDs.isEmpty else {
            throw EraseIntentStoreError.invalidAuthority
        }
        func physicalWitness() throws -> Schema2ColdRosterPolicyWitnessV1 {
            try operation.requireSchema2ColdRosterObservationOwner(
                store: self, registryGAlreadyHeld: registryGAlreadyHeld)
            let controls = try requireSchema2ColdCanonicalControls(
                intent: intent, preparation: preparation,
                operation: operation)
            let cut = try requireSchema2ColdObservedRosterCut(
                intent: intent, preparation: preparation,
                operation: operation,
                registryGAlreadyHeld: registryGAlreadyHeld)
            guard let leaf = cut.published,
                  cut.temporary == nil,
                  cut.eraseRoot == controls.eraseRoot,
                  cut.names == controls.names,
                  cut.names == schema2ColdRosterNames([Self.rosterName]),
                  leaf.bytes == roster.canonicalBytes,
                  leaf.fact == roster.recordFileFact,
                  leaf.fact.mode & S_IFMT == S_IFREG,
                  leaf.fact.links == 1 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return Schema2ColdRosterPolicyWitnessV1(
                intentBytes: controls.intentBytes,
                preparationBytes: controls.preparationBytes,
                bytes: leaf.bytes, fact: leaf.fact,
                eraseRoot: cut.eraseRoot, names: cut.names)
        }
        let before = try physicalWitness()
        guard roster.canonicalSHA256 ==
                StoreMigrationCanonicalJSONV1.sha256(before.bytes) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        if let disposition = coldVerifiedObservedRosterDisposition {
            guard coldVerifiedObservedRosterSHA256 ==
                    roster.canonicalSHA256,
                  try physicalWitness() == before else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let policy = try observeBorrowedColdPolicy(.journal,
                at: applicationSupportURL.appendingPathComponent(
                    policyRelativePath(Self.rosterName)))
            guard policy.device == UInt64(before.fact.device),
                  policy.inode == UInt64(before.fact.inode),
                  policy.linkCount == 1,
                  (disposition == .verifiedComplete
                    ? policy.state == .strictComplete
                    : (policy.state == .pendingSimulatorRequest ||
                        policy.state == .strictComplete)),
                  try physicalWitness() == before else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return
        }
        // Registry's publisher has G and rechecks the exact prior tokens
        // inside that lock. It may only consume a previously checked policy
        // disposition; a new Foundation setter cannot run inside G.
        guard !registryGAlreadyHeld else {
            throw EraseIntentStoreError.invalidAuthority
        }
        coldObservedRosterPolicyRequestInFlight = true
        do {
            let disposition = try ProtectedFilePolicyV1
                .verifyEraseColdTemporalPolicyWithCheckedRequest(
                    .journal,
                    at: applicationSupportURL.appendingPathComponent(
                        policyRelativePath(Self.rosterName)),
                    retainUncertainDescriptor: { value in
                        self.coldUncertainFDs.append(value)
                    }, unchangedWitness: { try physicalWitness() })
            guard coldUncertainFDs.isEmpty,
                  try physicalWitness() == before else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let policy = try observeBorrowedColdPolicy(.journal,
                at: applicationSupportURL.appendingPathComponent(
                    policyRelativePath(Self.rosterName)))
            guard policy.device == UInt64(before.fact.device),
                  policy.inode == UInt64(before.fact.inode),
                  policy.linkCount == 1,
                  (disposition == .verifiedComplete
                    ? policy.state == .strictComplete
                    : (policy.state == .pendingSimulatorRequest ||
                        policy.state == .strictComplete)),
                  try physicalWitness() == before else {
                throw EraseIntentStoreError.invalidAuthority
            }
            coldVerifiedObservedRosterSHA256 = roster.canonicalSHA256
            coldVerifiedObservedRosterDisposition = disposition
            coldObservedRosterPolicyRequestInFlight = false
        } catch {
            coldEffectUncertain = true
            throw error
        }
    }

    @MainActor
    private func observeSchema2ColdOpaqueRosterLeaf(
        _ name: String, expectedPresent: Bool
    ) throws -> Schema2ColdObservedRosterLeafV1? {
        guard name == Self.rosterName || name == Self.rosterNextName,
              coldActiveFD == nil,
              coldUncertainFDs.isEmpty else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let descriptor = Darwin.openat(eraseDescriptor, name,
            O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
        if descriptor < 0 {
            guard errno == ENOENT, !expectedPresent else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return nil
        }
        coldActiveFD = descriptor
        do {
            var before = stat(), after = stat(), named = stat()
            guard expectedPresent,
                  Darwin.fstat(descriptor, &before) == 0,
                  before.st_mode & S_IFMT == S_IFREG,
                  before.st_nlink == 1,
                  before.st_size >= 0,
                  before.st_size <= off_t(Int.max),
                  Darwin.fstatat(eraseDescriptor, name, &named,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(before)
                    == EraseColdControlLeafFactV1(named) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let fact = EraseColdControlLeafFactV1(before)
            let kind: OwnedFileKindV1 = name == Self.rosterName
                ? .journal : .journalTemporary
            let policyURL = applicationSupportURL.appendingPathComponent(
                policyRelativePath(name))
            let firstPolicy = try observeBorrowedColdPolicy(kind,
                at: policyURL)
            guard firstPolicy.device == UInt64(before.st_dev),
                  firstPolicy.inode == UInt64(before.st_ino),
                  firstPolicy.linkCount == 1,
                  (firstPolicy.state == .strictComplete ||
                    firstPolicy.state == .pendingSimulatorRequest) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            var bytes = Data()
            var buffer = [UInt8](repeating: 0, count: 16 * 1024)
            while true {
                let count = buffer.withUnsafeMutableBytes {
                    Darwin.read(descriptor, $0.baseAddress, $0.count)
                }
                if count > 0 {
                    guard bytes.count <= Int(before.st_size) - count else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                    bytes.append(contentsOf: buffer.prefix(count))
                } else if count == 0 { break }
                else if errno != EINTR {
                    throw EraseIntentStoreError.invalidAuthority
                }
            }
            guard bytes.count == Int(before.st_size),
                  Darwin.fstat(descriptor, &after) == 0,
                  Darwin.fstatat(eraseDescriptor, name, &named,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(after) == fact,
                  EraseColdControlLeafFactV1(named) == fact,
                  try observeBorrowedColdPolicy(kind,
                    at: policyURL) == firstPolicy else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try closeColdActiveChecked()
            return Schema2ColdObservedRosterLeafV1(
                bytes: bytes, fact: fact, policy: firstPolicy)
        } catch {
            let failure = error
            if coldActiveFD != nil { try closeColdActiveChecked() }
            throw failure
        }
    }

    /// Settle only the first opaque roster temporary after Manifest has
    /// derived the complete canonical record from still-held intact sources.
    /// The first temp bytes/fact remain immutable; a separate one-way root
    /// projection records this checked unlink and cannot authorize a
    /// different temporary or a partially deleted tree.
    @MainActor
    func settleSchema2ColdObservedRosterTemporary(
        seal: EraseSchema2ColdDeletionRosterPublicationSealV1,
        intent: EraseIntentV1,
        preparation: ErasePreparationV2,
        operation: EraseColdPreparationOperationV1
    ) throws {
        guard borrowsColdObservation,
              coldCapturedOpaqueRosterNextPresent,
              !coldCapturedOpaqueRosterPresent,
              !coldObservedRosterTempRemovalInFlight,
              !coldObservedRosterTempSettled,
              coldRosterPublication == nil,
              !coldRosterInFlight,
              !coldEffectUncertain,
              coldActiveFD == nil,
              coldUncertainFDs.isEmpty else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try operation.requireSchema2ColdRosterSourceFactsBeforeTempRemoval(
            seal: seal, store: self)
        func physicalWitness() throws -> Schema2ColdRosterPolicyWitnessV1 {
            try operation.requireSchema2ColdRosterSourceFactsBeforeTempRemoval(
                seal: seal, store: self)
            let controls = try requireSchema2ColdCanonicalControls(
                intent: intent, preparation: preparation,
                operation: operation)
            let cut = try requireSchema2ColdObservedRosterCut(
                intent: intent, preparation: preparation,
                operation: operation)
            guard cut.published == nil,
                  let temp = cut.temporary,
                  cut.eraseRoot == controls.eraseRoot,
                  cut.names == controls.names,
                  cut.names == schema2ColdRosterNames([Self.rosterNextName]),
                  temp.fact.mode & S_IFMT == S_IFREG,
                  temp.fact.links == 1,
                  temp.fact.size == off_t(temp.bytes.count),
                  seal.canonicalBytes.starts(with: temp.bytes) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return Schema2ColdRosterPolicyWitnessV1(
                intentBytes: controls.intentBytes,
                preparationBytes: controls.preparationBytes,
                bytes: temp.bytes, fact: temp.fact,
                eraseRoot: cut.eraseRoot, names: cut.names)
        }
        let first = try physicalWitness()
        coldObservedRosterTempRemovalInFlight = true
        do {
            let url = applicationSupportURL.appendingPathComponent(
                policyRelativePath(Self.rosterNextName))
            let disposition = try ProtectedFilePolicyV1
                .verifyEraseColdTemporalPolicyWithCheckedRequest(
                    .journalTemporary, at: url,
                    retainUncertainDescriptor: { value in
                        self.coldUncertainFDs.append(value)
                    }, unchangedWitness: { try physicalWitness() })
            guard coldUncertainFDs.isEmpty,
                  try physicalWitness() == first else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let policy = try observeBorrowedColdPolicy(
                .journalTemporary, at: url)
            guard policy.device == UInt64(first.fact.device),
                  policy.inode == UInt64(first.fact.inode),
                  policy.linkCount == 1,
                  (disposition == .verifiedComplete
                    ? policy.state == .strictComplete
                    : (policy.state == .pendingSimulatorRequest ||
                        policy.state == .strictComplete)),
                  try physicalWitness() == first else {
                throw EraseIntentStoreError.invalidAuthority
            }
            coldVerifiedObservedRosterTempDisposition = disposition
            let descriptor = Darwin.openat(eraseDescriptor,
                Self.rosterNextName,
                O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
            guard descriptor >= 0 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            coldActiveFD = descriptor
            var held = stat(), named = stat()
            var heldRoot = stat(), namedRoot = stat(), namedSupport = stat()
            try operation.requireSchema2ColdRosterSourceFactsBeforeTempRemoval(
                seal: seal, store: self)
            guard Darwin.fstat(descriptor, &held) == 0,
                  Darwin.fstatat(eraseDescriptor,
                    Self.rosterNextName, &named,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(held) == first.fact,
                  EraseColdControlLeafFactV1(named) == first.fact,
                  Darwin.fstat(eraseDescriptor, &heldRoot) == 0,
                  Darwin.fstatat(applicationSupportDescriptor,
                    Self.directoryName, &namedRoot,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(heldRoot)
                    == first.eraseRoot,
                  EraseColdControlLeafFactV1(namedRoot)
                    == first.eraseRoot,
                  Darwin.lstat(applicationSupportURL.path,
                    &namedSupport) == 0,
                  namedSupport.st_mode & S_IFMT == S_IFDIR,
                  namedSupport.st_dev
                    == applicationSupportIdentity.device,
                  namedSupport.st_ino
                    == applicationSupportIdentity.inode,
                  try coldNamesChecked() == first.names,
                  Darwin.unlinkat(eraseDescriptor,
                    Self.rosterNextName, 0) == 0,
                  Darwin.fsync(eraseDescriptor) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            try closeColdActiveChecked()
            let afterRoot = try coldRootFact()
            let afterNames = try coldNamesChecked()
            var absent = stat()
            guard afterRoot.device == first.eraseRoot.device,
                  afterRoot.inode == first.eraseRoot.inode,
                  afterRoot.mode == first.eraseRoot.mode,
                  afterRoot.links == first.eraseRoot.links,
                  afterNames == schema2ColdRosterNames(),
                  Darwin.fstatat(eraseDescriptor,
                    Self.rosterNextName, &absent,
                    AT_SYMLINK_NOFOLLOW) != 0,
                  errno == ENOENT else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try operation.requireSchema2ColdRosterSourceFactsBeforeTempRemoval(
                seal: seal, store: self)
            coldObservedRosterTempSettledRoot = afterRoot
            coldObservedRosterTempSettled = true
            coldObservedRosterTempRemovalInFlight = false
            let controls = try requireSchema2ColdCanonicalControls(
                intent: intent, preparation: preparation,
                operation: operation)
            guard controls.eraseRoot == afterRoot,
                  controls.names == afterNames else {
                throw EraseIntentStoreError.invalidAuthority
            }
        } catch {
            let failure = error
            if coldActiveFD != nil {
                do { try closeColdActiveChecked() }
                catch {
                    coldEffectUncertain = true
                    throw error
                }
            }
            coldEffectUncertain = true
            throw failure
        }
    }

    /// The Manifest owner has already sealed a complete semantic roster and
    /// the Router proves the actual R session/EX/G. This first physical cut
    /// has exactly the two captured canonical leaves and no roster child.
    @MainActor
    func beginSchema2ColdRosterPublication(
        intent: EraseIntentV1, preparation: ErasePreparationV2,
        seal: EraseSchema2ColdDeletionRosterPublicationSealV1,
        operation: EraseColdPreparationOperationV1
    ) throws -> Schema2ColdRosterPublicationV1 {
        guard intent.schemaVersion == 2,
              intent.phase == .sessionActivated,
              !coldRosterInFlight,
              coldRosterPublication == nil,
              coldOwnRosterFact == nil,
              !seal.canonicalBytes.isEmpty,
              seal.canonicalSHA256 == StoreMigrationCanonicalJSONV1.sha256(
                seal.canonicalBytes) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try operation.requireSchema2ColdRosterAdmission(
            intent: intent, store: self)
        try operation.requireSchema2ColdRosterPublicationSeal(seal)
        let controls = try requireSchema2ColdCanonicalControls(
            intent: intent, preparation: preparation,
            operation: operation)
        if coldObservedRosterTempSettled {
            guard let projected = coldObservedRosterTempSettledRoot,
                  controls.eraseRoot == projected else {
                throw EraseIntentStoreError.invalidAuthority
            }
        }
        guard controls.names == schema2ColdRosterNames() else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let receipt = Schema2ColdRosterPublicationV1(
            store: self, operation: operation,
            seal: seal,
            intentBytes: controls.intentBytes,
            preparationBytes: controls.preparationBytes,
            originalRoot: controls.eraseRoot)
        coldRosterPublication = receipt
        coldRosterInFlight = true
        return receipt
    }

    /// The borrowed Store is the sole descriptor owner for this prospective
    /// record. Its O_EXCL temporary is policy-checked, fully written and
    /// fsynced before a checked no-replace rename and parent fsync. No fixed
    /// journal-size ceiling is imposed on the complete node roster.
    @MainActor
    func publishSchema2ColdRosterBytes(
        receipt: Schema2ColdRosterPublicationV1,
        seal: EraseSchema2ColdDeletionRosterPublicationSealV1,
        operation: EraseColdPreparationOperationV1
    ) throws -> EraseColdControlLeafFactV1 {
        let canonicalBytes = seal.canonicalBytes
        guard coldRosterPublication === receipt,
              receipt.store === self,
              receipt.operation === operation,
              receipt.seal === seal,
              coldRosterInFlight,
              receipt.publishedFact == nil,
              !canonicalBytes.isEmpty,
              seal.canonicalSHA256 == StoreMigrationCanonicalJSONV1.sha256(
                canonicalBytes),
              coldOwnRosterBytes == nil,
              coldActiveFD == nil,
              coldUncertainFDs.isEmpty,
              !coldEffectUncertain else {
            throw EraseIntentStoreError.invalidAuthority
        }
        do {
            try operation.requireSchema2ColdRosterPublicationSeal(seal)
            try operation.requireSchema2ColdRosterEffectOwner(
                store: self)
            _ = try requireSchema2ColdRosterControls(
                receipt: receipt,
                expectedNames: schema2ColdRosterNames(),
                expectedRoot: receipt.originalRoot)
            coldOwnRosterBytes = canonicalBytes
            let temporary = try createColdLeaf(Self.rosterNextName,
                data: canonicalBytes, maximumBytes: canonicalBytes.count)
            receipt.postTemporaryRoot = try requireSchema2ColdRosterControls(
                receipt: receipt,
                expectedNames: schema2ColdRosterNames([Self.rosterNextName]),
                expectedRoot: nil)
            guard let checkedTemp = try readColdLeafIfPresent(
                    Self.rosterNextName,
                    maximumBytes: canonicalBytes.count),
                  checkedTemp.identity == temporary,
                  checkedTemp.data == canonicalBytes else {
                throw EraseIntentStoreError.writeFailed
            }
            guard let afterTemp = receipt.postTemporaryRoot else {
                throw EraseIntentStoreError.writeFailed
            }
            try operation.requireSchema2ColdRosterSourceFactsBeforeRename(
                seal: seal, store: self)
            guard try requireSchema2ColdRosterControls(
                    receipt: receipt,
                    expectedNames: schema2ColdRosterNames([Self.rosterNextName]),
                    expectedRoot: afterTemp) == afterTemp,
                  Darwin.renameatx_np(eraseDescriptor,
                    Self.rosterNextName, eraseDescriptor,
                    Self.rosterName, UInt32(RENAME_EXCL)) == 0,
                  Darwin.fsync(eraseDescriptor) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            coldOwnPublishingName = Self.rosterName
            coldOwnPublishedIdentity = temporary
            receipt.postPublishedRoot = try requireSchema2ColdRosterControls(
                receipt: receipt,
                expectedNames: schema2ColdRosterNames([Self.rosterName]),
                expectedRoot: nil)
            guard let written = try readColdLeafIfPresent(
                    Self.rosterName,
                    maximumBytes: canonicalBytes.count),
                  written.identity == temporary,
                  written.data == canonicalBytes else {
                throw EraseIntentStoreError.writeFailed
            }
            var record = stat(), named = stat()
            guard Darwin.fstatat(eraseDescriptor,
                    Self.rosterName, &record,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  Darwin.fstatat(eraseDescriptor,
                    Self.rosterName, &named,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(record)
                    == EraseColdControlLeafFactV1(named),
                  record.st_dev == temporary.device,
                  record.st_ino == temporary.inode,
                  record.st_mode & S_IFMT == S_IFREG,
                  record.st_nlink == 1 else {
                throw EraseIntentStoreError.writeFailed
            }
            let fact = EraseColdControlLeafFactV1(record)
            receipt.publishedFact = fact
            return fact
        } catch {
            coldEffectUncertain = true
            throw error
        }
    }

    /// Manifest may accept the record only after this same held Store sees
    /// its exact published inode/bytes, absent temp, unchanged canonical
    /// intent/preparation and a stable held/named Erase root. The projection
    /// grants no deletion right; the typed durable roster is separately due.
    @MainActor
    func finishSchema2ColdRosterPublication(
        receipt: Schema2ColdRosterPublicationV1,
        seal: EraseSchema2ColdDeletionRosterPublicationSealV1,
        recordFact: EraseColdControlLeafFactV1,
        operation: EraseColdPreparationOperationV1
    ) throws {
        let canonicalBytes = seal.canonicalBytes
        guard coldRosterPublication === receipt,
              receipt.store === self,
              receipt.operation === operation,
              receipt.seal === seal,
              coldRosterInFlight,
              seal.canonicalSHA256 == StoreMigrationCanonicalJSONV1.sha256(
                canonicalBytes),
              receipt.publishedFact == recordFact,
              coldOwnRosterBytes == canonicalBytes,
              !coldEffectUncertain else {
            throw EraseIntentStoreError.invalidAuthority
        }
        do {
            try operation.requireSchema2ColdRosterPublicationSeal(seal)
            guard let publishedRoot = receipt.postPublishedRoot,
                  try requireSchema2ColdRosterControls(
                receipt: receipt,
                expectedNames: schema2ColdRosterNames([Self.rosterName]),
                expectedRoot: publishedRoot) == publishedRoot else {
                throw EraseIntentStoreError.invalidAuthority
            }
            guard let written = try readColdLeafIfPresent(
                    Self.rosterName,
                    maximumBytes: canonicalBytes.count),
                  written.data == canonicalBytes else {
                throw EraseIntentStoreError.invalidAuthority
            }
            var record = stat()
            guard Darwin.fstatat(eraseDescriptor,
                    Self.rosterName, &record,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(record) == recordFact else {
                throw EraseIntentStoreError.invalidAuthority
            }
            coldOwnRosterFact = recordFact
            coldOwnTemporaryName = nil
            coldOwnTemporaryIdentity = nil
            coldOwnTemporaryBytes = nil
            coldOwnPublishingName = nil
            coldOwnPublishedIdentity = nil
            coldPublishedVerified = false
            coldRosterInFlight = false
            try verifyAuthority()
        } catch {
            coldEffectUncertain = true
            throw error
        }
    }

    /// Reprove the exact roster published by this borrowed Store before a
    /// rostered deletion step. This is an observation, not another roster
    /// admission or an opportunity to adopt a named file as our own record.
    @MainActor
    func requireSchema2ColdPublishedRoster(
        intent: EraseIntentV1,
        preparation: ErasePreparationV2,
        canonicalBytes: Data,
        recordFact: EraseColdControlLeafFactV1,
        operation: EraseColdPreparationOperationV1
    ) throws {
        try operation.requireSchema2ColdPublishedRosterControlOwner(
            store: self)
        if coldRosterPublication == nil {
            // A fresh R operation may inherit only the exact canonical leaf
            // captured as opaque physical evidence before EX. Its first
            // checked post-EX/G bytes/fact remain the sole replay baseline.
            // The decoded record must also carry this operation's successful
            // complete-request disposition; raw pending is insufficient.
            let roster = try operation.requireSchema2ColdObservedReplayRoster(
                canonicalBytes: canonicalBytes, recordFact: recordFact,
                store: self)
            try requireSchema2ColdVerifiedObservedRosterPolicy(
                roster: roster, intent: intent,
                preparation: preparation, operation: operation)
            let observed = try requireSchema2ColdObservedRosterCut(
                intent: intent, preparation: preparation,
                operation: operation)
            guard let leaf = observed.published,
                  observed.temporary == nil,
                  leaf.bytes == canonicalBytes,
                  leaf.fact == recordFact,
                  observed.names == schema2ColdRosterNames([Self.rosterName]) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try verifyAuthority()
            return
        }
        guard borrowsColdObservation,
              !coldRosterInFlight,
              !coldEffectUncertain,
              coldRosterPublication?.store === self,
              coldRosterPublication?.operation === operation,
              coldRosterPublication?.intentBytes
                == (try EraseIntentCodecV1.encode(intent)),
              coldRosterPublication?.preparationBytes
                == (try ErasePreparationCodecV2.encode(preparation)),
              coldOwnRosterFact == recordFact,
              coldOwnRosterBytes == canonicalBytes,
              !canonicalBytes.isEmpty else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try verifyAuthority()
        let controls = try requireSchema2ColdCanonicalControls(
            intent: intent,
            preparation: preparation,
            operation: operation)
        guard controls.names == schema2ColdRosterNames([Self.rosterName]),
              try readColdLeafIfPresent(Self.rosterNextName,
                maximumBytes: canonicalBytes.count) == nil,
              let leaf = try readColdLeafIfPresent(Self.rosterName,
                maximumBytes: canonicalBytes.count),
              leaf.data == canonicalBytes,
              leaf.identity.device == recordFact.device,
              leaf.identity.inode == recordFact.inode else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var named = stat()
        guard Darwin.fstatat(eraseDescriptor, Self.rosterName,
                &named, AT_SYMLINK_NOFOLLOW) == 0,
              EraseColdControlLeafFactV1(named) == recordFact,
              named.st_mode & S_IFMT == S_IFREG,
              named.st_nlink == 1 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try verifyAuthority()
    }

    @MainActor
    private func requireSchema2ColdRosterControls(
        receipt: Schema2ColdRosterPublicationV1,
        expectedNames: [String],
        expectedRoot: EraseColdControlLeafFactV1?
    ) throws -> EraseColdControlLeafFactV1 {
        guard coldRosterPublication === receipt,
              coldRosterInFlight,
              !coldEffectUncertain,
              coldActiveFD == nil,
              coldUncertainFDs.isEmpty else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var heldBefore = stat(), namedBefore = stat(),
            heldAfter = stat(), namedAfter = stat()
        guard Darwin.fstat(eraseDescriptor, &heldBefore) == 0,
              Darwin.fstatat(applicationSupportDescriptor,
                Self.directoryName, &namedBefore,
                AT_SYMLINK_NOFOLLOW) == 0,
              EraseColdControlLeafFactV1(heldBefore)
                == EraseColdControlLeafFactV1(namedBefore),
              expectedRoot == nil ||
                EraseColdControlLeafFactV1(heldBefore)
                    == expectedRoot,
              try coldNamesChecked() == expectedNames,
              let intent = try readColdLeafIfPresent(Self.intentName),
              let preparation = try readColdLeafIfPresent(
                Self.preparationName),
              intent.data == receipt.intentBytes,
              preparation.data == receipt.preparationBytes,
              try coldNamesChecked() == expectedNames,
              Darwin.fstat(eraseDescriptor, &heldAfter) == 0,
              Darwin.fstatat(applicationSupportDescriptor,
                Self.directoryName, &namedAfter,
                AT_SYMLINK_NOFOLLOW) == 0,
              EraseColdControlLeafFactV1(heldBefore)
                == EraseColdControlLeafFactV1(heldAfter),
              EraseColdControlLeafFactV1(heldAfter)
                == EraseColdControlLeafFactV1(namedAfter) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return EraseColdControlLeafFactV1(heldAfter)
    }

    deinit {
        // The retained cold observation owns these lent descriptors and its
        // checked close is the only release. Closing here could hit a reused
        // descriptor after that owner has already closed it.
        guard !borrowsColdObservation, !originalRecoveryCloseAttempted, !coldCloseAttempted else { return }
        _ = Darwin.close(eraseDescriptor)
        _ = Darwin.close(applicationSupportDescriptor)
    }

    /// The first-effect writer is constructed only under the original EX/G.
    /// Its two held descriptors and every transient are settled before the
    /// coordinator may transfer to target-writer installation.
    func closeCheckedForOriginalRecovery() throws {
        guard !borrowsColdObservation, let originalRecoveryCheckedIO,
              !originalRecoveryCloseAttempted else {
            throw EraseIntentStoreError.invalidAuthority
        }
        originalRecoveryCloseAttempted = true
        var failed = false
        if (try? originalRecoveryCheckedIO.requireSettled()) == nil
            || !originalRecoveryUncertainPolicyDescriptors.isEmpty { failed = true }
        for descriptor in [eraseDescriptor, applicationSupportDescriptor] {
            if Darwin.close(descriptor) != 0 {
                Self.uncertainOriginalRecoveryCloseLock.withLock {
                    Self.uncertainOriginalRecoveryDescriptors.append(descriptor)
                }
                failed = true
            }
        }
        guard !failed else { throw EraseIntentStoreError.invalidAuthority }
    }

    /// The operation-retained observer alone closes the lent root descriptors.
    /// A failed close is terminal and never retried by numeric descriptor.
    @MainActor
    func sealBorrowedColdAndCloseObserverChecked(
        operation: EraseColdPreparationOperationV1
    ) throws {
        try operation.requireSchema2ColdIntentStore(self)
        guard borrowsColdObservation, !coldCloseAttempted,
              coldActiveFD == nil, coldEnumerationFD == nil,
              coldDirectoryStream == nil, coldUncertainFDs.isEmpty,
              !coldUncertainStreamClose, coldOwnTemporaryName == nil,
              coldOwnPublishingName == nil,
              coldOwnPublishedIdentity == nil,
              coldDisplacedBytes == nil, coldDisplacedFact == nil,
              !coldEffectUncertain else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try verifyAuthority()
        _ = try readColdLeafIfPresent(Self.intentName)
        _ = try readColdLeafIfPresent(Self.preparationName)
        guard try readColdLeafIfPresent(Self.nextName) == nil,
              try readColdLeafIfPresent(Self.preparationNextName) == nil else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try verifyAuthority()
        coldCloseAttempted = true
        try operation.closeColdControlObservationChecked()
        coldClosed = true
    }

    /// The fixed retirement edge must never run load's pending-file repairs
    /// while the transferred registry exclusion is held.
    struct RetirementObservation {
        fileprivate let storeIdentity: ObjectIdentifier
        fileprivate let device: dev_t
        fileprivate let inode: ino_t
        fileprivate let fact: RetirementLeafFact
        fileprivate let data: Data
        let intent: EraseIntentV1
    }

    fileprivate struct RetirementLeafFact: Equatable {
        let device: dev_t, inode: ino_t, mode: mode_t, links: nlink_t
        let size: off_t
        let modifiedSeconds: Int64, modifiedNanoseconds: Int64
        let changedSeconds: Int64, changedNanoseconds: Int64
        init(_ value: stat) {
            device = value.st_dev; inode = value.st_ino
            mode = value.st_mode; links = value.st_nlink
            size = value.st_size
            modifiedSeconds = Int64(value.st_mtimespec.tv_sec)
            modifiedNanoseconds = Int64(value.st_mtimespec.tv_nsec)
            changedSeconds = Int64(value.st_ctimespec.tv_sec)
            changedNanoseconds = Int64(value.st_ctimespec.tv_nsec)
        }
    }

    private struct RetirementBoundWitness: Equatable {
        let fact: RetirementLeafFact
        let data: Data
    }

    private enum RetirementPolicyMode {
        case strict
        case pureObservation
        case authenticated(RetirementBoundWitness)
    }

    func captureRetirementObservation(expected: EraseIntentV1) throws
        -> RetirementObservation {
        guard expected.phase == .sessionActivated || expected.phase == .cleanupComplete,
              EraseIntentCodecV1.valid(expected) else {
            throw EraseIntentStoreError.invalidIntent
        }
        let leaf = try readRetirementCanonical(policy: .pureObservation)
        guard try decode(leaf.data) == expected else {
            throw EraseIntentStoreError.intentMismatch
        }
        let authenticated = try readRetirementCanonical(
            policy: .authenticated(RetirementBoundWitness(fact: leaf.fact, data: leaf.data)))
        guard authenticated.fact == leaf.fact,
              authenticated.data == leaf.data else {
            throw EraseIntentStoreError.intentMismatch
        }
        return RetirementObservation(storeIdentity: ObjectIdentifier(self),
            device: leaf.identity.device, inode: leaf.identity.inode,
            fact: leaf.fact, data: leaf.data, intent: expected)
    }

    func requireRetirementObservation(_ observation: RetirementObservation) throws {
        guard observation.storeIdentity == ObjectIdentifier(self) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let leaf = try readRetirementCanonical(
            policy: .authenticated(RetirementBoundWitness(fact: observation.fact, data: observation.data)))
        guard leaf.identity.device == observation.device,
              leaf.identity.inode == observation.inode,
              leaf.fact == observation.fact,
              leaf.data == observation.data,
              try decode(leaf.data) == observation.intent else {
            throw EraseIntentStoreError.intentMismatch
        }
    }

