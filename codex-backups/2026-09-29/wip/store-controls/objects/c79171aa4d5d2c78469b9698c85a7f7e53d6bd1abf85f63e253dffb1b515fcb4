    /// Opaque first P controls only. The cold Manifest and Registry must
    /// separately authenticate the recorded Data inode and source lineage
    /// under the same operation's EX/G before any replay effect.
    @MainActor
    func requireSchema2ColdObservedOriginalRetiredControls(
        intent: EraseIntentV1,
        preparation: ErasePreparationV2,
        operation: EraseColdPreparationOperationV1
    ) throws -> (records: [String: EraseColdExistingControlObservationV1
                    .OpaqueOriginalRetiredLeafV1],
                 eraseRoot: EraseColdControlLeafFactV1,
                 names: [String]) {
        try operation.requireSchema2ColdIntentStore(self)
        guard borrowsColdObservation,
              intent.schemaVersion == 2,
              intent.phase == .emptyGenerationPrepared,
              preparation.matches(intent),
              !coldCapturedOpaqueOriginalRetired.isEmpty,
              coldCapturedOpaqueOriginalRetired[
                Self.originalRetiredStageIdentityName] == nil ||
                coldCapturedOpaqueOriginalRetired[
                    Self.originalRetiredCommitmentName] != nil,
              !coldEffectUncertain,
              try load() == intent,
              try loadPreparation() == preparation else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try verifyAuthority()
        let firstRoot = try coldRootFact()
        let names = try coldNamesChecked()
        guard names == schema2ColdRosterNames() else {
            throw EraseIntentStoreError.invalidAuthority
        }
        for name in [Self.originalRetiredCommitmentName,
                     Self.originalRetiredCommitmentNextName,
                     Self.originalRetiredStageIdentityName,
                     Self.originalRetiredStageIdentityNextName] {
            let first = coldCapturedOpaqueOriginalRetired[name]
            guard names.contains(name) == (first != nil) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            guard let first else { continue }
            var before = stat(), after = stat()
            guard Darwin.fstatat(eraseDescriptor, name, &before,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(before) == first.fact,
                  try readColdOpaqueOriginalRetired(name,
                    expected: first),
                  Darwin.fstatat(eraseDescriptor, name, &after,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(after) == first.fact,
                  try observeBorrowedColdPolicy(
                    name.hasSuffix(".next")
                        ? .journalTemporary : .journal,
                    at: applicationSupportURL.appendingPathComponent(
                        policyRelativePath(name))) == first.policy else {
                throw EraseIntentStoreError.invalidAuthority
            }
        }
        try verifyAuthority()
        guard try coldRootFact() == firstRoot,
              try coldNamesChecked() == names else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return (coldCapturedOpaqueOriginalRetired, firstRoot, names)
    }

    /// Decode only the canonical first-held P records. A pending `.next`
    /// remains an opaque interruption cut; neither its bytes nor a matching
    /// deterministic name can establish the original writer's ownership.
    @MainActor
    func requireSchema2ColdSemanticOriginalRetiredControls(
        intent: EraseIntentV1,
        preparation: ErasePreparationV2,
        operation: EraseColdPreparationOperationV1
    ) throws -> (commitment: OriginalRecoveryRetiredCommitmentRecordV1,
                 stage: OriginalRecoveryRetiredStageIdentityRecordV1?,
                 first: [String: EraseColdExistingControlObservationV1
                    .OpaqueOriginalRetiredLeafV1],
                 root: EraseColdControlLeafFactV1,
                 names: [String]) {
        let cut = try requireSchema2ColdObservedOriginalRetiredControls(
            intent: intent, preparation: preparation,
            operation: operation)
        guard cut.records[Self.originalRetiredCommitmentNextName] == nil,
              cut.records[Self.originalRetiredStageIdentityNextName] == nil,
              let commitmentLeaf = cut.records[
                Self.originalRetiredCommitmentName],
              let firstIntent = coldExpectedIntentBytes,
              let firstPreparation = coldExpectedPreparationBytes,
              let firstIntentFact = coldExpectedIntentFact,
              let firstPreparationFact = coldExpectedPreparationFact,
              let auxiliaryBytes = coldCapturedOpaqueAuxiliaryRosterBytes,
              let auxiliaryFact = coldCapturedOpaqueAuxiliaryRosterFact,
              let auxiliaryPolicy = coldCapturedOpaqueAuxiliaryRosterPolicy,
              auxiliaryPolicy.state == .strictComplete,
              auxiliaryPolicy.backupExcluded == true,
              commitmentLeaf.policy?.state == .strictComplete,
              commitmentLeaf.policy?.backupExcluded == true,
              !coldCapturedOpaqueAuxiliaryRosterNextPresent else {
            throw EraseIntentStoreError.invalidAuthority
        }
        typealias Fact = OriginalRecoveryRetiredCommitmentRecordV1.Fact
        func full(_ value: EraseColdControlLeafFactV1) -> Fact {
            Fact(device: value.device, inode: value.inode,
                mode: value.mode, links: value.links,
                user: value.user, group: value.group,
                size: value.size,
                modifiedSeconds: value.modifiedSeconds,
                modifiedNanoseconds: value.modifiedNanoseconds,
                changedSeconds: value.changedSeconds,
                changedNanoseconds: value.changedNanoseconds)
        }
        let commitment = try OriginalRecoveryRetiredCommitmentRecordV1
            .decodeCanonical(commitmentLeaf.bytes)
        guard commitment.intentBytes == firstIntent,
              commitment.preparationBytes == firstPreparation,
              commitment.intentFact == full(firstIntentFact),
              commitment.preparationFact == full(firstPreparationFact),
              commitment.auxiliaryRosterBytes == auxiliaryBytes,
              commitment.auxiliaryRosterFact == full(auxiliaryFact),
              commitment.eraseID == intent.eraseID.uuidString.lowercased(),
              commitment.sourceGenerationID == intent.oldGenerationID
                .uuidString.lowercased(),
              commitment.targetGenerationID == intent.newGenerationID
                .uuidString.lowercased(),
              commitment.erase.device == Int64(cut.eraseRoot.device),
              commitment.erase.inode == UInt64(cut.eraseRoot.inode),
              commitment.erase.mode == UInt32(cut.eraseRoot.mode),
              commitment.erase.user == UInt32(cut.eraseRoot.user),
              commitment.erase.group == UInt32(cut.eraseRoot.group) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let stage: OriginalRecoveryRetiredStageIdentityRecordV1?
        if let stageLeaf = cut.records[Self.originalRetiredStageIdentityName] {
            guard stageLeaf.policy?.state == .strictComplete,
                  stageLeaf.policy?.backupExcluded == true else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let decoded = try OriginalRecoveryRetiredStageIdentityRecordV1
                .decodeCanonical(stageLeaf.bytes)
            guard decoded.eraseID == commitment.eraseID,
                  decoded.commitmentSHA256 ==
                    StoreMigrationCanonicalJSONV1.sha256(
                        commitmentLeaf.bytes),
                  decoded.commitmentFact == full(commitmentLeaf.fact),
                  decoded.firstDataFact == commitment.namespace.data,
                  decoded.firstDataChildren == [
                    .init(name: "current.json", kind: "regular",
                        fact: commitment.namespace.currentFact),
                    .init(name: "generations", kind: "directory",
                        fact: commitment.namespace.installedParent),
                    .init(name: "retired.json", kind: "regular",
                        fact: commitment.namespace.retiredFact)],
                  decoded.privateStageName == commitment.privateStageName,
                  decoded.canonicalTempName == commitment.canonicalTempName,
                  decoded.replacementSHA256 ==
                    commitment.replacementSHA256 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            stage = decoded
        } else {
            stage = nil
        }
        let after = try requireSchema2ColdObservedOriginalRetiredControls(
            intent: intent, preparation: preparation,
            operation: operation)
        guard after.records == cut.records,
              after.eraseRoot == cut.eraseRoot,
              after.names == cut.names else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return (commitment, stage, cut.records, cut.eraseRoot,
            cut.names)
    }

    /// Re-read the first opaque record or zero/prefix temporary without a
    /// policy setter. Failed or ambiguous close leaves this Store terminal.
    private func readColdOpaqueOriginalRetired(_ name: String,
        expected: EraseColdExistingControlObservationV1
            .OpaqueOriginalRetiredLeafV1) throws -> Bool {
        guard coldActiveFD == nil, coldUncertainFDs.isEmpty,
              !coldEffectUncertain else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let descriptor = Darwin.openat(eraseDescriptor, name,
            O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
        guard descriptor >= 0 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        coldActiveFD = descriptor
        do {
            var before = stat(), after = stat(), named = stat()
            guard Darwin.fstat(descriptor, &before) == 0,
                  EraseColdControlLeafFactV1(before) == expected.fact,
                  before.st_mode & S_IFMT == S_IFREG,
                  before.st_nlink == 1,
                  before.st_size >= 0,
                  before.st_size <= off_t(Self.maximumJournalBytes),
                  Darwin.lseek(descriptor, 0, SEEK_SET) == 0 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            var bytes = Data(count: Int(before.st_size))
            try bytes.withUnsafeMutableBytes { raw in
                var offset = 0
                while offset < raw.count {
                    let count = Darwin.read(descriptor,
                        raw.baseAddress!.advanced(by: offset),
                        raw.count - offset)
                    if count < 0 && errno == EINTR { continue }
                    guard count > 0 else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                    offset += count
                }
            }
            let kind: OwnedFileKindV1 = name.hasSuffix(".next")
                ? .journalTemporary : .journal
            let policy = try observeBorrowedColdPolicy(kind,
                at: applicationSupportURL.appendingPathComponent(
                    policyRelativePath(name)))
            guard bytes == expected.bytes,
                  policy == expected.policy,
                  Darwin.fstat(descriptor, &after) == 0,
                  Darwin.fstatat(eraseDescriptor, name, &named,
                    AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(after) == expected.fact,
                  EraseColdControlLeafFactV1(named) == expected.fact,
                  Darwin.close(descriptor) == 0 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            coldActiveFD = nil
            return true
        } catch {
            coldEffectUncertain = true
            throw error
        }
    }

