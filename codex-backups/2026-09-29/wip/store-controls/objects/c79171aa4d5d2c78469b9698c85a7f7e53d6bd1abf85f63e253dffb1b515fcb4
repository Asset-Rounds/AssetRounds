    private func opaqueContentSHA256(_ fd: Int32, parent: Int32, name: String) throws -> String {
        let before = try regular(fd)
        guard before.st_size >= 0,
              before.st_size <= off_t(EraseSchema2ColdCleanupGrammarV1.maximumControlBytes(name)),
              Darwin.lseek(fd, 0, SEEK_SET) == 0 else { throw EraseIntentStoreError.invalidAuthority }
        var hasher = SHA256(), consumed: off_t = 0
        var buffer = [UInt8](repeating: 0, count: 16 * 1_024)
        while true {
            let count = buffer.withUnsafeMutableBytes { Darwin.read(fd, $0.baseAddress, $0.count) }
            if count > 0 {
                guard off_t(count) <= before.st_size - consumed else { throw EraseIntentStoreError.invalidAuthority }
                hasher.update(data: Data(buffer.prefix(count))); consumed += off_t(count)
            } else if count == 0 { break }
            else if errno != EINTR { throw EraseIntentStoreError.invalidAuthority }
        }
        var named = stat()
        guard consumed == before.st_size,
              EraseColdControlLeafFactV1(try regular(fd)) == EraseColdControlLeafFactV1(before),
              Darwin.fstatat(parent, name, &named, AT_SYMLINK_NOFOLLOW) == 0,
              EraseColdControlLeafFactV1(named) == EraseColdControlLeafFactV1(before) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return hasher.finalize().map { String(format: "%02x", $0) }.joined()
    }

    private func requireClosedRawCleanupWitness(_ name: String, at erase: Int32, root: URL,
        first: OpaqueOriginalRetiredLeafV1) throws {
        guard let expectedSHA = first.contentSHA256, opaqueCleanupFDs[name] == nil else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let descriptor = Darwin.openat(erase, name, O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
        guard descriptor >= 0 else { throw EraseIntentStoreError.invalidAuthority }
        opaqueCleanupFDs[name] = descriptor
        do {
            var held = stat(), named = stat()
            guard Darwin.fstat(descriptor, &held) == 0,
                  Darwin.fstatat(erase, name, &named, AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(held) == first.fact,
                  EraseColdControlLeafFactV1(named) == first.fact,
                  try opaqueContentSHA256(descriptor, parent: erase, name: name) == expectedSHA,
                  try observeColdPolicy(name.hasSuffix(".next") ? .journalTemporary : .journal,
                    at: root.appendingPathComponent(name)) == first.policy else {
                throw EraseIntentStoreError.invalidAuthority
            }
            opaqueCleanupFDs.removeValue(forKey: name)
            guard Darwin.close(descriptor) == 0 else {
                uncertainFDs.append(descriptor); throw EraseIntentStoreError.invalidAuthority
            }
        } catch {
            if let retained = opaqueCleanupFDs.removeValue(forKey: name), Darwin.close(retained) != 0 {
                uncertainFDs.append(retained)
            }
            throw error
        }
    }

    private func opaqueBytes(_ fd: Int32, parent: Int32,
        name: String) throws -> Data {
        let before = try regular(fd)
        guard before.st_size >= 0,
              before.st_size <= off_t(EraseSchema2ColdCleanupGrammarV1.maximumControlBytes(name)),
              Darwin.lseek(fd, 0, SEEK_SET) == 0 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var bytes = Data(count: Int(before.st_size))
        try bytes.withUnsafeMutableBytes { raw in
            var offset = 0
            while offset < raw.count {
                let count = Darwin.read(fd,
                    raw.baseAddress!.advanced(by: offset),
                    raw.count - offset)
                if count < 0 && errno == EINTR { continue }
                guard count > 0 else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                offset += count
            }
        }
        var named = stat()
        guard EraseColdControlLeafFactV1(try regular(fd))
                == EraseColdControlLeafFactV1(before),
              Darwin.fstatat(parent, name, &named,
                  AT_SYMLINK_NOFOLLOW) == 0,
              EraseColdControlLeafFactV1(named)
                == EraseColdControlLeafFactV1(before) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return bytes
    }

