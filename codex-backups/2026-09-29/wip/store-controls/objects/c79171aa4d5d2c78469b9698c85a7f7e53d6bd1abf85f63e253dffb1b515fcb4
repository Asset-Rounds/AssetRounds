    private func openOpaqueOriginalRetired(_ name: String,
        at erase: Int32, root: URL) throws -> OpaqueOriginalRetiredLeafV1? {
        guard name == "original-retired-transition.json" ||
                name == ".original-retired-transition.json.next" ||
                name == "original-retired-stage-identity.json" ||
                name == ".original-retired-stage-identity.json.next" ||
                EraseSchema2ColdCleanupGrammarV1.isControlName(name),
              opaqueOriginalRetiredFDs[name] == nil, opaqueCleanupFDs[name] == nil else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let fd = Darwin.openat(erase, name,
            O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
        if fd < 0 {
            guard errno == ENOENT else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return nil
        }
        if EraseSchema2ColdCleanupGrammarV1.isControlName(name) { opaqueCleanupFDs[name] = fd }
        else { opaqueOriginalRetiredFDs[name] = fd }
        let held = try regular(fd)
        guard held.st_size >= 0,
              held.st_size <= off_t(EraseSchema2ColdCleanupGrammarV1.maximumControlBytes(name)),
              held.st_mode & 0o777 == 0o600,
              held.st_uid == Darwin.getuid(),
              held.st_gid == Darwin.getgid() else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let fact = EraseColdControlLeafFactV1(held)
        let isRaw = EraseSchema2ColdCleanupGrammarV1.isSourceName(name)
        let digest = isRaw ? try opaqueContentSHA256(fd, parent: erase, name: name) : nil
        let bytes = isRaw ? Data() : try opaqueBytes(fd, parent: erase, name: name)
        let policy = try observeColdPolicy(name.hasSuffix(".next")
            ? .journalTemporary : .journal,
            at: root.appendingPathComponent(name))
        var after = stat(), named = stat()
        guard policy.device == UInt64(held.st_dev),
              policy.inode == UInt64(held.st_ino),
              policy.linkCount == UInt64(held.st_nlink),
              policy.mode == UInt16(held.st_mode),
              Darwin.fstat(fd, &after) == 0,
              Darwin.fstatat(erase, name, &named,
                AT_SYMLINK_NOFOLLOW) == 0,
              EraseColdControlLeafFactV1(after) == fact,
              EraseColdControlLeafFactV1(named) == fact else {
            throw EraseIntentStoreError.invalidAuthority
        }
        if isRaw {
            // Retain the slot before IO, then clear BEFORE checked close.
            opaqueCleanupFDs.removeValue(forKey: name)
            if Darwin.close(fd) != 0 {
                uncertainFDs.append(fd); throw EraseIntentStoreError.invalidAuthority
            }
        }
        return OpaqueOriginalRetiredLeafV1(bytes: bytes, fact: fact,
