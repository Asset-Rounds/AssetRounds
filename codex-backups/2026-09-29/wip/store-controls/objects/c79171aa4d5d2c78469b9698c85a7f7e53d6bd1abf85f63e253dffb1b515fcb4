    private func createLeaf(_ name: String, data: Data) throws -> Identity {
        if let originalRecoveryCheckedIO {
            return try originalRecoveryCheckedIO.withOpen(
                parent: eraseDescriptor, name: name,
                flags: O_WRONLY | O_CREAT | O_EXCL,
                mode: mode_t(0o600)) { descriptor in
                let expected = try Self.fileIdentity(descriptor)
                do {
                    try applyTemporaryPolicy(.journalTemporary,
                        name: name, descriptor: descriptor)
                    try data.withUnsafeBytes { raw in
                        guard let base = raw.baseAddress else { return }
                        var offset = 0
                        while offset < raw.count {
                            let count = Darwin.write(descriptor,
                                base.advanced(by: offset), raw.count - offset)
                            if count > 0 { offset += count }
                            else if errno != EINTR {
                                throw EraseIntentStoreError.writeFailed
                            }
                        }
                    }
                    guard Darwin.fsync(descriptor) == 0,
                          let written = try readIfPresent(name),
                          written.identity == expected,
                          written.data == data else {
                        throw EraseIntentStoreError.writeFailed
                    }
                    return expected
