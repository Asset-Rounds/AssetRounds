            supportDevice == prior.supportDevice
                && supportInode == prior.supportInode
                && supportFact == prior.supportFact
                && supportOwnership == prior.supportOwnership
                && supportNames == prior.supportNames
                && eraseFact == prior.eraseFact
                && eraseOwnership == prior.eraseOwnership
                && eraseNames == prior.eraseNames
                && leaves.count == prior.leaves.count
                && zip(leaves, prior.leaves).allSatisfy { pair in
                    pair.0.name == pair.1.name
                        && pair.0.fact == pair.1.fact
                        && pair.0.ownership == pair.1.ownership
                        && pair.0.data == pair.1.data
                }
                && intent == prior.intent
                && preparation == prior.preparation
        }

