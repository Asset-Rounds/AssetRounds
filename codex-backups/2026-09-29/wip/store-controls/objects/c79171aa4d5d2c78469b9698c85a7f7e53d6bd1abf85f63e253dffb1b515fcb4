                      !names.contains(preparationNextName) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                func readLeaf(_ name: String) throws -> OriginalRecoveryObservation.Leaf? {
                    let maximumBytes =
                        (name == auxiliaryRosterName ||
                         name == originalRetiredCommitmentName ||
                         name == originalRetiredStageIdentityName)
                        ? maximumJournalBytes * 3 : 1_048_576
                    var named = stat()
                    if Darwin.fstatat(eraseFD, name, &named,
                                      AT_SYMLINK_NOFOLLOW) != 0 {
                        guard errno == ENOENT, !names.contains(name) else {
                            throw EraseIntentStoreError.invalidAuthority
                        }
                        return nil
                    }
                    guard names.contains(name) else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                    return try io.withOpen(parent: eraseFD, name: name,
                                           flags: O_RDONLY | O_NONBLOCK) { fileFD in
                        var before = stat(), after = stat(), namedAfter = stat()
                        guard Darwin.fstat(fileFD, &before) == 0,
                              RetirementLeafFact(before) == RetirementLeafFact(named),
                              OriginalRecoveryObservation.Ownership(before)
                                == OriginalRecoveryObservation.Ownership(named),
                              before.st_mode & S_IFMT == S_IFREG,
                              before.st_nlink == 1,
                              before.st_size >= 0,
                              before.st_size <= off_t(maximumBytes) else {
                            throw EraseIntentStoreError.invalidAuthority
                        }
                        var data = Data()
                        var buffer = [UInt8](repeating: 0, count: 16 * 1024)
                        while true {
                            let count = buffer.withUnsafeMutableBytes {
                                Darwin.read(fileFD, $0.baseAddress, $0.count)
                            }
                            if count > 0 {
                                guard data.count <= maximumBytes - count else {
                                    throw EraseIntentStoreError.invalidAuthority
                                }
                                data.append(contentsOf: buffer.prefix(count))
                            } else if count == 0 { break }
                            else if errno != EINTR {
                                throw EraseIntentStoreError.invalidAuthority
                            }
                        }
                        guard Darwin.fstat(fileFD, &after) == 0,
                              Darwin.fstatat(eraseFD, name, &namedAfter,
                                             AT_SYMLINK_NOFOLLOW) == 0,
                              RetirementLeafFact(before) == RetirementLeafFact(after),
                              RetirementLeafFact(before) == RetirementLeafFact(namedAfter),
                              OriginalRecoveryObservation.Ownership(before)
                                == OriginalRecoveryObservation.Ownership(after),
                              OriginalRecoveryObservation.Ownership(before)
                                == OriginalRecoveryObservation.Ownership(namedAfter),
                              data.count == Int(before.st_size) else {
                            throw EraseIntentStoreError.invalidAuthority
                        }
                        let policy = try ProtectedFilePolicyV1
                            .observeTemporalPolicyWithCheckedClose(
                                .journal, at: eraseURL.appendingPathComponent(name),
                                retainUncertainDescriptor: retainUncertainDescriptor)
                        var policyHeld = stat(), policyNamed = stat()
                        guard Darwin.fstat(fileFD, &policyHeld) == 0,
                              Darwin.fstatat(eraseFD, name, &policyNamed,
                                  AT_SYMLINK_NOFOLLOW) == 0,
                              RetirementLeafFact(policyHeld) == RetirementLeafFact(before),
                              RetirementLeafFact(policyNamed) == RetirementLeafFact(before),
                              OriginalRecoveryObservation.Ownership(policyHeld)
                                == OriginalRecoveryObservation.Ownership(before),
                              OriginalRecoveryObservation.Ownership(policyNamed)
                                == OriginalRecoveryObservation.Ownership(before),
                              try io.names(in: eraseFD) == names,
                              policy.device == UInt64(before.st_dev),
                              policy.inode == UInt64(before.st_ino),
                              policy.linkCount == UInt64(before.st_nlink),
                              policy.mode == UInt16(before.st_mode) else {
                            throw EraseIntentStoreError.invalidAuthority
                        }
                        return OriginalRecoveryObservation.Leaf(
                            name: name, fact: RetirementLeafFact(before),
                            ownership: OriginalRecoveryObservation.Ownership(before),
                            data: data, policy: policy)
                    }
                }
                let intentLeaf = try readLeaf(intentName)
                let preparationLeaf = try readLeaf(preparationName)
                let auxiliaryLeaf = try readLeaf(auxiliaryRosterName)
                let commitmentLeaf = try readLeaf(
                    originalRetiredCommitmentName)
                let stageIdentityLeaf = try readLeaf(
                    originalRetiredStageIdentityName)
                if let commitmentLeaf {
                    _ = try OriginalRecoveryRetiredCommitmentRecordV1
                        .decodeCanonical(commitmentLeaf.data)
                }
                if let stageIdentityLeaf {
                    guard commitmentLeaf != nil else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                    _ = try OriginalRecoveryRetiredStageIdentityRecordV1
                        .decodeCanonical(stageIdentityLeaf.data)
                }
                let intent = try intentLeaf.map { try EraseIntentCodecV1.decode($0.data) }
                let preparation = try preparationLeaf.map {
                    try ErasePreparationCodecV2.decode($0.data)
                }
                var namedEraseAfter = stat(), supportAfter = stat(),
                    namedSupportAfter = stat()
                guard Darwin.fstatat(supportFD, directoryName,
                                      &namedEraseAfter, AT_SYMLINK_NOFOLLOW) == 0,
                      Darwin.fstat(supportFD, &supportAfter) == 0,
                      Darwin.lstat(applicationSupportURL.path,
                          &namedSupportAfter) == 0,
                      RetirementLeafFact(namedEraseAfter) == eraseFact,
                      RetirementLeafFact(supportAfter) == supportFact,
                      RetirementLeafFact(namedSupportAfter) == supportFact,
                      OriginalRecoveryObservation.Ownership(namedEraseAfter)
                        == eraseOwnership,
                      OriginalRecoveryObservation.Ownership(supportAfter)
                        == supportOwnership,
                      OriginalRecoveryObservation.Ownership(namedSupportAfter)
                        == supportOwnership,
                      try io.names(in: eraseFD) == names,
                      try io.names(in: supportFD) == supportNames else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                let observation = OriginalRecoveryObservation(
                    supportDevice: Int64(heldSupport.st_dev),
                    supportInode: UInt64(heldSupport.st_ino),
                    supportFact: supportFact,
                    supportOwnership: supportOwnership,
                    supportNames: supportNames,
                    eraseFact: eraseFact, eraseOwnership: eraseOwnership,
                    erasePolicy: erasePolicy,
                    eraseNames: names,
                    leaves: [intentLeaf, preparationLeaf,
                        auxiliaryLeaf, commitmentLeaf,
                        stageIdentityLeaf].compactMap { $0 }
                        .sorted { $0.name < $1.name },
                    intent: intent, preparation: preparation)
                if stageIdentityLeaf != nil {
                    guard try observation.observedOriginalRetiredStageIdentity()
                        != nil else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                }
                return observation
            }
        }
        try io.requireSettled()
        return result
    }

    /// The first scan above is observation-only. Once the original owner has
    /// authenticated its P intent, preparation, private source and external
    /// controls, this exact G-held permit may request complete protection on
    /// the three first-captured Erase controls. Each request is bound to the
    /// same full physical facts and bytes; only its policy observation may be
    /// projected, and a raw pending observation is never effect authority.
    @MainActor
    static func completeOriginalRecoveryObservedPoliciesForFirstEffect(
        support: StoreTemporalPhysicalRootExclusionV1,
        applicationSupportURL: URL,
        io: EraseAbortCheckedSnapshotIOV1,
        expected: OriginalRecoveryObservation,
        permit: OriginalEraseRecoveryFirstEffectPermitV1,
        retainUncertainDescriptor: (Int32) -> Void
    ) throws -> OriginalRecoveryObservation {
        try permit.requireHeld()
        try io.requireSettled()
        guard expected.intent?.phase == .emptyGenerationPrepared,
              expected.eraseFact != nil,
              expected.erasePolicy != nil,
              expected.eraseNames.contains(intentName),
              Set(expected.eraseNames).isSubset(of: [intentName,
                  preparationName, auxiliaryRosterName,
                  originalRetiredCommitmentName,
                  originalRetiredStageIdentityName]),
              expected.eraseNames.contains(preparationName)
                == (expected.preparation != nil),
              expected.leaves.map(\.name) == expected.eraseNames else {
            throw EraseIntentStoreError.invalidAuthority
        }
        func read() throws -> OriginalRecoveryObservation {
            try observeOriginalRecoveryNoCreate(
                support: support, applicationSupportURL: applicationSupportURL,
                io: io, retainUncertainDescriptor: retainUncertainDescriptor)
        }
        var projected = expected
        guard try read() == expected else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let eraseURL = applicationSupportURL.appendingPathComponent(directoryName)
        let leafTargets: [(String?, OwnedFileKindV1, URL)] =
            expected.eraseNames.map { name in
                (name, OwnedFileKindV1.journal,
                 eraseURL.appendingPathComponent(name))
            }
        let targets: [(String?, OwnedFileKindV1, URL)] =
            [(nil, .stagingDirectory, eraseURL)] + leafTargets
        for (name, kind, url) in targets {
            try permit.requireHeld()
            guard try read() == projected else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let disposition = try ProtectedFilePolicyV1
                .verifyEraseColdTemporalPolicyWithCheckedRequest(
                    kind, at: url,
                    retainUncertainDescriptor: retainUncertainDescriptor,
                    unchangedWitness: {
                        let observed = try read()
                        guard observed.samePhysicalNamespace(as: expected) else {
                            throw EraseIntentStoreError.invalidAuthority
                        }
                        return true
                    })
            let after = try read()
            guard after.samePhysicalNamespace(as: expected),
                  after.supportFact == projected.supportFact,
                  after.supportNames == projected.supportNames,
                  after.eraseNames == projected.eraseNames else {
                throw EraseIntentStoreError.invalidAuthority
            }
            if let name {
                guard after.erasePolicy == projected.erasePolicy,
                      after.leaves.count == projected.leaves.count else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                for (old, updated) in zip(projected.leaves, after.leaves)
                    where old.name != name {
                    guard old == updated else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                }
                guard let updated = after.leaves.first(where: { $0.name == name }),
                      updated.policy.state ==
                        (disposition == .verifiedComplete
                            ? .strictComplete : .pendingSimulatorRequest) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
            } else {
                guard after.leaves == projected.leaves,
                      after.erasePolicy?.state ==
                        (disposition == .verifiedComplete
                            ? .strictComplete : .pendingSimulatorRequest) else {
                    throw EraseIntentStoreError.invalidAuthority
                }
            }
            projected = after
        }
        try permit.requireHeld()
        try io.requireSettled()
        guard try read() == projected else {
            throw EraseIntentStoreError.invalidAuthority
        }
        return projected
    }
}
