    /// The retained cold operation supplies its existing Support EX and
    /// Registry G interval. No creating Registry constructor is legal here.
    /// The same typed operation owns the borrowed Erase-root descriptors and
    /// the one-way result of this canonical phase CAS.
    @MainActor
    func requireSchema2ColdPhaseCASCut(
        expected: EraseIntentV1,
        replacement: EraseIntentV1,
        operation: EraseColdPreparationOperationV1
    ) throws -> Schema2ColdPhaseCASCutV1 {
        try operation.requireSchema2ColdIntentStore(self)
        guard borrowsColdObservation, !coldEffectUncertain,
              !coldCloseAttempted, !coldClosed,
              expected.schemaVersion == 2,
              expected.phase == .pointerSwitched,
              replacement == expected.advancing(to: .sessionActivated) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try verifyAuthority()
        let expectedData = try encode(expected)
        let replacementData = try encode(replacement)
        let current = try load()
        if current == expected {
            let nextIsPrefix = coldCapturedOpaqueNextBytes.map {
                replacementData.starts(with: $0)
            } ?? true
            guard coldExpectedIntentBytes == expectedData,
                  nextIsPrefix,
                  (coldCapturedOpaqueNextBytes == nil)
                    == (coldCapturedOpaqueNextFact == nil) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return .pending(nextBytes: coldCapturedOpaqueNextBytes,
                nextFact: coldCapturedOpaqueNextFact)
        }
        if current == replacement {
            guard coldExpectedIntentBytes == replacementData,
                  coldCapturedOpaqueNextBytes == nil ||
                    coldCapturedOpaqueNextBytes == expectedData,
                  (coldCapturedOpaqueNextBytes == nil)
                    == (coldCapturedOpaqueNextFact == nil) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            return .published(
                displacedBytes: coldCapturedOpaqueNextBytes,
                displacedFact: coldCapturedOpaqueNextFact)
        }
        throw EraseIntentStoreError.invalidAuthority
    }

    @MainActor
    func replaceSchema2ColdPointerPhase(
        expected: EraseIntentV1,
        with replacement: EraseIntentV1,
        operation: EraseColdPreparationOperationV1
    ) throws {
        guard borrowsColdObservation,
              expected.schemaVersion == 2,
              expected.phase == .pointerSwitched,
              replacement == expected.advancing(to: .sessionActivated),
              !coldEffectUncertain, !coldCloseAttempted, !coldClosed else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try operation.requireSchema2ColdIntentStore(self)
        let firstCut = try requireSchema2ColdPhaseCASCut(
            expected: expected, replacement: replacement,
            operation: operation)
        var enteredCanonicalCAS = false
        do {
            try operation.withSchema2ColdPointerPhaseMutation(
                expected: expected, replacement: replacement, store: self) {
                guard try self.requireSchema2ColdPhaseCASCut(
                    expected: expected, replacement: replacement,
                    operation: operation) == firstCut else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                enteredCanonicalCAS = true
                switch firstCut {
                case .pending:
                    if self.coldCapturedOpaqueNextBytes != nil {
                        try self.removeCapturedOpaqueNextForColdCAS()
                    }
                    try self.replaceWithoutMigrationReservation(
                        expected: expected, with: replacement)
                case .published:
                    if self.coldCapturedOpaqueNextBytes != nil {
                        try self.removeCapturedOpaqueNextForColdCAS()
                    }
                }
            }
            guard try load() == replacement,
                  coldCapturedOpaqueNextBytes == nil else {
                throw EraseIntentStoreError.intentMismatch
            }
        } catch {
            // Once the canonical writer entered, a failed postproof or close
            // cannot permit a second CAS on the same borrowed owner.
            if enteredCanonicalCAS { coldEffectUncertain = true }
            throw error
        }
    }

    /// A first authenticated R entry can retain a displaced exact P leaf.
    /// It never reruns the phase CAS: the operation's checked R owner holds
    /// EX/G and permits only this captured temporary's one-way removal.
    @MainActor
    func settleSchema2ColdActivatedEntryTemporary(
        pending: EraseIntentV1,
        published: EraseIntentV1,
        operation: EraseColdPreparationOperationV1
    ) throws {
        guard borrowsColdObservation,
              pending.schemaVersion == 2,
              pending.phase == .pointerSwitched,
              published == pending.advancing(to: .sessionActivated),
              !coldEffectUncertain, !coldCloseAttempted, !coldClosed else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try operation.requireSchema2ColdIntentStore(self)
        let firstCut = try requireSchema2ColdPhaseCASCut(
            expected: pending, replacement: published,
            operation: operation)
        guard case .published = firstCut else {
            throw EraseIntentStoreError.invalidAuthority
        }
        var entered = false
        do {
            try operation.withSchema2ColdActivatedEntryTempCleanup(
                pending: pending, published: published, store: self) {
                guard try self.requireSchema2ColdPhaseCASCut(
                    expected: pending, replacement: published,
                    operation: operation) == firstCut else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                entered = true
                if self.coldCapturedOpaqueNextBytes != nil {
                    try self.removeCapturedOpaqueNextForColdCAS()
                }
            }
            guard try load() == published,
                  coldCapturedOpaqueNextBytes == nil else {
                throw EraseIntentStoreError.intentMismatch
            }
        } catch {
            if entered { coldEffectUncertain = true }
            throw error
        }
    }

    /// Remove only the exact old interrupted leaf after the Router has
    /// rechecked this cut under the same physical EX and Registry G. A
    /// pending Simulator shape receives its own checked complete request on
    /// this exact held/named leaf before unlink; the request cannot rebase
    /// bytes, inode or metadata. No pathname-only cleanup is used.
    private func removeCapturedOpaqueNextForColdCAS() throws {
        guard borrowsColdObservation,
              let expected = coldCapturedOpaqueNextBytes,
              let fact = coldCapturedOpaqueNextFact,
              coldActiveFD == nil, coldUncertainFDs.isEmpty else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try requireCapturedOpaqueNextNoRepair()
        let url = applicationSupportURL.appendingPathComponent(
            policyRelativePath(Self.nextName))
        try ProtectedFilePolicyV1.verifyEraseColdTemporalPolicyWithCheckedRequest(
            .journalTemporary, at: url,
            retainUncertainDescriptor: { uncertain in
                self.coldUncertainFDs.append(uncertain)
            }, unchangedWitness: {
                try self.requireCapturedOpaqueNextNoRepair()
                return fact
            })
        try requireCapturedOpaqueNextNoRepair()
        let fd = Darwin.openat(eraseDescriptor, Self.nextName,
            O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
        guard fd >= 0 else { throw EraseIntentStoreError.invalidAuthority }
        coldActiveFD = fd
        do {
            var held = stat(), named = stat()
            guard Darwin.fstat(fd, &held) == 0,
                  Darwin.fstatat(eraseDescriptor, Self.nextName,
                      &named, AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(held) == fact,
                  EraseColdControlLeafFactV1(named) == fact,
                  Darwin.lseek(fd, 0, SEEK_SET) == 0 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            var bytes = Data()
            var buffer = [UInt8](repeating: 0, count: 16 * 1024)
            while true {
                let count = buffer.withUnsafeMutableBytes {
                    Darwin.read(fd, $0.baseAddress, $0.count)
                }
                if count > 0 { bytes.append(contentsOf: buffer.prefix(count)) }
                else if count == 0 { break }
                else if errno != EINTR {
                    throw EraseIntentStoreError.invalidAuthority
                }
            }
            guard bytes == expected,
                  Darwin.fstat(fd, &held) == 0,
                  Darwin.fstatat(eraseDescriptor, Self.nextName,
                      &named, AT_SYMLINK_NOFOLLOW) == 0,
                  EraseColdControlLeafFactV1(held) == fact,
                  EraseColdControlLeafFactV1(named) == fact,
                  Darwin.unlinkat(eraseDescriptor, Self.nextName, 0) == 0,
                  Darwin.fsync(eraseDescriptor) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            var absent = stat()
            guard Darwin.fstat(fd, &held) == 0,
                  held.st_dev == fact.device,
                  held.st_ino == fact.inode,
                  held.st_nlink == 0,
                  Darwin.fstatat(eraseDescriptor, Self.nextName,
                      &absent, AT_SYMLINK_NOFOLLOW) != 0,
                  errno == ENOENT else {
                throw EraseIntentStoreError.writeFailed
            }
            try closeColdActiveChecked()
            coldCapturedOpaqueNextBytes = nil
            coldCapturedOpaqueNextFact = nil
        } catch {
            let failure = error
            if coldActiveFD != nil { try closeColdActiveChecked() }
            coldEffectUncertain = true
            throw failure
        }
    }

    /// The V949 original ticket already owns its Registry G and Support EX.
    /// Reuse the incumbent exact phase CAS without constructing a second
    /// Registry or admitting a producer between sealed-source proof and effect.
    @MainActor
    func replaceForOriginalRecoveryFirstEffect(
        expected: EraseIntentV1,
        with replacement: EraseIntentV1,
        permit: OriginalEraseRecoveryFirstEffectPermitV1,
        support: StoreTemporalPhysicalRootExclusionV1,
        firstObservation: OriginalRecoveryObservation
    ) throws -> OriginalRecoveryFirstPointerCASReceiptV1 {
        guard let originalRecoveryCheckedIO,
              expected.schemaVersion == 2,
              expected.phase == .emptyGenerationPrepared,
              firstObservation.intent == expected,
              replacement == expected.advancing(to: .pointerSwitched) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try permit.requireHeld()
        let retain: (Int32) -> Void = { [self] in
            retainOriginalRecoveryUncertainDescriptor($0)
        }
        let before = try Self.observeOriginalRecoveryNoCreate(
            support: support, applicationSupportURL: applicationSupportURL,
            io: originalRecoveryCheckedIO,
            retainUncertainDescriptor: retain)
        guard before == firstObservation else {
            throw EraseIntentStoreError.invalidAuthority
        }
        // The following concrete Store effect creates the reserved temp,
        // swaps it with the canonical intent, fsyncs the held Erase parent,
        // verifies both leaves, removes the displaced temp, and reproves
        // authority. Only its exact completed postimage may project the
        // Erase parent's size/mtime/ctime.
        try replaceWithoutMigrationReservation(
            expected: expected, with: replacement)
        try permit.requireHeld()
        let after = try Self.observeOriginalRecoveryNoCreate(
            support: support, applicationSupportURL: applicationSupportURL,
            io: originalRecoveryCheckedIO,
            retainUncertainDescriptor: retain)
        guard after.intent == replacement,
              after.sameOwnedFirstCASNonIntentNamespace(as: before),
              after.eraseNames == before.eraseNames else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try originalRecoveryCheckedIO.requireSettled()
        return OriginalRecoveryFirstPointerCASReceiptV1(
            store: self, before: before, after: after)
    }

    /// Fixed Erase completion boundary after the original registry namespace
    /// has been retired. The actual support EX and exact operation proof take
    /// the place of creating a new registry; canonical CAS remains unchanged.
    @MainActor
    func replaceAfterRegistryRetirement(
