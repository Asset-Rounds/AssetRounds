    @MainActor
    func removeSchema2ColdCleanupControlsAfterCompletion(expected: EraseIntentV1,
        progress: EraseSchema2ColdCleanupProgressV1,
        terminal: EraseSchema2ColdCleanupTerminalObservationV1, ordinal: Int,
        retirement: EraseSchema2ColdTerminalAuthorityV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws {
        defer { coldCleanupPermit = nil; coldCleanupEffect = nil }
        let order = terminal.value.deletionOrder
        guard ordinal >= 0, ordinal <= order.count,
              terminal.value.progress == progress,
              terminal.value.cleanupIntentBytes == (try EraseIntentCodecV1.encode(expected)),
              expected.phase == .cleanupComplete else { throw EraseIntentStoreError.invalidAuthority }
        let terminalLeaf = EraseSchema2ColdCleanupTerminalV1.Leaf(
            name: EraseSchema2ColdCleanupGrammarV1.terminalName,
            fullFact: EraseSchema2ColdCleanupGrammarV1.fullFact(terminal.fact),
            sha256: StoreMigrationCanonicalJSONV1.sha256(terminal.bytes), byteCount: terminal.bytes.count)
        let leaf = ordinal == order.count ? terminalLeaf : order[ordinal]
        try bindSchema2ColdCleanupEffect(EraseSchema2ColdCleanupCommitmentV1.makeEffect(
            kind: .removeTerminalControls,
            inputSHA256: [terminalLeaf.sha256, EraseSchema2ColdCleanupCommitmentV1.sha256(String(ordinal)),
                leaf.sha256, EraseSchema2ColdCleanupCommitmentV1.sha256(leaf.fullFact)],
            expectedCanonicalSHA256: leaf.sha256, path: leaf.name), permit: permit)
        try retirement.requireNamespaceAbsent()
        coldCleanupTerminalRetirement = retirement
        try beginSchema2ColdCleanupControlScope(permit)
        try retirement.requireCompletionControlRemoval(expected: expected)
        try requireSchema2ColdTerminalRoot(retirement)
        guard try requireSchema2ColdTerminalPrefix(terminal, permit: permit) == ordinal else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try retirement.requireTerminalControlRemoval(expected: expected,
            terminalSHA256: StoreMigrationCanonicalJSONV1.sha256(terminal.bytes), ordinal: ordinal)
        coldCleanupTerminalObservation = terminal
        coldCleanupTerminalRetirement = retirement
        coldCleanupTerminalRemovalStarted = true
        coldCleanupTerminalRemovalIndex = ordinal
        try requireSchema2ColdTerminalLeaf(leaf, permit: permit)
        guard let current = try readSchema2CleanupOpaqueLeaf(leaf.name,
                maximumBytes: max(1, leaf.byteCount)) else { throw EraseIntentStoreError.invalidAuthority }
        if ordinal == order.count {
            // All durable-data consumers have completed. Fence every legacy
            // access in memory BEFORE losing the final named authority.
            coldCleanupCompletionControlsRemoved = true
        }
        do {
            try removeSchema2CleanupLeafExact(leaf.name, expected: current, permit: permit)
            if leaf.name == Self.preparationName {
                coldExpectedPreparationBytes = nil; coldExpectedPreparationFact = nil
            } else if leaf.name == Self.intentName {
                coldExpectedIntentBytes = nil; coldExpectedIntentFact = nil
            } else if leaf.name == Self.auxiliaryRosterName {
                coldCapturedOpaqueAuxiliaryRosterBytes = nil
                coldCapturedOpaqueAuxiliaryRosterFact = nil
                coldProjectedAuxiliaryRosterFact = nil
            } else if leaf.name == Self.rosterName {
                coldOwnRosterFact = nil; coldOwnRosterBytes = nil
                coldCapturedOpaqueRosterPresent = false
            }
            coldCapturedOpaqueOriginalRetired.removeValue(forKey: leaf.name)
            coldCleanupTerminalRemovalIndex = ordinal + 1
            if ordinal < order.count {
                guard try requireSchema2ColdTerminalPrefix(terminal, permit: permit) == ordinal + 1 else {
                    throw EraseIntentStoreError.cleanupFailed
                }
            } else {
                guard try coldNamesChecked().isEmpty else { throw EraseIntentStoreError.cleanupFailed }
            }
            try retirement.requireCompletionControlRemoval(expected: expected)
            try requireSchema2ColdCleanupEffect(permit)
        } catch {
            coldEffectUncertain = true; permit.poisonOnUncertainEffect()
            throw error
        }
    }

