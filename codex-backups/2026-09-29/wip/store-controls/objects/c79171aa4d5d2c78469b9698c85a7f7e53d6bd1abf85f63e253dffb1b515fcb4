    func closeChecked() throws {
        guard opened, !closeAttempted else {
            throw EraseIntentStoreError.invalidAuthority
        }
        closeAttempted = true
        if let stream = directoryStream {
            directoryStream = nil
            if Darwin.closedir(stream) != 0 { uncertainStreamClose = true }
        }
        for keyPath in [\EraseColdExistingControlObservationV1.preparationFD,
                        \EraseColdExistingControlObservationV1.intentFD,
                        \EraseColdExistingControlObservationV1.opaqueIntentNextFD,
                        \EraseColdExistingControlObservationV1.opaqueAuxiliaryRosterFD,
                        \EraseColdExistingControlObservationV1.enumerationFD,
                        \EraseColdExistingControlObservationV1.eraseFD,
                        \EraseColdExistingControlObservationV1.supportFD] {
            if let fd = self[keyPath: keyPath] {
                self[keyPath: keyPath] = nil
                if Darwin.close(fd) != 0 { uncertainFDs.append(fd) }
            }
        }
        for name in opaqueOriginalRetiredFDs.keys.sorted() {
            guard let descriptor = opaqueOriginalRetiredFDs.removeValue(
                forKey: name) else { continue }
            if Darwin.close(descriptor) != 0 { uncertainFDs.append(descriptor) }
        }
        for name in opaqueCleanupFDs.keys.sorted() {
            guard let descriptor = opaqueCleanupFDs.removeValue(forKey: name) else { continue }
            if Darwin.close(descriptor) != 0 { uncertainFDs.append(descriptor) }
        }
        guard uncertainFDs.isEmpty, !uncertainStreamClose else {
            throw EraseIntentStoreError.invalidAuthority
        }
    }

    /// Every entry, including an unknown sidecar, denies no-work. Retain the
    /// independent enumeration descriptor before fdopendir or readdir can
    /// fail, and never retry an ambiguous closedir.
    private func namesChecked(in erase: Int32) throws -> [String] {
        guard enumerationFD == nil, directoryStream == nil,
              !uncertainStreamClose else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let duplicate = Darwin.openat(erase, ".",
            O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
        guard duplicate >= 0 else { throw EraseIntentStoreError.invalidAuthority }
        enumerationFD = duplicate
        guard same(try directory(erase), try directory(duplicate)) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        guard let stream = Darwin.fdopendir(duplicate) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        enumerationFD = nil
        directoryStream = stream
        var names: [String] = []
        errno = 0
        while let entry = Darwin.readdir(stream) {
            guard let name = OwnedStorageDirectoryEntryNameV1.decode(entry) else {
                throw EraseIntentStoreError.invalidAuthority
            }
            if name != "." && name != ".." { names.append(name) }
            errno = 0
        }
        guard errno == 0 else { throw EraseIntentStoreError.invalidAuthority }
        directoryStream = nil
        guard Darwin.closedir(stream) == 0 else {
            uncertainStreamClose = true
            throw EraseIntentStoreError.invalidAuthority
        }
        return names.sorted()
    }

