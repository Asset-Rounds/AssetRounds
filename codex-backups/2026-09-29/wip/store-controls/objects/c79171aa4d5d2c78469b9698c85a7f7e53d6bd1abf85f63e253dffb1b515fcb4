    @MainActor
    private func authenticateSchema2CleanupLeaf(_ name: String,
        expected: EraseColdExistingControlObservationV1.OpaqueOriginalRetiredLeafV1,
        permit: EraseSchema2ColdControlPermitV1, maximumBytes: Int
    ) throws -> EraseColdExistingControlObservationV1.OpaqueOriginalRetiredLeafV1 {
        try requireSchema2ColdCleanupEffect(permit)
        guard let before = try readSchema2CleanupOpaqueLeaf(name, maximumBytes: maximumBytes),
              before == expected else { throw EraseIntentStoreError.invalidAuthority }
        let kind: OwnedFileKindV1 = name.hasSuffix(".next") ? .journalTemporary : .journal
        let url = applicationSupportURL.appendingPathComponent(policyRelativePath(name))
        let disposition = try ProtectedFilePolicyV1.verifyEraseColdTemporalPolicyWithCheckedRequest(
            kind, at: url, retainUncertainDescriptor: {
                self.coldUncertainFDs.append($0); permit.poisonOnUncertainEffect()
            }, unchangedWitness: {
                try requireSchema2ColdCleanupEffect(permit)
                guard let current = try self.readSchema2CleanupOpaqueLeaf(name,
                    maximumBytes: maximumBytes), current == before else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                return before.fact
            })
        guard let after = try readSchema2CleanupOpaqueLeaf(name, maximumBytes: maximumBytes),
              after.bytes == before.bytes, after.fact == before.fact,
              after.policy?.state == .strictComplete ||
                (after.policy?.state == .pendingSimulatorRequest
                    && disposition == .simulatorFileProtectionUnsupported) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try requireSchema2ColdCleanupEffect(permit)
        coldCleanupProjectedLeaves[name] = after.retainingHashOnly
        return after
    }

    @MainActor
    private func requireSchema2CleanupLeaf(_ name: String, bytes: Data,
        fullFact: String?, maximumBytes: Int,
        permit: EraseSchema2ColdControlPermitV1
    ) throws -> EraseColdExistingControlObservationV1.OpaqueOriginalRetiredLeafV1 {
        try requireSchema2ColdCleanupEffect(permit)
        guard let leaf = try readSchema2CleanupOpaqueLeaf(name, maximumBytes: maximumBytes),
              leaf.bytes == bytes,
              fullFact.map({ EraseSchema2ColdCleanupGrammarV1.fullFact(leaf.fact) == $0 }) ?? true,
              let expected = coldCleanupProjectedLeaves[name], expected == leaf else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let authenticated = try authenticateSchema2CleanupLeaf(name, expected: leaf,
            permit: permit, maximumBytes: maximumBytes)
        try requireSchema2ColdCleanupEffect(permit)
        return authenticated
    }

    /// Sole incumbent O_EXCL writer, no-replace/swap publisher, checked
    /// policy requests, fsync, byte/fact readback and checked transient close.
    /// An interrupted zero/prefix/swap is classified against exact expected
    /// canonical and next bytes before any mutation; foreign cuts refuse.
    @MainActor
    private func publishSchema2CleanupLeaf(_ name: String,
        bytes: Data, expectedBytes: Data?, maximumBytes: Int,
        permit: EraseSchema2ColdControlPermitV1
    ) throws -> EraseColdExistingControlObservationV1.OpaqueOriginalRetiredLeafV1 {
        try beginSchema2ColdCleanupControlScope(permit)
        guard (EraseSchema2ColdCleanupGrammarV1.isCanonicalName(name) ||
                (name == Self.intentName && coldCleanupEffect?.kind == .replaceCleanupPhase)),
              bytes.count <= maximumBytes else { throw EraseIntentStoreError.invalidPreparation }
        let next = EraseSchema2ColdCleanupGrammarV1.temporaryName(name)
        // A concrete attempt exists before stat/open/policy/write. An
        // ambiguous effect retains it and poisons this owner permanently.
        coldCleanupControlAttempt = (name, expectedBytes, bytes)
        coldCleanupOwnBytes[name] = bytes
        coldCleanupOwnBytes[next] = bytes
        do {
            try requireSchema2ColdCleanupEffect(permit)
            let firstCanonical = try readSchema2CleanupOpaqueLeaf(name, maximumBytes: maximumBytes)
            let firstTemporary = try readSchema2CleanupOpaqueLeaf(next, maximumBytes: maximumBytes)
            if let firstCanonical, firstCanonical != coldCleanupProjectedLeaves[name] {
                throw EraseIntentStoreError.invalidAuthority
            }
            if let firstTemporary, firstTemporary != coldCleanupProjectedLeaves[next] {
                throw EraseIntentStoreError.invalidAuthority
            }
            if firstCanonical?.bytes == bytes {
                let canonical = try authenticateSchema2CleanupLeaf(name,
                    expected: firstCanonical!, permit: permit, maximumBytes: maximumBytes)
                if let temporary = firstTemporary {
                    // Only the displaced exact predecessor or a same-byte
                    // publication temp can survive an authenticated swap.
                    guard temporary.bytes == expectedBytes || temporary.bytes == bytes else {
                        throw EraseIntentStoreError.invalidAuthority
                    }
                    _ = try authenticateSchema2CleanupLeaf(next, expected: temporary,
                        permit: permit, maximumBytes: maximumBytes)
                    try removeSchema2CleanupLeafExact(next, expected: temporary,
                        permit: permit)
                }
                clearSchema2CleanupPublisherTransients()
                try requireSchema2ColdCleanupEffect(permit)
                return canonical
            }
            guard firstCanonical?.bytes == expectedBytes else {
                throw EraseIntentStoreError.intentMismatch
            }
            if let canonical = firstCanonical {
                _ = try authenticateSchema2CleanupLeaf(name, expected: canonical,
                    permit: permit, maximumBytes: maximumBytes)
            }
            var temporary = firstTemporary
            if let temporary, temporary.bytes != bytes {
                guard bytes.starts(with: temporary.bytes),
                      temporary.bytes.count < bytes.count else {
                    throw EraseIntentStoreError.invalidAuthority
                }
                _ = try authenticateSchema2CleanupLeaf(next, expected: temporary,
                    permit: permit, maximumBytes: maximumBytes)
                try removeSchema2CleanupLeafExact(next, expected: temporary, permit: permit)
                clearSchema2CleanupPublisherTransients(settled: false)
                self.coldCleanupOwnBytes[name] = bytes
                self.coldCleanupOwnBytes[next] = bytes
            }
            temporary = try readSchema2CleanupOpaqueLeaf(next, maximumBytes: maximumBytes)
            if temporary == nil {
                // This invokes the existing checked publisher's only writer.
                _ = try createColdLeaf(next, data: bytes, maximumBytes: maximumBytes)
                temporary = try readSchema2CleanupOpaqueLeaf(next, maximumBytes: maximumBytes)
            }
            guard let temporary, temporary.bytes == bytes,
                  try readSchema2CleanupOpaqueLeaf(name, maximumBytes: maximumBytes) == firstCanonical else {
                throw EraseIntentStoreError.invalidAuthority
            }
            _ = try authenticateSchema2CleanupLeaf(next, expected: temporary,
                permit: permit, maximumBytes: maximumBytes)
            try requireSchema2ColdCleanupEffect(permit)
            let flags = expectedBytes == nil ? UInt32(RENAME_EXCL) : UInt32(RENAME_SWAP)
            guard Darwin.renameatx_np(eraseDescriptor, next, eraseDescriptor, name, flags) == 0,
                  Darwin.fsync(eraseDescriptor) == 0 else {
                throw EraseIntentStoreError.writeFailed
            }
            coldOwnPublishingName = name
            coldOwnPublishedIdentity = Identity(device: temporary.fact.device,
                inode: temporary.fact.inode)
            guard let canonical = try readSchema2CleanupOpaqueLeaf(name, maximumBytes: maximumBytes),
                  canonical.bytes == bytes,
                  canonical.fact.device == temporary.fact.device,
                  canonical.fact.inode == temporary.fact.inode else {
                throw EraseIntentStoreError.writeFailed
            }
            coldCleanupProjectedLeaves[name] = canonical.retainingHashOnly
            if !borrowsColdObservation, name == Self.intentName {
                originalAuxiliaryProjectedIntentBytes = canonical.bytes
                originalAuxiliaryProjectedIntentFact = canonical.fact
            }
            try settleOriginalCleanupRootProjection()
            let authenticated = try authenticateSchema2CleanupLeaf(name, expected: canonical,
                permit: permit, maximumBytes: maximumBytes)
            if expectedBytes != nil {
                guard let displaced = try readSchema2CleanupOpaqueLeaf(next, maximumBytes: maximumBytes),
                      displaced.bytes == expectedBytes,
                      displaced.fact.device == firstCanonical?.fact.device,
                      displaced.fact.inode == firstCanonical?.fact.inode else {
                    throw EraseIntentStoreError.intentMismatch
                }
                coldCleanupProjectedLeaves[next] = displaced.retainingHashOnly
                try removeSchema2CleanupLeafExact(next, expected: displaced, permit: permit)
            } else {
                guard try readSchema2CleanupOpaqueLeaf(next, maximumBytes: maximumBytes) == nil else {
                    throw EraseIntentStoreError.writeFailed
                }
                coldCleanupProjectedLeaves.removeValue(forKey: next)
            }
            clearSchema2CleanupPublisherTransients()
            try requireSchema2ColdCleanupEffect(permit)
            return authenticated
        } catch {
            coldEffectUncertain = true
            permit.poisonOnUncertainEffect()
            throw error
        }
    }

    private func requireSchema2ColdCleanupPrimitiveEffect() throws {
        if let permit = coldCleanupPermit {
            try MainActor.assumeIsolated { try self.requireSchema2ColdCleanupEffect(permit) }
        }
    }
    private func clearSchema2CleanupPublisherTransients(settled: Bool = true) {
        if let attempt = coldCleanupControlAttempt {
            coldCleanupOwnBytes.removeValue(forKey: attempt.canonicalName)
            coldCleanupOwnBytes.removeValue(forKey: EraseSchema2ColdCleanupGrammarV1.temporaryName(attempt.canonicalName))
        }
        coldOwnTemporaryName = nil; coldOwnTemporaryIdentity = nil
        coldOwnTemporaryBytes = nil; coldOwnPublishingName = nil
        coldOwnPublishedIdentity = nil; coldPublishedVerified = false
        if settled { coldCleanupControlAttempt = nil }
    }

    @MainActor
    private func removeSchema2CleanupLeafExact(_ name: String,
        expected: EraseColdExistingControlObservationV1.OpaqueOriginalRetiredLeafV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws {
        try requireSchema2ColdCleanupEffect(permit)
        guard try readSchema2CleanupOpaqueLeaf(name,
                maximumBytes: max(1, expected.bytes.count)) == expected else {
            throw EraseIntentStoreError.invalidAuthority
        }
        try requireSchema2ColdCleanupEffect(permit)
        guard Darwin.unlinkat(eraseDescriptor, name, 0) == 0,
              Darwin.fsync(eraseDescriptor) == 0,
              try readSchema2CleanupOpaqueLeaf(name,
                maximumBytes: max(1, expected.bytes.count)) == nil else {
            throw EraseIntentStoreError.cleanupFailed
        }
        coldCleanupProjectedLeaves.removeValue(forKey: name)
        coldCleanupOwnBytes.removeValue(forKey: name)
        if coldCleanupControlAttempt != nil && !coldCleanupTerminalRemovalStarted {
            try settleOriginalCleanupRootProjection()
        }
        try requireSchema2ColdCleanupEffect(permit)
    }

    @MainActor
    private func requireSchema2CleanupLineage(_ sources: EraseSchema2ColdCleanupSourcesV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws {
        try requireSchema2ColdCleanupEffect(permit)
        guard let intent = try load(), intent.schemaVersion == 2,
              intent.eraseID.uuidString.lowercased() == sources.eraseID,
              let preparation = try loadPreparation(), preparation.matches(intent),
              StoreMigrationCanonicalJSONV1.sha256(try ErasePreparationCodecV2.encode(preparation))
                == sources.preparationSHA256,
              let rosterBytes = coldCapturedOpaqueAuxiliaryRosterBytes
                ?? originalAuxiliaryPublishedReceipt?.seal.canonicalBytes,
              StoreMigrationCanonicalJSONV1.sha256(rosterBytes)
                == sources.originalPAuxiliaryRosterSHA256 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let roster = try EraseSchema2ColdAuxiliaryPhysicalRosterV1.decodeCanonical(rosterBytes,
            intent: intent, preparation: preparation)
        guard roster.record.firstIntentPhase == EraseIntentPhaseV1.emptyGenerationPrepared.rawValue,
              roster.record.eraseID == sources.eraseID else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let originalNodes = roster.record.trees.first {
            $0.key == "support/FieldEvidenceOperations"
        }?.nodes ?? []
        for source in sources.sources {
            guard let node = originalNodes.first(where: { $0.path == source.path }),
                  node.kind == "file", node.sha256 == source.sha256 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            let full = source.fullFact.split(separator: "|", omittingEmptySubsequences: false)
            let projected = [full[0], full[1], full[2], full[5], full[6],
                full[7], full[8], full[9], full[10]].joined(separator: "|")
            guard node.fact == projected else { throw EraseIntentStoreError.invalidAuthority }
        }
        try requireSchema2ColdCleanupEffect(permit)
    }

    @MainActor
    func publishSchema2ColdCleanupSources(_ sources: EraseSchema2ColdCleanupSourcesV1,
        sourceBytes: [String: Data], planBytes: Data,
        permit: EraseSchema2ColdControlPermitV1
    ) throws -> EraseSchema2ColdCleanupSourcesReceiptV1 {
        defer { coldCleanupPermit = nil; coldCleanupEffect = nil }
        let declarationBytes = try EraseSchema2ColdCleanupGrammarV1.canonicalBytes(sources)
        try bindSchema2ColdCleanupEffect(EraseSchema2ColdCleanupCommitmentV1.makeEffect(
            kind: .publishSources,
            inputSHA256: [StoreMigrationCanonicalJSONV1.sha256(declarationBytes),
                sources.c16PlanSHA256, try EraseSchema2ColdCleanupCommitmentV1.sourceByteTableSHA256(sources)],
            path: EraseSchema2ColdCleanupGrammarV1.sourcesName), permit: permit)
        try beginSchema2ColdCleanupControlScope(permit)
        try sources.validate(requirePublished: false)
        guard Set(sourceBytes.keys) == Set(sources.sources.map(\.path)),
              sourceBytes.values.allSatisfy({ $0.count <= 1_024 * 1_024 * 1_024 }),
              planBytes.count <= OriginalEraseC16PlanV1.maximumEncodedBytes,
              StoreMigrationCanonicalJSONV1.sha256(planBytes) == sources.c16PlanSHA256 else {
            throw EraseIntentStoreError.invalidPreparation
        }
        let plan = try StoreMigrationCanonicalJSONV1.decodeCanonical(OriginalEraseC16PlanV1.self,
            from: planBytes)
        try plan.validate()
        try requireSchema2CleanupLineage(sources, permit: permit)
        let transfer = EraseSchema2ColdCleanupTransferV1(schemaVersion: 1, sources: sources)
        let transferBytes = try transfer.canonicalBytes()
        let bootstrapName = EraseSchema2ColdCleanupGrammarV1.transferName
        let bootstrapNext = EraseSchema2ColdCleanupGrammarV1.temporaryName(bootstrapName)
        let initialControlNames = try coldNamesChecked().filter(EraseSchema2ColdCleanupGrammarV1.isControlName)
        if let retainedBootstrap = coldCleanupProjectedLeaves[bootstrapName] {
            guard retainedBootstrap.bytes == transferBytes else {
                throw EraseIntentStoreError.invalidAuthority
            }
        } else {
            // An absent canonical bootstrap cannot explain any source/plan
            // leaf. Even a matching partial bootstrap temp cannot adopt one.
            let allowed = Set([bootstrapNext,
                EraseSchema2ColdCleanupGrammarV1.notificationName,
                EraseSchema2ColdCleanupGrammarV1.temporaryName(EraseSchema2ColdCleanupGrammarV1.notificationName)])
            guard initialControlNames.allSatisfy(allowed.contains) else {
                throw EraseIntentStoreError.invalidAuthority
            }
        }
        _ = try publishSchema2CleanupLeaf(EraseSchema2ColdCleanupGrammarV1.transferName,
            bytes: transferBytes, expectedBytes: nil,
            maximumBytes: EraseSchema2ColdCleanupGrammarV1.maximumEncodedBytes, permit: permit)
        let transferNames = Set(sources.sources.map(\.leafName) + [sources.c16PlanLeafName,
            EraseSchema2ColdCleanupGrammarV1.transferName, EraseSchema2ColdCleanupGrammarV1.sourcesName])
        let permittedExisting = Set(coldCleanupProjectedLeaves.keys.filter {
            $0 == EraseSchema2ColdCleanupGrammarV1.notificationName ||
            $0 == EraseSchema2ColdCleanupGrammarV1.temporaryName(EraseSchema2ColdCleanupGrammarV1.notificationName)
        })
        guard try coldNamesChecked().filter(EraseSchema2ColdCleanupGrammarV1.isControlName)
            .allSatisfy({ transferNames.contains(EraseSchema2ColdCleanupGrammarV1.canonicalName($0))
                || permittedExisting.contains($0) }) else { throw EraseIntentStoreError.invalidAuthority }
        var transferOrder: [String] = []
        for leafName in sources.sources.map(\.leafName) + [sources.c16PlanLeafName,
            EraseSchema2ColdCleanupGrammarV1.sourcesName] {
            if !transferOrder.contains(leafName) { transferOrder.append(leafName) }
        }
        let present = try coldNamesChecked().filter {
            transferOrder.contains(EraseSchema2ColdCleanupGrammarV1.canonicalName($0))
        }
        let canonicals = Set(present.filter { transferOrder.contains($0) })
        guard let count = (0...transferOrder.count).first(where: {
            canonicals == Set(transferOrder.prefix($0))
        }) else { throw EraseIntentStoreError.invalidAuthority }
        let activeNext = count < transferOrder.count
            ? EraseSchema2ColdCleanupGrammarV1.temporaryName(transferOrder[count]) : nil
        guard present.filter({ !transferOrder.contains($0) }).allSatisfy({ $0 == activeNext }) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        // No indexed-dependent effect is admitted until the complete index
        // below is durably published/read back. Prefix leaves remain bound
        // to this exact first-P transfer, never to a current survivor census.
        var published: [EraseSchema2ColdCleanupSourcesV1.Source] = []
        for source in sources.sources {
            guard let bytes = sourceBytes[source.path], bytes.count == source.byteCount,
                  StoreMigrationCanonicalJSONV1.sha256(bytes) == source.sha256 else {
                throw EraseIntentStoreError.invalidPreparation
            }
            let leaf = try publishSchema2CleanupLeaf(source.leafName, bytes: bytes,
                expectedBytes: nil, maximumBytes: source.maximumByteCount, permit: permit)
            published.append(source.published(fullFact:
                EraseSchema2ColdCleanupGrammarV1.fullFact(leaf.fact)))
        }
        let planLeaf = try publishSchema2CleanupLeaf(sources.c16PlanLeafName, bytes: planBytes,
            expectedBytes: nil, maximumBytes: OriginalEraseC16PlanV1.maximumEncodedBytes, permit: permit)
        let resolved = EraseSchema2ColdCleanupSourcesV1(schemaVersion: sources.schemaVersion,
            eraseID: sources.eraseID, preparationSHA256: sources.preparationSHA256,
            originalPAuxiliaryRosterSHA256: sources.originalPAuxiliaryRosterSHA256,
            targetPointerSHA256: sources.targetPointerSHA256,
            c16PlanLeafName: sources.c16PlanLeafName, c16PlanSHA256: sources.c16PlanSHA256,
            c16PlanFullFact: EraseSchema2ColdCleanupGrammarV1.fullFact(planLeaf.fact),
            sources: published)
        let bytes = try resolved.canonicalBytes()
        let index = try publishSchema2CleanupLeaf(EraseSchema2ColdCleanupGrammarV1.sourcesName,
            bytes: bytes, expectedBytes: nil,
            maximumBytes: EraseSchema2ColdCleanupGrammarV1.maximumEncodedBytes, permit: permit)
        let receipt = try EraseSchema2ColdCleanupSourcesReceiptV1(store: self, sources: resolved,
            indexFullFact: EraseSchema2ColdCleanupGrammarV1.fullFact(index.fact))
        coldCleanupSourcesReceipt = receipt
        try requireSchema2CleanupSourceIndex(receipt.sources, indexFullFact: receipt.indexFullFact, permit: permit)
        return receipt
    }

    @MainActor
    func requireSchema2ColdCleanupSources(_ receipt: EraseSchema2ColdCleanupSourcesReceiptV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws -> EraseSchema2ColdCleanupSourcesV1 {
        defer { coldCleanupPermit = nil; coldCleanupEffect = nil }
        try bindSchema2ColdCleanupEffect(EraseSchema2ColdCleanupCommitmentV1.makeEffect(
            kind: .requireSources, inputSHA256: [receipt.indexSHA256],
            path: EraseSchema2ColdCleanupGrammarV1.sourcesName), permit: permit)
        try beginSchema2ColdCleanupControlScope(permit)
        guard receipt.store === self else { throw EraseIntentStoreError.invalidAuthority }
        try requireSchema2CleanupSourceIndex(receipt.sources, indexFullFact: receipt.indexFullFact,
            permit: permit)
        try requireSchema2ColdCleanupEffect(permit)
        return receipt.sources
    }

    @MainActor
    private func requireSchema2CleanupSourceIndex(_ sources: EraseSchema2ColdCleanupSourcesV1,
        indexFullFact: String?, permit: EraseSchema2ColdControlPermitV1
    ) throws {
        try sources.validate()
        let declaration = EraseSchema2ColdCleanupSourcesV1(schemaVersion: sources.schemaVersion,
            eraseID: sources.eraseID, preparationSHA256: sources.preparationSHA256,
            originalPAuxiliaryRosterSHA256: sources.originalPAuxiliaryRosterSHA256,
            targetPointerSHA256: sources.targetPointerSHA256,
            c16PlanLeafName: sources.c16PlanLeafName, c16PlanSHA256: sources.c16PlanSHA256,
            c16PlanFullFact: nil, sources: sources.sources.map {
                .init(path: $0.path, fullFact: $0.fullFact, sha256: $0.sha256,
                    byteCount: $0.byteCount, maximumByteCount: $0.maximumByteCount,
                    leafName: $0.leafName, leafFullFact: nil)
            })
        let bootstrap = try EraseSchema2ColdCleanupTransferV1(schemaVersion: 1,
            sources: declaration).canonicalBytes()
        _ = try requireSchema2CleanupLeaf(EraseSchema2ColdCleanupGrammarV1.transferName,
            bytes: bootstrap, fullFact: nil,
            maximumBytes: EraseSchema2ColdCleanupGrammarV1.maximumEncodedBytes, permit: permit)
        let bytes = try sources.canonicalBytes()
        _ = try requireSchema2CleanupLeaf(EraseSchema2ColdCleanupGrammarV1.sourcesName,
            bytes: bytes, fullFact: indexFullFact,
            maximumBytes: EraseSchema2ColdCleanupGrammarV1.maximumEncodedBytes, permit: permit)
        guard let planLeaf = try readSchema2CleanupOpaqueLeaf(sources.c16PlanLeafName,
                maximumBytes: OriginalEraseC16PlanV1.maximumEncodedBytes),
              EraseSchema2ColdCleanupGrammarV1.fullFact(planLeaf.fact) == sources.c16PlanFullFact,
              StoreMigrationCanonicalJSONV1.sha256(planLeaf.bytes) == sources.c16PlanSHA256 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        _ = try requireSchema2CleanupLeaf(sources.c16PlanLeafName, bytes: planLeaf.bytes,
            fullFact: sources.c16PlanFullFact,
            maximumBytes: OriginalEraseC16PlanV1.maximumEncodedBytes, permit: permit)
        for source in sources.sources {
            guard let leaf = try readSchema2CleanupOpaqueLeaf(source.leafName,
                    maximumBytes: source.maximumByteCount),
                  leaf.bytes.count == source.byteCount,
                  StoreMigrationCanonicalJSONV1.sha256(leaf.bytes) == source.sha256 else {
                throw EraseIntentStoreError.invalidAuthority
            }
            _ = try requireSchema2CleanupLeaf(source.leafName, bytes: leaf.bytes,
                fullFact: source.leafFullFact, maximumBytes: source.maximumByteCount, permit: permit)
        }
    }

    @MainActor
    func canonicalSchema2ColdTransferredSource(path: String,
        sources: EraseSchema2ColdCleanupSourcesV1,
        progress: EraseSchema2ColdCleanupProgressV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws -> (bytes: Data, fullFact: String) {
        defer { coldCleanupPermit = nil; coldCleanupEffect = nil }
        try bindSchema2ColdCleanupEffect(EraseSchema2ColdCleanupCommitmentV1.makeEffect(
            kind: .readTransferredSource,
            inputSHA256: [StoreMigrationCanonicalJSONV1.sha256(try sources.canonicalBytes()),
                StoreMigrationCanonicalJSONV1.sha256(try progress.canonicalBytes(sources: sources)),
                EraseSchema2ColdCleanupCommitmentV1.sha256(path)], path: path), permit: permit)
        try beginSchema2ColdCleanupControlScope(permit)
        try progress.validate(sources: sources)
        try requireSchema2CleanupSourceIndex(sources,
            indexFullFact: progress.sourcesFullFact, permit: permit)
        guard let current = try loadSchema2ColdCleanupProgressInternal(sources: sources, permit: permit),
              current == progress, let active = current.activeTargetIndex,
              current.targets[active].dependencyPaths.contains(path) ||
                current.targets[active].allowedBirthPaths.contains(path),
              let source = sources.sources.first(where: { $0.path == path }),
              let leaf = try readSchema2CleanupOpaqueLeaf(source.leafName,
                maximumBytes: source.maximumByteCount),
              leaf.bytes.count == source.byteCount,
              StoreMigrationCanonicalJSONV1.sha256(leaf.bytes) == source.sha256 else {
            throw EraseIntentStoreError.invalidAuthority
        }
        _ = try requireSchema2CleanupLeaf(source.leafName, bytes: leaf.bytes,
            fullFact: source.leafFullFact, maximumBytes: source.maximumByteCount, permit: permit)
        try requireSchema2ColdCleanupEffect(permit)
        return (leaf.bytes, source.fullFact)
    }

    @MainActor
    private func requireSchema2CleanupProgressPlan(_ progress: EraseSchema2ColdCleanupProgressV1,
        sources: EraseSchema2ColdCleanupSourcesV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws {
        try progress.validate(sources: sources)
        try requireSchema2CleanupSourceIndex(sources,
            indexFullFact: progress.sourcesFullFact, permit: permit)
        guard let leaf = try readSchema2CleanupOpaqueLeaf(sources.c16PlanLeafName,
                maximumBytes: OriginalEraseC16PlanV1.maximumEncodedBytes) else {
            throw EraseIntentStoreError.invalidAuthority
        }
        let plan = try StoreMigrationCanonicalJSONV1.decodeCanonical(OriginalEraseC16PlanV1.self,
            from: leaf.bytes)
        try plan.validate()
        let targets = progress.targets.filter { $0.kind == .c16 }
        guard targets.count == plan.steps.count else { throw EraseIntentStoreError.invalidPreparation }
        for (target, step) in zip(targets, plan.steps) {
            guard target.semanticSHA256 == StoreMigrationCanonicalJSONV1.sha256(
                try StoreMigrationCanonicalJSONV1.encode(step)) else {
                throw EraseIntentStoreError.invalidPreparation
            }
        }
    }

    @MainActor
    private func loadSchema2ColdCleanupProgressInternal(sources: EraseSchema2ColdCleanupSourcesV1,
        permit: EraseSchema2ColdControlPermitV1
    ) throws -> EraseSchema2ColdCleanupProgressV1? {
        try beginSchema2ColdCleanupControlScope(permit)
        try requireSchema2CleanupSourceIndex(sources, indexFullFact: nil, permit: permit)
        let name = EraseSchema2ColdCleanupGrammarV1.progressName
        guard let leaf = try readSchema2CleanupOpaqueLeaf(name) else {
            guard coldCleanupProjectedLeaves[name] == nil,
                  try readSchema2CleanupOpaqueLeaf(
                    EraseSchema2ColdCleanupGrammarV1.temporaryName(name)) == nil else {
                throw EraseIntentStoreError.invalidAuthority
            }
            try requireSchema2ColdCleanupEffect(permit)
            return nil
        }
        guard try readSchema2CleanupOpaqueLeaf(
            EraseSchema2ColdCleanupGrammarV1.temporaryName(name)) == nil else {
            // Router must use the exact expected/replacement CAS from the
            // first-held finite cut, preserving its zero/prefix/pair proof.
            throw EraseIntentStoreError.invalidAuthority
        }
        let value = try StoreMigrationCanonicalJSONV1.decodeCanonical(
