                        name: "current.json", kind: "regular",
                        fact: first.namespace.currentFact),
                    OriginalRecoveryRetiredStageIdentityRecordV1.Child(
                        name: "generations", kind: "directory",
                        fact: first.namespace.installedParent),
                    OriginalRecoveryRetiredStageIdentityRecordV1.Child(
                        name: "retired.json", kind: "regular",
                        fact: first.namespace.retiredFact)],
