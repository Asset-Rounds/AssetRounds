        subject: EraseSchema2ConsumerCompleteSubjectV4,
        binding: EraseSchema2CompactTerminalBindingV4) throws {
        do {
            guard !uncertain, self.store === store, self.subject == subject,
                self.binding == binding else { throw EraseIntentStoreError.invalidAuthority }
            try lastLeaf.requireBound(store: store, subject: subject, binding: binding)
            try reproveActualRetainedCut()
        } catch { uncertain = true; throw error }
    }
}

@MainActor
final class EraseSchema2CompactTerminalStoreCloseReceiptV4 {
    enum Origin { case originalOwnedDescriptors, coldFirstHeldObservation }
    let operationID: UUID
    let subject: EraseSchema2ConsumerCompleteSubjectV4
    let binding: EraseSchema2CompactTerminalBindingV4
    let rootRemoval: EraseSchema2CompactTerminalRootRemovalReceiptV4
    let origin: Origin
    let checkedResourceCloseIdentity: UUID
    private weak var store: EraseIntentStore?
    private let reproveClosedMemoryAndActualOwner: @MainActor () throws -> Void
    private var uncertain = false
    fileprivate init(store: EraseIntentStore, operationID: UUID,
        subject: EraseSchema2ConsumerCompleteSubjectV4,
        binding: EraseSchema2CompactTerminalBindingV4,
        rootRemoval: EraseSchema2CompactTerminalRootRemovalReceiptV4,
        origin: Origin, checkedResourceCloseIdentity: UUID,
        reproveClosedMemoryAndActualOwner: @escaping @MainActor () throws -> Void) throws {
        try reproveClosedMemoryAndActualOwner()
        self.store = store; self.operationID = operationID; self.subject = subject
        self.binding = binding; self.rootRemoval = rootRemoval; self.origin = origin
        self.checkedResourceCloseIdentity = checkedResourceCloseIdentity
        self.reproveClosedMemoryAndActualOwner = reproveClosedMemoryAndActualOwner
        try reproveClosedMemoryAndActualOwner()
    }
    func requireBound(store: EraseIntentStore,
        subject: EraseSchema2ConsumerCompleteSubjectV4,
        binding: EraseSchema2CompactTerminalBindingV4) throws {
        do {
            guard !uncertain, self.store === store, self.subject == subject,
                self.binding == binding else { throw EraseIntentStoreError.invalidAuthority }
            // NO IO on any closed/uncertain numeric descriptor. The real higher
            // retained EX owner reproofs its distinct actual resource set here.
            try reproveClosedMemoryAndActualOwner()
        } catch { uncertain = true; throw error }
    }
}

