import Foundation

struct EraseSchema2CompactTerminalCapsuleReadbackV4: Equatable {
    let subject: EraseSchema2ConsumerCompleteSubjectV4
    let notificationOrigin: EraseSchema2TerminalNotificationOriginV4
    let semanticData: EraseSchema2TransferredTargetSemanticDataV4
    let binding: EraseSchema2CompactTerminalBindingV4
    let nextDeletionOrdinal: UInt64
    let remainingEarlierControlCount: UInt64
    let actualEraseRootFullFact: String
    // Capsule selfSHA/fact are supplied EXTERNALLY after actualreadback;
    // no self fact/SHA occurs in its serialized bytes. Complete origin<=2MiB.
}

@MainActor
final class EraseSchema2CompactTerminalLastLeafReceiptV4 {
    let operationID: UUID
    let subject: EraseSchema2ConsumerCompleteSubjectV4
    let binding: EraseSchema2CompactTerminalBindingV4
    let deletionOrdinal: UInt64
    let eraseRootBeforeFullFact: String
    let eraseRootAfterFullFact: String
    let unlinkedHeldCapsuleFullFact: String
    let checkedLeafCloseIdentity: UUID
    private weak var store: EraseIntentStore?
    private let reproveActualRetainedCut: @MainActor () throws -> Void
    private var uncertain = false
    fileprivate init(store: EraseIntentStore, operationID: UUID,
        subject: EraseSchema2ConsumerCompleteSubjectV4,
        binding: EraseSchema2CompactTerminalBindingV4, deletionOrdinal: UInt64,
        eraseRootBeforeFullFact: String, eraseRootAfterFullFact: String,
        unlinkedHeldCapsuleFullFact: String, checkedLeafCloseIdentity: UUID,
        reproveActualRetainedCut: @escaping @MainActor () throws -> Void) throws {
        try reproveActualRetainedCut()
        self.store = store; self.operationID = operationID
        self.subject = subject; self.binding = binding; self.deletionOrdinal = deletionOrdinal
        self.eraseRootBeforeFullFact = eraseRootBeforeFullFact
        self.eraseRootAfterFullFact = eraseRootAfterFullFact
        self.unlinkedHeldCapsuleFullFact = unlinkedHeldCapsuleFullFact
        self.checkedLeafCloseIdentity = checkedLeafCloseIdentity
        self.reproveActualRetainedCut = reproveActualRetainedCut
        try reproveActualRetainedCut()
    }
    func requireBound(store: EraseIntentStore,
        subject: EraseSchema2ConsumerCompleteSubjectV4,
        binding: EraseSchema2CompactTerminalBindingV4) throws {
        do {
            guard !uncertain, self.store === store, self.subject == subject,
                self.binding == binding else { throw EraseIntentStoreError.invalidAuthority }
            try reproveActualRetainedCut()
        } catch { uncertain = true; throw error }
    }
}

