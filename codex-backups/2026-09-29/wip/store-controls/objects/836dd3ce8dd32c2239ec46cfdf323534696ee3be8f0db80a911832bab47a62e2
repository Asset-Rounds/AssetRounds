        rootRemoval: EraseSchema2CompactTerminalRootRemovalReceiptV4,
        authority: EraseSchema2CompactTerminalAuthorityV4,
        readback: EraseSchema2TerminalNotificationReadbackReceiptV4,
        operation: EraseColdPreparationOperationV1,
