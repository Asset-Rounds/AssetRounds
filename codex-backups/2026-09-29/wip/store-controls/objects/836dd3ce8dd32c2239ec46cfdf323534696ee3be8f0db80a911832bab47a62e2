        subject: EraseSchema2ConsumerCompleteSubjectV4,
        notificationOrigin: EraseSchema2TerminalNotificationOriginV4,
        semanticData: EraseSchema2TransferredTargetSemanticDataV4,
        semanticSeal: EraseSchema2TransferredTargetSemanticProducerSealV4,
