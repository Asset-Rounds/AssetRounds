+    @MainActor
+    private func requireSchema2CleanupProgressPlan(_ progress: EraseSchema2ColdCleanupProgressV1,
+        sources: EraseSchema2ColdCleanupSourcesV1,
+        permit: EraseSchema2ColdControlPermitV1
+    ) throws {
+        try progress.validate(sources: sources)
+        try requireSchema2CleanupSourceIndex(sources,
+            indexFullFact: progress.sourcesFullFact, permit: permit)
+        guard let leaf = try readSchema2CleanupOpaqueLeaf(sources.c16PlanLeafName,
+                maximumBytes: OriginalEraseC16PlanV1.maximumEncodedBytes) else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        let plan = try StoreMigrationCanonicalJSONV1.decodeCanonical(OriginalEraseC16PlanV1.self,
+            from: leaf.bytes)
+        try plan.validate()
+        let targets = progress.targets.filter { $0.kind == .c16 }
+        guard targets.count == plan.steps.count else { throw EraseIntentStoreError.invalidPreparation }
+        for (target, step) in zip(targets, plan.steps) {
+            guard target.semanticSHA256 == StoreMigrationCanonicalJSONV1.sha256(
+                try StoreMigrationCanonicalJSONV1.encode(step)) else {
+                throw EraseIntentStoreError.invalidPreparation
+            }
+        }
+    }
