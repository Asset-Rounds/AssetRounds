+    private func requireCASPhysicalPhase() throws {
+        guard let eraseFD, let preparationFD,
+              let oldBytes = capturedBytes,
+              let newBytes = replacementBytes else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        try requireBaseDirectories()
+        var current = stat(), temporary = stat()
+        switch replacementPhase {
+        case .initial:
+            try requireHeldNamed()
+        case .tempCreated, .tempPrepared:
+            guard let nextFD,
+                  Darwin.fstatat(eraseFD, "preparation.json",
+                      &current, AT_SYMLINK_NOFOLLOW) == 0,
+                  same(try regular(preparationFD), current),
+                  Darwin.fstatat(eraseFD, ".preparation.json.next",
+                      &temporary, AT_SYMLINK_NOFOLLOW) == 0,
+                  same(try regular(nextFD), temporary),
+                  try readExact(preparationFD, expected: oldBytes) else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            try requireNamedPolicy(.journal,
+                name: "preparation.json", held: current)
+            if replacementPhase == .tempPrepared {
+                guard try readExact(nextFD, expected: newBytes) else {
+                    throw EraseIntentStoreError.invalidAuthority
+                }
+                try requireNamedPolicy(.journalTemporary,
+                    name: ".preparation.json.next", held: temporary)
+            }
+        case .swapped:
+            guard let nextFD,
+                  Darwin.fstatat(eraseFD, "preparation.json",
+                      &current, AT_SYMLINK_NOFOLLOW) == 0,
+                  same(try regular(nextFD), current),
+                  Darwin.fstatat(eraseFD, ".preparation.json.next",
+                      &temporary, AT_SYMLINK_NOFOLLOW) == 0,
+                  same(try regular(preparationFD), temporary),
+                  try readExact(nextFD, expected: newBytes),
+                  try readExact(preparationFD, expected: oldBytes) else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            try requireNamedPolicy(.journal,
+                name: "preparation.json", held: current)
+            try requireNamedPolicy(.journalTemporary,
+                name: ".preparation.json.next", held: temporary)
+        case .oldRemoved:
+            guard let nextFD,
+                  Darwin.fstatat(eraseFD, "preparation.json",
+                      &current, AT_SYMLINK_NOFOLLOW) == 0,
+                  same(try regular(nextFD), current),
+                  Darwin.fstatat(eraseFD, ".preparation.json.next",
+                      &temporary, AT_SYMLINK_NOFOLLOW) != 0,
+                  errno == ENOENT,
+                  try unlinkedRegular(preparationFD),
+                  try readExact(nextFD, expected: newBytes),
+                  try readExact(preparationFD, expected: oldBytes,
+                      allowUnlinked: true) else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            try requireNamedPolicy(.journal,
+                name: "preparation.json", held: current)
+        }
+    }
