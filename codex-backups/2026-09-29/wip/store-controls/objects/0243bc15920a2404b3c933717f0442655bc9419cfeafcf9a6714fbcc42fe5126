+    private func requireLeaf(_ name: String, at erase: Int32,
+        root: URL, descriptor: Int32?, expected: Data?) throws {
+        var named = stat()
+        let found = Darwin.fstatat(erase, name, &named,
+            AT_SYMLINK_NOFOLLOW)
