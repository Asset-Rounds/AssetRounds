+    private func opaqueContentSHA256(_ fd: Int32, parent: Int32, name: String) throws -> String {
+        let before = try regular(fd)
+        guard before.st_size >= 0,
+              before.st_size <= off_t(EraseSchema2ColdCleanupGrammarV1.maximumControlBytes(name)),
+              Darwin.lseek(fd, 0, SEEK_SET) == 0 else { throw EraseIntentStoreError.invalidAuthority }
+        var hasher = SHA256(), consumed: off_t = 0
+        var buffer = [UInt8](repeating: 0, count: 16 * 1_024)
+        while true {
+            let count = buffer.withUnsafeMutableBytes { Darwin.read(fd, $0.baseAddress, $0.count) }
+            if count > 0 {
+                guard off_t(count) <= before.st_size - consumed else { throw EraseIntentStoreError.invalidAuthority }
+                hasher.update(data: Data(buffer.prefix(count))); consumed += off_t(count)
+            } else if count == 0 { break }
+            else if errno != EINTR { throw EraseIntentStoreError.invalidAuthority }
+        }
+        var named = stat()
+        guard consumed == before.st_size,
+              EraseColdControlLeafFactV1(try regular(fd)) == EraseColdControlLeafFactV1(before),
+              Darwin.fstatat(parent, name, &named, AT_SYMLINK_NOFOLLOW) == 0,
+              EraseColdControlLeafFactV1(named) == EraseColdControlLeafFactV1(before) else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        return hasher.finalize().map { String(format: "%02x", $0) }.joined()
+    }
