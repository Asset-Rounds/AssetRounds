+    /// The original owner's durable auxiliary roster is only opaque first
+    /// physical evidence here. Canonical decoding and any survivor-prefix
+    /// promotion belong to the retained cold R operation after EX/G.
+    private func openOpaqueAuxiliaryRoster(at erase: Int32,
+        root: URL) throws -> Data? {
+        let name = EraseSchema2ColdAuxiliaryPhysicalRosterV1.canonicalName
+        let fd = Darwin.openat(erase, name,
+            O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
+        if fd < 0 {
+            guard errno == ENOENT else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            return nil
+        }
+        opaqueAuxiliaryRosterFD = fd
+        let held = try regular(fd)
+        guard held.st_size > 0,
+              held.st_size <= 96 * 1024 * 1024,
+              held.st_uid == Darwin.getuid(),
+              held.st_gid == Darwin.getgid() else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        let fact = EraseColdControlLeafFactV1(held)
+        let bytes = try exactBytes(fd, parent: erase, name: name)
+        let policy = try observeColdPolicy(.journal,
