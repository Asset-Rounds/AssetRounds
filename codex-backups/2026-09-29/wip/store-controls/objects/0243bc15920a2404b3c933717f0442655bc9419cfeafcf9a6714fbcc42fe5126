+    @MainActor
+    private func replaceSchema2ColdCleanupProgressInternal(expected: EraseSchema2ColdCleanupProgressV1,
+        with replacement: EraseSchema2ColdCleanupProgressV1,
+        sources: EraseSchema2ColdCleanupSourcesV1,
+        permit: EraseSchema2ColdControlPermitV1
+    ) throws {
+        try beginSchema2ColdCleanupControlScope(permit)
+        guard try expected.permitsAdvance(to: replacement, sources: sources) else {
+            throw EraseIntentStoreError.invalidPreparation
+        }
+        try requireSchema2CleanupProgressPlan(expected, sources: sources, permit: permit)
+        try requireSchema2CleanupProgressPlan(replacement, sources: sources, permit: permit)
+        _ = try publishSchema2CleanupLeaf(EraseSchema2ColdCleanupGrammarV1.progressName,
+            bytes: replacement.canonicalBytes(sources: sources),
+            expectedBytes: expected.canonicalBytes(sources: sources),
+            maximumBytes: EraseSchema2ColdCleanupGrammarV1.maximumEncodedBytes, permit: permit)
+        guard try loadSchema2ColdCleanupProgressInternal(sources: sources, permit: permit) == replacement else {
+            throw EraseIntentStoreError.writeFailed
+        }
+    }
