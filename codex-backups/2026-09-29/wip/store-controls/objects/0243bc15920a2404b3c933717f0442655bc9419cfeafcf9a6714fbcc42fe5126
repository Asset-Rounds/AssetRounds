+            throw EraseIntentStoreError.invalidAuthority
+        }
+        let descriptor = Darwin.openat(erase, name, O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
+        guard descriptor >= 0 else { throw EraseIntentStoreError.invalidAuthority }
+        opaqueCleanupFDs[name] = descriptor
+        do {
+            var held = stat(), named = stat()
+            guard Darwin.fstat(descriptor, &held) == 0,
+                  Darwin.fstatat(erase, name, &named, AT_SYMLINK_NOFOLLOW) == 0,
+                  EraseColdControlLeafFactV1(held) == first.fact,
+                  EraseColdControlLeafFactV1(named) == first.fact,
+                  try opaqueContentSHA256(descriptor, parent: erase, name: name) == expectedSHA,
+                  try observeColdPolicy(name.hasSuffix(".next") ? .journalTemporary : .journal,
+                    at: root.appendingPathComponent(name)) == first.policy else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            opaqueCleanupFDs.removeValue(forKey: name)
+            guard Darwin.close(descriptor) == 0 else {
+                uncertainFDs.append(descriptor); throw EraseIntentStoreError.invalidAuthority
+            }
+        } catch {
+            if let retained = opaqueCleanupFDs.removeValue(forKey: name), Darwin.close(retained) != 0 {
+                uncertainFDs.append(retained)
