+        return try ProtectedFilePolicyV1.observeTemporalPolicyWithCheckedClose(
+            kind, at: url, retainUncertainDescriptor: { descriptor in
+                self.uncertainPolicyFDs.append(descriptor)
+                self.closeUncertain = true
+            })
+    }
+
+    private func requireNamedPolicy(_ kind: OwnedFileKindV1,
+        name: String, held: stat) throws {
+        guard let eraseURL else { throw EraseIntentStoreError.invalidAuthority }
+        let policy = try observeColdPolicy(kind,
+            at: eraseURL.appendingPathComponent(name))
+        guard policy.state == .strictComplete,
+              policy.device == UInt64(held.st_dev),
+              policy.inode == UInt64(held.st_ino) else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+    }
