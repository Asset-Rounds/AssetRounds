+    @MainActor
+    private func requireSchema2CleanupLineage(_ sources: EraseSchema2ColdCleanupSourcesV1,
+        permit: EraseSchema2ColdControlPermitV1
+    ) throws {
+        try requireSchema2ColdCleanupEffect(permit)
+        guard let intent = try load(), intent.schemaVersion == 2,
+              intent.eraseID.uuidString.lowercased() == sources.eraseID,
+              let preparation = try loadPreparation(), preparation.matches(intent),
+              StoreMigrationCanonicalJSONV1.sha256(try ErasePreparationCodecV2.encode(preparation))
+                == sources.preparationSHA256,
+              let rosterBytes = coldCapturedOpaqueAuxiliaryRosterBytes
+                ?? originalAuxiliaryPublishedReceipt?.seal.canonicalBytes,
+              StoreMigrationCanonicalJSONV1.sha256(rosterBytes)
+                == sources.originalPAuxiliaryRosterSHA256 else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        let roster = try EraseSchema2ColdAuxiliaryPhysicalRosterV1.decodeCanonical(rosterBytes,
+            intent: intent, preparation: preparation)
+        guard roster.record.firstIntentPhase == EraseIntentPhaseV1.emptyGenerationPrepared.rawValue,
+              roster.record.eraseID == sources.eraseID else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        let originalNodes = roster.record.trees.first {
+            $0.key == "support/FieldEvidenceOperations"
+        }?.nodes ?? []
+        for source in sources.sources {
+            guard let node = originalNodes.first(where: { $0.path == source.path }),
+                  node.kind == "file", node.sha256 == source.sha256 else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            let full = source.fullFact.split(separator: "|", omittingEmptySubsequences: false)
+            let projected = [full[0], full[1], full[2], full[5], full[6],
+                full[7], full[8], full[9], full[10]].joined(separator: "|")
+            guard node.fact == projected else { throw EraseIntentStoreError.invalidAuthority }
+        }
+        try requireSchema2ColdCleanupEffect(permit)
+    }
