+    /// Capture the reserved intent temporary as opaque physical evidence.
+    /// Empty and prefix writes are legitimate interrupted cuts, so this read
+    /// never decodes or grants policy authority. It keeps the original FD
+    /// until the checked borrow/close boundary.
+    private func openOpaqueIntentNext(at erase: Int32,
+        root: URL) throws -> Data? {
+        let name = ".erase.json.next"
+        let fd = Darwin.openat(erase, name,
+            O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
+        if fd < 0 {
+            guard errno == ENOENT else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            return nil
+        }
+        opaqueIntentNextFD = fd
+        let held = try regular(fd)
+        guard held.st_size >= 0,
+              held.st_size <= 96 * 1024 * 1024 else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        let fact = EraseColdControlLeafFactV1(held)
+        let policy = try observeColdPolicy(.journalTemporary,
+            at: root.appendingPathComponent(name))
+        guard policy.device == UInt64(held.st_dev),
+              policy.inode == UInt64(held.st_ino) else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        let bytes = try opaqueBytes(fd, parent: erase, name: name)
+        var after = stat(), named = stat()
+        guard Darwin.fstat(fd, &after) == 0,
+              Darwin.fstatat(erase, name, &named,
+                  AT_SYMLINK_NOFOLLOW) == 0,
+              EraseColdControlLeafFactV1(after) == fact,
+              EraseColdControlLeafFactV1(named) == fact else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        capturedOpaqueIntentNextFact = fact
+        capturedOpaqueIntentNextPolicy = policy
+        return bytes
+    }
+
+    private func requireOpaqueIntentNext(at erase: Int32, root: URL,
+        expectedPresent: Bool) throws {
+        let name = ".erase.json.next"
+        guard expectedPresent == (capturedOpaqueIntentNextBytes != nil) else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        if !expectedPresent {
+            var named = stat()
+            guard opaqueIntentNextFD == nil,
+                  Darwin.fstatat(erase, name, &named,
+                      AT_SYMLINK_NOFOLLOW) != 0,
+                  errno == ENOENT else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            return
+        }
+        guard let fd = opaqueIntentNextFD,
+              let expected = capturedOpaqueIntentNextBytes,
+              let fact = capturedOpaqueIntentNextFact,
+              let policy = capturedOpaqueIntentNextPolicy else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        var held = stat(), named = stat()
+        guard Darwin.fstat(fd, &held) == 0,
+              Darwin.fstatat(erase, name, &named,
+                  AT_SYMLINK_NOFOLLOW) == 0,
+              EraseColdControlLeafFactV1(held) == fact,
+              EraseColdControlLeafFactV1(named) == fact,
+              try opaqueBytes(fd, parent: erase, name: name) == expected,
+              try observeColdPolicy(.journalTemporary,
+                  at: root.appendingPathComponent(name)) == policy else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+    }
