+    private func requireNoPreparationTemporary(_ erase: Int32) throws {
+        for name in [".preparation.json.next"] {
+            var item = stat()
+            guard Darwin.fstatat(erase, name, &item,
+                AT_SYMLINK_NOFOLLOW) != 0, errno == ENOENT else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+        }
+    }
