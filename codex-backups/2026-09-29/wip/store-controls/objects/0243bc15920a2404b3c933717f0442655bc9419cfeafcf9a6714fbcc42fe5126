+    private func requireBaseDirectories() throws {
+        guard let supportFD, let eraseFD, let supportURL,
+              let eraseURL else { throw EraseIntentStoreError.invalidAuthority }
+        let heldSupport = try directory(supportFD)
+        let heldErase = try directory(eraseFD)
+        var namedSupport = stat(), namedErase = stat(), intent = stat()
+        guard Darwin.lstat(supportURL.path, &namedSupport) == 0,
+              same(heldSupport, namedSupport),
+              Darwin.fstatat(supportFD, "FieldEvidenceErase",
+                  &namedErase, AT_SYMLINK_NOFOLLOW) == 0,
+              same(heldErase, namedErase),
+              Darwin.fstatat(eraseFD, "erase.json",
+                  &intent, AT_SYMLINK_NOFOLLOW) != 0, errno == ENOENT else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        let policy = try observeColdPolicy(.stagingDirectory,
+            at: eraseURL)
+        guard policy.state == .strictComplete,
+              policy.device == UInt64(heldErase.st_dev),
+              policy.inode == UInt64(heldErase.st_ino) else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+    }
+
+    private func readExact(_ fd: Int32, expected: Data,
+        allowUnlinked: Bool = false) throws -> Bool {
+        var before = stat(), after = stat()
+        guard Darwin.fstat(fd, &before) == 0,
+              before.st_mode & S_IFMT == S_IFREG,
+              before.st_nlink == (allowUnlinked ? 0 : 1),
+              before.st_size == off_t(expected.count),
+              Darwin.lseek(fd, 0, SEEK_SET) == 0 else { return false }
+        var observed = Data(count: expected.count)
+        try observed.withUnsafeMutableBytes { raw in
+            var offset = 0
+            while offset < raw.count {
+                let count = Darwin.read(fd,
+                    raw.baseAddress!.advanced(by: offset), raw.count - offset)
+                if count < 0 && errno == EINTR { continue }
+                guard count > 0 else { throw EraseIntentStoreError.invalidAuthority }
+                offset += count
+            }
+        }
+        guard Darwin.fstat(fd, &after) == 0,
+              same(before, after),
+              before.st_size == after.st_size else { return false }
+        return observed == expected
+    }
+
+    private func unlinkedRegular(_ fd: Int32) throws -> Bool {
+        var held = stat()
+        guard Darwin.fstat(fd, &held) == 0 else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        return held.st_mode & S_IFMT == S_IFREG && held.st_nlink == 0
+    }
