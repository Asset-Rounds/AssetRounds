+    @MainActor
+    func createSchema2ColdCleanupProgress(_ initial: EraseSchema2ColdCleanupProgressV1,
+        sources: EraseSchema2ColdCleanupSourcesV1,
+        permit: EraseSchema2ColdControlPermitV1
+    ) throws {
+        defer { coldCleanupPermit = nil; coldCleanupEffect = nil }
+        let initialBytes = try initial.canonicalBytes(sources: sources)
+        try bindSchema2ColdCleanupEffect(EraseSchema2ColdCleanupCommitmentV1.makeEffect(
+            kind: .createProgress, inputSHA256: [StoreMigrationCanonicalJSONV1.sha256(initialBytes)],
+            path: EraseSchema2ColdCleanupGrammarV1.progressName), permit: permit)
+        try beginSchema2ColdCleanupControlScope(permit)
+        guard initial.stage == .prepared,
+              initial.completedPrefixCount == 0 else { throw EraseIntentStoreError.invalidPreparation }
+        try requireSchema2CleanupProgressPlan(initial, sources: sources, permit: permit)
+        let bytes = try initial.canonicalBytes(sources: sources)
+        _ = try publishSchema2CleanupLeaf(EraseSchema2ColdCleanupGrammarV1.progressName,
+            bytes: bytes, expectedBytes: nil,
+            maximumBytes: EraseSchema2ColdCleanupGrammarV1.maximumEncodedBytes, permit: permit)
+        guard try loadSchema2ColdCleanupProgressInternal(sources: sources, permit: permit) == initial else {
+            throw EraseIntentStoreError.writeFailed
+        }
+    }
