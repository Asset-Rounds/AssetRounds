+    @MainActor
+    func captureSchema2ColdBornCleanupSource(path: String, role: String, bytes: Data, fullFact: String,
+        physicalProjection: [EraseSchema2ColdCleanupProgressV1.Projection],
+        expected: EraseSchema2ColdCleanupProgressV1,
+        sources: EraseSchema2ColdCleanupSourcesV1,
+        permit: EraseSchema2ColdControlPermitV1
+    ) throws -> EraseSchema2ColdCleanupProgressV1 {
+        defer { coldCleanupPermit = nil; coldCleanupEffect = nil }
+        guard let activeOrdinal = expected.activeTargetIndex else { throw EraseIntentStoreError.invalidAuthority }
+        try EraseSchema2ColdCleanupGrammarV1.requireBirthRole(role, path: path)
+        try bindSchema2ColdCleanupEffect(EraseSchema2ColdCleanupCommitmentV1.makeEffect(
+            kind: .captureBornSource,
+            inputSHA256: [StoreMigrationCanonicalJSONV1.sha256(try expected.canonicalBytes(sources: sources)),
+                StoreMigrationCanonicalJSONV1.sha256(bytes), EraseSchema2ColdCleanupCommitmentV1.sha256(fullFact),
+                EraseSchema2ColdCleanupCommitmentV1.sha256(String(activeOrdinal)),
+                EraseSchema2ColdCleanupCommitmentV1.sha256(role),
+                try EraseSchema2ColdCleanupProgressV1.projectionSHA256(physicalProjection)], path: path), permit: permit)
+        try beginSchema2ColdCleanupControlScope(permit)
+        try expected.validate(sources: sources)
+        guard [.preparing, .preparingCaptured].contains(expected.stage),
+              let active = expected.activeTargetIndex,
+              expected.targets[active].allowedBirthPaths.contains(path),
+              EraseSchema2ColdCleanupGrammarV1.validFact(fullFact) else {
+            throw EraseIntentStoreError.invalidAuthority
+        }
+        let maximum = try EraseSchema2ColdCleanupGrammarV1.maximumSourceBytes(path: path)
+        guard bytes.count <= maximum else { throw EraseIntentStoreError.invalidPreparation }
+        let sha = StoreMigrationCanonicalJSONV1.sha256(bytes)
+        if let birth = expected.births.first(where: {
+            $0.source.path == path && $0.source.sha256 == sha
+                && $0.role == role && $0.targetIndex == active
+        }) {
+            guard physicalProjection == expected.physicalProjection,
+                  birth.targetIndex == active, birth.source.fullFact == fullFact,
+                  birth.source.sha256 == sha, birth.source.byteCount == bytes.count else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            _ = try requireSchema2CleanupLeaf(birth.source.leafName, bytes: bytes,
+                fullFact: birth.source.leafFullFact, maximumBytes: maximum, permit: permit)
+            guard try loadSchema2ColdCleanupProgressInternal(sources: sources, permit: permit) == expected else {
+                throw EraseIntentStoreError.invalidAuthority
+            }
+            return expected
+        }
+        let name = EraseSchema2ColdCleanupGrammarV1.sourceLeafName(sha256: sha)
+        let leaf = try publishSchema2CleanupLeaf(name, bytes: bytes, expectedBytes: nil,
+            maximumBytes: maximum, permit: permit)
+        let source = EraseSchema2ColdCleanupSourcesV1.Source(path: path, fullFact: fullFact,
+            sha256: sha, byteCount: bytes.count, maximumByteCount: maximum, leafName: name,
+            leafFullFact: EraseSchema2ColdCleanupGrammarV1.fullFact(leaf.fact))
+        let replacement = try expected.capturing(.init(role: role, targetIndex: active, source: source),
+            physicalProjection: physicalProjection, sources: sources)
+        try replaceSchema2ColdCleanupProgressInternal(expected: expected, with: replacement,
+            sources: sources, permit: permit)
+        return replacement
+    }
