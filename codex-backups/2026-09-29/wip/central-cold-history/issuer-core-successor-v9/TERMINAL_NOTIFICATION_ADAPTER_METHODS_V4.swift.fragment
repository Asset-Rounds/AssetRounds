func pendingObservations() async throws -> [NotificationSystemObservationV1] {
    let values = await center.pendingNotificationRequests()
    return values.map { Self.observation($0, delivered: false) }
}
func deliveredObservations() async throws -> [NotificationSystemObservationV1] {
    let values = await center.deliveredNotifications()
    return values.map { Self.observation($0.request, delivered: true) }
}
