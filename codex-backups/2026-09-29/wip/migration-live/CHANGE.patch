+    /// A fixed, operation-retained reader. The caller already owns the actual
+    /// G, EX and activity; no generic reader body or ordinary initializer is
+    /// used. Positive short reads advance; EINTR/error is not retried. Thus
+    /// each <=4 MiB leaf has at most byteCount reads plus one EOF probe.
+    @MainActor
+    private func readOriginalEraseScratchCleanupControl(
+        parent: Int32, name: String, url: URL, kind: OwnedFileKindV1,
+        activity: GenerationTemporalActivityHandleV1,
+        operation: EraseRouterOperationV1, store: EraseIntentStore,
+        exclusion: StoreTemporalNormalizationExclusionV1,
+        expectedCohort: [GenerationLeaseTokenV1]
+    ) throws -> (bytes: Data, fact: FileSnapshot,
+        policy: TemporalPolicyObservationV1)? {
+        @MainActor func requireOrigin() throws {
+            guard generationMutationLockDepth == 1 else {
+                throw Self.uncertainOwnerFailure()
+            }
+            try activity.validateOriginalEraseScratchCleanupRegistry(self)
+            guard try operation.requireOriginalEraseScratchCleanupEffectUnderHeldG(
+                registry: self, activity: activity, store: store,
+                exclusion: exclusion) == expectedCohort else {
+                throw Self.uncertainOwnerFailure()
+            }
+        }
+        try requireOrigin()
+        let attempt = EraseSchema2ColdRegistryObservationAttemptV1()
+        try operation.retainOriginalEraseAuxiliaryRegistryObservation(
+            attempt: attempt, registry: self) // BEFORE this leaf opens
+        @MainActor func readObservedLeaf() throws -> (bytes: Data,
+            fact: FileSnapshot, policy: TemporalPolicyObservationV1)? {
+            try requireOrigin()
+            var named = stat()
+            let namedResult = Darwin.fstatat(parent, name, &named, AT_SYMLINK_NOFOLLOW)
+            let namedErrno = errno
+            if namedResult < 0 {
+                guard namedErrno == ENOENT else {
+                    throw Self.identityFailure(errorNumber: namedErrno)
+                }
+                try requireOrigin()
+                guard Darwin.fstatat(parent, name, &named, AT_SYMLINK_NOFOLLOW) < 0 else {
+                    throw Self.identityFailure()
+                }
+                let absenceErrno = errno
+                guard absenceErrno == ENOENT else {
+                    throw Self.identityFailure(errorNumber: absenceErrno)
+                }
+                return nil
+            }
+            guard (named.st_mode & S_IFMT) == S_IFREG, named.st_nlink == 1,
+                  named.st_size >= 0,
+                  named.st_size <= off_t(Self.maximumControlFileBytes) else {
+                throw Self.identityFailure()
+            }
+            let original = FileSnapshot(named)
+            let descriptor = Darwin.openat(parent, name,
+                O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC)
+            let openErrno = errno
+            guard descriptor >= 0 else {
+                throw Self.identityFailure(errorNumber: openErrno)
+            }
+            try attempt.retain(descriptor)
+            @MainActor func requireLeaf() throws {
+                try requireOrigin()
+                var current = stat()
+                guard try Self.regularFileSnapshot(descriptor) == original,
+                      Darwin.fstatat(parent, name, &current, AT_SYMLINK_NOFOLLOW) == 0,
+                      (current.st_mode & S_IFMT) == S_IFREG,
+                      current.st_nlink == 1, FileSnapshot(current) == original else {
+                    throw Self.identityFailure()
+                }
+            }
+            try requireLeaf()
+            let policy = try ProtectedFilePolicyV1.observeTemporalPolicyWithCheckedClose(
+                kind, at: url, retainUncertainDescriptor: { value in
+                    self.originalEraseAuxiliaryPolicyUncertainDescriptors.append(value)
+                })
+            guard policy.state == .strictComplete,
+                  originalEraseAuxiliaryPolicyUncertainDescriptors.isEmpty else {
+                throw Self.uncertainOwnerFailure()
+            }
+            try requireLeaf()
+            var bytes = Data(count: Int(original.byteCount))
+            try bytes.withUnsafeMutableBytes { buffer in
+                var offset = 0
+                while offset < buffer.count {
+                    try requireLeaf()
+                    let wanted = min(64 * 1024, buffer.count - offset)
+                    let count = Darwin.pread(descriptor,
+                        buffer.baseAddress!.advanced(by: offset), wanted, off_t(offset))
+                    let readErrno = errno
+                    try requireLeaf()
+                    guard count > 0, count <= wanted else {
+                        throw Self.identityFailure(errorNumber: count < 0 ? readErrno : EIO)
+                    }
+                    offset += count
+                }
+            }
+            try requireLeaf()
+            var extra: UInt8 = 0
+            let eofCount = Darwin.pread(descriptor, &extra, 1, original.byteCount)
+            let eofErrno = errno
+            try requireLeaf()
+            guard eofCount == 0 else {
+                throw Self.identityFailure(errorNumber: eofCount < 0 ? eofErrno : EIO)
+            }
+            return (bytes, original, policy)
+
+        }
+        let result: (bytes: Data, fact: FileSnapshot,
+            policy: TemporalPolicyObservationV1)?
+        do { result = try readObservedLeaf() }
+        catch { try attempt.closeChecked(); throw error }
+        try attempt.closeChecked()
+        return result
+    }
