+    fileprivate var resourceOrder: [Resource] = []
+    fileprivate var sequence: UInt64 = 0
+    fileprivate var sourcesCaptured = false
+    fileprivate var canonicalSources: [String: OriginalEraseScratchCleanupCanonicalSourceV1] = [:]
