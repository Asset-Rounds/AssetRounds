{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetrounds.invalid/schemas/v23/requirement-assurance.schema.json",
  "title": "RequirementAssuranceCorpusV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "goldenCases", "hostileCases", "interruptionCases", "lifecycleCases"],
  "properties": {
    "schema": {"const": "V21P03C12RequirementAssuranceCorpusV1"},
    "schemaVersion": {"const": 1},
    "goldenCases": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/case"}},
    "hostileCases": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/case"}},
    "interruptionCases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/case"}},
    "lifecycleCases": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "expectedResult", "reasonCodes"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
        "classification": {"enum": ["GOLDEN", "ALTERNATE", "HOSTILE", "INTERRUPTION", "RECOVERY"]},
        "expectedResult": {"enum": ["SATISFIED", "NOT_SATISFIED", "NOT_APPLICABLE", "UNKNOWN", "WAIVED", "REJECTED"]},
        "reasonCodes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
        }
      }
    }
  }
}
