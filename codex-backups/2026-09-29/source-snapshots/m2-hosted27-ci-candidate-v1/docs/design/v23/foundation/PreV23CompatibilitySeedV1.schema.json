{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetrounds.local/schemas/v23/PreV23CompatibilitySeedV1.schema.json",
  "title": "PreV23CompatibilitySeedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceS10_6Head",
    "sourceSchemaVersion",
    "privacyClassification",
    "fixtureDigest",
    "edgeShapes"
  ],
  "properties": {
    "schema": {
      "const": "PreV23CompatibilitySeedV1"
    },
    "sourceS10_6Head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceSchemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "privacyClassification": {
      "const": "SYNTHETIC_NO_CUSTOMER_DATA"
    },
    "fixtureDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "edgeShapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "expectedDisposition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "expectedDisposition": {
            "enum": [
              "READABLE",
              "MIGRATABLE",
              "QUARANTINED_VISIBLE_RECOVERY"
            ]
          }
        }
      }
    }
  }
}
