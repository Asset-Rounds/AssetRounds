{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetrounds.local/schemas/v23/BrandImpactManifestV1.schema.json",
  "title": "BrandImpactManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cardID",
    "candidateHead",
    "acceptedS10_6BaselineDigest",
    "changedStates",
    "affectedConsumers",
    "phase10OwnershipConflicts",
    "revalidationSelectors"
  ],
  "properties": {
    "schema": {
      "const": "BrandImpactManifestV1"
    },
    "cardID": {
      "type": "string",
      "pattern": "^V23-P[0-9]{2}-C[0-9]{2}$"
    },
    "candidateHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "acceptedS10_6BaselineDigest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "changedStates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "screenID",
          "stateID",
          "changeKind",
          "ownedPaths"
        ],
        "properties": {
          "screenID": {
            "type": "string",
            "minLength": 1
          },
          "stateID": {
            "type": "string",
            "minLength": 1
          },
          "changeKind": {
            "enum": [
              "UNCHANGED_INHERITED",
              "LOCAL_CONTENT_OR_LAYOUT",
              "SHARED_COMPONENT",
              "GLOBAL_TOKEN",
              "NAVIGATION_OR_ROOT",
              "APP_IDENTITY",
              "REPORT_BRAND"
            ]
          },
          "ownedPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "affectedConsumers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "phase10OwnershipConflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "revalidationSelectors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "acceptedS10_6BaselineDigest": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "changedStates": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
