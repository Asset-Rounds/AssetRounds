          "canonicalMutationCount": 0,
          "durableAcceptanceReceiptCount": 0,
          "proposalDisposition": "REMOVED",
          "scratchDisposition": "DELETED"
        },
        {
          "action": "CANCEL",
          "canonicalMutationCount": 0,
          "durableAcceptanceReceiptCount": 0,
          "proposalDisposition": "REMOVED",
          "scratchDisposition": "DELETED"
        },
        {
          "action": "EXPIRE",
          "canonicalMutationCount": 0,
          "durableAcceptanceReceiptCount": 0,
          "proposalDisposition": "REMOVED",
          "scratchDisposition": "DELETED"
