          "locale": {
            "minLength": 1,
            "type": "string"
          },
          "manualFallback": {
            "const": "MANUAL_TYPED_FIELD_ENTRY"
          },
          "modelVersion": {
            "minLength": 1,
            "type": "string"
          },
          "permission": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
