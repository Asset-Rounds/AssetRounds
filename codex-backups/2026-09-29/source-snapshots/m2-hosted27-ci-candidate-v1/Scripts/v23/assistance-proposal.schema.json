    "schemaVersion",
    "cardID",
    "persistentSchemaVersion",
    "recordsSchemaVersion",
    "proposalPersistenceDisposition",
    "durableFamilies",
    "requiredContractNames",
    "evidenceIDs",
    "capabilities",
    "typedValueCases",
    "transitionMatrix",
    "expiryTriggers",
    "hostileCases",
    "recovery",
    "lifecycle",
    "invariants",
    "statusFlags"
