      "const": [
        "PROPOSAL_AFTER_USER_EDIT",
        "CONFIDENCE_ABSENT_WHEN_REQUIRED",
        "CONFIDENCE_OUT_OF_RANGE",
        "WRONG_LOCALE",
        "WRONG_MODEL_VERSION",
        "SOURCE_REMOVED",
        "PERMISSION_REVOKED",
