{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetrounds.invalid/v23/ReleaseHookInventoryV1.schema.json",
  "title": "ReleaseHookInventoryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "cardID",
    "authority",
    "scannerVersion",
    "scanRuleDigest",
    "sourceRoot",
    "sourceFiles",
    "sourceSnapshotDigest",
    "patterns",
    "findings",
    "countsByCategory",
    "countsByDisposition",
    "releaseAbsenceSatisfied",
    "acceptanceCredit",
    "releaseCredit",
    "artifactDigest"
  ],
  "properties": {
    "schema": {
      "const": "ReleaseHookInventoryV1"
    },
    "schemaVersion": {
      "const": 1
    },
    "cardID": {
      "const": "V23-P00-C07"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptID",
        "executionMode",
        "baseHead",
        "baseTree",
        "candidateBinding",
        "packageDigest",
        "dossierDigest",
        "canonicalRegisterDigest",
        "directGraphDigest",
        "selectorManifestDigest",
        "relationManifestDigest",
        "dependencyDispositionDigest",
        "ownerOverrideReceiptDigest",
        "frozenS10ReservationDigest",
        "bootstrapContextDigest",
        "bootstrapPathFenceDigest",
        "provisionalPrerequisiteDigest",
        "writerAuthority",
        "ledgerDigest",
        "ledgerCASSequence",
        "phase10PollingDuringParallelExecution",
        "acceptanceEnabled",
        "hostedDispatchEnabled",
        "adoptionEnabled",
        "requiresAcceptedS10_6Reconciliation",
        "releaseCredit"
      ],
      "properties": {
        "attemptID": {
          "const": 1
        },
        "executionMode": {
          "const": "PRE_S10_6_PROVISIONAL_ORDERED_IMPLEMENTATION"
        },
        "baseHead": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidateBinding": {
          "const": "EXTERNAL_EXACT_HEAD_AND_TREE_RECEIPT_REQUIRED"
        },
        "packageDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dossierDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonicalRegisterDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "directGraphDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selectorManifestDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "relationManifestDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencyDispositionDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ownerOverrideReceiptDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frozenS10ReservationDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bootstrapContextDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bootstrapPathFenceDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provisionalPrerequisiteDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "writerAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ownerID",
            "writerGeneration"
          ],
          "properties": {
            "ownerID": {
              "const": "A00_BOOTSTRAP_CONTROLLER"
            },
            "writerGeneration": {
              "const": 0
            }
          }
        },
        "ledgerDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ledgerCASSequence": {
          "const": 19
        },
        "phase10PollingDuringParallelExecution": {
          "const": false
        },
        "acceptanceEnabled": {
          "const": false
        },
        "hostedDispatchEnabled": {
          "const": false
        },
        "adoptionEnabled": {
          "const": false
        },
        "requiresAcceptedS10_6Reconciliation": {
          "const": true
        },
        "releaseCredit": {
          "const": false
        }
      }
    },
    "acceptanceCredit": {
      "const": false
    },
    "releaseCredit": {
      "const": false
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scannerVersion": {
      "const": 1
    },
    "scanRuleDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceRoot": {
      "const": "PRODUCTION_TARGET_AND_PROJECT_CONFIGURATION"
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "sourceSnapshotDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patterns": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "category",
          "reachability",
          "evidenceSHA256",
          "disposition"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "reachability": {
            "const": "PRODUCTION_SOURCE_TARGET"
          },
          "evidenceSHA256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "disposition": {
            "enum": [
              "DEFERRED_FROZEN_S10_RESERVED_PATH",
              "REQUIRES_C07_RELEASE_ISOLATION_REMEDIATION"
            ]
          }
        }
      }
    },
    "countsByCategory": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "countsByDisposition": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "releaseAbsenceSatisfied": {
      "const": false
    }
  }
}
