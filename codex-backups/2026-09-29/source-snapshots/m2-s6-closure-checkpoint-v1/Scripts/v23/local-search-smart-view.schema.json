    "sourceKindMapping": {"type":"object","additionalProperties":false,"properties":{"fieldID":{"enum":["asset_identifier","asset_label","location_identifier","location_label","location_breadcrumb","work_identifier","work_summary","report_identifier","report_summary","status"]},"sourceKind":{"enum":["ASSET","LOCATION","WORK","REPORT"]}},"required":["fieldID","sourceKind"]},
    "fields": {"type":"object","additionalProperties":{"type":["string","null"],"maxLength":512},"propertyNames":{"enum":["asset_identifier","asset_label","location_identifier","location_label","location_breadcrumb","work_identifier","work_summary","report_identifier","report_summary","status"]},"minProperties":2},
    "record": {"type":"object","additionalProperties":false,"properties":{"stableID":{"type":"string","minLength":1,"maxLength":128},"kind":{"enum":["ASSET","LOCATION","WORK","REPORT"]},"displayIdentity":{"type":"string","minLength":1,"maxLength":256},"locationBreadcrumb":{"type":"string","minLength":1,"maxLength":512},"status":{"type":"string","minLength":1,"maxLength":64},"openWorkContext":{"type":["string","null"],"maxLength":512},"timestamp":{"type":"integer","minimum":0},"fields":{"$ref":"#/$defs/fields"}},"required":["stableID","kind","displayIdentity","locationBreadcrumb","status","openWorkContext","timestamp","fields"]},
    "query": {"type":"object","additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+$"},"query":{"type":"string","maxLength":256},"scope":{"enum":["ALL","ASSETS","LOCATIONS","WORK","REPORTS"]},"filters":{"$ref":"#/$defs/closedStringArray"},"expectedStableIDs":{"$ref":"#/$defs/closedStringArray"}},"required":["id","query","scope","filters","expectedStableIDs"]},
    "hostile": {"type":"object","additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+$"},"sourceRevision":{"type":"integer","minimum":0},"indexRevision":{"type":"integer","minimum":0},"query":{"type":"string","maxLength":256},"recordCount":{"type":"integer","minimum":1,"maximum":10000},"expected":{"enum":["REBUILD_REQUIRED_NO_RESULTS","FAIL_CLOSED_NO_RESULTS","DEDUPLICATE_BY_STABLE_ID","REBUILD_PURGES_RESULT","NO_SUGGESTION","SUGGESTION_ONLY_DISTANCE_1","ZERO_RESULTS_ZERO_SUGGESTIONS","FAIL_BUDGET_NO_PARTIAL_SUCCESS"]}},"required":["id","expected"],"anyOf":[{"required":["sourceRevision","indexRevision"]},{"required":["query"]},{"required":["recordCount"]}]},
    "smartView": {"type":"object","additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+$"},"kind":{"enum":["RECENT","INCOMPLETE","RECHECK_DUE","REPORT_FAILED","BACKUP_STALE"]},"sort":{"enum":["TIMESTAMP_DESC_STABLE_ID_ASC","STATUS_THEN_STABLE_ID","DUE_DATE_THEN_STABLE_ID"]}},"required":["id","kind","sort"]},
    "crash": {"type":"object","additionalProperties":false,"properties":{"boundary":{"enum":["AFTER_CANONICAL_COMMIT_BEFORE_INDEX_UPDATE","AFTER_REBUILD_TEMP_WRITE_BEFORE_REPLACE","AFTER_REPLACE_BEFORE_WATERMARK_RECEIPT"]},"expected":{"enum":["REBUILD_FROM_REVISION_42","DISCARD_TEMP_REBUILD","RECONCILE_AND_RETURN_SAME_INDEX"]}},"required":["boundary","expected"]},
    "recovery": {"type":"object","additionalProperties":false,"properties":{"dropDerivedIndex":{"const":true},"retainCanonicalRecords":{"const":true},"retainSavedSmartViews":{"const":true},"retainTransientQuery":{"const":false},"rebuildDeterministic":{"const":true}},"required":["dropDerivedIndex","retainCanonicalRecords","retainSavedSmartViews","retainTransientQuery","rebuildDeterministic"]},
    "productionClosure": {"type":"object","additionalProperties":false,"properties":{"sourceKindRegistrationCount":{"const":13},"writerInvalidationSynchronous":{"const":true},"startupInvalidationSynchronous":{"const":true},"assetSiteCrashRetryMarkerOrdered":{"const":true},"orphanCleanupPurgesDerivedIndex":{"const":true},"typedCanonicalStableKeys":{"const":true},"sameSearchKindTypedIdentityCollisionSafe":{"const":true},"truthfulIncompleteStatusSemantics":{"const":true},"backupStaleRequiresOperationalProvider":{"const":true},"rebuildPublicationTokenRequired":{"const":true},"sameRevisionDeletionRaceCovered":{"const":true},"swiftDataProjectionSource":{"const":"SwiftDataSearchCanonicalProjectionSourceV1"},"serviceSeam":{"const":"ProductionSearchServicesV1"}},"required":["sourceKindRegistrationCount","writerInvalidationSynchronous","startupInvalidationSynchronous","assetSiteCrashRetryMarkerOrdered","orphanCleanupPurgesDerivedIndex","typedCanonicalStableKeys","sameSearchKindTypedIdentityCollisionSafe","truthfulIncompleteStatusSemantics","backupStaleRequiresOperationalProvider","rebuildPublicationTokenRequired","sameRevisionDeletionRaceCovered","swiftDataProjectionSource","serviceSeam"]},
    "privacy": {"type":"object","additionalProperties":false,"properties":{"indexedFieldIDs":{"$ref":"#/$defs/closedStringArray"},"excludedFieldIDs":{"$ref":"#/$defs/closedStringArray"},"diagnosticsContainCustomerContent":{"const":false}},"required":["indexedFieldIDs","excludedFieldIDs","diagnosticsContainCustomerContent"]},
    "corpus": {"type":"object","additionalProperties":false,"properties":{"schema":{"const":"V21P03C09LocalSearchCorpusV1"},"schemaVersion":{"const":1},"fixedSeed":{"const":230309},"workspaceID":{"type":"string","format":"uuid"},"sourceRevision":{"const":42},"bounds":{"$ref":"#/$defs/bounds"},"sourceKindMappings":{"type":"array","items":{"$ref":"#/$defs/sourceKindMapping"},"minItems":13,"maxItems":13,"uniqueItems":true},"records":{"type":"array","items":{"$ref":"#/$defs/record"},"minItems":6,"maxItems":6,"uniqueItems":true},"queries":{"type":"array","items":{"$ref":"#/$defs/query"},"minItems":6,"maxItems":6,"uniqueItems":true},"hostileCases":{"type":"array","items":{"$ref":"#/$defs/hostile"},"minItems":8,"maxItems":8,"uniqueItems":true},"smartViews":{"type":"array","items":{"$ref":"#/$defs/smartView"},"minItems":5,"maxItems":5,"uniqueItems":true},"crashMatrix":{"type":"array","items":{"$ref":"#/$defs/crash"},"minItems":3,"maxItems":3,"uniqueItems":true},"recovery":{"$ref":"#/$defs/recovery"},"productionClosure":{"$ref":"#/$defs/productionClosure"},"privacy":{"$ref":"#/$defs/privacy"}},"required":["schema","schemaVersion","fixedSeed","workspaceID","sourceRevision","bounds","sourceKindMappings","records","queries","hostileCases","smartViews","crashMatrix","recovery","productionClosure","privacy"]}
  }
