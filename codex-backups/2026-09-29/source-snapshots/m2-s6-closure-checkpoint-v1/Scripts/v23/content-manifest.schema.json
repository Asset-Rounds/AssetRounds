{
  "$id": "https://assetrounds.invalid/v23/v23-p03-c05/ContentManifestV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "contentID": {
            "maxLength": 128,
            "pattern": "^[a-z0-9._-]+$",
            "type": "string"
          },
          "digest": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "algorithm": {
                      "const": "SHA256"
                    }
                  },
                  "required": [
                    "algorithm"
                  ]
                },
                "then": {
                  "properties": {
                    "hexadecimalValue": {
                      "maxLength": 64,
                      "minLength": 64
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "algorithm": {
                      "const": "SHA512"
                    }
                  },
                  "required": [
                    "algorithm"
                  ]
                },
                "then": {
                  "properties": {
                    "hexadecimalValue": {
                      "maxLength": 128,
                      "minLength": 128
                    }
                  }
                }
              }
            ],
            "properties": {
              "algorithm": {
                "enum": [
                  "SHA256",
                  "SHA512"
                ],
                "type": "string"
              },
              "hexadecimalValue": {
                "maxLength": 128,
                "minLength": 64,
                "pattern": "^[0-9a-f]+$",
                "type": "string"
              }
            },
            "required": [
              "algorithm",
              "hexadecimalValue"
            ],
            "type": "object"
          },
          "expectedByteLength": {
            "minimum": 0,
            "type": "integer"
          },
          "expectedLocatorRevision": {
            "minimum": 0,
            "type": "integer"
          },
          "mediaType": {
            "maxLength": 127,
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
            "type": "string"
          },
          "requiredForOpen": {
            "type": "boolean"
          }
        },
        "required": [
          "contentID",
          "expectedByteLength",
          "mediaType",
          "digest",
          "expectedLocatorRevision",
          "requiredForOpen"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "manifestID": {
      "maxLength": 128,
      "pattern": "^[a-z0-9._-]+$",
      "type": "string"
    },
    "manifestRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1
    },
    "workspaceID": {
      "maxLength": 128,
      "pattern": "^[a-z0-9._-]+$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "manifestID",
    "workspaceID",
    "manifestRevision",
    "entries"
  ],
  "title": "ContentManifestV1",
  "type": "object",
  "x-assetrounds-restoreSemantics": {
    "cloneForkEmptyC05Metadata": "UNCHANGED",
    "cloneForkNonemptyC05Metadata": "FAIL_CLOSED",
    "recordsAtOrBelow41": "UNCHANGED",
    "replace": "EXACT_C05_METADATA"
  },
  "x-assetrounds-runtimeSemanticConstraints": [
    "ENTRIES_SORTED_BY_CONTENT_ID",
    "CONTENT_ID_UNIQUE",
    "REQUIRED_FOR_OPEN_IS_EXPLICIT"
  ]
}
