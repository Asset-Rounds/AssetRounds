{
  "$id": "https://assetrounds.invalid/v23/TypedResponseEvidenceReceiptV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "brandImpact": {
      "additionalProperties": false,
      "properties": {
        "affectedConsumers": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "changedScreens": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "minItems": 0,
          "type": "array"
        },
        "changedStates": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "minItems": 0,
          "type": "array"
        },
        "completenessRationale": {
          "type": "string"
        },
        "manifestCount": {
          "const": 1
        },
        "manifestType": {
          "const": "BrandImpactManifestV1"
        }
      },
      "required": [
        "manifestType",
        "manifestCount",
        "changedScreens",
        "changedStates",
        "affectedConsumers",
        "completenessRationale"
      ],
      "type": "object"
    },
    "cardID": {
      "const": "V23-P03-C03"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidenceID": {
            "pattern": "^V23-P03-C03-[GAHIR]01$",
            "type": "string"
          },
          "family": {
            "enum": [
              "G01",
              "A01",
              "H01",
              "I01",
              "R01"
            ],
            "type": "string"
          },
          "requiredOutcome": {
            "type": "string"
          },
          "testMethod": {
            "pattern": "^testV9_13[GAHIR]01[A-Za-z0-9_]+$",
            "type": "string"
          }
        },
        "required": [
          "evidenceID",
          "family",
          "testMethod",
          "requiredOutcome"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "fixture": {
      "additionalProperties": false,
      "properties": {
        "canonicalSHA256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "measurementDimensions": {
          "items": {
            "enum": [
              "DIMENSIONLESS",
              "LENGTH",
              "ILLUMINANCE",
              "DURATION",
              "TEMPERATURE"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "repeatActivities": {
          "items": {
            "enum": [
              "ACTIVE",
              "INACTIVE_BY_PATH",
              "REACTIVATION_REVIEW_REQUIRED"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "requiredMarkers": {
          "items": {
            "type": "string"
          },
          "maxItems": 9,
          "minItems": 9,
          "type": "array"
        },
        "responseKinds": {
          "items": {
            "enum": [
              "NO_VALUE",
              "NOT_APPLICABLE",
              "BOOLEAN",
              "TRI_STATE",
              "SINGLE_OPTION",
              "MULTIPLE_OPTIONS",
              "TEXT",
              "LOCAL_DATE",
              "LOCAL_TIME",
              "INSTANT",
              "DURATION",
              "INTEGER",
              "DECIMAL",
              "MEASUREMENT",
              "ENTITY_REFERENCE",
              "CONTENT_REFERENCE"
            ],
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        },
        "roundingDispositions": {
          "items": {
            "enum": [
              "EXACT",
              "NEAREST_TOWARD_ZERO",
              "NEAREST_AWAY_FROM_ZERO",
              "TIE_EVEN_UNCHANGED",
              "TIE_EVEN_ADJUSTED"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "schema": {
          "const": "V21P03C03TypedResponseCorpusV1"
        },
        "schemaVersion": {
          "const": 1
        },
        "sourceSHA256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "testOnly": {
          "const": true
        },
        "topLevelKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "unitIDs": {
          "items": {
            "pattern": "^[A-Za-z0-9._\\[\\]-]{1,128}$",
            "type": "string"
          },
          "maxItems": 15,
          "minItems": 15,
          "type": "array"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "testOnly",
        "topLevelKeys",
        "responseKinds",
        "measurementDimensions",
        "unitIDs",
        "roundingDispositions",
        "repeatActivities",
        "requiredMarkers",
        "sourceSHA256",
        "canonicalSHA256"
      ],
      "type": "object"
    },
    "interruptionBoundaries": {
      "items": {
        "enum": [
          "BEFORE_VALIDATION",
          "AFTER_VALIDATION_BEFORE_PUBLICATION",
          "AFTER_PUBLICATION_BEFORE_RECEIPT"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "privacy": {
      "additionalProperties": false,
      "properties": {
        "customerDataInContracts": {
          "const": false
        },
        "customerDataInFixtures": {
          "const": false
        },
        "networkTransport": {
          "const": false
        },
        "productionMeasurementCapture": {
          "const": false
        },
        "secretsInArtifacts": {
          "const": false
        },
        "userAuthoredCode": {
          "const": false
        }
      },
      "required": [
        "customerDataInContracts",
        "customerDataInFixtures",
        "networkTransport",
        "userAuthoredCode",
        "secretsInArtifacts",
        "productionMeasurementCapture"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    },
    "testMethods": {
      "items": {
        "pattern": "^testV9_13[GAHIR]01[A-Za-z0-9_]+$",
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "cardID",
    "evidence",
    "testMethods",
    "interruptionBoundaries",
    "fixture",
    "brandImpact",
    "privacy"
  ],
  "title": "TypedResponseEvidenceReceiptV1",
  "type": "object"
}
