    "brand": {"type": "object", "additionalProperties": false, "required": ["manifestCount", "uiSurfaceDelta", "brandSurfaceDelta", "fullSweepTriggered"], "properties": {"manifestCount": {"const": 1}, "uiSurfaceDelta": {"const": false}, "brandSurfaceDelta": {"const": false}, "fullSweepTriggered": {"const": false}}},
    "portableValidationReceipt": {"type": "object", "additionalProperties": false, "required": ["caseID", "classification", "instancePath", "schemaPath", "inputSHA256", "toolSourceSHA256", "lockSHA256", "deterministicReplayMatched"], "properties": {"caseID": {"type": "string", "minLength": 1}, "classification": {"enum": ["ACCEPTED", "REJECTED"]}, "instancePath": {"type": "string"}, "schemaPath": {"type": "string"}, "inputSHA256": {"$ref": "#/$defs/digest"}, "toolSourceSHA256": {"$ref": "#/$defs/digest"}, "lockSHA256": {"$ref": "#/$defs/digest"}, "deterministicReplayMatched": {"const": true}}},
    "portableValidationReceipts": {"type": "object", "additionalProperties": false, "required": ["toolID", "toolSourceSHA256", "lockSHA256", "networkFetchCount", "deterministicReplayMatched", "cases"], "properties": {"toolID": {"const": "ASSETROUNDS_PYTHON_JSON_SCHEMA_DRAFT_2020_12_V1"}, "toolSourceSHA256": {"$ref": "#/$defs/digest"}, "lockSHA256": {"$ref": "#/$defs/digest"}, "networkFetchCount": {"const": 0}, "deterministicReplayMatched": {"const": true}, "cases": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/portableValidationReceipt"}}}},
    "s10": {"type": "object", "additionalProperties": false, "required": ["reservedPathCount", "overlapPaths"], "properties": {"reservedPathCount": {"const": 86}, "overlapPaths": {"type": "array", "maxItems": 0}}}
