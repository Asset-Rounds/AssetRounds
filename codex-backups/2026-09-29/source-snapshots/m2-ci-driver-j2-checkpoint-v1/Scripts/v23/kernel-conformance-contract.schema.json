    "persistence": {"type": "object", "additionalProperties": false, "required": ["mode", "schemaBehaviorDelta", "migrationBehaviorDelta", "backupBehaviorDelta", "restoreBehaviorDelta", "deleteBehaviorDelta", "exportBehaviorDelta", "downgradeDisposition"], "properties": {"mode": {"const": "NONE"}, "schemaBehaviorDelta": {"const": false}, "migrationBehaviorDelta": {"const": false}, "backupBehaviorDelta": {"const": false}, "restoreBehaviorDelta": {"const": false}, "deleteBehaviorDelta": {"const": false}, "exportBehaviorDelta": {"const": false}, "downgradeDisposition": {"const": "NOT_APPLICABLE"}}},
