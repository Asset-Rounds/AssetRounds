  ],
  "alternateCases": [
    {"id": "V23-P03-C39-A01-missing-identifier", "expectedResult": "EXPLICIT_UNKNOWN_ATTRIBUTE", "reason": "Missing manufacturer, model, serial, and code remain valid explicit unknown values."},
    {"id": "V23-P03-C39-A01-duplicate-identifier", "expectedResult": "EXPLICIT_DUPLICATE_REVIEW_STATE", "reason": "A duplicate serial or code is review metadata and never replaces AssetID."},
    {"id": "V23-P03-C39-A01-retired-history", "expectedResult": "RETAINED_IMMUTABLE_HISTORY", "reason": "Retired and replaced assets remain in reports, snapshots, backups, and replay history."}
  ],
  "hostileCases": [
    {"id": "V23-P03-C39-H01-package-retired-mid-draft", "expectedResult": "OLD_DRAFT_RELEASE_PINNED", "reason": "A package retirement cannot rewrite an open work subject."},
    {"id": "V23-P03-C39-H01-binding-change-open-work", "expectedResult": "REJECTED_STALE_BINDING", "reason": "A binding revision change during open work fails closed."},
    {"id": "V23-P03-C39-H01-same-serial-across-sites", "expectedResult": "DUPLICATE_NOT_IDENTITY", "reason": "The same serial at two Sites is explicit duplicate review state."},
    {"id": "V23-P03-C39-H01-model-treated-as-unique", "expectedResult": "REJECTED_IDENTITY_SUBSTITUTION", "reason": "Model and external codes cannot become canonical identity."},
    {"id": "V23-P03-C39-H01-cyclic-successors", "expectedResult": "REJECTED_CYCLE", "reason": "Successor links are checked for cycles and atomic references."},
    {"id": "V23-P03-C39-H01-relationship-endpoint-replacement", "expectedResult": "REJECTED_WRONG_OWNER", "reason": "C39 cannot replace a functional relationship endpoint owned by C41."},
    {"id": "V23-P03-C39-H01-unknown-semantic-release", "expectedResult": "REJECTED_UNKNOWN_RELEASE", "reason": "Unknown semantic IDs and releases fail admission."},
    {"id": "V23-P03-C39-H01-cross-workspace-subject", "expectedResult": "REJECTED_CROSS_WORKSPACE_REFERENCE", "reason": "Subject snapshots cannot cross workspace boundaries."},
    {"id": "V23-P03-C39-H01-identifier-spoof-unicode", "expectedResult": "QUARANTINED_NORMALIZATION_COLLISION", "reason": "Spoofed or Unicode-colliding identifiers are reviewable attributes, never identity."},
    {"id": "V23-P03-C39-H01-recall-presented-confirmed", "expectedResult": "REJECTED_UNSUPPORTED_CLAIM", "reason": "C39 never polls for or confirms recall, safety, condition, age, or warranty."}
  ],
  "interruptionCases": [
    {"id": "V23-P03-C39-I01-migration-boundary", "expectedResult": "COPY_ON_WRITE_RETRY_CONVERGES", "reason": "A fault at each migration boundary retries to one schema-v10 result or no effect."},
    {"id": "V23-P03-C39-I01-binding-boundary", "expectedResult": "EFFECT_BEFORE_RECEIPT_RECOVERY", "reason": "Binding event retry returns the original durable receipt without duplication."},
    {"id": "V23-P03-C39-I01-lifecycle-boundary", "expectedResult": "ATOMIC_PAIR_OR_NO_EFFECT", "reason": "Lifecycle and exact successor or reclassification pair commit under one MutationID."},
    {"id": "V23-P03-C39-I01-scope-boundary", "expectedResult": "FROZEN_SCOPE_OR_NO_EFFECT", "reason": "Interrupted subject snapshot creation cannot leave a partial canonical scope."},
