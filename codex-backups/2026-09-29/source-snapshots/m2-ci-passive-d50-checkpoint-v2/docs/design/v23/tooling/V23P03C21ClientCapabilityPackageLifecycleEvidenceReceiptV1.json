      "kind": "ALTERNATE"
    },
    {
      "assertion": "All nine package operations have explicit closed dispositions and no implicit operation is admitted.",
      "id": "C21-S03",
      "kind": "OPERATION_MATRIX"
    },
    {
      "assertion": "Finalize and amend preserve immutable release bytes, revisions, predecessor identity, and receipt digests.",
