      "assertion": "V20/records19 migration, backup/restore, import/export, report/search, replay, delete, Erase, interruption, and recovery close four durable families.",
      "id": "C21-S06",
      "kind": "LIFECYCLE"
    },
    {
      "assertion": "Unknown client, forged capability, stale revision, cross-workspace/site input, remote identity, provider, network, mutable release, and second writer fail closed.",
      "id": "C21-H01",
      "kind": "HOSTILE"
    },
    {
      "assertion": "Interruption before or after admission/disposition leaves either no canonical effect or one exact retryable effect with no duplicate receipt.",
      "id": "C21-I01",
      "kind": "INTERRUPTION"
    },
    {
      "assertion": "Recovery, replay, restore, clone, fork, and forward-fix preserve exact old-or-new immutable package artifacts and readable history.",
