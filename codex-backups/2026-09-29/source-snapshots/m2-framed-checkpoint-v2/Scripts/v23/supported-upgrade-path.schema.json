{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supported-upgrade-path.schema.json",
  "title": "SupportedUpgradePathV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "persistence",
    "readableVersions",
    "currentWriterVersion",
    "forwardUpgradeTransitions",
    "unknownVersionDisposition",
    "writerDisposition",
    "searchDisposition",
    "rebuildDisposition"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "family": { "$ref": "#/$defs/artifactFamily" },
    "persistence": {
      "enum": ["publicly_persisted", "internal_recovery"]
    },
    "readableVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/versionToken" }
    },
    "currentWriterVersion": { "$ref": "#/$defs/versionToken" },
    "forwardUpgradeTransitions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromVersion", "toVersion"],
        "properties": {
          "fromVersion": { "$ref": "#/$defs/versionToken" },
          "toVersion": { "$ref": "#/$defs/versionToken" }
        }
      }
    },
    "unknownVersionDisposition": {
      "const": "fail_closed_unsupported_version"
    },
    "writerDisposition": { "const": "current_version_only" },
    "searchDisposition": { "$ref": "#/$defs/capabilityDisposition" },
    "rebuildDisposition": { "$ref": "#/$defs/capabilityDisposition" }
  },
  "$defs": {
    "artifactFamily": {
      "enum": [
        "live_store",
        "current_generation_pointer",
        "store_generation_manifest",
        "store_migration_journal",
        "backup_package",
        "streaming_archive",
        "report_open_json",
        "report_pdf",
        "finalization_intent",
        "sign_pack",
        "durable_media",
        "deletion_ledger",
        "deletion_intent",
        "erase_intent",
        "restore_intent"
      ]
    },
    "capabilityDisposition": {
      "enum": [
        "available",
        "unavailable_at_this_head",
        "deferred_to_v23_p03_c09",
        "not_applicable"
      ]
    },
    "versionToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/+\\-]+$"
    }
  }
}
