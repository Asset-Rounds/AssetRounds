{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetrounds.example/schemas/s10.4-automation-amendment-v1/s10-accessibility-common-tasks.schema.json",
  "title": "AssetRounds S10.4 sharded automated accessibility overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_status",
    "automation_amendment_id",
    "source_product_head",
    "device_profile_ids",
    "criteria_checked_date",
    "features",
    "eligible_features",
    "tasks",
    "aggregate"
  ],
  "properties": {
    "schema_version": { "const": "4.1.0" },
    "document_status": { "const": "automated_evaluated" },
    "automation_amendment_id": { "const": "assetrounds-s10.4-automation-amendment-v1" },
    "source_product_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "device_profile_ids": {
      "const": [
        "iphone-17-ios-26.2-current",
        "iphone-se-3-ios-18.0-minimum"
      ]
    },
    "criteria_checked_date": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "features": {
      "const": [
        "voiceover",
        "voice_control",
        "larger_text",
        "dark_interface",
        "differentiate_without_color",
        "sufficient_contrast",
        "reduced_motion"
      ]
    },
    "eligible_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["voiceover", "voice_control", "larger_text", "dark_interface", "differentiate_without_color", "sufficient_contrast", "reduced_motion"]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "title", "critical", "screen_state_ids", "feature_results"],
        "properties": {
          "task_id": {
            "enum": ["one_handed_start", "capture_and_review", "force_quit_draft_resume", "history_recovery", "work_and_recheck", "report_comprehension"]
          },
          "title": { "type": "string", "minLength": 1 },
          "critical": { "type": "boolean" },
          "screen_state_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^state\\.[a-z0-9._-]+$" }
          },
          "feature_results": {
            "type": "array",
            "minItems": 14,
            "maxItems": 14,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "device_profile_id",
                "feature",
                "automation_shard_id",
                "source_product_head",
                "run_id",
                "job_id",
                "artifact_id",
                "artifact_digest",
                "ax_evidence_id",
                "ax_evidence_locator",
                "ax_evidence_sha256",
                "focus_order_evidence_id",
                "target_size_evidence_id",
                "contrast_evidence_id",
                "automated_status",
                "automated_evidence_ids",
                "automated_reviewer",
                "exception_issue_id",
                "exception_owner",
                "exception_expires_at",
                "exception_rationale",
                "manual_status",
                "manual_evidence_ids",
                "manual_reviewer",
                "rationale"
              ],
              "properties": {
                "device_profile_id": { "enum": ["iphone-17-ios-26.2-current", "iphone-se-3-ios-18.0-minimum"] },
                "feature": { "enum": ["voiceover", "voice_control", "larger_text", "dark_interface", "differentiate_without_color", "sufficient_contrast", "reduced_motion"] },
                "automation_shard_id": { "type": "string", "pattern": "^s10\\.4\\.(current|minimum)\\.[a-z0-9-]+$" },
                "source_product_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
                "job_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
                "artifact_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
                "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "ax_evidence_id": { "type": "string", "minLength": 1 },
                "ax_evidence_locator": { "type": "string", "minLength": 1 },
                "ax_evidence_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
                "focus_order_evidence_id": { "type": "string", "minLength": 1 },
                "target_size_evidence_id": { "type": "string", "minLength": 1 },
                "contrast_evidence_id": { "type": "string", "minLength": 1 },
                "automated_status": { "enum": ["PASS", "NOT_APPLICABLE", "EXCEPTION"] },
                "automated_evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "automated_reviewer": { "type": "string", "minLength": 1 },
                "exception_issue_id": { "type": "string" },
                "exception_owner": { "type": "string" },
                "exception_expires_at": { "type": "string" },
                "exception_rationale": { "type": "string" },
                "manual_status": { "const": "NOT_RUN" },
                "manual_evidence_ids": { "const": [] },
                "manual_reviewer": { "const": "" },
                "rationale": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_product_head",
        "task_count",
        "device_profile_count",
        "feature_count",
        "automated_row_count",
        "manual_open_row_count",
        "task_set_sha256",
        "accessibility_tuple_set_sha256",
        "all_automated_rows_closed",
        "manual_results_unclaimed",
        "evidence_ids"
      ],
      "properties": {
        "source_product_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "task_count": { "const": 6 },
        "device_profile_count": { "const": 2 },
        "feature_count": { "const": 7 },
        "automated_row_count": { "const": 84 },
        "manual_open_row_count": { "const": 84 },
        "task_set_sha256": { "const": "BAC94780D3AA60B036E370F1FF1EAF12DE9E5CBB1EB4C6D1A58E6C19AD72C33B" },
        "accessibility_tuple_set_sha256": { "const": "E8F43E18BF400FA3BC229436DA0598EE3F67914710A729673C591BE6B49D76BE" },
        "all_automated_rows_closed": { "const": true },
        "manual_results_unclaimed": { "const": true },
        "evidence_ids": {
          "type": "array",
          "minItems": 14,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
